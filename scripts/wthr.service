[Unit]
Description=wthr Weather Service
After=network.target
Documentation=https://github.com/webappsgo/wthr

[Service]
Type=simple
User=wthr
Group=wthr
WorkingDirectory=/var/lib/webappsgo/wthr

# Application runs from /usr/local/bin/wthr (installed by package manager or scripts/install.sh)
ExecStart=/usr/local/bin/wthr

# Restart policy
Restart=on-failure
RestartSec=5s

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wthr

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/webappsgo/wthr /var/log/webappsgo/wthr /etc/webappsgo/wthr /var/cache/webappsgo/wthr
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Resource limits
LimitNOFILE=65536
TasksMax=4096

[Install]
WantedBy=multi-user.target
