<!DOCTYPE html>
<html lang="en" class="{{if .server.ThemeClass}}{{.server.ThemeClass}}{{else}}theme-dark{{end}}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title>{{.Title}}</title>
    <link rel="stylesheet" href="/static/css/common.css">
    <link rel="stylesheet" href="/static/css/components.css">
    <link rel="stylesheet" href="/static/css/public.css">
</head>
<body>
    <div class="login-container">
        <div class="login-card setup-card">
            <div class="login-header">
                <h1 class="login-title">{{t .server.Lang "setup_services_title"}}</h1>
                <p class="login-subtitle">{{t .server.Lang "setup_services_step_subtitle"}}</p>
            </div>

            <div class="setup-progress">
                <div class="progress-bar">
                    <div class="progress-fill" style="width: 83.33%"></div>
                </div>
                <div class="progress-steps">
                    <span class="step completed">{{t .server.Lang "setup_step_admin"}}</span>
                    <span class="step completed">{{t .server.Lang "setup_step_api_token"}}</span>
                    <span class="step completed">{{t .server.Lang "setup_step_server"}}</span>
                    <span class="step completed">{{t .server.Lang "setup_step_security"}}</span>
                    <span class="step active">{{t .server.Lang "setup_step_services"}}</span>
                    <span class="step">{{t .server.Lang "setup_step_complete"}}</span>
                </div>
            </div>

            <div class="login-info">
                <p>{{t .server.Lang "setup_services_intro"}}</p>
            </div>

            {{ if .error }}
            <div class="error-message" role="alert">{{ .error }}</div>
            {{ end }}

            <form method="POST" action="" id="services-form" autocomplete="off">
                <input type="hidden" name="csrf_token" value="{{.csrf_token}}">

                <div class="service-option">
                    <label class="checkbox-label">
                        <input type="checkbox"
                               id="enable_ssl"
                               name="enable_ssl"
                               value="true">
                        <span>{{t .server.Lang "setup_services_enable_ssl_label"}}</span>
                    </label>
                    <p class="form-hint">{{t .server.Lang "setup_services_enable_ssl_hint"}}</p>

                    <div id="ssl-options" class="sub-options hidden">
                        <div class="form-group">
                            <label class="form-label" for="ssl_domain">{{t .server.Lang "setup_services_ssl_domain_label"}}</label>
                            <input type="text"
                                   id="ssl_domain"
                                   name="ssl_domain"
                                   class="form-input"
                                   value="{{ .DefaultDomain }}"
                                   placeholder="example.com">
                            <small class="form-hint">{{t .server.Lang "setup_services_ssl_domain_hint"}}</small>
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="ssl_email">{{t .server.Lang "setup_services_ssl_email_label"}}</label>
                            <input type="email"
                                   id="ssl_email"
                                   name="ssl_email"
                                   class="form-input"
                                   value="{{ .AdminEmail }}"
                                   placeholder="admin@example.com">
                            <small class="form-hint">{{t .server.Lang "setup_services_ssl_email_hint"}}</small>
                        </div>
                    </div>
                </div>

                <div class="service-option">
                    <label class="checkbox-label">
                        <input type="checkbox"
                               id="enable_multiuser"
                               name="enable_multiuser"
                               value="true">
                        <span>{{t .server.Lang "setup_services_enable_multiuser_label"}}</span>
                    </label>
                    <p class="form-hint">{{t .server.Lang "setup_services_enable_multiuser_hint"}}</p>

                    <div id="multiuser-options" class="sub-options hidden">
                        <div class="form-group">
                            <label class="form-label" for="registration_mode">{{t .server.Lang "setup_services_registration_mode_label"}}</label>
                            <select id="registration_mode" name="registration_mode" class="form-input">
                                <option value="open">{{t .server.Lang "setup_services_registration_mode_open"}}</option>
                                <option value="invite" selected>{{t .server.Lang "setup_services_registration_mode_invite"}}</option>
                                <option value="admin_only">{{t .server.Lang "setup_services_registration_mode_admin_only"}}</option>
                                <option value="disabled">{{t .server.Lang "setup_services_registration_mode_disabled"}}</option>
                            </select>
                        </div>
                    </div>
                </div>

                {{ if .TorAvailable }}
                <div class="service-option">
                    <div class="service-status">
                        <span class="status-badge status-active">{{t .server.Lang "setup_services_auto_enabled_badge"}}</span>
                    </div>
                    <label class="checkbox-label disabled">
                        <input type="checkbox" checked disabled>
                        <span>{{t .server.Lang "setup_services_tor_label"}}</span>
                    </label>
                    <p class="form-hint">{{t .server.Lang "setup_services_tor_hint"}}</p>
                    {{ if .OnionAddress }}
                    <p class="onion-preview"><code class="onion-address">{{ .OnionAddress }}</code></p>
                    {{ end }}
                </div>
                {{ end }}

                <button type="submit" id="submit-btn" class="btn-login">{{t .server.Lang "setup_services_complete_button"}}</button>
            </form>

            <div class="setup-skip">
                <a href="?skip=true" class="text-comment">{{t .server.Lang "setup_services_skip_step"}}</a>
            </div>
        </div>

        {{ if .version }}
        <div class="login-footer">
            v{{ .version }}
        </div>
        {{ end }}
    </div>

    <script>
        document.getElementById('enable_ssl').addEventListener('change', function() {
            document.getElementById('ssl-options').classList.toggle('hidden', !this.checked);
        });

        document.getElementById('enable_multiuser').addEventListener('change', function() {
            document.getElementById('multiuser-options').classList.toggle('hidden', !this.checked);
        });

        document.getElementById('services-form').addEventListener('submit', function(e) {
            var btn = document.getElementById('submit-btn');
            btn.disabled = true;
            btn.textContent = '{{t .server.Lang "setup_services_completing_button"}}';
        });
    </script>
</body>
</html>
