{{template "head" .}}
{{template "navbar" .}}

<div class="weather-container page-container">
    <div class="notifications-container">
        <div class="top-actions">
            <div class="filter-tabs">
                <button class="filter-tab active" data-filter="all">{{t .server.Lang "notifications_filter_all"}}</button>
                <button class="filter-tab" data-filter="unread">{{t .server.Lang "notifications_filter_unread"}}</button>
            </div>
            <button id="mark-all-read" class="btn btn-secondary btn-sm">✅ {{t .server.Lang "notifications_mark_all_read"}}</button>
        </div>

        <div id="notifications-list"></div>
    </div>
</div>

<script type="application/json" id="notifications-list-data">
{"apiPath": "{{.api_path}}"}
</script>

{{template "footer" .}}
