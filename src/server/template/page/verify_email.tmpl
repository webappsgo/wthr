{{define "page/verify_email.tmpl"}}
<!DOCTYPE html>
<html lang="en" class="{{if .server.ThemeClass}}{{.server.ThemeClass}}{{else}}theme-dark{{end}}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{.title}}</title>
    <link rel="stylesheet" href="/static/css/common.css">
    <link rel="stylesheet" href="/static/css/components.css">
    <link rel="stylesheet" href="/static/css/public.css">
</head>
<body>
    <div class="auth-container">
        <div class="auth-card">
            <h1>{{t .server.Lang "verify_email_heading"}}</h1>

            {{if .error}}
            <div class="alert alert-error" role="alert">{{.error}}</div>
            <div class="auth-links">
                <a href="/server/auth/login">{{t .server.Lang "user_invite_back_to_login"}}</a>
            </div>
            {{else}}
            <p>{{t .server.Lang "verify_email_verifying"}}</p>
            {{end}}
        </div>
    </div>
</body>
</html>
{{end}}
