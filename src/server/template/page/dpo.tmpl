{{template "head" .}}

{{template "navbar" .}}

<main id="main-content">
  <div class="container container-sm">
    <header class="page-header"><h1 class="page-title">{{t .server.Lang "dpo.title"}}</h1></header>

    <section class="section-card" aria-labelledby="dpo-details">
        <h2 id="dpo-details" class="sr-only">{{t .server.Lang "dpo.title"}}</h2>
        <p>{{t .server.Lang "dpo.intro"}}</p>
        {{if .name}}
        <p><strong>{{t .server.Lang "dpo.name_label"}}:</strong> {{.name}}</p>
        {{end}}
        {{if .email}}
        <p><strong>{{t .server.Lang "dpo.email_label"}}:</strong> <a href="mailto:{{.email}}">{{.email}}</a></p>
        {{else}}
        <p>{{t .server.Lang "dpo.no_email"}}</p>
        {{end}}
        <div class="actions">
            <a href="{{path "/server/security"}}" class="btn btn-primary">{{t .server.Lang "dpo.contact_form"}}</a>
            <a href="{{path "/server/privacy"}}" class="btn btn-secondary">{{t .server.Lang "dpo.privacy_link"}}</a>
        </div>
    </section>
  </div>
</main>

{{template "footer" .}}
