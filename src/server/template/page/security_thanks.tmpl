{{template "head" .}}

{{template "navbar" .}}

<main id="main-content">
  <div class="container container-sm">
    <header class="page-header">
      <nav class="breadcrumb" aria-label="Breadcrumb"><a href="{{path "/server/security"}}">{{t .server.Lang "security.back"}}</a></nav>
      <h1 class="page-title">{{t .server.Lang "security.thanks.title"}}</h1>
      <p class="page-lead">{{t .server.Lang "security.thanks.intro"}}</p>
    </header>

    <section class="section-card" aria-labelledby="security-thanks-content">
        <h2 id="security-thanks-content" class="sr-only">{{t .server.Lang "security.thanks.title"}}</h2>
        {{if .Entries}}
        <ul>
            {{range .Entries}}<li>{{.Credit}} <small>{{.Date}}</small></li>{{end}}
        </ul>
        {{else}}
        <p>{{t .server.Lang "security.thanks.empty"}}</p>
        {{end}}
    </section>
  </div>
</main>

{{template "footer" .}}
