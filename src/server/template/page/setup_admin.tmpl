<!DOCTYPE html>
<html lang="en" class="{{if .server.ThemeClass}}{{.server.ThemeClass}}{{else}}theme-dark{{end}}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title>{{.Title}}</title>
    <link rel="stylesheet" href="/static/css/common.css">
    <link rel="stylesheet" href="/static/css/components.css">
    <link rel="stylesheet" href="/static/css/public.css">
</head>
<body>
    <div class="login-container">
        <div class="login-card">
            <div class="login-header">
                <h1 class="login-title">{{t .server.Lang "setup_admin_title"}}</h1>
                <p class="login-subtitle">{{t .server.Lang "setup_admin_step_subtitle"}}</p>
            </div>

            <div class="login-info">
                <p>{{t .server.Lang "setup_admin_intro_line1"}}</p>
                <p>{{t .server.Lang "setup_admin_intro_line2"}}</p>
            </div>

            <div class="setup-progress">
                <div class="progress-bar">
                    <div class="progress-fill" style="width: 16.67%"></div>
                </div>
                <div class="progress-steps">
                    <span class="step active">{{t .server.Lang "setup_step_admin"}}</span>
                    <span class="step">{{t .server.Lang "setup_step_api_token"}}</span>
                    <span class="step">{{t .server.Lang "setup_step_server"}}</span>
                    <span class="step">{{t .server.Lang "setup_step_security"}}</span>
                    <span class="step">{{t .server.Lang "setup_step_services"}}</span>
                    <span class="step">{{t .server.Lang "setup_step_complete"}}</span>
                </div>
            </div>

            {{ if .error }}
            <div class="error-message" role="alert">{{ .error }}</div>
            {{ end }}

            {{/* Form works without JS (progressive enhancement) */}}
            <form method="POST" action="" id="admin-form" autocomplete="off">
                <input type="hidden" name="csrf_token" value="{{.csrf_token}}">

                <div class="form-group">
                    <label class="form-label" for="username">{{t .server.Lang "setup_admin_username_label"}}</label>
                    <input type="text"
                           id="username"
                           name="username"
                           class="form-input"
                           value="administrator"
                           required
                           minlength="3"
                           aria-required="true">
                    <small class="form-hint">{{t .server.Lang "setup_admin_username_hint"}}</small>
                </div>

                <div class="form-group">
                    <label class="form-label" for="email">{{t .server.Lang "setup_admin_email_label"}}</label>
                    <input type="email"
                           id="email"
                           name="email"
                           class="form-input"
                           required
                           placeholder="admin@example.com"
                           aria-required="true">
                    <small class="form-hint">{{t .server.Lang "setup_admin_email_hint"}}</small>
                </div>

                <div class="form-group">
                    <label class="checkbox-label">
                        <input type="checkbox"
                               id="use_random"
                               name="use_random"
                               value="true"
                               checked>
                        <span>{{t .server.Lang "setup_admin_random_password_label"}}</span>
                    </label>
                    <small class="form-hint">{{t .server.Lang "setup_admin_random_password_hint"}}</small>
                </div>

                <div id="password-fields" class="password-fields hidden">
                    <div class="form-group">
                        <label class="form-label" for="password">{{t .server.Lang "setup_admin_password_label"}}</label>
                        <input type="password"
                               id="password"
                               name="password"
                               class="form-input"
                               minlength="12"
                               aria-required="false">
                        <small class="form-hint">{{t .server.Lang "setup_admin_password_min_hint"}}</small>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="confirm_password">{{t .server.Lang "reset_password_confirm_password_label"}}</label>
                        <input type="password"
                               id="confirm_password"
                               name="confirm_password"
                               class="form-input"
                               minlength="12"
                               aria-required="false">
                    </div>
                </div>

                <button type="submit" id="submit-btn" class="btn-login">{{t .server.Lang "setup_admin_submit_button"}}</button>
            </form>
        </div>

        {{ if .version }}
        <div class="login-footer">
            v{{ .version }}
        </div>
        {{ end }}
    </div>

    {{/* Progressive enhancement - form works without this */}}
    <script>
        (function() {
            var useRandomCheckbox = document.getElementById('use_random');
            var passwordFields = document.getElementById('password-fields');
            var passwordInput = document.getElementById('password');
            var confirmInput = document.getElementById('confirm_password');

            function togglePasswordFields() {
                if (useRandomCheckbox.checked) {
                    passwordFields.classList.add('hidden');
                    passwordInput.removeAttribute('required');
                    confirmInput.removeAttribute('required');
                } else {
                    passwordFields.classList.remove('hidden');
                    passwordInput.setAttribute('required', 'required');
                    confirmInput.setAttribute('required', 'required');
                }
            }

            useRandomCheckbox.addEventListener('change', togglePasswordFields);
            togglePasswordFields();

            document.getElementById('admin-form').addEventListener('submit', function(e) {
                var btn = document.getElementById('submit-btn');
                btn.disabled = true;
                btn.textContent = '{{t .server.Lang "setup_admin_creating_button"}}';
            });
        })();
    </script>
</body>
</html>
