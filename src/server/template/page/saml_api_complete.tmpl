<!DOCTYPE html>
<html lang="{{if .server.Lang}}{{.server.Lang}}{{else}}en{{end}}" dir="ltr" class="{{if .server.ThemeClass}}{{.server.ThemeClass}}{{else}}theme-dark{{end}}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{.title}}</title>
    <link rel="stylesheet" href="{{asset "/static/css/common.css"}}">
    <link rel="stylesheet" href="{{asset "/static/css/components.css"}}">
    <link rel="stylesheet" href="{{asset "/static/css/public.css"}}">
</head>
<body>
{{template "header" .}}
{{template "navbar" .}}
<main id="main-content" role="main">
    <section class="register-container" aria-labelledby="saml-api-complete-title">
        <h1 id="saml-api-complete-title">{{t .server.Lang "auth.saml.api_complete_title"}}</h1>
        <p>{{t .server.Lang "auth.saml.api_complete_description"}}</p>
        <dl>
            <dt>{{t .server.Lang "auth.saml.api_request_id"}}</dt>
            <dd><code class="break-all">{{.RequestID}}</code></dd>
            <dt>{{t .server.Lang "auth.saml.api_exchange_code"}}</dt>
            <dd><code class="break-all">{{.Code}}</code></dd>
        </dl>
        <p>{{t .server.Lang "auth.saml.api_complete_return"}}</p>
    </section>
</main>
{{template "footer" .}}
</body>
</html>
