{{template "head" .}}
{{template "navbar" .}}
<main id="main-content">
  <div class="container container-md">


{{$titleClass := "eq-detail-title--red"}}
{{if eq .Earthquake.Tsunami 1}}
    {{$titleClass = "eq-detail-title--cyan"}}
{{else if lt .Earthquake.Magnitude 2.0}}
    {{$titleClass = "eq-detail-title--green"}}
{{else if lt .Earthquake.Magnitude 4.0}}
    {{$titleClass = "eq-detail-title--yellow"}}
{{else if lt .Earthquake.Magnitude 5.0}}
    {{$titleClass = "eq-detail-title--orange"}}
{{end}}

{{$magnitudeClass := "eq-magnitude__badge--major"}}
{{if lt .Earthquake.Magnitude 2.0}}
    {{$magnitudeClass = "eq-magnitude__badge--minor"}}
{{else if lt .Earthquake.Magnitude 4.0}}
    {{$magnitudeClass = "eq-magnitude__badge--light"}}
{{else if lt .Earthquake.Magnitude 5.0}}
    {{$magnitudeClass = "eq-magnitude__badge--moderate"}}
{{else if lt .Earthquake.Magnitude 6.0}}
    {{$magnitudeClass = "eq-magnitude__badge--strong"}}
{{end}}

<header class="page-header">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/earthquakes">{{t .server.Lang "earthquake.detail_back_link"}}</a></nav>
    <h1 class="page-title">{{.Earthquake.Place}}</h1>
</header>

    <section class="section-card" aria-labelledby="earthquake-detail-heading">
        <h2 id="earthquake-detail-heading">{{t .server.Lang "earthquake.detail_magnitude_label"}}</h2>

        <div class="eq-detail-summary">
            <div class="eq-magnitude">
                <span class="eq-magnitude__badge {{$magnitudeClass}}">{{printf "%.1f" .Earthquake.Magnitude}}</span>
                <span class="eq-magnitude__label">{{t .server.Lang "earthquake.detail_magnitude_label"}}</span>
            </div>

            {{if eq .Earthquake.Tsunami 1}}
            <div class="eq-tsunami-alert">🌊 {{t .server.Lang "earthquake.detail_tsunami_warning"}}</div>
            {{end}}
        </div>

        <div class="eq-detail-grid">
            <div class="eq-detail-attribute">
                <div class="eq-detail-attribute__label">{{t .server.Lang "earthquake.detail_time_label"}}</div>
                <div class="eq-detail-attribute__value">{{.Earthquake.Time.Format "2006-01-02 15:04:05"}}</div>
                <div class="eq-detail-attribute__meta">{{.Earthquake.Time.Format "MST"}}</div>
            </div>

            <div class="eq-detail-attribute">
                <div class="eq-detail-attribute__label">{{t .server.Lang "earthquake.detail_location_label"}}</div>
                <div class="eq-detail-attribute__value">{{.Earthquake.Latitude}}°, {{.Earthquake.Longitude}}°</div>
                <div class="eq-detail-attribute__meta">{{t .server.Lang "earthquake.detail_lat_lon_meta"}}</div>
            </div>

            <div class="eq-detail-attribute">
                <div class="eq-detail-attribute__label">{{t .server.Lang "earthquake.detail_depth_label"}}</div>
                <div class="eq-detail-attribute__value">{{printf "%.1f" .Earthquake.Depth}} km</div>
                <div class="eq-detail-attribute__meta">{{t .server.Lang "earthquake.detail_below_surface"}}</div>
            </div>

            <div class="eq-detail-attribute">
                <div class="eq-detail-attribute__label">{{t .server.Lang "earthquake.detail_status_label"}}</div>
                <div class="eq-detail-attribute__value">{{.Earthquake.Status | upper}}</div>
                <div class="eq-detail-attribute__meta">{{t .server.Lang "earthquake.detail_reviewed_by_usgs"}}</div>
            </div>

            <div class="eq-detail-attribute">
                <div class="eq-detail-attribute__label">{{t .server.Lang "earthquake.detail_type_label"}}</div>
                <div class="eq-detail-attribute__value">{{.Earthquake.MagnitudeType}} {{.Earthquake.Type | upper}}</div>
            </div>

            {{if .Earthquake.Felt}}
            <div class="eq-detail-attribute">
                <div class="eq-detail-attribute__label">{{t .server.Lang "earthquake.detail_felt_label"}}</div>
                <div class="eq-detail-attribute__value">{{.Earthquake.Felt}} {{t .server.Lang "earthquake.detail_felt_people"}}</div>
                <div class="eq-detail-attribute__meta">{{t .server.Lang "earthquake.detail_felt_meta"}}</div>
            </div>
            {{end}}

            {{if .Earthquake.CDI}}
            <div class="eq-detail-attribute">
                <div class="eq-detail-attribute__label">CDI</div>
                <div class="eq-detail-attribute__value">{{printf "%.1f" .Earthquake.CDI}}</div>
                <div class="eq-detail-attribute__meta">{{t .server.Lang "earthquake.detail_cdi_meta"}}</div>
            </div>
            {{end}}

            {{if .Earthquake.MMI}}
            <div class="eq-detail-attribute">
                <div class="eq-detail-attribute__label">MMI</div>
                <div class="eq-detail-attribute__value">{{printf "%.1f" .Earthquake.MMI}}</div>
                <div class="eq-detail-attribute__meta">{{t .server.Lang "earthquake.detail_mmi_meta"}}</div>
            </div>
            {{end}}

            {{if .Earthquake.Alert}}
            <div class="eq-detail-attribute">
                <div class="eq-detail-attribute__label">{{t .server.Lang "earthquake.detail_alert_level_label"}}</div>
                <div class="eq-detail-attribute__value">{{.Earthquake.Alert | upper}}</div>
            </div>
            {{end}}
        </div>

        <div id="map" class="map-container" data-latitude="{{.Earthquake.Latitude}}" data-longitude="{{.Earthquake.Longitude}}" data-magnitude="{{.Earthquake.Magnitude}}" data-place="{{.Earthquake.Place}}" data-time="{{.Earthquake.Time.Format "2006-01-02 15:04:05"}}" data-depth="{{.Earthquake.Depth}}" data-tsunami="{{.Earthquake.Tsunami}}"></div>
    </section>

    <section class="section-card" aria-labelledby="earthquake-console-heading">
        <h2 id="earthquake-console-heading">📟 {{t .server.Lang "earthquake.detail_console_heading"}}</h2>
        <div class="console-commands">
            <div class="command-item">
                <strong class="console-section__label">{{t .server.Lang "earthquake.detail_command_label"}}</strong>
                <div class="code-wrapper">
                    <code class="mobile-code">curl -q -LSs {{.HostInfo.FullHost}}/earthquakes/detail/{{.Earthquake.ID}}</code>
                    <button class="copy-btn" data-action="copy-command" data-text="curl -q -LSs {{.HostInfo.FullHost}}/earthquakes/detail/{{.Earthquake.ID}}">{{t .server.Lang "admin.tor.copy_action"}}</button>
                </div>
            </div>
        </div>
    </section>

    <section class="section-card" aria-labelledby="earthquake-data-source-heading">
        <h2 id="earthquake-data-source-heading" class="sr-only">{{t .server.Lang "earthquake.detail_data_provided_by"}}</h2>
        <p class="data-footer__text">
            {{t .server.Lang "earthquake.detail_data_provided_by"}} <a href="https://earthquake.usgs.gov/" target="_blank" class="data-footer__link">{{t .server.Lang "earthquake.detail_usgs_program"}}</a><br>
            {{t .server.Lang "earthquake.detail_updated_frequently"}}
        </p>
    </section>


  </div>
</main>
{{template "footer" .}}
