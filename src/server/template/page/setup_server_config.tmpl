<!DOCTYPE html>
<html lang="en" class="{{if .server.ThemeClass}}{{.server.ThemeClass}}{{else}}theme-dark{{end}}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title>{{.Title}}</title>
    <link rel="stylesheet" href="/static/css/common.css">
    <link rel="stylesheet" href="/static/css/components.css">
    <link rel="stylesheet" href="/static/css/public.css">
</head>
<body>
    <div class="login-container">
        <div class="login-card setup-card">
            <div class="login-header">
                <h1 class="login-title">{{t .server.Lang "setup_server_config_title"}}</h1>
                <p class="login-subtitle">{{t .server.Lang "setup_server_config_step_subtitle"}}</p>
            </div>

            <div class="setup-progress">
                <div class="progress-bar">
                    <div class="progress-fill" style="width: 50%"></div>
                </div>
                <div class="progress-steps">
                    <span class="step completed">{{t .server.Lang "setup_step_admin"}}</span>
                    <span class="step completed">{{t .server.Lang "setup_step_api_token"}}</span>
                    <span class="step active">{{t .server.Lang "setup_step_server"}}</span>
                    <span class="step">{{t .server.Lang "setup_step_security"}}</span>
                    <span class="step">{{t .server.Lang "setup_step_services"}}</span>
                    <span class="step">{{t .server.Lang "setup_step_complete"}}</span>
                </div>
            </div>

            <div class="login-info">
                <p>{{t .server.Lang "setup_server_config_intro"}}</p>
            </div>

            {{ if .error }}
            <div class="error-message" role="alert">{{ .error }}</div>
            {{ end }}

            <form method="POST" action="" id="server-form" autocomplete="off">
                <input type="hidden" name="csrf_token" value="{{.csrf_token}}">

                <div class="form-group">
                    <label class="form-label" for="app_name">{{t .server.Lang "setup_server_config_app_name_label"}}</label>
                    <input type="text"
                           id="app_name"
                           name="app_name"
                           class="form-input"
                           value="{{ .DefaultAppName }}"
                           required
                           placeholder="Weather">
                    <small class="form-hint">{{t .server.Lang "setup_server_config_app_name_hint"}}</small>
                </div>

                <div class="form-group">
                    <label class="form-label" for="domain">{{t .server.Lang "setup_server_config_domain_label"}}</label>
                    <input type="text"
                           id="domain"
                           name="domain"
                           class="form-input"
                           value="{{ .DefaultDomain }}"
                           placeholder="weather.example.com">
                    <small class="form-hint">{{t .server.Lang "setup_server_config_domain_hint"}}</small>
                </div>

                <div class="form-group">
                    <label class="form-label" for="mode">{{t .server.Lang "setup_server_config_mode_label"}}</label>
                    <select id="mode" name="mode" class="form-input">
                        <option value="production" {{ if eq .DefaultMode "production" }}selected{{ end }}>{{t .server.Lang "setup_server_config_mode_production"}}</option>
                        <option value="development" {{ if eq .DefaultMode "development" }}selected{{ end }}>{{t .server.Lang "setup_server_config_mode_development"}}</option>
                    </select>
                    <small class="form-hint">{{t .server.Lang "setup_server_config_mode_hint"}}</small>
                </div>

                <div class="form-group">
                    <label class="form-label" for="timezone">{{t .server.Lang "setup_server_config_timezone_label"}}</label>
                    <select id="timezone" name="timezone" class="form-input">
                        <option value="UTC" {{ if eq .DefaultTimezone "UTC" }}selected{{ end }}>UTC</option>
                        <option value="America/New_York" {{ if eq .DefaultTimezone "America/New_York" }}selected{{ end }}>America/New_York ({{t .server.Lang "tz_eastern"}})</option>
                        <option value="America/Chicago" {{ if eq .DefaultTimezone "America/Chicago" }}selected{{ end }}>America/Chicago ({{t .server.Lang "tz_central"}})</option>
                        <option value="America/Denver" {{ if eq .DefaultTimezone "America/Denver" }}selected{{ end }}>America/Denver ({{t .server.Lang "tz_mountain"}})</option>
                        <option value="America/Los_Angeles" {{ if eq .DefaultTimezone "America/Los_Angeles" }}selected{{ end }}>America/Los_Angeles ({{t .server.Lang "tz_pacific"}})</option>
                        <option value="Europe/London" {{ if eq .DefaultTimezone "Europe/London" }}selected{{ end }}>Europe/London</option>
                        <option value="Europe/Paris" {{ if eq .DefaultTimezone "Europe/Paris" }}selected{{ end }}>Europe/Paris</option>
                        <option value="Asia/Tokyo" {{ if eq .DefaultTimezone "Asia/Tokyo" }}selected{{ end }}>Asia/Tokyo</option>
                        <option value="Australia/Sydney" {{ if eq .DefaultTimezone "Australia/Sydney" }}selected{{ end }}>Australia/Sydney</option>
                    </select>
                </div>

                <button type="submit" id="submit-btn" class="btn-login">{{t .server.Lang "setup_server_config_continue_button"}}</button>
            </form>

            <div class="setup-skip">
                <a href="?skip=true" class="text-comment">{{t .server.Lang "setup_security_skip_step"}}</a>
            </div>
        </div>

        {{ if .version }}
        <div class="login-footer">
            v{{ .version }}
        </div>
        {{ end }}
    </div>

    <script>
        document.getElementById('server-form').addEventListener('submit', function(e) {
            var btn = document.getElementById('submit-btn');
            btn.disabled = true;
            btn.textContent = '{{t .server.Lang "setup_security_saving_button"}}';
        });
    </script>
</body>
</html>
