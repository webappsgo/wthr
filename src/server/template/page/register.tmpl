<!DOCTYPE html>
<html lang="en" class="{{if .server.ThemeClass}}{{.server.ThemeClass}}{{else}}theme-dark{{end}}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ .title }}</title>
    <link rel="stylesheet" href="/static/css/common.css">
    <link rel="stylesheet" href="/static/css/components.css">
    <link rel="stylesheet" href="/static/css/public.css">
</head>
<body>
    <div class="register-container">
        <div class="register-header">
            <h1>🌤️ {{t .server.Lang "login_brand_heading"}}</h1>
            <p>{{t .server.Lang "register_create_account_subtitle"}}</p>
        </div>

        {{ if .error }}
        <div class="error-message" role="alert" aria-live="assertive">{{ .error }}</div>
        {{ end }}

        <form method="POST" action="/server/auth/register" id="registerForm" role="form" aria-label="{{t .server.Lang "register_form_aria"}}">
    <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
            <div class="form-group">
                <label for="username">{{t .server.Lang "register_username_label"}}</label>
                <input type="text"
                       id="username"
                       name="username"
                       required
                       autofocus
                       minlength="3"
                       maxlength="32"
                       pattern="[a-z][a-z0-9_-]{2,31}"
                       aria-label="{{t .server.Lang "register_username_label"}}"
                       aria-required="true"
                       aria-describedby="username-requirements"
                       title="{{t .server.Lang "register_username_title"}}">
                <small id="username-requirements">{{t .server.Lang "register_username_requirements"}}</small>
            </div>

            <div class="form-group">
                <label for="email">{{t .server.Lang "register_email_label"}}</label>
                <input type="email"
                       id="email"
                       name="email"
                       required
                       aria-label="{{t .server.Lang "register_email_aria"}}"
                       aria-required="true"
                       title="{{t .server.Lang "register_email_title"}}">
            </div>

            <div class="form-group">
                <label for="password">{{t .server.Lang "login_password_label"}}</label>
                <input type="password"
                       id="password"
                       name="password"
                       required
                       minlength="8"
                       aria-label="{{t .server.Lang "login_password_label"}}"
                       aria-required="true"
                       aria-describedby="password-requirements password-strength-indicator"
                       title="{{t .server.Lang "register_password_title"}}">
                <small id="password-requirements">{{t .server.Lang "register_password_requirements"}}</small>
                <div class="password-strength">
                    <div class="password-strength-bar"
                         id="strengthBar"
                         role="progressbar"
                         aria-label="{{t .server.Lang "register_password_strength_aria"}}"
                         aria-live="polite"
                         aria-valuemin="0"
                         aria-valuemax="4"
                         aria-valuenow="0"></div>
                </div>
                <span class="sr-only" id="password-strength-indicator" aria-live="polite"></span>
            </div>

            <div class="form-group">
                <label for="confirm_password">{{t .server.Lang "register_confirm_password_label"}}</label>
                <input type="password"
                       id="confirm_password"
                       name="confirm_password"
                       required
                       aria-label="{{t .server.Lang "register_confirm_password_label"}}"
                       aria-required="true"
                       aria-describedby="password-match-help"
                       title="{{t .server.Lang "register_confirm_password_title"}}">
                <small id="password-match-help" class="sr-only">{{t .server.Lang "register_password_match_help"}}</small>
            </div>

            <button type="submit"
                    class="btn-primary"
                    aria-label="{{t .server.Lang "register_submit_aria"}}"
                    title="{{t .server.Lang "register_submit_title"}}">
                {{t .server.Lang "register_submit_button"}}
            </button>
        </form>

        <div class="form-footer">
            <p>{{t .server.Lang "register_already_have_account"}} <a href="/server/auth/login">{{t .server.Lang "register_sign_in_link"}}</a></p>
        </div>

        <div class="back-link">
            <a href="/">← {{t .server.Lang "login_back_to_weather_link"}}</a>
        </div>
    </div>

    <script>
        const I18N = {
            passwordStrengthWeak: '{{t .server.Lang "register_js_strength_weak"}}',
            passwordStrengthMedium: '{{t .server.Lang "register_js_strength_medium"}}',
            passwordStrengthStrong: '{{t .server.Lang "register_js_strength_strong"}}',
            passwordTooShort: '{{t .server.Lang "register_js_password_too_short"}}',
            passwordsDoNotMatch: '{{t .server.Lang "register_js_passwords_no_match"}}'
        };

        const passwordInput = document.getElementById('password');
        const confirmInput = document.getElementById('confirm_password');
        const strengthBar = document.getElementById('strengthBar');
        const form = document.getElementById('registerForm');

        // Password strength checker
        passwordInput.addEventListener('input', function() {
            const password = this.value;
            let strength = 0;
            const strengthIndicator = document.getElementById('password-strength-indicator');

            if (password.length >= 8) strength++;
            if (password.match(/[a-z]/) && password.match(/[A-Z]/)) strength++;
            if (password.match(/[0-9]/)) strength++;
            if (password.match(/[^a-zA-Z0-9]/)) strength++;

            strengthBar.className = 'password-strength-bar';
            strengthBar.setAttribute('aria-valuenow', strength);

            if (strength <= 1) {
                strengthBar.classList.add('weak');
                strengthIndicator.textContent = I18N.passwordStrengthWeak;
            } else if (strength <= 3) {
                strengthBar.classList.add('medium');
                strengthIndicator.textContent = I18N.passwordStrengthMedium;
            } else {
                strengthBar.classList.add('strong');
                strengthIndicator.textContent = I18N.passwordStrengthStrong;
            }
        });

        // Form validation
        form.addEventListener('submit', function(e) {
            const password = passwordInput.value;
            const confirm = confirmInput.value;

            if (password.length < 8) {
                e.preventDefault();
                showAlert(I18N.passwordTooShort);
                return;
            }

            if (password !== confirm) {
                e.preventDefault();
                showAlert(I18N.passwordsDoNotMatch);
                return;
            }
        });

        // Match confirmation password visual feedback
        confirmInput.addEventListener('input', function() {
            if (this.value && this.value !== passwordInput.value) {
                this.classList.add('register-password-mismatch');
                this.classList.remove('register-password-match');
            } else {
                this.classList.remove('register-password-mismatch');
                this.classList.add('register-password-match');
            }
        });
    </script>
</body>
</html>
