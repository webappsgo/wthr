<!DOCTYPE html>
<html lang="en" class="{{if .server.ThemeClass}}{{.server.ThemeClass}}{{else}}theme-dark{{end}}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title>{{.Title}}</title>
    <link rel="stylesheet" href="/static/css/common.css">
    <link rel="stylesheet" href="/static/css/components.css">
    <link rel="stylesheet" href="/static/css/public.css">
</head>
<body>
    <div class="login-container">
        <div class="login-card setup-card">
            <div class="login-header">
                <h1 class="login-title">{{t .server.Lang "setup_security_title"}}</h1>
                <p class="login-subtitle">{{t .server.Lang "setup_security_step_subtitle"}}</p>
            </div>

            <div class="setup-progress">
                <div class="progress-bar">
                    <div class="progress-fill" style="width: 66.67%"></div>
                </div>
                <div class="progress-steps">
                    <span class="step completed">{{t .server.Lang "setup_step_admin"}}</span>
                    <span class="step completed">{{t .server.Lang "setup_step_api_token"}}</span>
                    <span class="step completed">{{t .server.Lang "setup_step_server"}}</span>
                    <span class="step active">{{t .server.Lang "setup_step_security"}}</span>
                    <span class="step">{{t .server.Lang "setup_step_services"}}</span>
                    <span class="step">{{t .server.Lang "setup_step_complete"}}</span>
                </div>
            </div>

            <div class="login-info">
                <p>{{t .server.Lang "setup_security_intro"}}</p>
            </div>

            {{ if .error }}
            <div class="error-message" role="alert">{{ .error }}</div>
            {{ end }}

            <form method="POST" action="" id="security-form" autocomplete="off">
                <input type="hidden" name="csrf_token" value="{{.csrf_token}}">

                <div class="form-group">
                    <label class="form-label" for="backup_password">{{t .server.Lang "setup_security_backup_password_label"}}</label>
                    <input type="password"
                           id="backup_password"
                           name="backup_password"
                           class="form-input"
                           placeholder="{{t .server.Lang "setup_security_backup_password_placeholder"}}">
                    <small class="form-hint">{{t .server.Lang "setup_security_backup_password_hint"}}</small>
                </div>

                <div class="form-group">
                    <label class="form-label" for="backup_password_confirm">{{t .server.Lang "setup_security_confirm_backup_password_label"}}</label>
                    <input type="password"
                           id="backup_password_confirm"
                           name="backup_password_confirm"
                           class="form-input"
                           placeholder="{{t .server.Lang "reset_password_confirm_password_placeholder"}}">
                </div>

                <div class="form-group">
                    <label class="checkbox-label">
                        <input type="checkbox"
                               id="enable_2fa"
                               name="enable_2fa"
                               value="true">
                        <span>{{t .server.Lang "setup_security_enable_2fa_label"}}</span>
                    </label>
                    <small class="form-hint">{{t .server.Lang "setup_security_enable_2fa_hint"}}</small>
                </div>

                <div id="totp-setup" class="hidden">
                    {{ if .TOTPSecret }}
                    <div class="totp-qr">
                        <p>{{t .server.Lang "setup_security_scan_qr_instruction"}}</p>
                        <img src="{{ .TOTPQRCode }}" alt="{{t .server.Lang "setup_security_totp_qr_alt"}}" class="qr-code">
                        <p>{{t .server.Lang "setup_security_manual_secret_instruction"}}</p>
                        <code class="long-string">{{ .TOTPSecret }}</code>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="totp_code">{{t .server.Lang "setup_security_verify_totp_label"}}</label>
                        <input type="text"
                               id="totp_code"
                               name="totp_code"
                               class="form-input"
                               placeholder="000000"
                               pattern="[0-9]{6}"
                               maxlength="6">
                        <small class="form-hint">{{t .server.Lang "setup_security_totp_code_hint"}}</small>
                    </div>
                    {{ end }}
                </div>

                <button type="submit" id="submit-btn" class="btn-login">{{t .server.Lang "setup_security_continue_button"}}</button>
            </form>

            <div class="setup-skip">
                <a href="?skip=true" class="text-comment">{{t .server.Lang "setup_security_skip_step"}}</a>
            </div>
        </div>

        {{ if .version }}
        <div class="login-footer">
            v{{ .version }}
        </div>
        {{ end }}
    </div>

    <script>
        document.getElementById('enable_2fa').addEventListener('change', function() {
            var totpSetup = document.getElementById('totp-setup');
            if (this.checked) {
                totpSetup.classList.remove('hidden');
            } else {
                totpSetup.classList.add('hidden');
            }
        });

        document.getElementById('security-form').addEventListener('submit', function(e) {
            var backupPwd = document.getElementById('backup_password').value;
            var backupConfirm = document.getElementById('backup_password_confirm').value;
            if (backupPwd && backupPwd !== backupConfirm) {
                e.preventDefault();
                alert('{{t .server.Lang "setup_security_password_mismatch_alert"}}');
                return false;
            }
            var btn = document.getElementById('submit-btn');
            btn.disabled = true;
            btn.textContent = '{{t .server.Lang "setup_security_saving_button"}}';
        });
    </script>
</body>
</html>
