<!DOCTYPE html>
<html lang="en" class="{{if .server.ThemeClass}}{{.server.ThemeClass}}{{else}}theme-dark{{end}}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ .title }}</title>
    <link rel="stylesheet" href="/static/css/common.css">
    <link rel="stylesheet" href="/static/css/components.css">
    <link rel="stylesheet" href="/static/css/public.css">
</head>
<body>
    <div class="login-container">
        <div class="login-header">
            <h1>🌤️ {{t .server.Lang "login_brand_heading"}}</h1>
            <p>{{t .server.Lang "login_sign_in_subtitle"}}</p>
        </div>

        {{ if .error }}
        <div class="error-message" role="alert" aria-live="assertive">{{ .error }}</div>
        {{ end }}

        {{ if .verified }}
        <div class="success-message" role="status" aria-live="polite">✅ {{t .server.Lang "login_email_verified_message"}}</div>
        {{ end }}

        <form method="POST" action="/server/auth/login" role="form" aria-label="{{t .server.Lang "login_form_aria"}}">
    <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
            <div class="form-group">
                <label for="identifier">{{t .server.Lang "login_identifier_label"}}</label>
                <input type="text"
                       id="identifier"
                       name="identifier"
                       {{if .identifier}}value="{{.identifier}}" readonly{{end}}
                       required
                       {{if not .require_2fa}}autofocus{{end}}
                       aria-label="{{t .server.Lang "login_identifier_aria"}}"
                       aria-required="true"
                       title="{{t .server.Lang "login_identifier_title"}}">
            </div>

            <div class="form-group">
                <label for="password">{{t .server.Lang "login_password_label"}}</label>
                <input type="password"
                       id="password"
                       name="password"
                       {{if .require_2fa}}readonly{{end}}
                       required
                       aria-label="{{t .server.Lang "login_password_aria"}}"
                       aria-required="true"
                       title="{{t .server.Lang "login_password_title"}}">
            </div>

            {{if .require_2fa}}
            <div class="form-group" id="twoFactorGroup">
                <label for="two_factor_code" id="twoFactorLabel">{{t .server.Lang "login_2fa_code_label"}}</label>
                <input type="text"
                       id="two_factor_code"
                       name="two_factor_code"
                       required
                       autofocus
                       maxlength="19"
                       placeholder="{{t .server.Lang "login_2fa_code_placeholder"}}"
                       aria-label="{{t .server.Lang "login_2fa_code_aria"}}"
                       aria-required="true"
                       title="{{t .server.Lang "login_2fa_code_title"}}">
                <input type="hidden" id="use_recovery_key" name="use_recovery_key" value="false">
                <div class="form-footer mt-1">
                    <a href="#" id="toggleRecoveryKey" class="fs-sm">{{t .server.Lang "login_use_recovery_key_link"}}</a>
                </div>
            </div>
            {{end}}

            <button type="submit"
                    class="btn-primary"
                    aria-label="{{t .server.Lang "login_submit_aria"}}"
                    title="{{t .server.Lang "login_submit_title"}}">{{t .server.Lang "login_submit_button"}}</button>
        </form>

        {{ if .registrationPublic }}
        <div class="form-footer">
            <p>{{t .server.Lang "login_no_account_text"}} <a href="/server/auth/register">{{t .server.Lang "login_register_link"}}</a></p>
        </div>
        {{ end }}

        {{ if .pendingVerification }}
        <div class="success-message" role="status" aria-live="polite">✅ {{t .server.Lang "login_registration_success_message"}}</div>
        {{ end }}

        <div class="back-link">
            <a href="/">← {{t .server.Lang "login_back_to_weather_link"}}</a>
        </div>
    </div>

    <script>
        const I18N = {
            twoFactorCodeLabel: '{{t .server.Lang "login_2fa_code_label"}}',
            recoveryKeyLabel: '{{t .server.Lang "login_recovery_key_label"}}',
            twoFactorCodePlaceholder: '{{t .server.Lang "login_2fa_code_placeholder_short"}}',
            recoveryKeyPlaceholder: '{{t .server.Lang "login_recovery_key_placeholder"}}',
            useRecoveryKeyLink: '{{t .server.Lang "login_use_recovery_key_link"}}',
            useAuthenticatorCodeLink: '{{t .server.Lang "login_use_authenticator_code_link"}}'
        };

        // Auto-focus appropriate field
        {{if .require_2fa}}
        document.getElementById('two_factor_code').focus();
        {{else}}
        document.getElementById('identifier').focus();
        {{end}}

        {{if .require_2fa}}
        // Toggle between TOTP code and recovery key
        const toggleLink = document.getElementById('toggleRecoveryKey');
        const twoFactorInput = document.getElementById('two_factor_code');
        const twoFactorLabel = document.getElementById('twoFactorLabel');
        const useRecoveryKeyInput = document.getElementById('use_recovery_key');
        let usingRecoveryKey = false;

        toggleLink.addEventListener('click', function(e) {
            e.preventDefault();
            usingRecoveryKey = !usingRecoveryKey;

            if (usingRecoveryKey) {
                twoFactorLabel.textContent = I18N.recoveryKeyLabel;
                twoFactorInput.placeholder = I18N.recoveryKeyPlaceholder;
                twoFactorInput.maxLength = 19;
                toggleLink.textContent = I18N.useAuthenticatorCodeLink;
                useRecoveryKeyInput.value = 'true';
            } else {
                twoFactorLabel.textContent = I18N.twoFactorCodeLabel;
                twoFactorInput.placeholder = I18N.twoFactorCodePlaceholder;
                twoFactorInput.maxLength = 6;
                toggleLink.textContent = I18N.useRecoveryKeyLink;
                useRecoveryKeyInput.value = 'false';
            }

            twoFactorInput.value = '';
            twoFactorInput.focus();
        });
        {{end}}

        // HTML5 form validation handles empty fields automatically via 'required' attribute
        // No JavaScript validation needed - compliant with TEMPLATE.md lines 770, 1009-1018
    </script>
</body>
</html>
