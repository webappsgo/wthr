{{template "head" .}}

{{template "navbar" .}}

<div class="weather-container">
  <h1 class="text-purple">{{t .lang "preferences.heading"}}</h1>
  <p>{{t .lang "preferences.description"}}</p>

  <div class="card margin-y-lg">
    <h2 class="text-cyan">{{t .lang "preferences.theme_heading"}}</h2>
    <p class="preferences-current">{{t .lang "preferences.current_theme"}} <strong>{{t .lang (printf "theme.%s" .theme)}}</strong></p>

    <form action="/server/preferences" method="post" class="preferences-form">
      <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
      <fieldset class="preferences-fieldset">
        <legend class="sr-only">{{t .lang "preferences.theme_heading"}}</legend>

        <label class="preferences-option" for="theme-dark">
          <input type="radio" id="theme-dark" name="theme" value="dark" {{if eq .theme "dark"}}checked{{end}}>
          <span class="preferences-option-icon" aria-hidden="true">🌙</span>
          <span class="preferences-option-text">
            <span class="preferences-option-title">{{t .lang "theme.dark"}}</span>
            <span class="preferences-option-hint">{{t .lang "preferences.theme_dark_hint"}}</span>
          </span>
        </label>

        <label class="preferences-option" for="theme-light">
          <input type="radio" id="theme-light" name="theme" value="light" {{if eq .theme "light"}}checked{{end}}>
          <span class="preferences-option-icon" aria-hidden="true">☀️</span>
          <span class="preferences-option-text">
            <span class="preferences-option-title">{{t .lang "theme.light"}}</span>
            <span class="preferences-option-hint">{{t .lang "preferences.theme_light_hint"}}</span>
          </span>
        </label>

        <label class="preferences-option" for="theme-auto">
          <input type="radio" id="theme-auto" name="theme" value="auto" {{if eq .theme "auto"}}checked{{end}}>
          <span class="preferences-option-icon" aria-hidden="true">🔄</span>
          <span class="preferences-option-text">
            <span class="preferences-option-title">{{t .lang "theme.auto"}}</span>
            <span class="preferences-option-hint">{{t .lang "preferences.theme_auto_hint"}}</span>
          </span>
        </label>
      </fieldset>

      <button type="submit" class="btn btn-primary preferences-save">{{t .lang "preferences.save"}}</button>
    </form>
  </div>

  <div class="card margin-y-lg">
    <h2 class="text-cyan">{{t .lang "preferences.language_heading"}}</h2>
    <form action="/server/preferences" method="get" class="preferences-form">
      <label class="preferences-label" for="preferences-lang">{{t .lang "common.select_language"}}</label>
      <select id="preferences-lang" name="lang" class="lang-select">
        {{range .available_languages}}
        <option value="{{.Code}}" {{if eq .Code $.lang}}selected{{end}}>{{.NativeName}}</option>
        {{end}}
      </select>
      <button type="submit" class="btn btn-primary preferences-save">{{t .lang "preferences.save"}}</button>
    </form>
  </div>
</div>

{{template "footer" .}}
