{{template "head" .}}

{{template "navbar" .}}

    <div class="container">
        <div class="add-location-header">
            <h1 class="text-purple">{{t .server.Lang "add_location_heading"}}</h1>
            <a href="/users/dashboard" class="add-location-back-link">← {{t .server.Lang "add_location_back_to_dashboard"}}</a>
        </div>

        <div class="card">
            <div class="card-body">
                <div id="message"></div>

                <!-- GPS Button -->
                <button class="btn btn-secondary gps-button"
                        data-action="add-location-use-current"
                        aria-label="{{t .server.Lang "add_location_use_current_aria"}}"
                        title="{{t .server.Lang "add_location_use_current_title"}}">
                    📍 {{t .server.Lang "add_location_use_current_label"}}
                </button>

                <!-- Tabs -->
                <div class="tabs" id="add-location-tabs" role="tablist" aria-label="{{t .server.Lang "add_location_tabs_aria"}}">
                    <button class="tab active"
                            data-action="add-location-switch-tab"
                            data-tab="search"
                            role="tab"
                            aria-label="{{t .server.Lang "add_location_tab_search_aria"}}"
                            aria-selected="true"
                            title="{{t .server.Lang "add_location_tab_search_title"}}">🔍 {{t .server.Lang "btn_search"}}</button>
                    <button class="tab"
                            data-action="add-location-switch-tab"
                            data-tab="zip"
                            role="tab"
                            aria-label="{{t .server.Lang "add_location_tab_zip_aria"}}"
                            aria-selected="false"
                            title="{{t .server.Lang "add_location_tab_zip_title"}}">📮 {{t .server.Lang "add_location_tab_zip_label"}}</button>
                    <button class="tab"
                            data-action="add-location-switch-tab"
                            data-tab="coords"
                            role="tab"
                            aria-label="{{t .server.Lang "add_location_tab_coords_aria"}}"
                            aria-selected="false"
                            title="{{t .server.Lang "add_location_tab_coords_title"}}">🗺️ {{t .server.Lang "add_location_tab_coords_label"}}</button>
                </div>

                <!-- Search Tab -->
                <div id="search-tab" class="tab-content active" role="tabpanel" aria-labelledby="search-tab-button">
                    <div class="form-group">
                        <label class="form-label" for="citySearch">{{t .server.Lang "add_location_search_city_label"}}</label>
                        <input type="text"
                               id="citySearch"
                               class="form-input"
                               placeholder="{{t .server.Lang "add_location_search_city_placeholder"}}"
                               aria-label="{{t .server.Lang "add_location_search_city_aria"}}"
                               aria-describedby="citySearch-help"
                               aria-autocomplete="list"
                               aria-controls="searchResults"
                               title="{{t .server.Lang "add_location_search_city_title"}}">
                        <p class="form-help" id="citySearch-help">{{t .server.Lang "add_location_search_city_help"}}</p>
                    </div>

                    <div class="search-results">
                        <div id="searchResults" class="results-dropdown" role="listbox" aria-label="{{t .server.Lang "add_location_search_results_aria"}}"></div>
                    </div>
                </div>

                <!-- ZIP Code Tab -->
                <div id="zip-tab" class="tab-content" role="tabpanel" aria-labelledby="zip-tab-button">
                    <div class="form-group">
                        <label class="form-label" for="zipCode">{{t .server.Lang "add_location_zip_label"}}</label>
                        <input type="text"
                               id="zipCode"
                               class="form-input"
                               placeholder="{{t .server.Lang "add_location_zip_placeholder"}}"
                               aria-label="{{t .server.Lang "add_location_zip_aria"}}"
                               aria-describedby="zipCode-help"
                               title="{{t .server.Lang "add_location_zip_title"}}">
                        <p class="form-help" id="zipCode-help">{{t .server.Lang "add_location_zip_help"}}</p>
                    </div>
                    <button class="btn btn-primary"
                            data-action="add-location-lookup-zip"
                            aria-label="{{t .server.Lang "add_location_lookup_zip_aria"}}"
                            title="{{t .server.Lang "add_location_lookup_zip_title"}}">{{t .server.Lang "add_location_look_up"}}</button>
                </div>

                <!-- Coordinates Tab -->
                <div id="coords-tab" class="tab-content" role="tabpanel" aria-labelledby="coords-tab-button">
                    <div class="form-group">
                        <label class="form-label" for="manualLat">{{t .server.Lang "add_location_latitude_label"}}</label>
                        <input type="number"
                               id="manualLat"
                               class="form-input"
                               step="0.000001"
                               min="-90"
                               max="90"
                               placeholder="40.7128"
                               aria-label="{{t .server.Lang "add_location_latitude_aria"}}"
                               aria-describedby="manualLat-help"
                               title="{{t .server.Lang "add_location_latitude_title"}}">
                        <p class="form-help" id="manualLat-help">{{t .server.Lang "add_location_latitude_help"}}</p>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="manualLon">{{t .server.Lang "add_location_longitude_label"}}</label>
                        <input type="number"
                               id="manualLon"
                               class="form-input"
                               step="0.000001"
                               min="-180"
                               max="180"
                               placeholder="-74.0060"
                               aria-label="{{t .server.Lang "add_location_longitude_aria"}}"
                               aria-describedby="manualLon-help"
                               title="{{t .server.Lang "add_location_longitude_title"}}">
                        <p class="form-help" id="manualLon-help">{{t .server.Lang "add_location_longitude_help"}}</p>
                    </div>
                    <button class="btn btn-primary"
                            data-action="add-location-lookup-coords"
                            aria-label="{{t .server.Lang "add_location_lookup_coords_aria"}}"
                            title="{{t .server.Lang "add_location_lookup_coords_title"}}">{{t .server.Lang "add_location_look_up"}}</button>
                </div>

                <!-- Location Form (shown after selection) -->
                <form id="locationForm" class="add-location-form-hidden" role="form" aria-label="{{t .server.Lang "add_location_confirm_form_aria"}}">
    <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
                    <h3 class="text-cyan add-location-form-title">{{t .server.Lang "add_location_confirm_heading"}}</h3>

                    <div class="form-group">
                        <label class="form-label" for="name">{{t .server.Lang "add_location_name_label"}}</label>
                        <input type="text"
                               id="name"
                               class="form-input"
                               required
                               placeholder="{{t .server.Lang "add_location_name_placeholder"}}"
                               aria-label="{{t .server.Lang "add_location_name_aria"}}"
                               aria-required="true"
                               aria-describedby="name-help"
                               title="{{t .server.Lang "add_location_name_title"}}">
                        <p class="form-help" id="name-help">{{t .server.Lang "add_location_name_help"}}</p>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="displayCity">{{t .server.Lang "add_location_city_label"}}</label>
                        <input type="text"
                               id="displayCity"
                               class="form-input"
                               readonly
                               aria-label="{{t .server.Lang "add_location_city_aria"}}"
                               aria-readonly="true"
                               title="{{t .server.Lang "add_location_city_title"}}">
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="displayCoords">{{t .server.Lang "add_location_coordinates_label"}}</label>
                        <input type="text"
                               id="displayCoords"
                               class="form-input"
                               readonly
                               aria-label="{{t .server.Lang "add_location_coordinates_aria"}}"
                               aria-readonly="true"
                               title="{{t .server.Lang "add_location_coordinates_title"}}">
                    </div>

                    <input type="hidden" id="latitude" name="latitude" aria-hidden="true">
                    <input type="hidden" id="longitude" name="longitude" aria-hidden="true">
                    <input type="hidden" id="timezone" name="timezone" aria-hidden="true">

                    <div class="flex gap-md add-location-form-actions">
                        <button type="submit"
                                class="btn btn-primary"
                                aria-label="{{t .server.Lang "add_location_save_aria"}}"
                                title="{{t .server.Lang "add_location_save_title"}}">💾 {{t .server.Lang "add_location_save_label"}}</button>
                        <button type="button"
                                class="btn btn-secondary"
                                data-action="add-location-reset"
                                aria-label="{{t .server.Lang "add_location_start_over_aria"}}"
                                title="{{t .server.Lang "add_location_start_over_title"}}">🔄 {{t .server.Lang "add_location_start_over_label"}}</button>
                        <button type="button"
                                class="btn btn-ghost"
                                data-action="navigate"
                                data-href="/users/dashboard"
                                aria-label="{{t .server.Lang "action.cancel"}}"
                                title="{{t .server.Lang "add_location_cancel_title"}}">{{t .server.Lang "action.cancel"}}</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script type="application/json" id="add-location-data">
    {"apiPath": "{{.api_path}}"}
    </script>

{{template "footer" .}}
