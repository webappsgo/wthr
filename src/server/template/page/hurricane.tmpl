<!DOCTYPE html>
<html lang="en" class="{{if .server.ThemeClass}}{{.server.ThemeClass}}{{else}}theme-dark{{end}}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{.Title}} - {{t .server.Lang "hurricane_page_title_suffix"}}</title>
    <link rel="stylesheet" href="/static/css/common.css">
    <link rel="stylesheet" href="/static/css/components.css">
    <link rel="stylesheet" href="/static/css/public.css">
    <script src="/static/js/app.js" defer></script>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🌀</text></svg>">
</head>
<body>
    {{template "navbar" .}}

    <div class="weather-container">

        <div class="hurricane-header">
            <h1>🌀 {{t .server.Lang "hurricane_page_heading"}}</h1>
            <p class="storm-count">
                {{ if eq .Count 0 }}
                    {{t .server.Lang "hurricane_no_active_storms"}}
                {{ else if eq .Count 1 }}
                    {{t .server.Lang "hurricane_one_active_storm"}}
                {{ else }}
                    {{.Count}} {{t .server.Lang "hurricane_active_storms_count"}}
                {{ end }}
            </p>
        </div>

        {{ if eq .Count 0 }}
        <div class="no-storms">
            <div class="no-storms-icon">🌊</div>
            <h3>{{t .server.Lang "hurricane_all_clear_heading"}}</h3>
            <p>{{t .server.Lang "hurricane_all_clear_message"}}</p>
            <p class="text-sm margin-y-md">{{t .server.Lang "hurricane_data_source_noaa"}}</p>
        </div>
        {{ else }}
        <div class="storms-grid">
            {{ range .Storms }}
            {{ $category := "tropical-storm" }}
            {{ if ge .WindSpeed 157 }}
                {{ $category = "category-5" }}
            {{ else if ge .WindSpeed 130 }}
                {{ $category = "category-4" }}
            {{ else if ge .WindSpeed 111 }}
                {{ $category = "category-3" }}
            {{ else if ge .WindSpeed 96 }}
                {{ $category = "category-2" }}
            {{ else if ge .WindSpeed 74 }}
                {{ $category = "category-1" }}
            {{ end }}
            <div class="storm-card {{$category}}">
                <div class="storm-name">
                    {{ if ge .WindSpeed 74 }}🌀{{ else if ge .WindSpeed 39 }}🌊{{ else }}🌧️{{ end }}
                    {{.Name}}
                </div>
                <div class="storm-classification">{{.Intensity}}</div>

                <div class="storm-details">
                    <div class="detail-item">
                        <span class="detail-label">{{t $.server.Lang "hurricane_wind_speed_label"}}</span>
                        <span class="detail-value">{{.WindSpeed}} mph</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">{{t $.server.Lang "hurricane_pressure_label"}}</span>
                        <span class="detail-value">{{.Pressure}} mb</span>
                    </div>
                    {{ if gt .MovementSpeed 0 }}
                    <div class="detail-item">
                        <span class="detail-label">{{t $.server.Lang "hurricane_movement_label"}}</span>
                        <span class="detail-value">{{.MovementDir}} {{.MovementSpeed}} mph</span>
                    </div>
                    {{ end }}
                    <div class="detail-item">
                        <span class="detail-label">{{t $.server.Lang "hurricane_basin_label"}}</span>
                        <span class="detail-value">{{.Basin}}</span>
                    </div>
                </div>

                <div class="storm-location">
                    <strong>{{t $.server.Lang "index_location_label"}}:</strong> {{.Latitude}}, {{.Longitude}}
                </div>

                <div class="storm-update">
                    {{t $.server.Lang "hurricane_last_update_label"}}: {{.LastUpdate}}
                </div>

                {{ if or .PublicAdvisory .ForecastAdvisory .DiscussionLink }}
                <div class="advisory-links">
                    {{ if .PublicAdvisory }}
                    <a href="{{.PublicAdvisory}}" target="_blank" class="advisory-link">📄 {{t $.server.Lang "hurricane_public_advisory_link"}}</a>
                    {{ end }}
                    {{ if .ForecastAdvisory }}
                    <a href="{{.ForecastAdvisory}}" target="_blank" class="advisory-link">📊 {{t $.server.Lang "hurricane_forecast_link"}}</a>
                    {{ end }}
                    {{ if .DiscussionLink }}
                    <a href="{{.DiscussionLink}}" target="_blank" class="advisory-link">💬 {{t $.server.Lang "hurricane_discussion_link"}}</a>
                    {{ end }}
                </div>
                {{ end }}
            </div>
            {{ end }}
        </div>
        {{ end }}

        <div class="data-footer">
            <p class="data-footer__text">
                {{t .server.Lang "hurricane_data_provided_by"}} <a href="https://www.nhc.noaa.gov" target="_blank" class="data-footer__link">{{t .server.Lang "hurricane_noaa_nhc_name"}}</a>
                <br>
                {{t .server.Lang "hurricane_updates_frequency"}}
            </p>
        </div>
    </div>

    <script>
        // Auto-refresh every 5 minutes
        setTimeout(() => {
            window.location.reload();
        }, 5 * 60 * 1000);

        // Initialize notification polling
        if (typeof Notifications !== 'undefined') {
            Notifications.startPolling(30000);
        }
    </script>

{{template "footer" .}}
