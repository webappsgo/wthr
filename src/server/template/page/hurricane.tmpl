<!DOCTYPE html>
<html lang="en" class="{{if .server.ThemeClass}}{{.server.ThemeClass}}{{else}}theme-dark{{end}}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{.Title}} - Weather</title>
    <link rel="stylesheet" href="/static/css/common.css">
    <link rel="stylesheet" href="/static/css/components.css">
    <link rel="stylesheet" href="/static/css/public.css">
    <script src="/static/js/app.js" defer></script>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🌀</text></svg>">
</head>
<body>
    {{template "navbar" .}}

    <div class="weather-container">

        <div class="hurricane-header">
            <h1>🌀 Active Hurricanes & Tropical Storms</h1>
            <p class="storm-count">
                {{ if eq .Count 0 }}
                    No active storms
                {{ else if eq .Count 1 }}
                    1 active storm
                {{ else }}
                    {{.Count}} active storms
                {{ end }}
            </p>
        </div>

        {{ if eq .Count 0 }}
        <div class="no-storms">
            <div class="no-storms-icon">🌊</div>
            <h3>All Clear!</h3>
            <p>No active tropical storms or hurricanes at this time.</p>
            <p class="text-sm margin-y-md">Data from NOAA National Hurricane Center</p>
        </div>
        {{ else }}
        <div class="storms-grid">
            {{ range .Storms }}
            {{ $category := "tropical-storm" }}
            {{ if ge .WindSpeed 157 }}
                {{ $category = "category-5" }}
            {{ else if ge .WindSpeed 130 }}
                {{ $category = "category-4" }}
            {{ else if ge .WindSpeed 111 }}
                {{ $category = "category-3" }}
            {{ else if ge .WindSpeed 96 }}
                {{ $category = "category-2" }}
            {{ else if ge .WindSpeed 74 }}
                {{ $category = "category-1" }}
            {{ end }}
            <div class="storm-card {{$category}}">
                <div class="storm-name">
                    {{ if ge .WindSpeed 74 }}🌀{{ else if ge .WindSpeed 39 }}🌊{{ else }}🌧️{{ end }}
                    {{.Name}}
                </div>
                <div class="storm-classification">{{.Intensity}}</div>

                <div class="storm-details">
                    <div class="detail-item">
                        <span class="detail-label">Wind Speed</span>
                        <span class="detail-value">{{.WindSpeed}} mph</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Pressure</span>
                        <span class="detail-value">{{.Pressure}} mb</span>
                    </div>
                    {{ if gt .MovementSpeed 0 }}
                    <div class="detail-item">
                        <span class="detail-label">Movement</span>
                        <span class="detail-value">{{.MovementDir}} {{.MovementSpeed}} mph</span>
                    </div>
                    {{ end }}
                    <div class="detail-item">
                        <span class="detail-label">Basin</span>
                        <span class="detail-value">{{.Basin}}</span>
                    </div>
                </div>

                <div class="storm-location">
                    <strong>Location:</strong> {{.Latitude}}, {{.Longitude}}
                </div>

                <div class="storm-update">
                    Last Update: {{.LastUpdate}}
                </div>

                {{ if or .PublicAdvisory .ForecastAdvisory .DiscussionLink }}
                <div class="advisory-links">
                    {{ if .PublicAdvisory }}
                    <a href="{{.PublicAdvisory}}" target="_blank" class="advisory-link">📄 Public Advisory</a>
                    {{ end }}
                    {{ if .ForecastAdvisory }}
                    <a href="{{.ForecastAdvisory}}" target="_blank" class="advisory-link">📊 Forecast</a>
                    {{ end }}
                    {{ if .DiscussionLink }}
                    <a href="{{.DiscussionLink}}" target="_blank" class="advisory-link">💬 Discussion</a>
                    {{ end }}
                </div>
                {{ end }}
            </div>
            {{ end }}
        </div>
        {{ end }}

        <div class="data-footer">
            <p class="data-footer__text">
                Data provided by <a href="https://www.nhc.noaa.gov" target="_blank" class="data-footer__link">NOAA National Hurricane Center</a>
                <br>
                Updates every 10 minutes
            </p>
        </div>
    </div>

    <script>
        // Auto-refresh every 5 minutes
        setTimeout(() => {
            window.location.reload();
        }, 5 * 60 * 1000);

        // Initialize notification polling
        if (typeof Notifications !== 'undefined') {
            Notifications.startPolling(30000);
        }
    </script>

{{template "footer" .}}
