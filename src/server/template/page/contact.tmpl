{{template "head" .}}

{{template "navbar" .}}

<div class="weather-container">
    <h1 class="text-purple">{{t .server.Lang "contact.heading"}}</h1>

    <div class="card margin-y-lg">
        {{template "flash" .}}
        <div id="contact-message" role="alert" aria-live="polite"></div>

        <form id="contact-form" method="post" action="{{path "/server/contact"}}" aria-label="{{t .server.Lang "contact.form_aria"}}">
    <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
            <div class="form-group">
                <label for="contact-name" class="form-label">{{t .server.Lang "contact.name_label"}}</label>
                <input type="text"
                       id="contact-name"
                       name="name"
                       class="form-input"
                       required
                       aria-label="{{t .server.Lang "contact.name_aria"}}"
                       aria-required="true"
                       aria-describedby="contact-name-help"
                       title="{{t .server.Lang "contact.name_title"}}"
                       placeholder="John Doe">
                <small id="contact-name-help" class="form-help">{{t .server.Lang "contact.name_help"}}</small>
            </div>

            <div class="form-group">
                <label for="contact-email" class="form-label">{{t .server.Lang "contact.email_label"}}</label>
                <input type="email"
                       id="contact-email"
                       name="email"
                       class="form-input"
                       required
                       aria-label="{{t .server.Lang "contact.email_aria"}}"
                       aria-required="true"
                       aria-describedby="contact-email-help"
                       title="{{t .server.Lang "contact.email_title"}}"
                       placeholder="john@example.com">
                <small id="contact-email-help" class="form-help">{{t .server.Lang "contact.email_help"}}</small>
            </div>

            <div class="form-group">
                <label for="contact-subject" class="form-label">{{t .server.Lang "contact.subject_label"}}</label>
                <select id="contact-subject"
                        name="subject"
                        class="form-input"
                        required
                        aria-label="{{t .server.Lang "contact.subject_aria"}}"
                        aria-required="true"
                        aria-describedby="contact-subject-help"
                        title="{{t .server.Lang "contact.subject_title"}}">
                    <option value="">{{t .server.Lang "contact.subject_select"}}</option>
                    <option value="general">{{t .server.Lang "contact.subject_general"}}</option>
                    <option value="support">{{t .server.Lang "contact.subject_support"}}</option>
                    <option value="bug">{{t .server.Lang "contact.subject_bug"}}</option>
                    <option value="feature">{{t .server.Lang "contact.subject_feature"}}</option>
                    <option value="privacy">{{t .server.Lang "contact.subject_privacy"}}</option>
                    <option value="account">{{t .server.Lang "contact.subject_account"}}</option>
                    <option value="other">{{t .server.Lang "contact.subject_other"}}</option>
                </select>
                <small id="contact-subject-help" class="form-help">{{t .server.Lang "contact.subject_help"}}</small>
            </div>

            <div class="form-group">
                <label for="contact-message-text" class="form-label">{{t .server.Lang "contact.message_label"}}</label>
                <textarea id="contact-message-text"
                          name="message"
                          class="form-input"
                          rows="8"
                          required
                          aria-label="{{t .server.Lang "contact.message_aria"}}"
                          aria-required="true"
                          aria-describedby="contact-message-help"
                          title="{{t .server.Lang "contact.message_title"}}"
                          placeholder="{{t .server.Lang "contact.message_placeholder"}}"></textarea>
                <small id="contact-message-help" class="form-help">{{t .server.Lang "contact.message_help"}}</small>
            </div>

            {{if eq .Captcha.Provider "simple"}}
            <div class="form-group">
                <label for="contact-captcha" class="form-label">{{tf .server.Lang "contact.captcha.question" "a" (printf "%d" .Captcha.A) "b" (printf "%d" .Captcha.B)}}</label>
                <input type="hidden" name="captcha_id" value="{{.Captcha.ID}}">
                <input type="text" id="contact-captcha" name="captcha_answer" class="form-input" required inputmode="numeric" autocomplete="off" aria-describedby="contact-captcha-help">
                <small id="contact-captcha-help" class="form-help">{{t .server.Lang "contact.captcha.help"}}</small>
            </div>
            {{else if eq .Captcha.Provider "recaptcha"}}
            <div class="g-recaptcha" data-sitekey="{{.Captcha.SiteKey}}"></div>
            <script src="https://www.google.com/recaptcha/api.js" async defer></script>
            {{else if eq .Captcha.Provider "hcaptcha"}}
            <div class="h-captcha" data-sitekey="{{.Captcha.SiteKey}}"></div>
            <script src="https://js.hcaptcha.com/1/api.js" async defer></script>
            {{end}}

            <div class="form-actions">
                <button type="submit"
                        class="btn btn-primary"
                        id="contact-submit"
                        aria-label="{{t .server.Lang "contact.send_aria"}}"
                        title="{{t .server.Lang "contact.send_title"}}">
                    📧 {{t .server.Lang "contact.send_label"}}
                </button>
                <button type="reset"
                        class="btn btn-secondary"
                        aria-label="{{t .server.Lang "contact.clear_aria"}}"
                        title="{{t .server.Lang "contact.clear_title"}}">
                    🔄 {{t .server.Lang "contact.clear_label"}}
                </button>
            </div>
        </form>
    </div>

    <div class="card margin-y-lg">
        <h2 class="text-cyan">{{t .server.Lang "contact.alternative_heading"}}</h2>
        <div class="margin-y-md">
            <p><strong>{{t .server.Lang "contact.github_issues_label"}}</strong> <a href="https://github.com/{{.server.GitOrg}}/{{.server.GitRepo}}/issues" target="_blank" class="text-cyan">{{t .server.Lang "contact.github_issues_link"}}</a></p>
            <p><strong>{{t .server.Lang "contact.documentation_label"}}</strong> <a href="/docs" class="text-cyan">{{t .server.Lang "contact.documentation_link"}}</a></p>
            <p><strong>{{t .server.Lang "contact.help_label"}}</strong> <a href="/server/help" class="text-cyan">{{t .server.Lang "contact.help_link"}}</a></p>
        </div>
    </div>
</div>



{{template "footer" .}}
