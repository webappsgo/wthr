<!DOCTYPE html>
<html lang="{{if .server.Lang}}{{.server.Lang}}{{else}}en{{end}}" dir="{{if eq (printf "%v" .server.Lang) "ar"}}rtl{{else}}ltr{{end}}" class="{{if .server.ThemeClass}}{{.server.ThemeClass}}{{else}}theme-dark{{end}}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{.Title}}</title>
    <link rel="stylesheet" href="/static/css/common.css">
    <link rel="stylesheet" href="/static/css/components.css">
    <link rel="stylesheet" href="/static/css/public.css">
    <script src="/static/js/app.js" defer></script>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🌙</text></svg>">
</head>
<body>
    {{template "navbar" .}}

    <div class="weather-container">

        <!-- Location Search Form - Mobile First -->
        <form id="moon-form" class="moon-form">
    <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
            <div class="moon-form__wrapper">
                <!-- First row: Location input and units -->
                <div class="moon-form__row">
                    <div class="moon-form__input-wrapper">
                        <input
                            type="text"
                            id="moon-location-input"
                            name="location"
                            class="location-input moon-form__input"
                            placeholder="{{t .server.Lang "moon_location_placeholder"}}"
                            value="{{.Location}}"
                            autocomplete="off"
                        >
                        <div id="moon-autocomplete-dropdown" class="autocomplete-dropdown"></div>
                    </div>
                    <select name="units" id="moon-units-select" class="location-input moon-form__units">
                        <option value="imperial"{{if eq .Units "imperial"}} selected{{end}}>°F</option>
                        <option value="metric"{{if eq .Units "metric"}} selected{{end}}>°C</option>
                    </select>
                </div>

                <!-- Second row: Buttons -->
                <div class="moon-form__row">
                    <button type="submit" class="search-button moon-form__button">
                        🌙 {{t .server.Lang "moon_moon_info_button"}}
                    </button>
                    <button type="button" id="moon-location-btn" class="search-button moon-form__button--location">
                        📍 {{t .server.Lang "index_my_location_button"}}
                    </button>
                </div>
            </div>
        </form>

        {{if .MoonData}}
            {{template "location_details" .MoonData}}

            <!-- Current Moon Phase -->
            <div class="current-weather">
                <div class="weather-icon moon-weather-icon">
                    {{.MoonData.Moon.Icon}}
                </div>
                <div class="weather-details">
                    <div class="temperature moon-temp-display">
                        {{.MoonData.Moon.Phase}}
                    </div>
                    <div class="description">
                        {{.MoonData.Moon.Illumination}}% {{t .server.Lang "moon_illuminated_suffix"}}
                    </div>
                    <div class="weather-stats">
                        <div class="stat">{{t .server.Lang "moon_age_label"}} <span class="stat-value">{{.MoonData.Moon.AgeFmt}} {{t .server.Lang "moon_days_suffix"}}</span></div>
                        <div class="stat">{{t .server.Lang "moon_next_phase_label"}} <span class="stat-value">
                            {{if lt .MoonData.Moon.Age 7.0}}{{t .server.Lang "moon_phase_first_quarter"}}{{else if lt .MoonData.Moon.Age 14.0}}{{t .server.Lang "moon_phase_full_moon"}}{{else if lt .MoonData.Moon.Age 21.0}}{{t .server.Lang "moon_phase_last_quarter"}}{{else}}{{t .server.Lang "moon_phase_new_moon"}}{{end}}
                        </span></div>
                    </div>
                </div>
            </div>

            <!-- Moon and Sun Times -->
            <div class="grid-auto-fit-300">
                <!-- Moon Times -->
                <div class="info-box">
                    <h3 class="info-box__title info-box__title--lunar">🌙 {{t .server.Lang "moon_lunar_information_heading"}}</h3>
                    <div class="info-box__content">
                        <div class="info-box__item">
                            <strong class="info-box__label">{{t .server.Lang "moon_phase_label"}}</strong>
                            <span class="info-box__value--primary">{{.MoonData.Moon.Phase}}</span>
                        </div>
                        <div class="info-box__item">
                            <strong class="info-box__label">{{t .server.Lang "moon_illumination_label"}}</strong>
                            <span class="info-box__value--green">{{.MoonData.Moon.Illumination}}%</span>
                        </div>
                        <div class="info-box__item">
                            <strong class="info-box__label">{{t .server.Lang "moon_age_label"}}</strong>
                            <span class="info-box__value--pink">{{.MoonData.Moon.AgeFmt}} {{t .server.Lang "moon_days_suffix"}}</span>
                        </div>
                        {{if and .MoonData.Moon.Rise .MoonData.Moon.Set}}
                        <div class="info-box__item">
                            <strong class="info-box__label">{{t .server.Lang "moon_moonrise_label"}}</strong>
                            <span class="info-box__value--orange">{{.MoonData.Moon.RiseFormatted}}</span>
                        </div>
                        <div class="info-box__item">
                            <strong class="info-box__label">{{t .server.Lang "moon_moonset_label"}}</strong>
                            <span class="info-box__value--orange">{{.MoonData.Moon.SetFormatted}}</span>
                        </div>
                        {{end}}
                        <div class="info-box__item">
                            <strong class="info-box__label">{{t .server.Lang "moon_distance_label"}}</strong>
                            <span class="info-box__value--cyan">{{.MoonData.Moon.DistanceFormatted}}</span>
                        </div>
                        <div class="info-box__item">
                            <strong class="info-box__label">{{t .server.Lang "moon_angular_size_label"}}</strong>
                            <span class="info-box__value--purple">{{.MoonData.Moon.AngularSizeFmt}}</span>
                        </div>
                    </div>
                </div>

                <!-- Upcoming Phases -->
                <div class="info-box">
                    <h3 class="info-box__title info-box__title--upcoming">📅 {{t .server.Lang "moon_upcoming_phases_heading"}}</h3>
                    <div class="info-box__content">
                        <div class="info-box__item">
                            <strong class="info-box__label">🌑 {{t .server.Lang "moon_next_new_moon_label"}}</strong>
                            <span class="info-box__value--primary">{{.MoonData.Moon.NextNewMoonFmt}}</span>
                        </div>
                        <div class="info-box__item">
                            <strong class="info-box__label">🌕 {{t .server.Lang "moon_next_full_moon_label"}}</strong>
                            <span class="info-box__value--yellow">{{.MoonData.Moon.NextFullMoonFmt}}</span>
                        </div>
                    </div>
                </div>

                <!-- Sun Times -->
                <div class="info-box">
                    <h3 class="info-box__title info-box__title--solar">☀️ {{t .server.Lang "moon_solar_information_heading"}}</h3>
                    <div class="info-box__content">
                        <div class="info-box__item">
                            <strong class="info-box__label">{{t .server.Lang "moon_sunrise_label"}}</strong>
                            <span class="info-box__value--primary">{{.MoonData.Sun.SunriseFormatted}}</span>
                        </div>
                        <div class="info-box__item">
                            <strong class="info-box__label">{{t .server.Lang "moon_sunset_label"}}</strong>
                            <span class="info-box__value--red">{{.MoonData.Sun.SunsetFormatted}}</span>
                        </div>
                        <div class="info-box__item">
                            <strong class="info-box__label">{{t .server.Lang "moon_solar_noon_label"}}</strong>
                            <span class="info-box__value--green">{{.MoonData.Sun.SolarNoonFormatted}}</span>
                        </div>
                        <div class="info-box__item">
                            <strong class="info-box__label">{{t .server.Lang "moon_day_length_label"}}</strong>
                            <span class="info-box__value--pink">{{.MoonData.Sun.DayLengthFormatted}}</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Console Command Examples -->
            <div class="console-section">
                <h3 class="console-section__title">{{t .server.Lang "index_console_access_heading"}}</h3>
                <div class="console-commands">
                    <div class="command-item">
                        <strong class="console-section__label">{{t .server.Lang "index_console_weather_label"}}</strong>
                        <div class="code-wrapper">
                            <code class="mobile-code">curl -q -LSs {{.HostInfo.FullHost}}/{{.MoonData.Location.NameEncoded}}</code>
                            <button class="copy-btn" data-action="copy-command" data-text="curl -q -LSs {{.HostInfo.FullHost}}/{{.MoonData.Location.NameEncoded}}">{{t .server.Lang "moon_copy_button"}}</button>
                        </div>
                    </div>
                    <div class="command-item">
                        <strong class="console-section__label">{{t .server.Lang "index_console_oneline_label"}}</strong>
                        <div class="code-wrapper">
                            <code class="mobile-code">curl -q -LSs {{.HostInfo.FullHost}}/{{.MoonData.Location.NameEncoded}}?format=3</code>
                            <button class="copy-btn" data-action="copy-command" data-text="curl -q -LSs {{.HostInfo.FullHost}}/{{.MoonData.Location.NameEncoded}}?format=3">{{t .server.Lang "moon_copy_button"}}</button>
                        </div>
                    </div>
                    <div class="command-item">
                        <strong class="console-section__label">{{t .server.Lang "index_console_moon_label"}}</strong>
                        <div class="code-wrapper">
                            <code class="mobile-code">curl -q -LSs {{.HostInfo.FullHost}}/moon</code>
                            <button class="copy-btn" data-action="copy-command" data-text="curl -q -LSs {{.HostInfo.FullHost}}/moon">{{t .server.Lang "moon_copy_button"}}</button>
                        </div>
                    </div>
                    <div class="command-item">
                        <strong class="console-section__label">{{t .server.Lang "index_console_moon_location_label"}}</strong>
                        <div class="code-wrapper">
                            <code class="mobile-code">curl -q -LSs {{.HostInfo.FullHost}}/moon/{{.MoonData.Location.NameEncoded}}</code>
                            <button class="copy-btn" data-action="copy-command" data-text="curl -q -LSs {{.HostInfo.FullHost}}/moon/{{.MoonData.Location.NameEncoded}}">{{t .server.Lang "moon_copy_button"}}</button>
                        </div>
                    </div>
                </div>
            </div>
        {{else}}
            <div class="welcome-section">
                <h2 class="welcome-section__title">🌙 {{t .server.Lang "moon_welcome_heading"}}</h2>
                <p>{{t .server.Lang "moon_welcome_text"}}</p>
                <div class="city-links-grid">
                    <a href="?location=London" class="city-link">🇬🇧 London</a>
                    <a href="?location=Tokyo" class="city-link">🇯🇵 Tokyo</a>
                    <a href="?location=New+York" class="city-link">🇺🇸 New York</a>
                    <a href="?location=Sydney" class="city-link">🇦🇺 Sydney</a>
                </div>
            </div>
        {{end}}

    </div>

    <script type="application/json" id="moon-data">
        {
            "apiPath": "{{.api_path}}",
            "gettingLocation": "{{t .server.Lang "moon_js_getting_location"}}",
            "foundLocation": "{{t .server.Lang "moon_js_found_location"}}",
            "locationError": "{{t .server.Lang "moon_js_location_error"}}"
        }
    </script>

{{if not .HideFooter}}
{{template "footer" .}}
{{else}}
</body>
</html>
{{end}}
