{{template "head" .}}

{{template "navbar" .}}

<div class="profile-container">
    <div class="page-header">
        <h1 class="profile-page-header-title">{{t .server.Lang "settings_tokens_title"}}</h1>
        <p class="text-comment">{{t .server.Lang "settings_tokens_subtitle"}}</p>
    </div>

    <!-- Settings Navigation -->
    <div class="settings-nav">
        <a href="/users/settings" class="settings-nav-item">{{t .server.Lang "settings_nav_account"}}</a>
        <a href="/users/settings/privacy" class="settings-nav-item">{{t .server.Lang "settings_nav_privacy"}}</a>
        <a href="/users/settings/notifications" class="settings-nav-item">{{t .server.Lang "settings_nav_notifications"}}</a>
        <a href="/users/settings/appearance" class="settings-nav-item">{{t .server.Lang "settings_nav_appearance"}}</a>
        <a href="/users/security" class="settings-nav-item">{{t .server.Lang "settings_nav_security"}}</a>
        <a href="/users/tokens" class="settings-nav-item active">{{t .server.Lang "settings_nav_api_tokens"}}</a>
    </div>

    <!-- API Tokens Card -->
    <div class="card profile-card">
        <div class="card-header d-flex justify-between align-center">
            <h2 class="profile-card-header-title">{{t .server.Lang "settings_tokens_title"}}</h2>
            <button type="button" class="btn btn-primary" data-action="tokens-show-new-modal">+ {{t .server.Lang "settings_tokens_new_token"}}</button>
        </div>
        <div class="card-body">
            <div id="tokenList">
                {{if .tokens}}
                {{range .tokens}}
                <div class="token-item" data-token-id="{{.ID}}">
                    <div class="token-info">
                        <div class="token-name">{{if .Name}}{{.Name}}{{else}}{{t $.server.Lang "settings_tokens_unnamed_token"}}{{end}}</div>
                        <div class="token-meta">
                            <span class="token-prefix">{{.TokenPrefix}}</span>
                            {{if .Scopes}}
                            <span class="token-scopes">{{t $.server.Lang "settings_tokens_scopes_label"}} {{.Scopes}}</span>
                            {{end}}
                        </div>
                        <div class="token-dates">
                            <span>{{t $.server.Lang "settings_tokens_created_label"}} {{.CreatedAt.Format "Jan 2, 2006"}}</span>
                            {{if .ExpiresAt}}
                            <span>{{t $.server.Lang "settings_tokens_expires_label"}} {{.ExpiresAt.Format "Jan 2, 2006"}}</span>
                            {{else}}
                            <span>{{t $.server.Lang "settings_tokens_expires_label"}} {{t $.server.Lang "settings_tokens_never"}}</span>
                            {{end}}
                            {{if .LastUsedAt}}
                            <span>{{t $.server.Lang "settings_tokens_last_used_label"}} {{.LastUsedAt.Format "Jan 2, 2006 15:04"}}</span>
                            {{else}}
                            <span>{{t $.server.Lang "settings_tokens_last_used_label"}} {{t $.server.Lang "settings_tokens_never"}}</span>
                            {{end}}
                        </div>
                    </div>
                    <button type="button" class="btn btn-danger btn-sm" data-action="tokens-revoke" data-token-id="{{.ID}}">{{t $.server.Lang "settings_tokens_revoke"}}</button>
                </div>
                {{end}}
                {{else}}
                <div class="empty-state">
                    <p>{{t .server.Lang "settings_tokens_empty_title"}}</p>
                    <p class="text-comment">{{t .server.Lang "settings_tokens_empty_message"}}</p>
                </div>
                {{end}}
            </div>
        </div>
    </div>

    <!-- Token Info Card -->
    <div class="card profile-card">
        <div class="card-header">
            <h2 class="profile-card-header-title">{{t .server.Lang "settings_tokens_about_heading"}}</h2>
        </div>
        <div class="card-body">
            <div class="info-content">
                <p>{{t .server.Lang "settings_tokens_about_intro"}}</p>
                <ul>
                    <li>{{t .server.Lang "settings_tokens_use_cli"}}</li>
                    <li>{{t .server.Lang "settings_tokens_use_scripts"}}</li>
                    <li>{{t .server.Lang "settings_tokens_use_integrations"}}</li>
                </ul>
                <p class="text-comment">
                    <strong>{{t .server.Lang "settings_tokens_security_note_label"}}</strong> {{t .server.Lang "settings_tokens_security_note_message"}}
                </p>
            </div>
        </div>
    </div>
</div>

<!-- New Token Modal -->
<div id="newTokenModal" class="modal d-none">
    <div class="modal-content">
        <div class="modal-header">
            <h3>{{t .server.Lang "settings_tokens_create_new_title"}}</h3>
            <button class="modal-close" data-action="tokens-close-new-modal">&times;</button>
        </div>
        <div class="modal-body">
            <form id="newTokenForm">
                <input type="hidden" name="csrf_token" value="{{.csrf_token}}">

                <div class="form-group">
                    <label for="tokenName" class="form-label">{{t .server.Lang "settings_tokens_name_label"}}</label>
                    <input type="text" id="tokenName" class="form-input" required placeholder="My CLI Token">
                    <small class="text-comment">{{t .server.Lang "settings_tokens_name_hint"}}</small>
                </div>

                <div class="form-group">
                    <label for="tokenScopes" class="form-label">{{t .server.Lang "settings_tokens_scopes_label_optional"}}</label>
                    <input type="text" id="tokenScopes" class="form-input" placeholder="read, write">
                    <small class="text-comment">{{t .server.Lang "settings_tokens_scopes_hint"}}</small>
                </div>

                <div class="form-group">
                    <label for="tokenExpires" class="form-label">{{t .server.Lang "settings_tokens_expiration_label"}}</label>
                    <select id="tokenExpires" class="form-input">
                        <option value="0">{{t .server.Lang "settings_tokens_never"}}</option>
                        <option value="7">{{t .server.Lang "settings_tokens_7_days"}}</option>
                        <option value="30">{{t .server.Lang "settings_tokens_30_days"}}</option>
                        <option value="90">{{t .server.Lang "settings_tokens_90_days"}}</option>
                        <option value="365">{{t .server.Lang "settings_tokens_1_year"}}</option>
                    </select>
                </div>

                <div class="profile-form-actions">
                    <button type="submit" class="btn btn-primary">{{t .server.Lang "settings_tokens_create_button"}}</button>
                    <button type="button" class="btn btn-secondary" data-action="tokens-close-new-modal">{{t .server.Lang "security_cancel"}}</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Token Created Modal -->
<div id="tokenCreatedModal" class="modal d-none">
    <div class="modal-content">
        <div class="modal-header">
            <h3>{{t .server.Lang "settings_tokens_created_title"}}</h3>
        </div>
        <div class="modal-body">
            <div class="alert alert-warning">
                <strong>{{t .server.Lang "settings_tokens_important_label"}}</strong> {{t .server.Lang "settings_tokens_created_warning"}}
            </div>
            <div class="form-group">
                <label class="form-label">{{t .server.Lang "settings_tokens_your_new_token_label"}}</label>
                <div class="token-display">
                    <input type="text" id="createdToken" class="form-input" readonly>
                    <button type="button" class="btn btn-secondary" data-action="tokens-copy-created">{{t .server.Lang "weather_copy"}}</button>
                </div>
            </div>
            <div class="profile-form-actions">
                <button type="button" class="btn btn-primary" data-action="tokens-close-created-modal">{{t .server.Lang "settings_tokens_done_button"}}</button>
            </div>
        </div>
    </div>
</div>

<style>
.settings-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    padding: 1rem;
    background: var(--bg-dark);
    border-radius: 8px;
    border: 1px solid var(--border);
}
.settings-nav-item {
    padding: 0.5rem 1rem;
    border-radius: 4px;
    color: var(--text);
    text-decoration: none;
    transition: background 0.2s;
}
.settings-nav-item:hover {
    background: var(--bg);
}
.settings-nav-item.active {
    background: var(--accent);
    color: var(--bg);
}
.d-flex {
    display: flex;
}
.justify-between {
    justify-content: space-between;
}
.align-center {
    align-items: center;
}
.token-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    margin-bottom: 1rem;
}
.token-info {
    flex: 1;
}
.token-name {
    font-weight: bold;
    margin-bottom: 0.25rem;
}
.token-meta {
    font-family: monospace;
    font-size: 0.9rem;
    color: var(--text-comment);
    margin-bottom: 0.25rem;
}
.token-prefix {
    background: var(--bg-dark);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    margin-right: 0.5rem;
}
.token-scopes {
    margin-left: 0.5rem;
}
.token-dates {
    font-size: 0.85rem;
    color: var(--text-comment);
}
.token-dates span {
    margin-right: 1rem;
}
.btn-sm {
    padding: 0.25rem 0.75rem;
    font-size: 0.9rem;
}
.empty-state {
    text-align: center;
    padding: 2rem;
    color: var(--text-comment);
}
.info-content ul {
    margin: 1rem 0;
    padding-left: 1.5rem;
}
.info-content li {
    margin-bottom: 0.5rem;
}
.modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.7);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
}
.modal-content {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    max-width: 500px;
    width: 90%;
}
.modal-header {
    padding: 1rem;
    border-bottom: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
}
.modal-close {
    background: none;
    border: none;
    font-size: 1.5rem;
    cursor: pointer;
    color: var(--text-comment);
}
.modal-body {
    padding: 1.5rem;
}
.token-display {
    display: flex;
    gap: 0.5rem;
}
.token-display input {
    flex: 1;
    font-family: monospace;
}
.d-none {
    display: none !important;
}
</style>

<script type="application/json" id="settings-tokens-data">
{"apiPath": "{{.api_path}}"}
</script>

{{template "footer" .}}
</body>
</html>
