{{template "head" .}}

{{template "navbar" .}}

<div class="profile-container">
    <div class="page-header">
        <h1 class="profile-page-header-title">👤 Profile</h1>
        <p class="text-comment">Manage your account information and preferences</p>
    </div>

    <!-- Profile Information Card -->
    <div class="card profile-card">
        <div class="card-header">
            <h2 class="profile-card-header-title">Account Information</h2>
        </div>
        <div class="card-body">
            <form id="profileForm">
    <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
                <div class="form-grid">
                    <!-- Username -->
                    <div class="form-group">
                        <label for="username" class="form-label">Username</label>
                        <input type="text" id="username" class="form-input" value="{{.user.Username}}" readonly>
                        <small class="text-comment">Username cannot be changed</small>
                    </div>

                    <!-- Email -->
                    <div class="form-group">
                        <label for="email" class="form-label">Email Address</label>
                        <input type="email" id="email" class="form-input" value="{{.user.Email}}" required>
                        <small class="text-comment">Used for notifications and account recovery</small>
                    </div>

                    <!-- Display Name -->
                    <div class="form-group">
                        <label for="displayName" class="form-label">Display Name</label>
                        <input type="text" id="displayName" class="form-input" value="{{.user.DisplayName}}" placeholder="{{.user.Username}}">
                        <small class="text-comment">Shown in the navigation bar (optional)</small>
                    </div>

                    <!-- Phone -->
                    <div class="form-group">
                        <label for="phone" class="form-label">Phone Number</label>
                        <input type="tel" id="phone" class="form-input" value="{{.user.Phone}}" placeholder="+1 (555) 123-4567">
                        <small class="text-comment">For SMS notifications (optional)</small>
                    </div>
                </div>

                <div class="profile-form-actions">
                    <button type="submit" class="btn btn-primary">💾 Save Changes</button>
                    <button type="button" class="btn btn-secondary" data-action="profile-reset-form">↻ Reset</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Security Settings Card -->
    <div class="card profile-card">
        <div class="card-header">
            <h2 class="profile-card-header-title">Security</h2>
        </div>
        <div class="card-body">
            <div class="info-grid">
                <div class="info-item">
                    <div class="info-label">Two-Factor Authentication</div>
                    <div class="info-value">
                        {{if .user.TwoFactorEnabled}}
                        <span class="badge badge-success">Enabled</span>
                        {{else}}
                        <span class="badge badge-danger">Disabled</span>
                        {{end}}
                    </div>
                </div>
            </div>
            <a href="/users/security" class="btn btn-primary margin-y-md">🔒 Manage Security Settings</a>
        </div>
    </div>

    <!-- Change Password Card -->
    <div class="card profile-card">
        <div class="card-header">
            <h2 class="profile-card-header-title">Change Password</h2>
        </div>
        <div class="card-body">
            <form id="passwordForm">
    <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
                <div class="form-group">
                    <label for="currentPassword" class="form-label">Current Password</label>
                    <input type="password" id="currentPassword" class="form-input" required minlength="8">
                </div>

                <div class="form-grid">
                    <div class="form-group">
                        <label for="newPassword" class="form-label">New Password</label>
                        <input type="password" id="newPassword" class="form-input" required minlength="8">
                        <small class="text-comment">Minimum 8 characters</small>
                    </div>

                    <div class="form-group">
                        <label for="confirmPassword" class="form-label">Confirm New Password</label>
                        <input type="password" id="confirmPassword" class="form-input" required minlength="8">
                        <small class="text-comment">Must match new password</small>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary profile-password-button">🔒 Change Password</button>
            </form>
        </div>
    </div>

    <!-- Notification Preferences Card -->
    <div class="card profile-card">
        <div class="card-header">
            <h2 class="profile-card-header-title">🔔 Notification Preferences</h2>
        </div>
        <div class="card-body">
            <form id="notificationPreferencesForm">
    <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
                <div class="form-group">
                    <p class="text-comment mb-3">
                        Customize how you receive notifications from the system. Configure display modes and auto-dismiss timing.
                    </p>

                    <!-- Display Mode Toggles -->
                    <div class="mb-4">
                        <h3 class="section-title">Display Modes</h3>

                        <div class="form-group">
                            <label class="checkbox-label">
                                <input type="checkbox" id="enableToast" checked>
                                <span>Enable Toast Notifications</span>
                            </label>
                            <small class="text-comment">Show temporary popups in the top-right corner (auto-dismiss)</small>
                        </div>

                        <div class="form-group">
                            <label class="checkbox-label">
                                <input type="checkbox" id="enableBanner" checked>
                                <span>Enable Banner Notifications</span>
                            </label>
                            <small class="text-comment">Show persistent banners at the top of the page (manual dismiss)</small>
                        </div>

                        <div class="form-group">
                            <label class="checkbox-label">
                                <input type="checkbox" id="enableCenter" checked>
                                <span>Enable Notification Center</span>
                            </label>
                            <small class="text-comment">Store notifications in the notification center (bell icon)</small>
                        </div>

                        <div class="form-group">
                            <label class="checkbox-label">
                                <input type="checkbox" id="enableSound">
                                <span>Enable Notification Sound</span>
                            </label>
                            <small class="text-comment">Play a sound when receiving notifications</small>
                        </div>
                    </div>

                    <!-- Toast Duration Settings -->
                    <div class="mb-3">
                        <h3 class="section-title">Toast Auto-Dismiss Duration</h3>

                        <div class="form-grid">
                            <div class="form-group">
                                <label for="toastDurationSuccess" class="form-label">Success Notifications</label>
                                <div class="d-flex align-center gap-2">
                                    <input type="range" id="toastDurationSuccess" min="1" max="60" value="5"
                                           class="flex-1" oninput="updateDurationLabel('success', this.value)">
                                    <span id="durationLabelSuccess" class="duration-label-success">5s</span>
                                </div>
                                <small class="text-comment">How long success toasts remain visible (1-60 seconds)</small>
                            </div>

                            <div class="form-group">
                                <label for="toastDurationInfo" class="form-label">Info Notifications</label>
                                <div class="d-flex align-center gap-2">
                                    <input type="range" id="toastDurationInfo" min="1" max="60" value="5"
                                           class="flex-1" oninput="updateDurationLabel('info', this.value)">
                                    <span id="durationLabelInfo" class="duration-label-info">5s</span>
                                </div>
                                <small class="text-comment">How long info toasts remain visible (1-60 seconds)</small>
                            </div>

                            <div class="form-group">
                                <label for="toastDurationWarning" class="form-label">Warning Notifications</label>
                                <div class="d-flex align-center gap-2">
                                    <input type="range" id="toastDurationWarning" min="1" max="60" value="10"
                                           class="flex-1" oninput="updateDurationLabel('warning', this.value)">
                                    <span id="durationLabelWarning" class="duration-label-warning">10s</span>
                                </div>
                                <small class="text-comment">How long warning toasts remain visible (1-60 seconds)</small>
                            </div>
                        </div>

                        <div class="info-box-styled">
                            <p>
                                <strong>Note:</strong> Error notifications always require manual dismissal for safety.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="profile-form-actions">
                    <button type="submit" class="btn btn-primary">💾 Save Preferences</button>
                    <button type="button" class="btn btn-secondary" data-action="profile-load-notification-prefs">↻ Reset</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Account Information (Read-only) -->
    <div class="card">
        <div class="card-header">
            <h2 class="profile-card-header-title">Account Details</h2>
        </div>
        <div class="card-body">
            <div class="info-grid">
                <div class="info-item">
                    <div class="info-label">User ID</div>
                    <div class="info-value">{{.user.ID}}</div>
                </div>
                <div class="info-item">
                    <div class="info-label">Role</div>
                    <div class="info-value">
                        <span class="badge {{if eq .user.Role "admin"}}badge-admin{{else}}badge-user{{end}}">
                            {{.user.Role}}
                        </span>
                    </div>
                </div>
                <div class="info-item">
                    <div class="info-label">Account Created</div>
                    <div class="info-value">{{.user.CreatedAt.Format "January 2, 2006 at 3:04 PM"}}</div>
                </div>
                <div class="info-item">
                    <div class="info-label">Last Updated</div>
                    <div class="info-value">{{.user.UpdatedAt.Format "January 2, 2006 at 3:04 PM"}}</div>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="application/json" id="profile-data">
{"apiPath": "{{.api_path}}"}
</script>

{{template "footer" .}}
</body>
</html>
