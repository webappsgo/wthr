{{template "head" .}}

{{template "navbar" .}}

<div class="profile-container">
    <div class="page-header">
        <h1 class="profile-page-header-title">{{t .server.Lang "settings_notifications_title"}}</h1>
        <p class="text-comment">{{t .server.Lang "settings_notifications_subtitle"}}</p>
    </div>

    {{template "flash" .}}

    <!-- Settings Navigation -->
    <div class="settings-nav">
        <a href="/users/settings" class="settings-nav-item">{{t .server.Lang "settings_nav_account"}}</a>
        <a href="/users/settings/privacy" class="settings-nav-item">{{t .server.Lang "settings_nav_privacy"}}</a>
        <a href="/users/settings/notifications" class="settings-nav-item active">{{t .server.Lang "settings_nav_notifications"}}</a>
        <a href="/users/settings/appearance" class="settings-nav-item">{{t .server.Lang "settings_nav_appearance"}}</a>
        <a href="/users/security" class="settings-nav-item">{{t .server.Lang "settings_nav_security"}}</a>
        <a href="/users/tokens" class="settings-nav-item">{{t .server.Lang "settings_nav_api_tokens"}}</a>
    </div>

    <!-- Notification Settings Form -->
    <div class="card profile-card">
        <div class="card-header">
            <h2 class="profile-card-header-title">{{t .server.Lang "settings_email_notifications_heading"}}</h2>
        </div>
        <div class="card-body">
            <form id="notificationSettingsForm" method="post" action="/users/settings/notifications">
                <input type="hidden" name="csrf_token" value="{{.csrf_token}}">

                <div class="toggle-group">
                    <label class="toggle-item disabled">
                        <input type="checkbox" checked disabled>
                        <div class="toggle-content">
                            <strong>{{t .server.Lang "settings_security_alerts_required"}}</strong>
                            <span class="badge badge-locked">{{t .server.Lang "settings_locked_badge"}}</span>
                            <p class="text-comment">{{t .server.Lang "settings_security_alerts_hint"}}</p>
                        </div>
                    </label>

                    <label class="toggle-item">
                        <input type="checkbox" id="emailMentions" name="emailMentions" {{if .preferences.EmailNotifications}}checked{{end}}>
                        <div class="toggle-content">
                            <strong>{{t .server.Lang "settings_mentions_replies_label"}}</strong>
                            <p class="text-comment">{{t .server.Lang "settings_mentions_replies_hint"}}</p>
                        </div>
                    </label>

                    <label class="toggle-item">
                        <input type="checkbox" id="emailUpdates" name="emailUpdates">
                        <div class="toggle-content">
                            <strong>{{t .server.Lang "settings_product_updates_label"}}</strong>
                            <p class="text-comment">{{t .server.Lang "settings_product_updates_hint"}}</p>
                        </div>
                    </label>
                </div>

                <div class="form-group margin-y-md">
                    <label for="emailDigest" class="form-label">{{t .server.Lang "settings_activity_digest_label"}}</label>
                    <select id="emailDigest" name="emailDigest" class="form-input">
                        <option value="never">{{t .server.Lang "settings_digest_never"}}</option>
                        <option value="daily">{{t .server.Lang "settings_digest_daily"}}</option>
                        <option value="weekly" selected>{{t .server.Lang "settings_digest_weekly"}}</option>
                    </select>
                    <small class="text-comment">{{t .server.Lang "settings_activity_digest_hint"}}</small>
                </div>

                <hr class="settings-divider">

                <h3 class="section-title">{{t .server.Lang "settings_push_notifications_heading"}}</h3>

                <div class="toggle-group">
                    <label class="toggle-item">
                        <input type="checkbox" id="pushEnabled" name="pushEnabled" {{if .preferences.NotificationsEnabled}}checked{{end}}>
                        <div class="toggle-content">
                            <strong>{{t .server.Lang "settings_enable_push_label"}}</strong>
                            <p class="text-comment">{{t .server.Lang "settings_enable_push_hint"}}</p>
                            <p class="text-comment text-sm">{{t .server.Lang "settings_requires_browser_permission"}}</p>
                        </div>
                    </label>

                    <label class="toggle-item" id="pushMentionsWrapper">
                        <input type="checkbox" id="pushMentions" name="pushMentions" checked disabled>
                        <div class="toggle-content">
                            <strong>{{t .server.Lang "settings_push_for_mentions_label"}}</strong>
                            <p class="text-comment">{{t .server.Lang "settings_push_for_mentions_hint"}}</p>
                        </div>
                    </label>
                </div>

                <div class="profile-form-actions">
                    <button type="submit" class="btn btn-primary">{{t .server.Lang "profile_save_preferences"}}</button>
                </div>
            </form>
        </div>
    </div>
</div>


{{template "footer" .}}
</body>
</html>
