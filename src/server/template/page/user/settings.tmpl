{{template "head" .}}

{{template "navbar" .}}

<div class="profile-container">
    <div class="page-header">
        <h1 class="profile-page-header-title">{{t .server.Lang "settings_account_settings_title"}}</h1>
        <p class="text-comment">{{t .server.Lang "profile_subtitle"}}</p>
    </div>

    <!-- Settings Navigation -->
    <div class="settings-nav">
        <a href="/users/settings" class="settings-nav-item active">{{t .server.Lang "settings_nav_account"}}</a>
        <a href="/users/settings/privacy" class="settings-nav-item">{{t .server.Lang "settings_nav_privacy"}}</a>
        <a href="/users/settings/notifications" class="settings-nav-item">{{t .server.Lang "settings_nav_notifications"}}</a>
        <a href="/users/settings/appearance" class="settings-nav-item">{{t .server.Lang "settings_nav_appearance"}}</a>
        <a href="/users/security" class="settings-nav-item">{{t .server.Lang "settings_nav_security"}}</a>
        <a href="/users/tokens" class="settings-nav-item">{{t .server.Lang "settings_nav_api_tokens"}}</a>
    </div>

    <!-- Account Settings Form -->
    <div class="card profile-card">
        <div class="card-header">
            <h2 class="profile-card-header-title">{{t .server.Lang "settings_profile_information"}}</h2>
        </div>
        <div class="card-body">
            <form id="accountSettingsForm">
                <input type="hidden" name="csrf_token" value="{{.csrf_token}}">

                <div class="form-group">
                    <label for="displayName" class="form-label">{{t .server.Lang "profile_display_name_label"}}</label>
                    <input type="text" id="displayName" class="form-input" value="{{.user.DisplayName}}" placeholder="{{.user.Username}}">
                    <small class="text-comment">{{t .server.Lang "settings_display_name_hint"}}</small>
                </div>

                <div class="form-group">
                    <label for="bio" class="form-label">{{t .server.Lang "settings_bio_label"}}</label>
                    <textarea id="bio" class="form-input" rows="3" maxlength="500" placeholder="{{t .server.Lang "settings_bio_placeholder"}}">{{.user.Bio}}</textarea>
                    <small class="text-comment"><span id="bioCount">{{len .user.Bio}}</span>{{t .server.Lang "settings_bio_char_count_suffix"}}</small>
                </div>

                <div class="form-group">
                    <label for="location" class="form-label">{{t .server.Lang "settings_location_label"}}</label>
                    <input type="text" id="location" class="form-input" value="{{.user.Location}}" placeholder="San Francisco, CA">
                    <small class="text-comment">{{t .server.Lang "settings_location_hint"}}</small>
                </div>

                <div class="form-group">
                    <label for="website" class="form-label">{{t .server.Lang "settings_website_label"}}</label>
                    <input type="url" id="website" class="form-input" value="{{.user.Website}}" placeholder="https://example.com">
                    <small class="text-comment">{{t .server.Lang "settings_website_hint"}}</small>
                </div>

                <hr class="settings-divider">

                <div class="form-grid">
                    <div class="form-group">
                        <label for="timezone" class="form-label">{{t .server.Lang "settings_timezone_label"}}</label>
                        <select id="timezone" class="form-input">
                            <option value="UTC" {{if eq .user.Timezone "UTC"}}selected{{end}}>UTC</option>
                            <option value="America/New_York" {{if eq .user.Timezone "America/New_York"}}selected{{end}}>America/New_York (UTC-5)</option>
                            <option value="America/Chicago" {{if eq .user.Timezone "America/Chicago"}}selected{{end}}>America/Chicago (UTC-6)</option>
                            <option value="America/Denver" {{if eq .user.Timezone "America/Denver"}}selected{{end}}>America/Denver (UTC-7)</option>
                            <option value="America/Los_Angeles" {{if eq .user.Timezone "America/Los_Angeles"}}selected{{end}}>America/Los_Angeles (UTC-8)</option>
                            <option value="Europe/London" {{if eq .user.Timezone "Europe/London"}}selected{{end}}>Europe/London (UTC+0)</option>
                            <option value="Europe/Paris" {{if eq .user.Timezone "Europe/Paris"}}selected{{end}}>Europe/Paris (UTC+1)</option>
                            <option value="Europe/Berlin" {{if eq .user.Timezone "Europe/Berlin"}}selected{{end}}>Europe/Berlin (UTC+1)</option>
                            <option value="Asia/Tokyo" {{if eq .user.Timezone "Asia/Tokyo"}}selected{{end}}>Asia/Tokyo (UTC+9)</option>
                            <option value="Asia/Shanghai" {{if eq .user.Timezone "Asia/Shanghai"}}selected{{end}}>Asia/Shanghai (UTC+8)</option>
                            <option value="Australia/Sydney" {{if eq .user.Timezone "Australia/Sydney"}}selected{{end}}>Australia/Sydney (UTC+10)</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="language" class="form-label">{{t .server.Lang "settings_language_label"}}</label>
                        <select id="language" class="form-input">
                            <option value="en" {{if eq .user.Language "en"}}selected{{end}}>{{t .server.Lang "lang_english"}}</option>
                            <option value="es" {{if eq .user.Language "es"}}selected{{end}}>{{t .server.Lang "lang_spanish"}}</option>
                            <option value="fr" {{if eq .user.Language "fr"}}selected{{end}}>{{t .server.Lang "lang_french"}}</option>
                            <option value="de" {{if eq .user.Language "de"}}selected{{end}}>{{t .server.Lang "lang_german"}}</option>
                            <option value="ja" {{if eq .user.Language "ja"}}selected{{end}}>{{t .server.Lang "lang_japanese"}}</option>
                            <option value="zh" {{if eq .user.Language "zh"}}selected{{end}}>{{t .server.Lang "lang_chinese"}}</option>
                            <option value="ar" {{if eq .user.Language "ar"}}selected{{end}}>{{t .server.Lang "lang_arabic"}}</option>
                        </select>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">{{t .server.Lang "settings_date_format_label"}}</label>
                    <div class="radio-group">
                        <label class="radio-label">
                            <input type="radio" name="dateFormat" value="YYYY-MM-DD" checked>
                            <span>YYYY-MM-DD (2025-01-15)</span>
                        </label>
                        <label class="radio-label">
                            <input type="radio" name="dateFormat" value="MM/DD/YYYY">
                            <span>MM/DD/YYYY (01/15/2025)</span>
                        </label>
                        <label class="radio-label">
                            <input type="radio" name="dateFormat" value="DD/MM/YYYY">
                            <span>DD/MM/YYYY (15/01/2025)</span>
                        </label>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">{{t .server.Lang "settings_time_format_label"}}</label>
                    <div class="radio-group">
                        <label class="radio-label">
                            <input type="radio" name="timeFormat" value="24h" checked>
                            <span>{{t .server.Lang "settings_time_format_24h"}} (14:30)</span>
                        </label>
                        <label class="radio-label">
                            <input type="radio" name="timeFormat" value="12h">
                            <span>{{t .server.Lang "settings_time_format_12h"}} (2:30 PM)</span>
                        </label>
                    </div>
                </div>

                <div class="profile-form-actions">
                    <button type="submit" class="btn btn-primary">{{t .server.Lang "profile_save_changes"}}</button>
                    <button type="button" class="btn btn-secondary" data-action="settings-reset-form">{{t .server.Lang "profile_reset"}}</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
.settings-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    padding: 1rem;
    background: var(--bg-dark);
    border-radius: 8px;
    border: 1px solid var(--border);
}
.settings-nav-item {
    padding: 0.5rem 1rem;
    border-radius: 4px;
    color: var(--text);
    text-decoration: none;
    transition: background 0.2s;
}
.settings-nav-item:hover {
    background: var(--bg);
}
.settings-nav-item.active {
    background: var(--accent);
    color: var(--bg);
}
.settings-divider {
    border: none;
    border-top: 1px solid var(--border);
    margin: 1.5rem 0;
}
.radio-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}
.radio-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
}
.radio-label input[type="radio"] {
    accent-color: var(--accent);
}
</style>

<script type="application/json" id="settings-data">
{"apiPath": "{{.api_path}}"}
</script>

{{template "footer" .}}
</body>
</html>
