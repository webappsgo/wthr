{{template "head" .}}

{{template "navbar" .}}

<main id="main-content">
  <div class="container container-sm">
    <header class="page-header"><h1 class="page-title">{{t .server.Lang "security.report.received.title"}}</h1></header>
    <section class="section-card" aria-labelledby="report-received-heading" role="status">
        <h2 id="report-received-heading" class="sr-only">{{t .server.Lang "security.report.received.title"}}</h2>
        <p>{{t .server.Lang "security.report.received.text"}}</p>
        <p><strong>{{t .server.Lang "security.report.received.tracking"}}</strong> <code>{{.TrackingID}}</code></p>
        <p>{{t .server.Lang "security.report.received.email_note"}}</p>
    </section>
    <p><a href="{{path "/server/security"}}">{{t .server.Lang "security.back"}}</a></p>
  </div>
</main>

{{template "footer" .}}
