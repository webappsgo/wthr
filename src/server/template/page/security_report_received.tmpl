{{template "head" .}}

{{template "navbar" .}}

<main id="main-content" class="weather-container">
    <h1 class="text-purple">{{t .server.Lang "security.report.received.title"}}</h1>
    <section class="card margin-y-lg" role="status">
        <p>{{t .server.Lang "security.report.received.text"}}</p>
        <p><strong>{{t .server.Lang "security.report.received.tracking"}}</strong> <code>{{.TrackingID}}</code></p>
        <p>{{t .server.Lang "security.report.received.email_note"}}</p>
    </section>
    <p><a href="{{path "/server/security"}}">{{t .server.Lang "security.back"}}</a></p>
</main>

{{template "footer" .}}
