<!DOCTYPE html>
<html lang="en" class="{{if .server.ThemeClass}}{{.server.ThemeClass}}{{else}}theme-dark{{end}}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{.Title}}</title>
    <link rel="stylesheet" href="/static/css/common.css">
    <link rel="stylesheet" href="/static/css/components.css">
    <link rel="stylesheet" href="/static/css/public.css">
    <script src="/static/js/app.js" defer></script>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>⚠️</text></svg>">
</head>
<body>
    {{template "navbar" .}}

    <div class="weather-container">

        <!-- Location Search Form - Mobile First (matching moon.html) -->
        <form id="severe-weather-form" class="moon-form" role="form" aria-label="{{t .server.Lang "severe_weather_form_aria_label"}}">
    <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
            <div class="moon-form__wrapper">
                <!-- First row: Location input with type and distance filters to the right -->
                <div class="moon-form__row">
                    <div class="moon-form__input-wrapper">
                        <input
                            type="text"
                            id="location-input"
                            name="location"
                            class="location-input moon-form__input"
                            placeholder="{{t .server.Lang "severe_weather_location_placeholder"}}"
                            value="{{.LocationName}}"
                            autocomplete="off"
                            aria-label="{{t .server.Lang "severe_weather_search_location_aria"}}"
                            aria-autocomplete="list"
                            aria-controls="severe-autocomplete-dropdown"
                            title="{{t .server.Lang "severe_weather_location_input_title"}}"
                        >
                        <div id="severe-autocomplete-dropdown" class="autocomplete-dropdown" role="listbox" aria-label="{{t .server.Lang "severe_weather_location_suggestions_aria"}}"></div>
                    </div>
                    <select name="type"
                            id="type-select"
                            class="location-input moon-form__units"
                            aria-label="{{t .server.Lang "severe_weather_type_filter_aria"}}"
                            title="{{t .server.Lang "severe_weather_type_filter_title"}}">
                        <option value="all"{{if eq .TypeFilter "all"}} selected{{end}}>{{t .server.Lang "severe_weather_type_all"}}</option>
                        <option value="hurricanes"{{if eq .TypeFilter "hurricanes"}} selected{{end}}>🌀 {{t .server.Lang "severe_weather_type_hurricanes"}}</option>
                        <option value="tornadoes"{{if eq .TypeFilter "tornadoes"}} selected{{end}}>🌪️ {{t .server.Lang "severe_weather_type_tornadoes"}}</option>
                        <option value="storms"{{if eq .TypeFilter "storms"}} selected{{end}}>⛈️ {{t .server.Lang "severe_weather_type_storms"}}</option>
                        <option value="winter"{{if eq .TypeFilter "winter"}} selected{{end}}>❄️ {{t .server.Lang "severe_weather_type_winter"}}</option>
                        <option value="floods"{{if eq .TypeFilter "floods"}} selected{{end}}>🌊 {{t .server.Lang "severe_weather_type_floods"}}</option>
                    </select>
                    <select name="distance"
                            id="distance-select"
                            class="location-input moon-form__units"
                            aria-label="{{t .server.Lang "severe_weather_distance_filter_aria"}}"
                            title="{{t .server.Lang "severe_weather_distance_filter_title"}}">
                        <option value="25"{{if eq .DistanceFilter "25"}} selected{{end}}>25 {{t .server.Lang "severe_weather_distance_unit"}}</option>
                        <option value="50"{{if eq .DistanceFilter "50"}} selected{{end}}>50 {{t .server.Lang "severe_weather_distance_unit"}}</option>
                        <option value="100"{{if eq .DistanceFilter "100"}} selected{{end}}>100 {{t .server.Lang "severe_weather_distance_unit"}}</option>
                        <option value="250"{{if eq .DistanceFilter "250"}} selected{{end}}>250 {{t .server.Lang "severe_weather_distance_unit"}}</option>
                        <option value="500"{{if eq .DistanceFilter "500"}} selected{{end}}>500 {{t .server.Lang "severe_weather_distance_unit"}}</option>
                        <option value="0"{{if eq .DistanceFilter "0"}} selected{{end}}>{{t .server.Lang "severe_weather_distance_all"}}</option>
                    </select>
                </div>

                <!-- Second row: Buttons -->
                <div class="moon-form__row">
                    <button type="submit"
                            class="search-button moon-form__button"
                            aria-label="{{t .server.Lang "severe_weather_get_alerts_aria"}}"
                            title="{{t .server.Lang "severe_weather_get_alerts_title"}}">
                        ⚠️ {{t .server.Lang "severe_weather_get_alerts_button"}}
                    </button>
                    <button type="button"
                            id="location-btn"
                            class="search-button moon-form__button--location"
                            aria-label="{{t .server.Lang "severe_weather_my_location_aria"}}"
                            title="{{t .server.Lang "severe_weather_my_location_title"}}">
                        📍 {{t .server.Lang "severe_weather_my_location_button"}}
                    </button>
                </div>
            </div>
        </form>

        {{if .LocationData}}
            {{template "location_details" .LocationData}}

            <!-- Alert Summary -->
            {{/* Calculate actual visible alert count */}}
            {{ $visibleCount := 0 }}
            {{ if .Data.Hurricanes }}{{ $visibleCount = add $visibleCount (len .Data.Hurricanes) }}{{ end }}
            {{ if .Data.TornadoWarnings }}{{ $visibleCount = add $visibleCount (len .Data.TornadoWarnings) }}{{ end }}
            {{ if .Data.SevereStorms }}{{ $visibleCount = add $visibleCount (len .Data.SevereStorms) }}{{ end }}
            {{ if .Data.WinterStorms }}{{ $visibleCount = add $visibleCount (len .Data.WinterStorms) }}{{ end }}
            {{ if .Data.FloodWarnings }}{{ $visibleCount = add $visibleCount (len .Data.FloodWarnings) }}{{ end }}
            {{ if .Data.OtherAlerts }}{{ $visibleCount = add $visibleCount (len .Data.OtherAlerts) }}{{ end }}

            <div class="current-weather">
                <div class="weather-icon">
                    ⚠️
                </div>
                <div class="weather-details">
                    <div class="temperature">
                        {{$visibleCount}} {{if eq $visibleCount 1}}{{t .server.Lang "severe_weather_active_alert_singular"}}{{else}}{{t .server.Lang "severe_weather_active_alert_plural"}}{{end}}
                    </div>
                    <div class="description">
                        {{if .Data.Hurricanes}}{{len .Data.Hurricanes}}{{else}}0{{end}} {{if eq (len .Data.Hurricanes) 1}}{{t .server.Lang "severe_weather_hurricane_tracked_singular"}}{{else}}{{t .server.Lang "severe_weather_hurricane_tracked_plural"}}{{end}}
                    </div>
                    <div class="weather-stats">
                        <div class="stat">{{t .server.Lang "severe_weather_filter_label"}} <span class="stat-value">{{if eq .TypeFilter "all"}}{{t .server.Lang "severe_weather_type_all"}}{{else}}{{.TypeFilter}}{{end}}</span></div>
                        <div class="stat">{{t .server.Lang "severe_weather_distance_label"}} <span class="stat-value">{{if eq .DistanceFilter "0"}}{{t .server.Lang "severe_weather_distance_all"}}{{else}}{{.DistanceFilter}} {{t .server.Lang "severe_weather_distance_unit"}}{{end}}</span></div>
                    </div>
                </div>
            </div>

            {{if .Data}}
                {{/* Hurricanes Section */}}
                {{if .Data.Hurricanes}}
                <div class="alert-section">
                    <div class="section-header">
                        <span class="section-icon">🌀</span>
                        <span class="section-title">{{t .server.Lang "severe_weather_section_hurricanes"}}</span>
                        <span class="section-count">{{len .Data.Hurricanes}}</span>
                    </div>
                    <div class="alerts-grid">
                        {{range .Data.Hurricanes}}
                        {{ $stormClass := "tropical-storm" }}
                        {{ if ge .WindSpeed 157 }}
                            {{ $stormClass = "category-5" }}
                        {{ else if ge .WindSpeed 130 }}
                            {{ $stormClass = "category-4" }}
                        {{ else if ge .WindSpeed 111 }}
                            {{ $stormClass = "category-3" }}
                        {{ else if ge .WindSpeed 96 }}
                            {{ $stormClass = "category-2" }}
                        {{ else if ge .WindSpeed 74 }}
                            {{ $stormClass = "category-1" }}
                        {{ end }}
                        <div class="storm-card {{$stormClass}}">
                            <div class="storm-name">{{.Name}}</div>
                            <div class="storm-category">{{.Intensity}}</div>
                            <div class="storm-details">
                                <div class="storm-detail">
                                    <span class="detail-label">{{t .server.Lang "severe_weather_wind_speed_label"}}</span>
                                    <span class="detail-value">{{.WindSpeed}} mph</span>
                                </div>
                                <div class="storm-detail">
                                    <span class="detail-label">{{t .server.Lang "severe_weather_pressure_label"}}</span>
                                    <span class="detail-value">{{.Pressure}} mb</span>
                                </div>
                                <div class="storm-detail">
                                    <span class="detail-label">{{t .server.Lang "severe_weather_movement_label"}}</span>
                                    <span class="detail-value">{{.Movement}}</span>
                                </div>
                                <div class="storm-detail">
                                    <span class="detail-label">{{t .server.Lang "severe_weather_position_label"}}</span>
                                    <span class="detail-value">{{.Position}}</span>
                                </div>
                            </div>
                            {{if .LastUpdate}}
                            <div class="storm-update">{{t .server.Lang "severe_weather_last_update_label"}} {{.LastUpdate}}</div>
                            {{end}}
                        </div>
                        {{end}}
                    </div>
                </div>
                {{end}}

                {{/* Tornado Warnings */}}
                {{if .Data.TornadoWarnings}}
                <div class="alert-section">
                    <div class="section-header">
                        <span class="section-icon">🌪️</span>
                        <span class="section-title">{{t .server.Lang "severe_weather_section_tornadoes"}}</span>
                        <span class="section-count">{{len .Data.TornadoWarnings}}</span>
                    </div>
                    <div class="alerts-grid">
                        {{range .Data.TornadoWarnings}}
                        {{ $severityClass := "severity-minor" }}
                        {{ if eq .Severity "Extreme" }}
                            {{ $severityClass = "severity-extreme" }}
                        {{ else if eq .Severity "Severe" }}
                            {{ $severityClass = "severity-severe" }}
                        {{ else if eq .Severity "Moderate" }}
                            {{ $severityClass = "severity-moderate" }}
                        {{ end }}
                        <div class="alert-card {{$severityClass}}" data-action="toggle-alert-details">
                            <div class="alert-header">
                                <div class="alert-type">{{.Event}}</div>
                                {{if .DistanceMiles}}
                                <div class="alert-distance">📍 {{printf "%.0f" .DistanceMiles}} mi</div>
                                {{end}}
                            </div>
                            <div class="alert-headline">{{.Headline}}</div>
                            <div class="alert-meta">
                                <span class="alert-severity">{{.Severity}}</span>
                                <span class="alert-urgency">{{.Urgency}}</span>
                                {{if .Country}}
                                <span class="alert-country">{{.Country}}</span>
                                {{end}}
                            </div>
                            <div class="alert-area">{{.AreaDesc}}</div>
                            {{if .Description}}
                            <div class="alert-details display-none">
                                <div class="alert-description">{{.Description}}</div>
                                {{if .Instruction}}
                                <div class="alert-instruction">
                                    <strong>{{t .server.Lang "severe_weather_instructions_label"}}</strong> {{.Instruction}}
                                </div>
                                {{end}}
                            </div>
                            <div class="alert-expand">▼ {{t .server.Lang "severe_weather_click_to_expand"}}</div>
                            {{end}}
                        </div>
                        {{end}}
                    </div>
                </div>
                {{end}}

                {{/* Severe Storms */}}
                {{if .Data.SevereStorms}}
                <div class="alert-section">
                    <div class="section-header">
                        <span class="section-icon">⛈️</span>
                        <span class="section-title">{{t .server.Lang "severe_weather_section_severe_storms"}}</span>
                        <span class="section-count">{{len .Data.SevereStorms}}</span>
                    </div>
                    <div class="alerts-grid">
                        {{range .Data.SevereStorms}}
                        {{ $severityClass := "severity-minor" }}
                        {{ if eq .Severity "Extreme" }}
                            {{ $severityClass = "severity-extreme" }}
                        {{ else if eq .Severity "Severe" }}
                            {{ $severityClass = "severity-severe" }}
                        {{ else if eq .Severity "Moderate" }}
                            {{ $severityClass = "severity-moderate" }}
                        {{ end }}
                        <div class="alert-card {{$severityClass}}" data-action="toggle-alert-details">
                            <div class="alert-header">
                                <div class="alert-type">{{.Event}}</div>
                                {{if .DistanceMiles}}
                                <div class="alert-distance">📍 {{printf "%.0f" .DistanceMiles}} mi</div>
                                {{end}}
                            </div>
                            <div class="alert-headline">{{.Headline}}</div>
                            <div class="alert-meta">
                                <span class="alert-severity">{{.Severity}}</span>
                                <span class="alert-urgency">{{.Urgency}}</span>
                                {{if .Country}}
                                <span class="alert-country">{{.Country}}</span>
                                {{end}}
                            </div>
                            <div class="alert-area">{{.AreaDesc}}</div>
                            {{if .Description}}
                            <div class="alert-details display-none">
                                <div class="alert-description">{{.Description}}</div>
                                {{if .Instruction}}
                                <div class="alert-instruction">
                                    <strong>{{t .server.Lang "severe_weather_instructions_label"}}</strong> {{.Instruction}}
                                </div>
                                {{end}}
                            </div>
                            <div class="alert-expand">▼ {{t .server.Lang "severe_weather_click_to_expand"}}</div>
                            {{end}}
                        </div>
                        {{end}}
                    </div>
                </div>
                {{end}}

                {{/* Winter Storms */}}
                {{if .Data.WinterStorms}}
                <div class="alert-section">
                    <div class="section-header">
                        <span class="section-icon">❄️</span>
                        <span class="section-title">{{t .server.Lang "severe_weather_section_winter"}}</span>
                        <span class="section-count">{{len .Data.WinterStorms}}</span>
                    </div>
                    <div class="alerts-grid">
                        {{range .Data.WinterStorms}}
                        {{ $severityClass := "severity-minor" }}
                        {{ if eq .Severity "Extreme" }}
                            {{ $severityClass = "severity-extreme" }}
                        {{ else if eq .Severity "Severe" }}
                            {{ $severityClass = "severity-severe" }}
                        {{ else if eq .Severity "Moderate" }}
                            {{ $severityClass = "severity-moderate" }}
                        {{ end }}
                        <div class="alert-card {{$severityClass}}" data-action="toggle-alert-details">
                            <div class="alert-header">
                                <div class="alert-type">{{.Event}}</div>
                                {{if .DistanceMiles}}
                                <div class="alert-distance">📍 {{printf "%.0f" .DistanceMiles}} mi</div>
                                {{end}}
                            </div>
                            <div class="alert-headline">{{.Headline}}</div>
                            <div class="alert-meta">
                                <span class="alert-severity">{{.Severity}}</span>
                                <span class="alert-urgency">{{.Urgency}}</span>
                                {{if .Country}}
                                <span class="alert-country">{{.Country}}</span>
                                {{end}}
                            </div>
                            <div class="alert-area">{{.AreaDesc}}</div>
                            {{if .Description}}
                            <div class="alert-details display-none">
                                <div class="alert-description">{{.Description}}</div>
                                {{if .Instruction}}
                                <div class="alert-instruction">
                                    <strong>{{t .server.Lang "severe_weather_instructions_label"}}</strong> {{.Instruction}}
                                </div>
                                {{end}}
                            </div>
                            <div class="alert-expand">▼ {{t .server.Lang "severe_weather_click_to_expand"}}</div>
                            {{end}}
                        </div>
                        {{end}}
                    </div>
                </div>
                {{end}}

                {{/* Flood Warnings */}}
                {{if .Data.FloodWarnings}}
                <div class="alert-section">
                    <div class="section-header">
                        <span class="section-icon">🌊</span>
                        <span class="section-title">{{t .server.Lang "severe_weather_section_floods"}}</span>
                        <span class="section-count">{{len .Data.FloodWarnings}}</span>
                    </div>
                    <div class="alerts-grid">
                        {{range .Data.FloodWarnings}}
                        {{ $severityClass := "severity-minor" }}
                        {{ if eq .Severity "Extreme" }}
                            {{ $severityClass = "severity-extreme" }}
                        {{ else if eq .Severity "Severe" }}
                            {{ $severityClass = "severity-severe" }}
                        {{ else if eq .Severity "Moderate" }}
                            {{ $severityClass = "severity-moderate" }}
                        {{ end }}
                        <div class="alert-card {{$severityClass}}" data-action="toggle-alert-details">
                            <div class="alert-header">
                                <div class="alert-type">{{.Event}}</div>
                                {{if .DistanceMiles}}
                                <div class="alert-distance">📍 {{printf "%.0f" .DistanceMiles}} mi</div>
                                {{end}}
                            </div>
                            <div class="alert-headline">{{.Headline}}</div>
                            <div class="alert-meta">
                                <span class="alert-severity">{{.Severity}}</span>
                                <span class="alert-urgency">{{.Urgency}}</span>
                                {{if .Country}}
                                <span class="alert-country">{{.Country}}</span>
                                {{end}}
                            </div>
                            <div class="alert-area">{{.AreaDesc}}</div>
                            {{if .Description}}
                            <div class="alert-details display-none">
                                <div class="alert-description">{{.Description}}</div>
                                {{if .Instruction}}
                                <div class="alert-instruction">
                                    <strong>{{t .server.Lang "severe_weather_instructions_label"}}</strong> {{.Instruction}}
                                </div>
                                {{end}}
                            </div>
                            <div class="alert-expand">▼ {{t .server.Lang "severe_weather_click_to_expand"}}</div>
                            {{end}}
                        </div>
                        {{end}}
                    </div>
                </div>
                {{end}}

                {{/* Other Alerts */}}
                {{if .Data.OtherAlerts}}
                <div class="alert-section">
                    <div class="section-header">
                        <span class="section-icon">⚠️</span>
                        <span class="section-title">{{t .server.Lang "severe_weather_section_other"}}</span>
                        <span class="section-count">{{len .Data.OtherAlerts}}</span>
                    </div>
                    <div class="alerts-grid">
                        {{range .Data.OtherAlerts}}
                        {{ $severityClass := "severity-minor" }}
                        {{ if eq .Severity "Extreme" }}
                            {{ $severityClass = "severity-extreme" }}
                        {{ else if eq .Severity "Severe" }}
                            {{ $severityClass = "severity-severe" }}
                        {{ else if eq .Severity "Moderate" }}
                            {{ $severityClass = "severity-moderate" }}
                        {{ end }}
                        <div class="alert-card {{$severityClass}}" data-action="toggle-alert-details">
                            <div class="alert-header">
                                <div class="alert-type">{{.Event}}</div>
                                {{if .DistanceMiles}}
                                <div class="alert-distance">📍 {{printf "%.0f" .DistanceMiles}} mi</div>
                                {{end}}
                            </div>
                            <div class="alert-headline">{{.Headline}}</div>
                            <div class="alert-meta">
                                <span class="alert-severity">{{.Severity}}</span>
                                <span class="alert-urgency">{{.Urgency}}</span>
                                {{if .Country}}
                                <span class="alert-country">{{.Country}}</span>
                                {{end}}
                            </div>
                            <div class="alert-area">{{.AreaDesc}}</div>
                            {{if .Description}}
                            <div class="alert-details display-none">
                                <div class="alert-description">{{.Description}}</div>
                                {{if .Instruction}}
                                <div class="alert-instruction">
                                    <strong>{{t .server.Lang "severe_weather_instructions_label"}}</strong> {{.Instruction}}
                                </div>
                                {{end}}
                            </div>
                            <div class="alert-expand">▼ {{t .server.Lang "severe_weather_click_to_expand"}}</div>
                            {{end}}
                        </div>
                        {{end}}
                    </div>
                </div>
                {{end}}

                {{/* No alerts message */}}
                {{if not .Data.Hurricanes}}{{if not .Data.TornadoWarnings}}{{if not .Data.SevereStorms}}{{if not .Data.WinterStorms}}{{if not .Data.FloodWarnings}}{{if not .Data.OtherAlerts}}
                <div class="welcome-section">
                    <h2 class="welcome-section__title">✅ {{t .server.Lang "severe_weather_no_alerts_title"}}</h2>
                    <p>{{t .server.Lang "severe_weather_no_alerts_message"}}</p>
                </div>
                {{end}}{{end}}{{end}}{{end}}{{end}}{{end}}
            {{else}}
                <div class="welcome-section">
                    <h2 class="welcome-section__title">✅ {{t .server.Lang "severe_weather_no_alerts_title"}}</h2>
                    <p>{{t .server.Lang "severe_weather_no_alerts_message"}}</p>
                </div>
            {{end}}

            <!-- Console Command Examples -->
            <div class="console-section">
                <h3 class="console-section__title">{{t .server.Lang "severe_weather_console_access_title"}}</h3>
                <div class="console-commands">
                    <div class="command-item">
                        <strong class="console-section__label">{{t .server.Lang "severe_weather_console_label_severe"}}</strong>
                        <div class="code-wrapper">
                            <code class="mobile-code">curl -q -LSs {{.HostInfo.FullHost}}/severe-weather/{{.LocationData.Location.NameEncoded}}</code>
                            <button class="copy-btn" data-action="copy-command" data-text="curl -q -LSs {{.HostInfo.FullHost}}/severe-weather/{{.LocationData.Location.NameEncoded}}">{{t .server.Lang "btn_copy"}}</button>
                        </div>
                    </div>
                    <div class="command-item">
                        <strong class="console-section__label">{{t .server.Lang "severe_weather_console_label_json"}}</strong>
                        <div class="code-wrapper">
                            <code class="mobile-code">curl -q -LSs {{.HostInfo.FullHost}}/api/v1/severe-weather?location={{.LocationData.Location.NameEncoded}}</code>
                            <button class="copy-btn" data-action="copy-command" data-text="curl -q -LSs {{.HostInfo.FullHost}}/api/v1/severe-weather?location={{.LocationData.Location.NameEncoded}}">{{t .server.Lang "btn_copy"}}</button>
                        </div>
                    </div>
                </div>
            </div>
        {{else}}
            <div class="welcome-section">
                <h2 class="welcome-section__title">⚠️ {{t .server.Lang "severe_weather_welcome_title"}}</h2>
                <p>{{t .server.Lang "severe_weather_welcome_subtitle"}}</p>
                <div class="city-links-grid">
                    <a href="?location=Miami" class="city-link">🌴 {{t .server.Lang "severe_weather_city_miami"}}</a>
                    <a href="?location=Houston" class="city-link">🤠 {{t .server.Lang "severe_weather_city_houston"}}</a>
                    <a href="?location=New+Orleans" class="city-link">🎺 {{t .server.Lang "severe_weather_city_new_orleans"}}</a>
                    <a href="?location=Tampa" class="city-link">⚡ {{t .server.Lang "severe_weather_city_tampa"}}</a>
                </div>
            </div>
        {{end}}

    </div>

    <script>
        // Path variables - SPEC compliant (AI.md PART 13)
        const API_PATH = '{{.api_path}}';

        // Form handling for severe weather page
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.getElementById('severe-weather-form');
            const locationInput = document.getElementById('location-input');
            const typeSelect = document.getElementById('type-select');
            const distanceSelect = document.getElementById('distance-select');
            const locationBtn = document.getElementById('location-btn');

            // Handle form submission
            if (form) {
                form.addEventListener('submit', function(e) {
                    e.preventDefault();
                    updateLocation();
                });
            }

            // Auto-reload when distance or type changes
            if (typeSelect) {
                typeSelect.addEventListener('change', function() {
                    updateLocation();
                });
            }

            if (distanceSelect) {
                distanceSelect.addEventListener('change', function() {
                    updateLocation();
                });
            }

            // Handle My Location button
            if (locationBtn) {
                locationBtn.addEventListener('click', async function() {
                    const originalText = this.textContent;
                    this.disabled = true;
                    this.textContent = '📍 {{t .server.Lang "severe_weather_getting_location_button"}}';

                    try {
                        const position = await new Promise((resolve, reject) => {
                            navigator.geolocation.getCurrentPosition(resolve, reject, {
                                timeout: 10000,
                                enableHighAccuracy: true
                            });
                        });

                        const lat = position.coords.latitude.toFixed(4);
                        const lon = position.coords.longitude.toFixed(4);
                        locationInput.value = `${lat},${lon}`;

                        this.textContent = '📍 {{t .server.Lang "severe_weather_location_found_button"}}';
                        setTimeout(() => {
                            updateLocation();
                        }, 500);
                    } catch (error) {
                        // Fallback to IP detection
                        fetch('/debug/ip')
                            .then(response => response.json())
                            .then(data => {
                                if (data.location && data.location.value) {
                                    locationInput.value = data.location.value;
                                    this.textContent = '📍 {{t .server.Lang "severe_weather_location_found_button"}}';
                                    setTimeout(() => {
                                        updateLocation();
                                    }, 500);
                                } else {
                                    throw new Error('No location');
                                }
                            })
                            .catch(() => {
                                this.textContent = originalText;
                                this.disabled = false;
                                showAlert('{{t .server.Lang "severe_weather_location_error_message"}}');
                            });
                    }
                });
            }

            // Autocomplete functionality
            let autocompleteTimeout;
            if (locationInput) {
                locationInput.addEventListener('input', function(e) {
                    clearTimeout(autocompleteTimeout);
                    const query = e.target.value.trim();
                    if (query.length < 2) {
                        hideAutocomplete();
                        return;
                    }
                    autocompleteTimeout = setTimeout(() => {
                        searchLocations(query);
                    }, 300);
                });

                // Hide autocomplete when clicking outside
                document.addEventListener('click', function(e) {
                    if (!e.target.closest('#location-input') && !e.target.closest('#severe-autocomplete-dropdown')) {
                        hideAutocomplete();
                    }
                });
            }
        });

        function updateLocation() {
            const location = document.getElementById('location-input').value.trim();
            const type = document.getElementById('type-select').value;
            const distance = document.getElementById('distance-select').value;

            if (!location) {
                window.location.href = `${window.location.origin}/severe-weather`;
                return;
            }

            const cleanLocation = location.replace(/ /g, '+');
            const params = [];
            if (type !== 'all') params.push(`type=${type}`);
            if (distance !== '50') params.push(`distance=${distance}`);
            const queryString = params.length > 0 ? '?' + params.join('&') : '';

            window.location.href = `${window.location.origin}/severe-weather/${cleanLocation}${queryString}`;
        }

        function searchLocations(query) {
            fetch(`${API_PATH}/search?q=${encodeURIComponent(query)}`)
                .then(response => response.json())
                .then(data => {
                    if (data.results && data.results.length > 0) {
                        showAutocomplete(data.results);
                    } else {
                        hideAutocomplete();
                    }
                })
                .catch(err => {
                    console.error('Autocomplete error:', err);
                    hideAutocomplete();
                });
        }

        function showAutocomplete(results) {
            const dropdown = document.getElementById('severe-autocomplete-dropdown');
            dropdown.innerHTML = '';

            results.forEach(result => { // Show all results (scrollable dropdown)
                const item = document.createElement('div');
                item.className = 'autocomplete-item';

                const locationName = result.admin1
                    ? `${result.name}, ${result.admin1}, ${result.countryCode}`
                    : `${result.name}, ${result.countryCode}`;

                item.innerHTML = `
                    <span class="autocomplete-item city-name">${result.name}</span>
                    <span class="autocomplete-item location-details">${result.admin1 ? result.admin1 + ', ' : ''}${result.countryCode}</span>
                `;

                item.addEventListener('click', function() {
                    // Use coordinates for navigation (more accurate)
                    const coords = `${result.latitude.toFixed(4)},${result.longitude.toFixed(4)}`;
                    document.getElementById('location-input').value = coords;
                    hideAutocomplete();
                    updateLocation();
                });

                dropdown.appendChild(item);
            });

            dropdown.classList.add('autocomplete-dropdown-visible');
        }

        function hideAutocomplete() {
            const dropdown = document.getElementById('severe-autocomplete-dropdown');
            if (dropdown) {
                dropdown.classList.remove('autocomplete-dropdown-visible');
                dropdown.innerHTML = '';
            }
        }

        // Initialize notification polling
        if (typeof Notifications !== 'undefined') {
            Notifications.startPolling(30000);
        }
    </script>

{{if not .HideFooter}}
{{template "footer" .}}
{{else}}
</body>
</html>
{{end}}
