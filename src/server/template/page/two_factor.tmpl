{{define "page/two_factor.tmpl"}}
<!DOCTYPE html>
<html lang="en" class="{{if .server.ThemeClass}}{{.server.ThemeClass}}{{else}}theme-dark{{end}}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{.title}}</title>
    <link rel="stylesheet" href="/static/css/common.css">
    <link rel="stylesheet" href="/static/css/components.css">
    <link rel="stylesheet" href="/static/css/public.css">
</head>
<body>
    <div class="auth-container">
        <div class="auth-card">
            <h1>{{t .server.Lang "two_factor_title"}}</h1>
            <p>{{t .server.Lang "two_factor_subtitle"}}</p>

            {{if .error}}
            <div class="alert alert-error">{{.error}}</div>
            {{end}}

            <form method="POST" class="auth-form">
                <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
                <div class="form-group">
                    <label for="code">{{t .server.Lang "two_factor_code_label"}}</label>
                    <input type="text" id="code" name="code" required autocomplete="one-time-code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" placeholder="000000">
                </div>
                <button type="submit" class="btn btn-primary">{{t .server.Lang "two_factor_verify_button"}}</button>
            </form>

            <div class="auth-links">
                <a href="/server/auth/recovery/use">{{t .server.Lang "two_factor_use_recovery_key"}}</a>
                <a href="/server/auth/login">{{t .server.Lang "two_factor_back_to_login"}}</a>
            </div>
        </div>
    </div>
</body>
</html>
{{end}}
