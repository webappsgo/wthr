{{define "page/recovery_key.tmpl"}}
<!DOCTYPE html>
<html lang="{{if .server.Lang}}{{.server.Lang}}{{else}}en{{end}}" dir="{{if eq (printf "%v" .server.Lang) "ar"}}rtl{{else}}ltr{{end}}" class="{{if .server.ThemeClass}}{{.server.ThemeClass}}{{else}}theme-dark{{end}}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{.title}}</title>
    <link rel="stylesheet" href="{{asset "/static/css/common.css"}}">
    <link rel="stylesheet" href="{{asset "/static/css/components.css"}}">
    <link rel="stylesheet" href="{{asset "/static/css/public.css"}}">
</head>
<body>
{{template "header" .}}
{{template "navbar" .}}
<main id="main-content" role="main">
    <div class="auth-container">
        <div class="auth-card">
            <h1>{{t .server.Lang "recovery.key_page_heading"}}</h1>
            <p>{{t .server.Lang "recovery.key_page_subtitle"}}</p>

            {{if .error}}
            <div class="alert alert-error">{{.error}}</div>
            {{end}}

            <form method="POST" class="auth-form">
                <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
                <div class="form-group">
                    <label for="recovery_key">{{t .server.Lang "recovery.key_field_label"}}</label>
                    <input type="text" id="recovery_key" name="recovery_key" required autocomplete="off" placeholder="{{t .server.Lang "recovery.key_field_placeholder"}}">
                </div>
                <button type="submit" class="btn btn-primary">{{t .server.Lang "recovery.key_submit_button"}}</button>
            </form>

            <div class="auth-links">
                <a href="/server/auth/login">{{t .server.Lang "oidc.back_to_login_link"}}</a>
            </div>
        </div>
    </div>
</main>
{{template "footer" .}}

{{end}}
