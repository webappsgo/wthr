<!DOCTYPE html>
<html lang="en" class="{{if .server.ThemeClass}}{{.server.ThemeClass}}{{else}}theme-dark{{end}}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>🌍 {{t .server.Lang "earthquake_page_title"}}</title>
    <link rel="stylesheet" href="/static/css/common.css">
    <link rel="stylesheet" href="/static/css/components.css">
    <link rel="stylesheet" href="/static/css/public.css">
    <script src="/static/js/app.js" defer></script>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
</head>
<body>
    {{template "navbar" .}}

    <div class="weather-container">

        <!-- Location Search Form -->
        <form id="earthquake-form" class="search-form" role="form" aria-label="{{t .server.Lang "earthquake_search_filters_aria"}}">
    <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
            <div class="search-row-single flex-column-mobile">
                <input
                    type="text"
                    name="location"
                    id="eq-location-input"
                    class="location-input flex-1"
                    placeholder="🔍 {{t .server.Lang "earthquake_search_placeholder"}}"
                    value="{{if .Location}}{{.Location}}{{end}}"
                    autocomplete="off"
                    aria-label="{{t .server.Lang "earthquake_search_aria"}}"
                    title="{{t .server.Lang "earthquake_search_title"}}"
                >
            </div>

            <div class="search-row flex-column-mobile">
                <select name="feed"
                        class="select-input flex-1"
                        aria-label="{{t .server.Lang "earthquake_feed_select_aria"}}"
                        title="{{t .server.Lang "earthquake_feed_select_title"}}">
                    <option value="all_hour" {{if eq .FeedType "all_hour"}}selected{{end}}>{{t .server.Lang "earthquake_feed_past_hour"}}</option>
                    <option value="all_day" {{if eq .FeedType "all_day"}}selected{{end}}>{{t .server.Lang "earthquake_feed_past_day"}}</option>
                    <option value="all_week" {{if eq .FeedType "all_week"}}selected{{end}}>{{t .server.Lang "earthquake_feed_past_week"}}</option>
                    <option value="all_month" {{if eq .FeedType "all_month"}}selected{{end}}>{{t .server.Lang "earthquake_feed_past_month"}}</option>
                    <option value="4.5_day" {{if eq .FeedType "4.5_day"}}selected{{end}}>{{t .server.Lang "earthquake_feed_m45_day"}}</option>
                    <option value="4.5_week" {{if eq .FeedType "4.5_week"}}selected{{end}}>{{t .server.Lang "earthquake_feed_m45_week"}}</option>
                    <option value="significant_day" {{if eq .FeedType "significant_day"}}selected{{end}}>{{t .server.Lang "earthquake_feed_significant_day"}}</option>
                    <option value="significant_week" {{if eq .FeedType "significant_week"}}selected{{end}}>{{t .server.Lang "earthquake_feed_significant_week"}}</option>
                </select>
                <select name="sort"
                        class="select-input flex-1"
                        aria-label="{{t .server.Lang "earthquake_sort_aria"}}"
                        title="{{t .server.Lang "earthquake_sort_title"}}">
                    <option value="newest" {{if or (eq .SortBy "newest") (not .SortBy)}}selected{{end}}>{{t .server.Lang "earthquake_sort_newest"}}</option>
                    <option value="oldest" {{if eq .SortBy "oldest"}}selected{{end}}>{{t .server.Lang "earthquake_sort_oldest"}}</option>
                    <option value="magnitude" {{if eq .SortBy "magnitude"}}selected{{end}}>{{t .server.Lang "earthquake_sort_magnitude"}}</option>
                    <option value="depth" {{if eq .SortBy "depth"}}selected{{end}}>{{t .server.Lang "earthquake_sort_depth"}}</option>
                    {{if .HasUserLocation}}
                    <option value="closest" {{if eq .SortBy "closest"}}selected{{end}}>{{t .server.Lang "earthquake_sort_closest"}}</option>
                    {{end}}
                </select>
                <input
                    type="number"
                    name="number"
                    placeholder="{{t .server.Lang "earthquake_limit_placeholder"}}"
                    min="0"
                    value="{{if .Number}}{{.Number}}{{end}}"
                    class="location-input flex-1"
                    aria-label="{{t .server.Lang "earthquake_limit_aria"}}"
                    title="{{t .server.Lang "earthquake_limit_title"}}"
                >
            </div>

            {{if .Location}}
            <div class="search-row-single">
                <input
                    type="number"
                    name="radius"
                    placeholder="{{t .server.Lang "earthquake_radius_placeholder"}}"
                    value="{{if .Radius}}{{.Radius}}{{end}}"
                    min="100"
                    max="20000"
                    class="location-input"
                    aria-label="{{t .server.Lang "earthquake_radius_aria"}}"
                    title="{{t .server.Lang "earthquake_radius_title"}}"
                >
            </div>
            {{end}}

            <div class="search-row-single">
                <button type="submit"
                        class="search-button primary flex-1"
                        aria-label="{{t .server.Lang "earthquake_search_submit_aria"}}"
                        title="{{t .server.Lang "earthquake_search_submit_title"}}">
                    🌍 {{t .server.Lang "earthquake_search_submit_label"}}
                </button>
                {{if .Location}}
                <button type="button"
                        class="search-button secondary flex-1"
                        data-action="navigate"
                        data-href="/earthquake?feed={{.FeedType}}"
                        aria-label="{{t .server.Lang "earthquake_view_all_aria"}}"
                        title="{{t .server.Lang "earthquake_view_all_title"}}">
                    🗺️ {{t .server.Lang "earthquake_view_all_label"}}
                </button>
                {{end}}
            </div>
        </form>

        {{if .LocationData}}
            {{template "location_details" .LocationData}}
        {{end}}

        <!-- Statistics -->
        <div class="grid-auto-fit-200 margin-y-lg">
            <div class="stat-box">
                <div class="stat-box__value stat-box__value--cyan">{{len .Earthquakes}}</div>
                <div class="stat-box__label">{{t .server.Lang "earthquake_stat_total"}}</div>
            </div>
            <div class="stat-box">
                {{ $maxMag := 0.0 }}
                {{range .Earthquakes}}
                    {{if gt .Magnitude $maxMag}}{{$maxMag = .Magnitude}}{{end}}
                {{end}}
                <div class="stat-box__value stat-box__value--orange">{{printf "%.1f" $maxMag}}</div>
                <div class="stat-box__label">{{t .server.Lang "earthquake_stat_largest_magnitude"}}</div>
            </div>
            <div class="stat-box">
                {{ $tsunami := 0 }}
                {{range .Earthquakes}}
                    {{if eq .Tsunami 1}}{{$tsunami = 1}}{{end}}
                {{end}}
                <div class="stat-box__value stat-box__value--purple">{{if gt $tsunami 0}}⚠️{{else}}✓{{end}}</div>
                <div class="stat-box__label">{{t .server.Lang "earthquake_stat_tsunami_warnings"}}</div>
            </div>
        </div>

        <!-- Interactive Map -->
        <div id="map" class="map-container"></div>

        <!-- Earthquake List -->
        <div class="margin-y-lg">
            <h2 class="text-cyan">{{t .server.Lang "earthquake_recent_heading"}}</h2>
            <div class="scroll-container">
                {{range .Earthquakes}}
                {{ $severity := "earthquake-item--moderate" }}
                {{ if eq .Tsunami 1 }}
                    {{ $severity = "earthquake-item--tsunami" }}
                {{ else if lt .Magnitude 2.0 }}
                    {{ $severity = "earthquake-item--minor" }}
                {{ else if lt .Magnitude 4.0 }}
                    {{ $severity = "earthquake-item--light" }}
                {{ else if lt .Magnitude 5.0 }}
                    {{ $severity = "earthquake-item--moderate" }}
                {{ else }}
                    {{ $severity = "earthquake-item--strong" }}
                {{ end }}

                {{ $badge := "magnitude-badge--moderate" }}
                {{ if lt .Magnitude 2.0 }}
                    {{ $badge = "magnitude-badge--minor" }}
                {{ else if lt .Magnitude 4.0 }}
                    {{ $badge = "magnitude-badge--light" }}
                {{ else if lt .Magnitude 5.0 }}
                    {{ $badge = "magnitude-badge--moderate" }}
                {{ else if lt .Magnitude 6.0 }}
                    {{ $badge = "magnitude-badge--strong" }}
                {{ else }}
                    {{ $badge = "magnitude-badge--major" }}
                {{ end }}

                <div data-action="earthquake-item" data-lat="{{.Latitude}}" data-lng="{{.Longitude}}" class="earthquake-item {{$severity}}">
                    <div class="flex gap-md flex-column-mobile">
                        <span class="magnitude-badge {{$badge}}">
                            {{printf "%.1f" .Magnitude}}
                        </span>
                        <div class="flex-1">
                            <div class="font-semibold">{{.Place}}</div>
                            {{if eq .Tsunami 1}}<span class="text-cyan font-semibold">🌊 {{t $.server.Lang "earthquake_tsunami_badge"}}</span>{{end}}
                            <div class="eq-info">
                                {{.Time.Format "2006-01-02 15:04:05"}} • {{t $.server.Lang "earthquake_depth_label"}} {{printf "%.1f" .Depth}}km
                                {{if .DistanceFmt}} • <span class="text-cyan">📍 {{.DistanceFmt}} {{t $.server.Lang "earthquake_away_label"}}</span>{{end}}
                                {{if .Felt}} • {{t $.server.Lang "earthquake_felt_by_label"}} {{.Felt}} {{t $.server.Lang "earthquake_detail_felt_people"}}{{end}}
                            </div>
                            <div class="eq-details">
                                <div><strong>{{t $.server.Lang "earthquake_coordinates_label"}}:</strong> {{.Latitude}}, {{.Longitude}}</div>
                                <div><strong>{{t $.server.Lang "earthquake_detail_type_label"}}:</strong> {{.MagnitudeType}} {{.Type}}</div>
                                <div><strong>{{t $.server.Lang "earthquake_detail_status_label"}}:</strong> {{.Status}}</div>
                                {{if .CDI}}<div><strong>CDI:</strong> {{printf "%.1f" .CDI}}</div>{{end}}
                                {{if .MMI}}<div><strong>MMI:</strong> {{printf "%.1f" .MMI}}</div>{{end}}
                            </div>
                        </div>
                        <a href="/earthquake/detail/{{.ID}}" data-action="stop-propagation" class="text-cyan font-medium">{{t $.server.Lang "earthquake_details_link"}} →</a>
                    </div>
                </div>
                {{else}}
                <p class="text-center text-comment margin-y-lg">{{t .server.Lang "earthquake_none_found"}}</p>
                {{end}}
            </div>
        </div>

        {{if .Earthquakes}}
        <!-- Console Commands -->
        <div class="console-section">
            <h3 class="console-section__title text-green">📟 {{t .server.Lang "earthquake_console_heading"}}</h3>
            <div class="console-commands">
                <div class="command-item">
                    <strong class="console-section__label">{{t .server.Lang "earthquake_console_all_label"}}</strong>
                    <div class="code-wrapper">
                        <code class="mobile-code">curl -s {{.HostInfo.FullHost}}/api/v1/earthquakes?feed={{.FeedType}}</code>
                        <button class="copy-btn" data-action="copy-command" data-text="curl -s {{.HostInfo.FullHost}}/api/v1/earthquakes?feed={{.FeedType}}">{{t .server.Lang "admin.tor.copy_action"}}</button>
                    </div>
                </div>
                {{if .Location}}
                <div class="command-item">
                    <strong class="console-section__label">{{t .server.Lang "earthquake_console_selected_feed_label"}}</strong>
                    <div class="code-wrapper">
                        <code class="mobile-code">curl -s {{.HostInfo.FullHost}}/api/v1/earthquakes?feed={{.FeedType}}</code>
                        <button class="copy-btn" data-action="copy-command" data-text="curl -s {{.HostInfo.FullHost}}/api/v1/earthquakes?feed={{.FeedType}}">{{t .server.Lang "admin.tor.copy_action"}}</button>
                    </div>
                </div>
                {{end}}
            </div>
        </div>
        {{end}}

        <div class="data-footer">
            <p class="data-footer__text">
                {{t .server.Lang "earthquake_data_from"}} <a href="https://earthquake.usgs.gov/" target="_blank" class="data-footer__link">{{t .server.Lang "earthquake_detail_usgs_program"}}</a><br>
                {{t .server.Lang "earthquake_detail_updated_frequently"}}
            </p>
        </div>
    </div>

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script type="application/json" id="earthquake-page-data">
    {"centerLat": {{.CenterLat}}, "centerLon": {{.CenterLon}}, "hasLocation": {{if .Location}}true{{else}}false{{end}}, "earthquakes": [{{range $i, $e := .Earthquakes}}{{if $i}},{{end}}{"lat": {{$e.Latitude}}, "lng": {{$e.Longitude}}, "mag": {{$e.Magnitude}}, "place": {{$e.Place | printf "%q"}}, "time": {{$e.Time.Format "2006-01-02 15:04:05" | printf "%q"}}, "depth": {{$e.Depth}}, "tsunami": {{$e.Tsunami}}, "url": {{$e.URL | printf "%q"}}}{{end}}]}
    </script>

{{template "footer" .}}
