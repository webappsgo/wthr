{{define "page/user_invite.tmpl"}}
<!DOCTYPE html>
<html lang="en" class="{{if .server.ThemeClass}}{{.server.ThemeClass}}{{else}}theme-dark{{end}}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{.title}}</title>
    <link rel="stylesheet" href="/static/css/common.css">
    <link rel="stylesheet" href="/static/css/components.css">
    <link rel="stylesheet" href="/static/css/public.css">
</head>
<body>
    <div class="auth-container">
        <div class="auth-card">
            <h1>{{t .server.Lang "user_invite_heading"}}</h1>
            <p>{{t .server.Lang "user_invite_subtitle"}}</p>

            {{if .error}}
            <div class="alert alert-error">{{.error}}</div>
            {{end}}

            <form method="POST" class="auth-form">
                <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
                <input type="hidden" name="code" value="{{.code}}">
                <div class="form-group">
                    <label for="username">{{t .server.Lang "user_invite_username_label"}}</label>
                    <input type="text" id="username" name="username" required autocomplete="username" placeholder="{{t .server.Lang "user_invite_username_placeholder"}}" value="{{.username}}">
                </div>
                <div class="form-group">
                    <label for="email">{{t .server.Lang "user_invite_email_label"}}</label>
                    <input type="email" id="email" value="{{.email}}" readonly disabled>
                </div>
                {{if .role}}
                <p class="auth-subtitle">{{t .server.Lang "user_invite_role_label"}} {{.role}}</p>
                {{end}}
                {{if .expires_at}}
                <p class="auth-subtitle">{{t .server.Lang "user_invite_expires_label"}} {{.expires_at}}.</p>
                {{end}}
                <div class="form-group">
                    <label for="password">{{t .server.Lang "user_invite_password_label"}}</label>
                    <input type="password" id="password" name="password" required autocomplete="new-password" placeholder="{{t .server.Lang "user_invite_password_placeholder"}}">
                </div>
                <div class="form-group">
                    <label for="confirm_password">{{t .server.Lang "user_invite_confirm_password_label"}}</label>
                    <input type="password" id="confirm_password" name="confirm_password" required autocomplete="new-password" placeholder="{{t .server.Lang "user_invite_confirm_password_placeholder"}}">
                </div>
                <button type="submit" class="btn btn-primary">{{t .server.Lang "user_invite_submit"}}</button>
            </form>

            <div class="auth-links">
                <a href="/server/auth/login">{{t .server.Lang "user_invite_back_to_login"}}</a>
            </div>
        </div>
    </div>
</body>
</html>
{{end}}
