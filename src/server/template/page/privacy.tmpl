{{template "head" .}}

{{template "navbar" .}}

<div class="weather-container">
    <h1 class="text-purple">{{t .server.Lang "privacy.page_heading"}}</h1>

    <div class="card margin-y-lg">
        <h2 class="text-cyan">{{t .server.Lang "privacy.data_collection_heading"}}</h2>
        <p>{{t .server.Lang "privacy.data_collection_intro"}}</p>
        <ul>
            <li><strong>{{t .server.Lang "privacy.account_info_label"}}</strong> {{t .server.Lang "privacy.account_info_text"}}</li>
            <li><strong>{{t .server.Lang "privacy.location_data_label"}}</strong> {{t .server.Lang "privacy.location_data_text"}}</li>
            <li><strong>{{t .server.Lang "privacy.usage_data_label"}}</strong> {{t .server.Lang "privacy.usage_data_text"}}</li>
            <li><strong>{{t .server.Lang "privacy.technical_data_label"}}</strong> {{t .server.Lang "privacy.technical_data_text"}}</li>
        </ul>
    </div>

    <div class="card margin-y-lg">
        <h2 class="text-cyan">{{t .server.Lang "privacy.data_use_heading"}}</h2>
        <p>{{t .server.Lang "privacy.data_use_intro"}}</p>
        <ul>
            <li>{{t .server.Lang "privacy.data_use_weather"}}</li>
            <li>{{t .server.Lang "privacy.data_use_alerts"}}</li>
            <li>{{t .server.Lang "privacy.data_use_quality"}}</li>
            <li>{{t .server.Lang "privacy.data_use_security"}}</li>
            <li>{{t .server.Lang "privacy.data_use_support"}}</li>
        </ul>
    </div>

    <div class="card margin-y-lg">
        <h2 class="text-cyan">{{t .server.Lang "privacy.data_retention_heading"}}</h2>
        <p>{{t .server.Lang "privacy.data_retention_intro"}}</p>
        <ul>
            <li><strong>{{t .server.Lang "privacy.account_data_label"}}</strong> {{t .server.Lang "privacy.account_data_text"}}</li>
            <li><strong>{{t .server.Lang "privacy.access_logs_label"}}</strong> {{t .server.Lang "privacy.access_logs_text"}}</li>
            <li><strong>{{t .server.Lang "privacy.audit_logs_label"}}</strong> {{t .server.Lang "privacy.audit_logs_text"}}</li>
            <li><strong>{{t .server.Lang "privacy.weather_data_label"}}</strong> {{t .server.Lang "privacy.weather_data_text"}}</li>
        </ul>
    </div>

    <div class="card margin-y-lg">
        <h2 class="text-cyan">{{t .server.Lang "privacy.third_party_heading"}}</h2>
        <p>{{t .server.Lang "privacy.third_party_intro"}}</p>
        <ul>
            <li><strong>{{t .server.Lang "privacy.open_meteo_label"}}</strong> {{t .server.Lang "privacy.open_meteo_text"}}</li>
            <li><strong>{{t .server.Lang "privacy.usgs_label"}}</strong> {{t .server.Lang "privacy.usgs_text"}}</li>
            <li><strong>{{t .server.Lang "privacy.geoip_label"}}</strong> {{t .server.Lang "privacy.geoip_text"}}</li>
        </ul>
        <p>{{t .server.Lang "privacy.third_party_disclaimer"}}</p>
    </div>

    <div class="card margin-y-lg">
        <h2 class="text-cyan">{{t .server.Lang "privacy.cookies_heading"}}</h2>
        <p>{{t .server.Lang "privacy.cookies_intro"}}</p>
        <ul>
            <li><strong>{{t .server.Lang "privacy.session_cookie_label"}}</strong> {{t .server.Lang "privacy.session_cookie_text"}}</li>
            <li><strong>{{t .server.Lang "privacy.csrf_token_label"}}</strong> {{t .server.Lang "privacy.csrf_token_text"}}</li>
            <li><strong>{{t .server.Lang "privacy.preferences_label"}}</strong> {{t .server.Lang "privacy.preferences_text"}}</li>
        </ul>
        <p>{{t .server.Lang "privacy.cookies_disclaimer"}}</p>
    </div>

    <div class="card margin-y-lg">
        <h2 class="text-cyan">{{t .server.Lang "privacy.your_rights_heading"}}</h2>
        <p>{{t .server.Lang "privacy.your_rights_intro"}}</p>
        <ul>
            <li><strong>{{t .server.Lang "privacy.right_access_label"}}</strong> {{t .server.Lang "privacy.right_access_text"}}</li>
            <li><strong>{{t .server.Lang "privacy.right_export_label"}}</strong> {{t .server.Lang "privacy.right_export_text"}}</li>
            <li><strong>{{t .server.Lang "privacy.right_modify_label"}}</strong> {{t .server.Lang "privacy.right_modify_text"}}</li>
            <li><strong>{{t .server.Lang "privacy.right_delete_label"}}</strong> {{t .server.Lang "privacy.right_delete_text"}}</li>
            <li><strong>{{t .server.Lang "privacy.right_optout_label"}}</strong> {{t .server.Lang "privacy.right_optout_text"}}</li>
        </ul>
        <p>{{t .server.Lang "privacy.rights_access_prefix"}} <a href="/users/profile" class="text-cyan">{{t .server.Lang "privacy.profile_page_link"}}</a>.</p>
    </div>

    <div class="card margin-y-lg">
        <h2 class="text-cyan">{{t .server.Lang "privacy.security_heading"}}</h2>
        <p>{{t .server.Lang "privacy.security_intro"}}</p>
        <ul>
            <li>{{t .server.Lang "privacy.security_encrypted"}}</li>
            <li>{{t .server.Lang "privacy.security_argon2id"}}</li>
            <li>{{t .server.Lang "privacy.security_csrf"}}</li>
            <li>{{t .server.Lang "privacy.security_rate_limiting"}}</li>
            <li>{{t .server.Lang "privacy.security_audits"}}</li>
        </ul>
    </div>

    <div class="card margin-y-lg">
        <h2 class="text-cyan">{{t .server.Lang "privacy.contact_heading"}}</h2>
        <p>{{t .server.Lang "privacy.contact_intro"}}</p>
        <div class="margin-y-md">
            <a href="/server/contact" class="btn btn-primary">{{t .server.Lang "privacy.contact_form_link"}}</a>
        </div>
    </div>

    <div class="card margin-y-lg">
        <p class="text-comment"><small>{{t .server.Lang "privacy.last_updated_label"}} {{.server.BuildDate}}</small></p>
    </div>
</div>

{{template "footer" .}}
