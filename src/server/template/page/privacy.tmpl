{{template "head" .}}

{{template "navbar" .}}

<div class="weather-container">
    <h1 class="text-purple">{{t .server.Lang "privacy_page_heading"}}</h1>

    <div class="card margin-y-lg">
        <h2 class="text-cyan">{{t .server.Lang "privacy_data_collection_heading"}}</h2>
        <p>{{t .server.Lang "privacy_data_collection_intro"}}</p>
        <ul>
            <li><strong>{{t .server.Lang "privacy_account_info_label"}}</strong> {{t .server.Lang "privacy_account_info_text"}}</li>
            <li><strong>{{t .server.Lang "privacy_location_data_label"}}</strong> {{t .server.Lang "privacy_location_data_text"}}</li>
            <li><strong>{{t .server.Lang "privacy_usage_data_label"}}</strong> {{t .server.Lang "privacy_usage_data_text"}}</li>
            <li><strong>{{t .server.Lang "privacy_technical_data_label"}}</strong> {{t .server.Lang "privacy_technical_data_text"}}</li>
        </ul>
    </div>

    <div class="card margin-y-lg">
        <h2 class="text-cyan">{{t .server.Lang "privacy_data_use_heading"}}</h2>
        <p>{{t .server.Lang "privacy_data_use_intro"}}</p>
        <ul>
            <li>{{t .server.Lang "privacy_data_use_weather"}}</li>
            <li>{{t .server.Lang "privacy_data_use_alerts"}}</li>
            <li>{{t .server.Lang "privacy_data_use_quality"}}</li>
            <li>{{t .server.Lang "privacy_data_use_security"}}</li>
            <li>{{t .server.Lang "privacy_data_use_support"}}</li>
        </ul>
    </div>

    <div class="card margin-y-lg">
        <h2 class="text-cyan">{{t .server.Lang "privacy_data_retention_heading"}}</h2>
        <p>{{t .server.Lang "privacy_data_retention_intro"}}</p>
        <ul>
            <li><strong>{{t .server.Lang "privacy_account_data_label"}}</strong> {{t .server.Lang "privacy_account_data_text"}}</li>
            <li><strong>{{t .server.Lang "privacy_access_logs_label"}}</strong> {{t .server.Lang "privacy_access_logs_text"}}</li>
            <li><strong>{{t .server.Lang "privacy_audit_logs_label"}}</strong> {{t .server.Lang "privacy_audit_logs_text"}}</li>
            <li><strong>{{t .server.Lang "privacy_weather_data_label"}}</strong> {{t .server.Lang "privacy_weather_data_text"}}</li>
        </ul>
    </div>

    <div class="card margin-y-lg">
        <h2 class="text-cyan">{{t .server.Lang "privacy_third_party_heading"}}</h2>
        <p>{{t .server.Lang "privacy_third_party_intro"}}</p>
        <ul>
            <li><strong>{{t .server.Lang "privacy_open_meteo_label"}}</strong> {{t .server.Lang "privacy_open_meteo_text"}}</li>
            <li><strong>{{t .server.Lang "privacy_usgs_label"}}</strong> {{t .server.Lang "privacy_usgs_text"}}</li>
            <li><strong>{{t .server.Lang "privacy_geoip_label"}}</strong> {{t .server.Lang "privacy_geoip_text"}}</li>
        </ul>
        <p>{{t .server.Lang "privacy_third_party_disclaimer"}}</p>
    </div>

    <div class="card margin-y-lg">
        <h2 class="text-cyan">{{t .server.Lang "privacy_cookies_heading"}}</h2>
        <p>{{t .server.Lang "privacy_cookies_intro"}}</p>
        <ul>
            <li><strong>{{t .server.Lang "privacy_session_cookie_label"}}</strong> {{t .server.Lang "privacy_session_cookie_text"}}</li>
            <li><strong>{{t .server.Lang "privacy_csrf_token_label"}}</strong> {{t .server.Lang "privacy_csrf_token_text"}}</li>
            <li><strong>{{t .server.Lang "privacy_preferences_label"}}</strong> {{t .server.Lang "privacy_preferences_text"}}</li>
        </ul>
        <p>{{t .server.Lang "privacy_cookies_disclaimer"}}</p>
    </div>

    <div class="card margin-y-lg">
        <h2 class="text-cyan">{{t .server.Lang "privacy_your_rights_heading"}}</h2>
        <p>{{t .server.Lang "privacy_your_rights_intro"}}</p>
        <ul>
            <li><strong>{{t .server.Lang "privacy_right_access_label"}}</strong> {{t .server.Lang "privacy_right_access_text"}}</li>
            <li><strong>{{t .server.Lang "privacy_right_export_label"}}</strong> {{t .server.Lang "privacy_right_export_text"}}</li>
            <li><strong>{{t .server.Lang "privacy_right_modify_label"}}</strong> {{t .server.Lang "privacy_right_modify_text"}}</li>
            <li><strong>{{t .server.Lang "privacy_right_delete_label"}}</strong> {{t .server.Lang "privacy_right_delete_text"}}</li>
            <li><strong>{{t .server.Lang "privacy_right_optout_label"}}</strong> {{t .server.Lang "privacy_right_optout_text"}}</li>
        </ul>
        <p>{{t .server.Lang "privacy_rights_access_prefix"}} <a href="/users/profile" class="text-cyan">{{t .server.Lang "privacy_profile_page_link"}}</a>.</p>
    </div>

    <div class="card margin-y-lg">
        <h2 class="text-cyan">{{t .server.Lang "privacy_security_heading"}}</h2>
        <p>{{t .server.Lang "privacy_security_intro"}}</p>
        <ul>
            <li>{{t .server.Lang "privacy_security_encrypted"}}</li>
            <li>{{t .server.Lang "privacy_security_argon2id"}}</li>
            <li>{{t .server.Lang "privacy_security_csrf"}}</li>
            <li>{{t .server.Lang "privacy_security_rate_limiting"}}</li>
            <li>{{t .server.Lang "privacy_security_audits"}}</li>
        </ul>
    </div>

    <div class="card margin-y-lg">
        <h2 class="text-cyan">{{t .server.Lang "privacy_contact_heading"}}</h2>
        <p>{{t .server.Lang "privacy_contact_intro"}}</p>
        <div class="margin-y-md">
            <a href="/server/contact" class="btn btn-primary">{{t .server.Lang "privacy_contact_form_link"}}</a>
        </div>
    </div>

    <div class="card margin-y-lg">
        <p class="text-comment"><small>{{t .server.Lang "privacy_last_updated_label"}} {{.server.BuildDate}}</small></p>
    </div>
</div>

<script>
// Initialize notification polling
if (typeof Notifications !== 'undefined') {
    Notifications.startPolling(30000);
}
</script>

{{template "footer" .}}
