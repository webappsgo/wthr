{{template "head" .}}
{{template "navbar" .}}

<main class="container" id="main-content" role="main" aria-label="Weather forecast content">
    <div class="admin_header">
        <div>
            <h1>🌤️ {{t .server.Lang "index_page_heading"}}</h1>
            <p class="subtitle">{{t .server.Lang "index_page_subtitle"}}</p>
        </div>
    </div>

        <!-- Location Search Form - Mobile First -->
        <form id="weather-form" class="weather-form" role="search" aria-label="{{t .server.Lang "aria_search_form"}}">
    <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
            <div class="weather-form__wrapper">
                <!-- First row: Location input and units -->
                <div class="weather-form__row">
                    <div class="weather-form__input-wrapper">
                        <label for="location-input" class="sr-only">{{t .server.Lang "label_location"}}</label>
                        <input
                            type="text"
                            id="location-input"
                            name="location"
                            class="location-input weather-form__input"
                            placeholder="Enter city or coordinates"
                            value="{{.Location}}"
                            autocomplete="off"
                            aria-label="{{t .server.Lang "index_location_search_aria"}}"
                            aria-autocomplete="list"
                            aria-controls="autocomplete-dropdown"
                        >
                        <div id="autocomplete-dropdown" class="autocomplete-dropdown" role="listbox" aria-label="{{t .server.Lang "index_location_suggestions_aria"}}"></div>
                    </div>
                    <label for="units-select" class="sr-only">{{t .server.Lang "index_temperature_unit_label"}}</label>
                    <select name="units" id="units-select" class="location-input weather-form__units" aria-label="{{t .server.Lang "index_temperature_unit_label"}}">
                        <option value="imperial"{{if eq .Units "imperial"}} selected{{end}}>°F</option>
                        <option value="metric"{{if eq .Units "metric"}} selected{{end}}>°C</option>
                    </select>
                </div>

                <!-- Second row: Buttons -->
                <div class="weather-form__button-row">
                    <button type="submit" class="search-button weather-form__button" aria-label="{{t .server.Lang "btn_search"}} weather">
                        🌤️ {{t .server.Lang "index_get_weather_button"}}
                    </button>
                    <button type="button" id="location-btn" class="search-button weather-form__button--location" aria-label="{{t .server.Lang "index_use_location_aria"}}">
                        📍 {{t .server.Lang "index_my_location_button"}}
                    </button>
                </div>
            </div>
        </form>

        {{if .WeatherData}}
            <!-- Location Details Section -->
            <div class="location-details-section">
                <div class="location-info">
                    <!-- Always show location name -->
                    <div class="location-detail">
                        📍 <strong class="text-cyan">{{t .server.Lang "index_location_label"}}:</strong>
                        <span class="location-detail-value--yellow">{{if .WeatherData.Location.ShortName}}{{.WeatherData.Location.ShortName}}{{else}}{{.WeatherData.Location.Name}}, {{.WeatherData.Location.Country}}{{end}}</span>
                    </div>
                    <div class="location-detail">
                        🌍 <strong class="text-cyan">{{t .server.Lang "index_country_label"}}:</strong>
                        <span class="location-detail-value--green">{{.WeatherData.Location.Country}}</span>
                    </div>
                    <div class="location-detail">
                        🗺️ <strong class="text-cyan">{{t .server.Lang "index_coordinates_label"}}:</strong>
                        <span class="text-pink">{{.WeatherData.Location.Latitude}}, {{.WeatherData.Location.Longitude}}</span>
                    </div>
                    {{if .WeatherData.Location.Population}}
                    <div class="location-detail">
                        👥 <strong class="text-cyan">{{t .server.Lang "index_population_label"}}:</strong>
                        <span class="location-detail-value--orange">{{.WeatherData.Location.PopulationFormatted}}</span>
                    </div>
                    {{end}}
                </div>
            </div>
        {{end}}

        {{if .Error}}
            <div class="error-message-box">
                <strong>{{t .server.Lang "index_error_label"}}:</strong> {{.Error}}
            </div>
        {{end}}

        {{if .WeatherData}}
            <!-- Current Weather -->
            <div class="current-weather">
                <div class="weather-icon">
                    {{.WeatherData.Current.Icon}}
                </div>
                <div class="weather-details">
                    <div class="temperature">
                        {{printf "%.0f" .WeatherData.Current.Temperature}}{{if eq .Units "imperial"}}°F{{else}}°C{{end}}
                    </div>
                    <div class="description">
                        {{.WeatherData.Current.Description}}
                    </div>
                    <div class="weather-stats">
                        <div class="stat">{{t .server.Lang "index_feels_like_stat"}}: <span class="stat-value">{{printf "%.0f" .WeatherData.Current.FeelsLike}}{{if eq .Units "imperial"}}°F{{else}}°C{{end}}</span></div>
                        <div class="stat">{{t .server.Lang "index_th_wind"}}: <span class="stat-value">{{printf "%.0f" .WeatherData.Current.WindSpeed}} {{if eq .Units "imperial"}}mph{{else}}km/h{{end}}</span></div>
                        <div class="stat">{{t .server.Lang "index_humidity_label"}}: <span class="stat-value">{{.WeatherData.Current.Humidity}}%</span></div>
                        <div class="stat">{{t .server.Lang "index_pressure_label"}}: <span class="stat-value">{{if eq .Units "imperial"}}{{printf "%.2f" .WeatherData.Current.Pressure}} inHg{{else}}{{printf "%.0f" .WeatherData.Current.Pressure}} hPa{{end}}</span></div>
                    </div>
                </div>
            </div>

            <!-- Mobile-Optimized Forecast -->
            <div class="forecast-section">
                <!-- Desktop Table (hidden on mobile) -->
                <table class="forecast-table desktop-table">
                    <thead>
                        <tr>
                            <th>{{t .server.Lang "index_th_date"}}</th>
                            <th>{{t .server.Lang "index_th_conditions"}}</th>
                            <th>{{t .server.Lang "index_th_temperature"}}</th>
                            <th>{{t .server.Lang "index_th_feels_like"}}</th>
                            <th>{{t .server.Lang "index_th_wind"}}</th>
                            <th>{{t .server.Lang "index_th_precipitation"}}</th>
                        </tr>
                    </thead>
                    <tbody>
                    {{range $index, $day := .WeatherData.Forecast.Days}}
                        {{if lt $index 7}}
                        <tr>
                            <td class="day-header">{{$day.DateFormatted}}</td>
                            <td class="forecast-condition">
                                {{$day.Icon}} {{$day.Description}}
                            </td>
                            <td class="forecast-temp">
                                <span class="forecast-temp-high">↑{{printf "%.0f" $day.TempMax}}°</span>
                                <span class="forecast-temp-low">↓{{printf "%.0f" $day.TempMin}}°</span>
                                {{if eq $.Units "imperial"}}F{{else}}C{{end}}
                            </td>
                            <td class="forecast-feels-like">
                                <span class="forecast-temp-high">↑{{printf "%.0f" $day.FeelsLikeMax}}°</span>
                                <span class="forecast-temp-low">↓{{printf "%.0f" $day.FeelsLikeMin}}°</span>
                            </td>
                            <td class="wind-info">{{printf "%.0f" $day.WindSpeedMax}} {{if eq $.Units "imperial"}}mph{{else}}km/h{{end}}</td>
                            <td class="precipitation">{{printf "%.1f" $day.Precipitation}} {{if eq $.Units "imperial"}}in{{else}}mm{{end}} ({{$day.PrecipitationProbability}}%)</td>
                        </tr>
                        {{end}}
                    {{end}}
                    </tbody>
                </table>

                <!-- Mobile Cards (shown on mobile, hidden on desktop) -->
                <div class="mobile-forecast">
                    {{range $index, $day := .WeatherData.Forecast.Days}}
                        {{if lt $index 5}}
                        <div class="forecast-card">
                            <div class="forecast-card-header">
                                {{$day.DateFormatted}}
                            </div>
                            <div class="forecast-card-content">
                                <div class="forecast-main">
                                    <span class="forecast-icon">{{$day.Icon}}</span>
                                    <span class="forecast-temp">
                                        <span class="forecast-temp-high">↑{{printf "%.0f" $day.TempMax}}°</span>
                                        <span class="forecast-temp-low">↓{{printf "%.0f" $day.TempMin}}°</span>
                                        {{if eq $.Units "imperial"}}F{{else}}C{{end}}
                                    </span>
                                </div>
                                <div class="forecast-details-mobile">
                                    <div>{{$day.Description}}</div>
                                    <div class="wind-info">💨 {{printf "%.0f" $day.WindSpeedMax}} {{if eq $.Units "imperial"}}mph{{else}}km/h{{end}}</div>
                                    <div class="precipitation">☔ {{printf "%.1f" $day.Precipitation}} {{if eq $.Units "imperial"}}in{{else}}mm{{end}} ({{$day.PrecipitationProbability}}%)</div>
                                    {{if $day.FeelsLikeMax}}
                                    <div class="text-comment">{{t $.server.Lang "index_feels_like_stat"}} ↑{{printf "%.0f" $day.FeelsLikeMax}}° ↓{{printf "%.0f" $day.FeelsLikeMin}}°</div>
                                    {{end}}
                                </div>
                            </div>
                        </div>
                        {{end}}
                    {{end}}
                </div>
            </div>

            <!-- Console Command Examples -->
            <div class="console-container">
                <h3 class="console-title">{{t .server.Lang "index_console_access_heading"}}</h3>
                <div class="console-commands">
                    <div class="command-item">
                        <strong class="console-label">{{t .server.Lang "index_console_weather_label"}}:</strong>
                        <code class="mobile-code">curl -q -LSs {{.HostInfo.FullHost}}/{{.LocationFormatted}}</code>
                    </div>
                    <div class="command-item">
                        <strong class="console-label">{{t .server.Lang "index_console_oneline_label"}}:</strong>
                        <code class="mobile-code">curl -q -LSs {{.HostInfo.FullHost}}/{{.LocationFormatted}}?format=3</code>
                    </div>
                    <div class="command-item">
                        <strong class="console-label">{{t .server.Lang "index_console_moon_label"}}:</strong>
                        <code class="mobile-code">curl -q -LSs {{.HostInfo.FullHost}}/moon</code>
                    </div>
                    <div class="command-item">
                        <strong class="console-label">{{t .server.Lang "index_console_moon_location_label"}}:</strong>
                        <code class="mobile-code">curl -q -LSs {{.HostInfo.FullHost}}/moon/{{.LocationFormatted}}</code>
                    </div>
                    <div class="command-item">
                        <strong class="console-label">{{t .server.Lang "index_console_json_api_label"}}:</strong>
                        <code class="mobile-code">curl -q -LSs {{.HostInfo.FullHost}}/api/v1/weather?location={{.LocationFormatted}}</code>
                    </div>
                </div>
            </div>
        {{else}}
            <div class="welcome-container">
                <h2 class="welcome-title">{{t .server.Lang "index_welcome_heading"}}</h2>
                <p class="welcome-text">{{t .server.Lang "index_welcome_text"}}</p>
                <div class="city-grid">
                    <a href="?location=London" class="city-link">🇬🇧 London</a>
                    <a href="?location=Tokyo" class="city-link">🇯🇵 Tokyo</a>
                    <a href="?location=Paris" class="city-link">🇫🇷 Paris</a>
                    <a href="?location=Sydney" class="city-link">🇦🇺 Sydney</a>
                </div>

                <div class="city-grid-container">
                    <h4 class="city-grid-title">{{t .server.Lang "index_console_access_heading"}}:</h4>
                    <div class="console-commands">
                        <code class="mobile-code">curl -q -LSs {{.HostInfo.FullHost}}/London</code>
                        <code class="mobile-code">curl -q -LSs {{.HostInfo.FullHost}}/api/v1/weather?location=Paris</code>
                    </div>
                </div>
            </div>
        {{end}}

        {{if not .HideFooter}}
        <div class="page-footer-main">
            <p class="page-footer-text">
                <a href="https://github.com/webappsgo/wthr" target="_blank" class="page-footer-link">Weather</a>
                <span class="page-footer-divider">•</span>
                <span>{{t .server.Lang "index_footer_made_with"}} <span class="page-footer-heart">❤️</span></span>
                <span class="page-footer-divider">•</span>
                <a href="/docs" class="page-footer-link--green">v2.0.0</a>
            </p>
        </div>
        {{end}}
    </div>

    <script type="application/json" id="index-data">
        {
            "getting": "{{t .server.Lang "index_js_getting"}}",
            "gps": "{{t .server.Lang "index_js_gps"}}",
            "lowAccuracy": "{{t .server.Lang "index_js_low_accuracy"}}",
            "myLocation": "{{t .server.Lang "index_my_location_button"}}",
            "locating": "{{t .server.Lang "index_js_locating"}}",
            "found": "{{t .server.Lang "index_js_found"}}",
            "forceRefresh": "{{t .server.Lang "index_js_force_refresh"}}",
            "ipLocation": "{{t .server.Lang "index_js_ip_location"}}",
            "locationUnavailable": "{{t .server.Lang "index_js_location_unavailable"}}",
            "locationDenied": "{{t .server.Lang "index_js_location_denied"}}",
            "locationServicesUnavailable": "{{t .server.Lang "index_js_location_services_unavailable"}}",
            "enterManually": "{{t .server.Lang "index_js_enter_manually"}}",
            "locationBtnTooltip": "{{t .server.Lang "index_js_location_btn_tooltip"}}",
            "locationNotAvailable": "{{t .server.Lang "index_js_location_not_available"}}",
            "locationPrefilled": "{{t .server.Lang "index_js_location_prefilled"}}",
            "approximateLocation": "{{t .server.Lang "index_js_approximate_location"}}"
        }
    </script>
</main>

{{template "footer" .}}
