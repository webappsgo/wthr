<!DOCTYPE html>
<html lang="{{if .server.Lang}}{{.server.Lang}}{{else}}en{{end}}" dir="ltr" class="{{if .server.ThemeClass}}{{.server.ThemeClass}}{{else}}theme-dark{{end}}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{.title}}</title>
    <link rel="stylesheet" href="{{asset "/static/css/common.css"}}">
    <link rel="stylesheet" href="{{asset "/static/css/components.css"}}">
    <link rel="stylesheet" href="{{asset "/static/css/public.css"}}">
</head>
<body>
{{template "header" .}}
{{template "navbar" .}}
<main id="main-content" role="main">
    <section class="register-container" aria-labelledby="external-username-title">
        <h1 id="external-username-title">{{if .RequireAdminMFA}}{{t .server.Lang "login.2fa_required_title"}}{{else}}{{t .server.Lang "auth.external_username.title"}}{{end}}</h1>
        <p>{{if .RequireAdminMFA}}{{t .server.Lang "errors.auth.two_factor_required"}}{{else}}{{t .server.Lang "auth.external_username.description"}}{{end}}</p>
        {{if .error}}<p class="error-message" role="alert">{{.error}}</p>{{end}}
        <form method="post" action="/server/auth/external/username">
            <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
            {{if .RequireAdminMFA}}
            <label for="two_factor_code">{{t .server.Lang "admin.totp.current_code"}}</label>
            <input type="text" id="two_factor_code" name="two_factor_code" required inputmode="numeric" autocomplete="one-time-code">
            <button type="submit" class="btn-primary">{{t .server.Lang "login.submit_button"}}</button>
            {{else}}
            <label for="username">{{t .server.Lang "register.username_label"}}</label>
            <input type="text" id="username" name="username" required minlength="2" maxlength="39" pattern="[a-z0-9](?:[a-z0-9]|-[a-z0-9])*" value="{{.username}}" autocomplete="username">
            <p>{{t .server.Lang "register.username_requirements"}}</p>
            {{if .IsAdmin}}
            <label for="password">{{t .server.Lang "auth.external_admin_fallback_password"}}</label>
            <input type="password" id="password" name="password" required minlength="8" autocomplete="new-password">
            <label for="confirm_password">{{t .server.Lang "auth.external_admin_fallback_password_confirm"}}</label>
            <input type="password" id="confirm_password" name="confirm_password" required minlength="8" autocomplete="new-password">
            <p>{{t .server.Lang "auth.external_admin_fallback_password_help"}}</p>
            {{end}}
            <button type="submit" class="btn-primary">{{t .server.Lang "register.submit_button"}}</button>
            {{end}}
        </form>
    </section>
</main>
{{template "footer" .}}
</body>
</html>
