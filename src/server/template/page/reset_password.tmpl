{{define "page/reset_password.tmpl"}}
<!DOCTYPE html>
<html lang="en" class="{{if .server.ThemeClass}}{{.server.ThemeClass}}{{else}}theme-dark{{end}}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{.title}}</title>
    <link rel="stylesheet" href="/static/css/common.css">
    <link rel="stylesheet" href="/static/css/components.css">
    <link rel="stylesheet" href="/static/css/public.css">
</head>
<body>
    <div class="auth-container">
        <div class="auth-card">
            <h1>{{t .server.Lang "reset_password_title"}}</h1>
            <p>{{t .server.Lang "reset_password_subtitle"}}</p>

            {{if .error}}
            <div class="alert alert-error">{{.error}}</div>
            {{end}}

            <form method="POST" class="auth-form">
                <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
                <input type="hidden" name="token" value="{{.token}}">
                <div class="form-group">
                    <label for="password">{{t .server.Lang "reset_password_new_password_label"}}</label>
                    <input type="password" id="password" name="password" required autocomplete="new-password" placeholder="{{t .server.Lang "reset_password_new_password_placeholder"}}">
                </div>
                <div class="form-group">
                    <label for="confirm_password">{{t .server.Lang "reset_password_confirm_password_label"}}</label>
                    <input type="password" id="confirm_password" name="confirm_password" required autocomplete="new-password" placeholder="{{t .server.Lang "reset_password_confirm_password_placeholder"}}">
                </div>
                <button type="submit" class="btn btn-primary">{{t .server.Lang "reset_password_submit_button"}}</button>
            </form>

            <div class="auth-links">
                <a href="/server/auth/login">{{t .server.Lang "reset_password_back_to_login"}}</a>
            </div>
        </div>
    </div>
</body>
</html>
{{end}}
