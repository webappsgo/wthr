<!DOCTYPE html>
<html lang="{{if .server.Lang}}{{.server.Lang}}{{else}}en{{end}}" dir="{{if eq (printf "%v" .server.Lang) "ar"}}rtl{{else}}ltr{{end}}" class="{{if .server.ThemeClass}}{{.server.ThemeClass}}{{else}}theme-dark{{end}}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ if .server }}{{t .server.Lang "error.page_title_prefix"}}{{ else }}Error{{ end }} - {{ if .server }}{{ if .server.Title }}{{ .server.Title }}{{ else }}Weather{{ end }}{{ else }}Weather{{ end }}</title>
    <link rel="stylesheet" href="{{asset "/static/css/common.css"}}">
    <link rel="stylesheet" href="{{asset "/static/css/components.css"}}">
    <link rel="stylesheet" href="{{asset "/static/css/public.css"}}">
</head>
<body>
<a href="#main-content" class="skip-link">{{t .server.Lang "aria.skip_to_main"}}</a>
<a href="#navigation" class="skip-link">{{t .server.Lang "aria.skip_to_nav"}}</a>
{{template "header" .}}
{{template "navbar" .}}
<main id="main-content">
  <div class="container container-sm">
    <header class="page-header"><h1 class="page-title">{{t .server.Lang "error.title"}}</h1></header>
    <div class="error-container">
        <div class="error-icon">⚠️</div>
        <div class="error-message">
            {{ if .error }}
                {{ .error }}
            {{ else }}
                {{t .server.Lang "error.unexpected"}}
            {{ end }}
        </div>
        <div class="error-actions">
            <a href="/" class="btn btn-primary">{{t .server.Lang "error.go_home"}}</a>
        </div>
    </div>
  </div>
</main>
{{template "footer" .}}
