{{template "head" .}}

{{template "navbar" .}}

<div class="weather-container">
    <h1 class="text-purple">{{t .server.Lang "terms.page_title"}}</h1>

    <div class="card margin-y-lg">
        <h2 class="text-cyan">{{t .server.Lang "terms.acceptance_title"}}</h2>
        <p>{{t .server.Lang "terms.acceptance_text"}}</p>
    </div>

    <div class="card margin-y-lg">
        <h2 class="text-cyan">{{t .server.Lang "terms.description_title"}}</h2>
        <p>{{t .server.Lang "terms.description_text"}}</p>
    </div>

    <div class="card margin-y-lg">
        <h2 class="text-cyan">{{t .server.Lang "terms.acceptable_use_title"}}</h2>
        <p>{{t .server.Lang "terms.acceptable_use_intro"}}</p>
        <ul>
            <li>{{t .server.Lang "terms.acceptable_use_disrupt"}}</li>
            <li>{{t .server.Lang "terms.acceptable_use_circumvent"}}</li>
            <li>{{t .server.Lang "terms.acceptable_use_harm"}}</li>
            <li>{{t .server.Lang "terms.acceptable_use_scrape"}}</li>
            <li>{{t .server.Lang "terms.acceptable_use_misrepresent"}}</li>
        </ul>
    </div>

    <div class="card margin-y-lg">
        <h2 class="text-cyan">{{t .server.Lang "terms.api_usage_title"}}</h2>
        <p>{{t .server.Lang "terms.api_usage_intro"}}</p>
        <ul>
            <li><strong>{{t .server.Lang "terms.api_rate_limits_label"}}</strong> {{t .server.Lang "terms.api_rate_limits_text"}}</li>
            <li><strong>{{t .server.Lang "terms.api_fair_use_label"}}</strong> {{t .server.Lang "terms.api_fair_use_text"}}</li>
            <li><strong>{{t .server.Lang "terms.api_attribution_label"}}</strong> {{t .server.Lang "terms.api_attribution_text"}}</li>
        </ul>
    </div>

    <div class="card margin-y-lg">
        <h2 class="text-cyan">{{t .server.Lang "terms.data_accuracy_title"}}</h2>
        <p>{{t .server.Lang "terms.data_accuracy_text"}}</p>
        <p><strong>{{t .server.Lang "terms.data_accuracy_warning"}}</strong> {{t .server.Lang "terms.data_accuracy_advice"}}</p>
    </div>

    <div class="card margin-y-lg">
        <h2 class="text-cyan">{{t .server.Lang "terms.liability_title"}}</h2>
        <p>{{t .server.Lang "terms.liability_intro"}}</p>
        <ul>
            <li>{{t .server.Lang "terms.liability_use"}}</li>
            <li>{{t .server.Lang "terms.liability_inaccurate"}}</li>
            <li>{{t .server.Lang "terms.liability_interruptions"}}</li>
            <li>{{t .server.Lang "terms.liability_decisions"}}</li>
        </ul>
    </div>

    <div class="card margin-y-lg">
        <h2 class="text-cyan">{{t .server.Lang "terms.changes_title"}}</h2>
        <p>{{t .server.Lang "terms.changes_text"}}</p>
    </div>

    <div class="card margin-y-lg">
        <h2 class="text-cyan">{{t .server.Lang "terms.contact_title"}}</h2>
        <p>{{t .server.Lang "terms.contact_text"}}</p>
        <div class="margin-y-md">
            <a href="/server/contact" class="btn btn-primary">{{t .server.Lang "terms.contact_form_button"}}</a>
        </div>
    </div>

    <div class="card margin-y-lg">
        <p class="text-comment"><small>{{t .server.Lang "terms.last_updated_label"}} {{.server.BuildDate}}</small></p>
    </div>
</div>

{{template "footer" .}}
