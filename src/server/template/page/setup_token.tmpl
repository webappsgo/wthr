<!DOCTYPE html>
<html lang="en" class="{{if .server.ThemeClass}}{{.server.ThemeClass}}{{else}}theme-dark{{end}}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{.Title}}</title>
    <link rel="stylesheet" href="/static/css/common.css">
    <link rel="stylesheet" href="/static/css/components.css">
    <link rel="stylesheet" href="/static/css/public.css">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🔐</text></svg>">
</head>
<body>
    <div class="setup-container">
        <div class="setup-card">
            <div class="setup-header">
                <div class="setup-icon">🔐</div>
                <h1 class="setup-title">{{t .server.Lang "setup_token_title"}}</h1>
                <p class="setup-subtitle">{{t .server.Lang "setup_token_subtitle"}}</p>
            </div>

            <div class="info-box">
                <p>{{t .server.Lang "setup_token_info"}}</p>
            </div>

            <div id="error-message" class="error-message" role="alert" aria-live="polite"></div>

            <form id="token-form" role="form" aria-label="{{t .server.Lang "setup_token_form_aria_label"}}">
                <div class="form-group">
                    <label class="form-label" for="setup_token">{{t .server.Lang "setup_token_label"}}</label>
                    <input type="text"
                           id="setup_token"
                           name="setup_token"
                           class="form-input"
                           required
                           minlength="32"
                           maxlength="32"
                           pattern="[a-fA-F0-9]{32}"
                           placeholder="{{t .server.Lang "setup_token_placeholder"}}"
                           autocomplete="off"
                           spellcheck="false"
                           aria-label="{{t .server.Lang "setup_token_label"}}"
                           aria-required="true"
                           aria-describedby="token-hint"
                           title="{{t .server.Lang "setup_token_input_title"}}">
                    <small class="setup-admin-form-hint" id="token-hint">{{t .server.Lang "setup_token_hint"}}</small>
                </div>

                <button type="submit"
                        id="submit-btn"
                        class="submit-button"
                        aria-label="{{t .server.Lang "setup_token_verify_aria_label"}}"
                        title="{{t .server.Lang "setup_token_verify_title"}}">{{t .server.Lang "setup_token_continue_button"}}</button>
            </form>
        </div>
    </div>

    <script>
        document.getElementById('token-form').addEventListener('submit', async (e) => {
            e.preventDefault();

            const submitBtn = document.getElementById('submit-btn');
            const errorMsg = document.getElementById('error-message');
            const token = document.getElementById('setup_token').value.trim().toLowerCase();

            errorMsg.classList.remove('edit-error-message');

            // Validate token format
            if (!/^[a-f0-9]{32}$/.test(token)) {
                errorMsg.textContent = '{{t .server.Lang "setup_token_invalid_format_error"}}';
                errorMsg.classList.add('edit-error-message');
                return;
            }

            submitBtn.disabled = true;
            submitBtn.textContent = '{{t .server.Lang "setup_token_verifying_button"}}';

            try {
                const response = await fetch(window.location.pathname.replace(/\/$/, '') + '/verify', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ setup_token: token })
                });

                const result = await response.json();

                if (response.ok) {
                    window.location.href = result.redirect;
                } else {
                    errorMsg.textContent = result.error || '{{t .server.Lang "setup_token_invalid_token_error"}}';
                    errorMsg.classList.add('edit-error-message');
                    submitBtn.disabled = false;
                    submitBtn.textContent = '{{t .server.Lang "setup_token_continue_button"}}';
                }
            } catch (error) {
                errorMsg.textContent = '{{t .server.Lang "setup_token_network_error"}}';
                errorMsg.classList.add('edit-error-message');
                submitBtn.disabled = false;
                submitBtn.textContent = '{{t .server.Lang "setup_token_continue_button"}}';
            }
        });
    </script>
</body>
</html>
