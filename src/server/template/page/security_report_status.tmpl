{{template "head" .}}

{{template "navbar" .}}

<main id="main-content">
  <div class="container container-sm">
    <header class="page-header"><h1 class="page-title">{{t .server.Lang "security.report.status.title"}}</h1></header>
    <section class="section-card" aria-labelledby="report-status-heading">
        <h2 id="report-status-heading" class="sr-only">{{t .server.Lang "security.report.status.title"}}</h2>
        <dl>
            <dt>{{t .server.Lang "security.report.received.tracking"}}</dt>
            <dd><code>{{.Report.TrackingID}}</code></dd>
            <dt>{{t .server.Lang "security.report.status.state"}}</dt>
            <dd>{{t .server.Lang (printf "security.report.state.%s" .Report.Status)}}</dd>
            <dt>{{t .server.Lang "security.report.status.comment"}}</dt>
            <dd>{{if .Report.ResearcherComment}}{{.Report.ResearcherComment}}{{else}}{{t .server.Lang "security.report.status.none"}}{{end}}</dd>
            <dt>{{t .server.Lang "security.report.status.disclosure"}}</dt>
            <dd>{{if .Report.DisclosureDate}}{{.Report.DisclosureDate}}{{else}}{{t .server.Lang "security.report.status.none"}}{{end}}</dd>
        </dl>
    </section>
  </div>
</main>

{{template "footer" .}}
