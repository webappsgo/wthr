<!DOCTYPE html>
<html lang="en" class="{{if .server.ThemeClass}}{{.server.ThemeClass}}{{else}}theme-dark{{end}}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title>{{.Title}}</title>
    <link rel="stylesheet" href="/static/css/common.css">
    <link rel="stylesheet" href="/static/css/components.css">
    <link rel="stylesheet" href="/static/css/public.css">
</head>
<body>
    <div class="login-container">
        <div class="login-card setup-card">
            <div class="login-header">
                <h1 class="login-title">{{t .server.Lang "setup_api_token_title"}}</h1>
                <p class="login-subtitle">{{t .server.Lang "setup_api_token_step_subtitle"}}</p>
            </div>

            <div class="setup-progress">
                <div class="progress-bar">
                    <div class="progress-fill" style="width: 33.33%"></div>
                </div>
                <div class="progress-steps">
                    <span class="step completed">{{t .server.Lang "setup_step_admin"}}</span>
                    <span class="step active">{{t .server.Lang "setup_step_api_token"}}</span>
                    <span class="step">{{t .server.Lang "setup_step_server"}}</span>
                    <span class="step">{{t .server.Lang "setup_step_security"}}</span>
                    <span class="step">{{t .server.Lang "setup_step_services"}}</span>
                    <span class="step">{{t .server.Lang "setup_step_complete"}}</span>
                </div>
            </div>

            <div class="login-info">
                <p>{{t .server.Lang "setup_api_token_intro"}}</p>
                <p class="text-orange"><strong>{{t .server.Lang "setup_api_token_copy_warning"}}</strong></p>
            </div>

            {{ if .error }}
            <div class="error-message" role="alert">{{ .error }}</div>
            {{ end }}

            <div class="token-display">
                <label class="form-label">{{t .server.Lang "setup_api_token_your_token_label"}}</label>
                <div class="token-box">
                    <code id="api-token" class="token-value long-string">{{ .APIToken }}</code>
                    <button type="button" class="btn-copy" data-action="copy-command" data-text="{{ .APIToken }}">{{t .server.Lang "btn_copy"}}</button>
                </div>
                <small class="form-hint">{{t .server.Lang "setup_api_token_usage_hint"}} <code>Bearer {token}</code></small>
            </div>

            <div class="form-group checkbox-confirm">
                <label class="checkbox-label">
                    <input type="checkbox" id="token-copied" required>
                    <span>{{t .server.Lang "setup_api_token_confirm_checkbox"}}</span>
                </label>
            </div>

            <form method="POST" action="" id="token-form">
                <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
                <input type="hidden" name="token_acknowledged" value="true">
                <button type="submit" id="submit-btn" class="btn-login" disabled>{{t .server.Lang "setup_api_token_continue_button"}}</button>
            </form>
        </div>

        {{ if .version }}
        <div class="login-footer">
            v{{ .version }}
        </div>
        {{ end }}
    </div>

    <script src="/static/js/app.js" defer></script>
    <script>
        document.getElementById('token-copied').addEventListener('change', function() {
            document.getElementById('submit-btn').disabled = !this.checked;
        });
    </script>
</body>
</html>
