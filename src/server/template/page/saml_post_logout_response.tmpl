<!DOCTYPE html>
<html lang="{{if .server.Lang}}{{.server.Lang}}{{else}}en{{end}}" dir="ltr" class="{{if .server.ThemeClass}}{{.server.ThemeClass}}{{else}}theme-dark{{end}}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{.title}}</title>
    <link rel="stylesheet" href="{{asset "/static/css/common.css"}}">
    <link rel="stylesheet" href="{{asset "/static/css/components.css"}}">
    <link rel="stylesheet" href="{{asset "/static/css/public.css"}}">
</head>
<body>
{{template "header" .}}
{{template "navbar" .}}
<main id="main-content" role="main">
    <section class="register-container" aria-labelledby="saml-logout-title">
        <h1 id="saml-logout-title">{{t .server.Lang "auth.saml.logout_title"}}</h1>
        <p>{{t .server.Lang "auth.saml.logout_description"}}</p>
        <form method="post" action="{{.Destination}}">
            <input type="hidden" name="SAMLResponse" value="{{.Message}}">
            <input type="hidden" name="RelayState" value="{{.RelayState}}">
            <button type="submit" class="btn-primary">{{t .server.Lang "auth.saml.logout_continue"}}</button>
        </form>
    </section>
</main>
{{template "footer" .}}
</body>
</html>
