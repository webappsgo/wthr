<!DOCTYPE html>
<html lang="en" class="{{if .server.ThemeClass}}{{.server.ThemeClass}}{{else}}theme-dark{{end}}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title>{{.Title}}</title>
    <link rel="stylesheet" href="/static/css/common.css">
    <link rel="stylesheet" href="/static/css/components.css">
    <link rel="stylesheet" href="/static/css/public.css">
</head>
<body>
    <div class="login-container">
        <div class="login-card">
            <div class="login-header">
                <h1 class="login-title">{{t .server.Lang "setup_complete_title"}}</h1>
                <p class="login-subtitle">{{t .server.Lang "setup_complete_step_subtitle"}}</p>
            </div>

            <div class="setup-progress">
                <div class="progress-bar">
                    <div class="progress-fill success" style="width: 100%"></div>
                </div>
                <div class="progress-steps">
                    <span class="step completed">{{t .server.Lang "setup_step_admin"}}</span>
                    <span class="step completed">{{t .server.Lang "setup_step_api_token"}}</span>
                    <span class="step completed">{{t .server.Lang "setup_step_server"}}</span>
                    <span class="step completed">{{t .server.Lang "setup_step_security"}}</span>
                    <span class="step completed">{{t .server.Lang "setup_step_services"}}</span>
                    <span class="step active">{{t .server.Lang "setup_step_complete"}}</span>
                </div>
            </div>

            <div class="login-info success-box">
                <p>{{t .server.Lang "setup_complete_success_line1"}}</p>
                <p>{{t .server.Lang "setup_complete_success_line2"}}</p>
            </div>

            <div class="button-group">
                <a href="{{.AdminPath}}/dashboard" class="btn-login">
                    {{t .server.Lang "setup_complete_go_to_dashboard"}}
                </a>
                <a href="/" class="btn-secondary">
                    {{t .server.Lang "setup_complete_go_to_homepage"}}
                </a>
            </div>
        </div>

        {{ if .version }}
        <div class="login-footer">
            v{{ .version }}
        </div>
        {{ end }}
    </div>
</body>
</html>
