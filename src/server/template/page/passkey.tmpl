{{define "page/passkey.tmpl"}}
<!DOCTYPE html>
<html lang="{{if .server.Lang}}{{.server.Lang}}{{else}}en{{end}}" dir="{{if eq (printf "%v" .server.Lang) "ar"}}rtl{{else}}ltr{{end}}" class="{{if .server.ThemeClass}}{{.server.ThemeClass}}{{else}}theme-dark{{end}}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{.title}}</title>
    <link rel="stylesheet" href="{{asset "/static/css/common.css"}}">
    <link rel="stylesheet" href="{{asset "/static/css/components.css"}}">
    <link rel="stylesheet" href="{{asset "/static/css/public.css"}}">
    <script src="{{asset "/static/js/app.js"}}" defer></script>
</head>
<body>
{{template "header" .}}
{{template "navbar" .}}
<main id="main-content" role="main">
    <div class="auth-container">
        <div class="auth-card">
            <h1>{{t .server.Lang "passkey.page_heading"}}</h1>
            <p>{{t .server.Lang "passkey.page_subtitle"}}</p>

            {{if .error}}
            <div class="alert alert-error">{{.error}}</div>
            {{end}}

            <div class="auth-message">
                <p>{{t .server.Lang "passkey.auth_message"}}</p>
            </div>

            <div id="passkeyStatus" class="alert alert-info">{{t .server.Lang "passkey.status_waiting"}}</div>

            <div class="auth-links">
                <a href="/server/auth/login">{{t .server.Lang "oidc.back_to_login_link"}}</a>
            </div>
        </div>
    </div>
    <script type="application/json" id="passkey-login-data">
        {
            "unsupportedBrowser": "{{t .server.Lang "passkey.js_unsupported_browser"}}",
            "failedStart": "{{t .server.Lang "passkey.js_failed_start"}}",
            "touchPrompt": "{{t .server.Lang "passkey.js_touch_prompt"}}",
            "cancelled": "{{t .server.Lang "passkey.js_cancelled"}}",
            "failedVerify": "{{t .server.Lang "passkey.js_failed_verify"}}",
            "successRedirecting": "{{t .server.Lang "passkey.js_success_redirecting"}}",
            "failedGeneric": "{{t .server.Lang "passkey.js_failed_generic"}}"
        }
    </script>
</main>
{{template "footer" .}}

{{end}}
