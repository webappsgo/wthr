<!DOCTYPE html>
<html lang="{{if .server.Lang}}{{.server.Lang}}{{else}}en{{end}}" dir="{{if eq (printf "%v" .server.Lang) "ar"}}rtl{{else}}ltr{{end}}" class="{{if .server.ThemeClass}}{{.server.ThemeClass}}{{else}}theme-dark{{end}}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{.Title}}</title>
    <link rel="stylesheet" href="/static/css/common.css">
    <link rel="stylesheet" href="/static/css/components.css">
    <link rel="stylesheet" href="/static/css/public.css">
    <script src="/static/js/app.js" defer></script>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🌤️</text></svg>">
</head>
<body>
    {{template "navbar" .}}

    <div class="weather-container">

        <!-- Location Search Form -->
        <form id="weather-form" class="search-form">
    <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
            <div class="search-row-single">
                <div class="search-input-wrapper">
                    <input
                        type="text"
                        id="location-input"
                        name="location"
                        class="location-input"
                        placeholder="{{t .server.Lang "weather_location_placeholder"}}"
                        value="{{.Location}}"
                        autocomplete="off"
                    >
                    <div id="autocomplete-dropdown" class="autocomplete-dropdown"></div>
                </div>
                <select name="units" id="units-select" class="units-select">
                    <option value="imperial"{{if eq .Units "imperial"}} selected{{end}}>°F</option>
                    <option value="metric"{{if eq .Units "metric"}} selected{{end}}>°C</option>
                </select>
            </div>

            <div class="search-row-single">
                <button type="submit" class="search-button primary flex-1">
                    🌤️ {{t .server.Lang "weather_get_weather"}}
                </button>
                <button type="button" id="location-btn" class="search-button secondary flex-1">
                    📍 {{t .server.Lang "weather_my_location"}}
                </button>
            </div>
        </form>

        {{if .WeatherData}}
            {{template "location_details" .WeatherData}}
        {{end}}

        {{if .Error}}
            <div class="error-box">
                <strong>{{t .server.Lang "weather_error_label"}}</strong> {{.Error}}
            </div>
        {{end}}

        {{if .WeatherData}}
            <!-- Current Weather -->
            <div class="current-weather">
                <div class="weather-icon">
                    {{.WeatherData.Current.Icon}}
                </div>
                <div class="weather-details">
                    <div class="temperature">
                        {{printf "%.0f" .WeatherData.Current.Temperature}}{{if eq .Units "imperial"}}°F{{else}}°C{{end}}
                    </div>
                    <div class="description">
                        {{.WeatherData.Current.Description}}
                    </div>
                    <div class="weather-stats">
                        <div class="stat">{{t .server.Lang "weather_feels_like"}} <span class="stat-value">{{printf "%.0f" .WeatherData.Current.FeelsLike}}{{if eq .Units "imperial"}}°F{{else}}°C{{end}}</span></div>
                        <div class="stat">{{t .server.Lang "weather_wind"}} <span class="stat-value">{{printf "%.0f" .WeatherData.Current.WindSpeed}} {{if eq .Units "imperial"}}mph{{else}}km/h{{end}}</span></div>
                        <div class="stat">{{t .server.Lang "weather_humidity"}} <span class="stat-value">{{.WeatherData.Current.Humidity}}%</span></div>
                        <div class="stat">{{t .server.Lang "weather_pressure"}} <span class="stat-value">{{if eq .Units "imperial"}}{{printf "%.2f" .WeatherData.Current.Pressure}} inHg{{else}}{{printf "%.0f" .WeatherData.Current.Pressure}} hPa{{end}}</span></div>
                    </div>
                </div>
            </div>

            <!-- Mobile-Optimized Forecast -->
            <div class="forecast-section">
                <!-- Desktop Table (hidden on mobile) -->
                <table class="forecast-table desktop-table">
                    <thead>
                        <tr>
                            <th>{{t .server.Lang "weather_th_date"}}</th>
                            <th>{{t .server.Lang "weather_th_conditions"}}</th>
                            <th>{{t .server.Lang "weather_th_temperature"}}</th>
                            <th>{{t .server.Lang "weather_th_feels_like"}}</th>
                            <th>{{t .server.Lang "weather_th_wind"}}</th>
                            <th>{{t .server.Lang "weather_th_precipitation"}}</th>
                            <th>{{t .server.Lang "weather_th_wind_gusts"}}</th>
                            <th>{{t .server.Lang "weather_th_solar_radiation"}}</th>
                        </tr>
                    </thead>
                    <tbody>
                    {{range $day := .WeatherData.Forecast.Days}}
                        <tr>
                            <td class="day-header">{{$day.DateFormatted}}</td>
                            <td class="forecast-condition">
                                {{$day.Icon}} {{$day.Description}}
                            </td>
                            <td class="forecast-temp">
                                <span class="text-orange">↑{{printf "%.0f" $day.TempMax}}°</span>
                                <span class="text-cyan">↓{{printf "%.0f" $day.TempMin}}°</span>
                                {{if eq $.Units "imperial"}}F{{else}}C{{end}}
                            </td>
                            <td class="text-comment text-sm">
                                <span class="text-orange">↑{{printf "%.0f" $day.FeelsLikeMax}}°</span>
                                <span class="text-cyan">↓{{printf "%.0f" $day.FeelsLikeMin}}°</span>
                            </td>
                            <td class="wind-info">
                                💨 {{printf "%.0f" $day.WindSpeedMax}} {{if eq $.Units "imperial"}}mph{{else}}km/h{{end}}
                                <div class="text-xs text-comment">{{$day.WindDirection}}°</div>
                            </td>
                            <td class="precipitation">
                                ☔ {{printf "%.1f" $day.Precipitation}} {{if eq $.Units "imperial"}}in{{else}}mm{{end}}
                                <div class="text-xs text-comment">{{$day.PrecipitationProbability}}% • {{printf "%.1f" $day.PrecipitationHours}}h</div>
                            </td>
                            <td class="wind-info">
                                💨 {{printf "%.0f" $day.WindGustsMax}} {{if eq $.Units "imperial"}}mph{{else}}km/h{{end}}
                            </td>
                            <td class="text-yellow">
                                ☀️ {{printf "%.1f" $day.SolarRadiation}} MJ/m²
                            </td>
                        </tr>
                    {{end}}
                    </tbody>
                </table>

                <!-- Mobile Cards (shown on mobile, hidden on desktop) -->
                <div class="mobile-forecast">
                    {{range $day := .WeatherData.Forecast.Days}}
                        <div class="forecast-card">
                            <div class="forecast-card-header">
                                {{$day.DateFormatted}}
                            </div>
                            <div class="forecast-card-content">
                                <div class="forecast-main">
                                    <span class="forecast-icon">{{$day.Icon}}</span>
                                    <span class="forecast-temp">
                                        <span class="text-orange">↑{{printf "%.0f" $day.TempMax}}°</span>
                                        <span class="text-cyan">↓{{printf "%.0f" $day.TempMin}}°</span>
                                        {{if eq $.Units "imperial"}}F{{else}}C{{end}}
                                    </span>
                                </div>
                                <div class="forecast-details text-sm">
                                    <div class="text-cyan font-medium">{{$day.Description}}</div>
                                    {{if $day.FeelsLikeMax}}
                                    <div class="text-comment">
                                        <strong>{{t $.server.Lang "weather_card_feels_like"}}</strong> ↑{{printf "%.0f" $day.FeelsLikeMax}}° ↓{{printf "%.0f" $day.FeelsLikeMin}}°
                                    </div>
                                    {{end}}
                                    <div class="wind-info">
                                        <strong>{{t $.server.Lang "weather_card_wind"}}</strong> 💨 {{printf "%.0f" $day.WindSpeedMax}} {{if eq $.Units "imperial"}}mph{{else}}km/h{{end}} ({{$day.WindDirection}}°)
                                    </div>
                                    <div class="wind-info">
                                        <strong>{{t $.server.Lang "weather_card_gusts"}}</strong> 💨 {{printf "%.0f" $day.WindGustsMax}} {{if eq $.Units "imperial"}}mph{{else}}km/h{{end}}
                                    </div>
                                    <div class="precipitation">
                                        <strong>{{t $.server.Lang "weather_card_precip"}}</strong> ☔ {{printf "%.1f" $day.Precipitation}} {{if eq $.Units "imperial"}}in{{else}}mm{{end}} • {{$day.PrecipitationProbability}}% {{t $.server.Lang "weather_card_chance"}}
                                    </div>
                                    <div class="text-comment">
                                        <strong>{{t $.server.Lang "weather_card_duration"}}</strong> {{printf "%.1f" $day.PrecipitationHours}} {{t $.server.Lang "weather_card_hours"}}
                                    </div>
                                    <div class="text-yellow">
                                        <strong>{{t $.server.Lang "weather_card_solar"}}</strong> ☀️ {{printf "%.1f" $day.SolarRadiation}} MJ/m²
                                    </div>
                                </div>
                            </div>
                        </div>
                    {{end}}
                </div>
            </div>

            <!-- Console Command Examples -->
            <div class="console-section">
                <h3 class="console-section__title">{{t .server.Lang "weather_console_access"}}</h3>
                <div class="console-commands">
                    <div class="command-item">
                        <strong class="console-section__label">{{t .server.Lang "weather_console_weather_label"}}</strong>
                        <div class="code-wrapper">
                            <code class="mobile-code">curl -q -LSs {{.HostInfo.FullHost}}/{{.LocationFormatted}}</code>
                            <button class="copy-btn" data-action="copy-command" data-text="curl -q -LSs {{.HostInfo.FullHost}}/{{.LocationFormatted}}">{{t .server.Lang "weather_copy"}}</button>
                        </div>
                    </div>
                    <div class="command-item">
                        <strong class="console-section__label">{{t .server.Lang "weather_console_oneline_label"}}</strong>
                        <div class="code-wrapper">
                            <code class="mobile-code">curl -q -LSs {{.HostInfo.FullHost}}/{{.LocationFormatted}}?format=3</code>
                            <button class="copy-btn" data-action="copy-command" data-text="curl -q -LSs {{.HostInfo.FullHost}}/{{.LocationFormatted}}?format=3">{{t .server.Lang "weather_copy"}}</button>
                        </div>
                    </div>
                    <div class="command-item">
                        <strong class="console-section__label">{{t .server.Lang "weather_console_moon_label"}}</strong>
                        <div class="code-wrapper">
                            <code class="mobile-code">curl -q -LSs {{.HostInfo.FullHost}}/moon</code>
                            <button class="copy-btn" data-action="copy-command" data-text="curl -q -LSs {{.HostInfo.FullHost}}/moon">{{t .server.Lang "weather_copy"}}</button>
                        </div>
                    </div>
                    <div class="command-item">
                        <strong class="console-section__label">{{t .server.Lang "weather_console_moon_location_label"}}</strong>
                        <div class="code-wrapper">
                            <code class="mobile-code">curl -q -LSs {{.HostInfo.FullHost}}/moon/{{.LocationFormatted}}</code>
                            <button class="copy-btn" data-action="copy-command" data-text="curl -q -LSs {{.HostInfo.FullHost}}/moon/{{.LocationFormatted}}">{{t .server.Lang "weather_copy"}}</button>
                        </div>
                    </div>
                    <div class="command-item">
                        <strong class="console-section__label">{{t .server.Lang "weather_console_json_api_label"}}</strong>
                        <div class="code-wrapper">
                            <code class="mobile-code">curl -q -LSs {{.HostInfo.FullHost}}/api/v1/weather?location={{.LocationFormatted}}</code>
                            <button class="copy-btn" data-action="copy-command" data-text="curl -q -LSs {{.HostInfo.FullHost}}/api/v1/weather?location={{.LocationFormatted}}">{{t .server.Lang "weather_copy"}}</button>
                        </div>
                    </div>
                </div>
            </div>
        {{else}}
            <div class="welcome-section">
                <h2 class="welcome-section__title">🌤️ {{t .server.Lang "weather_forecasts_title"}}</h2>
                <p>{{t .server.Lang "weather_forecasts_intro"}}</p>
                <div class="city-links-grid">
                    <a href="?location=London" class="city-link">🇬🇧 London</a>
                    <a href="?location=Tokyo" class="city-link">🇯🇵 Tokyo</a>
                    <a href="?location=Paris" class="city-link">🇫🇷 Paris</a>
                    <a href="?location=Sydney" class="city-link">🇦🇺 Sydney</a>
                </div>
                <div class="console-section margin-y-md">
                    <h4 class="console-section__title">{{t .server.Lang "weather_quick_console_examples"}}</h4>
                    <div class="console-commands">
                        <div class="command-item">
                            <strong class="console-section__label">{{t .server.Lang "weather_console_london_label"}}</strong>
                            <div class="code-wrapper">
                                <code class="mobile-code">curl -q -LSs {{.HostInfo.FullHost}}/London</code>
                                <button class="copy-btn" data-action="copy-command" data-text="curl -q -LSs {{.HostInfo.FullHost}}/London">{{t .server.Lang "weather_copy"}}</button>
                            </div>
                        </div>
                        <div class="command-item">
                            <strong class="console-section__label">{{t .server.Lang "weather_console_paris_json_label"}}</strong>
                            <div class="code-wrapper">
                                <code class="mobile-code">curl -q -LSs {{.HostInfo.FullHost}}/api/v1/weather?location=Paris</code>
                                <button class="copy-btn" data-action="copy-command" data-text="curl -q -LSs {{.HostInfo.FullHost}}/api/v1/weather?location=Paris">{{t .server.Lang "weather_copy"}}</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {{end}}

    </div>

    <script type="application/json" id="index-data">
        {
            "getting": "{{t .server.Lang "index_js_getting"}}",
            "gps": "{{t .server.Lang "index_js_gps"}}",
            "lowAccuracy": "{{t .server.Lang "index_js_low_accuracy"}}",
            "myLocation": "{{t .server.Lang "index_my_location_button"}}",
            "locating": "{{t .server.Lang "index_js_locating"}}",
            "found": "{{t .server.Lang "index_js_found"}}",
            "forceRefresh": "{{t .server.Lang "index_js_force_refresh"}}",
            "ipLocation": "{{t .server.Lang "index_js_ip_location"}}",
            "locationUnavailable": "{{t .server.Lang "index_js_location_unavailable"}}",
            "locationDenied": "{{t .server.Lang "index_js_location_denied"}}",
            "locationServicesUnavailable": "{{t .server.Lang "index_js_location_services_unavailable"}}",
            "enterManually": "{{t .server.Lang "index_js_enter_manually"}}",
            "locationBtnTooltip": "{{t .server.Lang "index_js_location_btn_tooltip"}}",
            "locationNotAvailable": "{{t .server.Lang "index_js_location_not_available"}}",
            "locationPrefilled": "{{t .server.Lang "index_js_location_prefilled"}}",
            "approximateLocation": "{{t .server.Lang "index_js_approximate_location"}}"
        }
    </script>

{{if not .HideFooter}}
{{template "footer" .}}
{{else}}
</body>
</html>
{{end}}
