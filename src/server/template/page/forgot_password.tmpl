{{define "page/forgot_password.tmpl"}}
<!DOCTYPE html>
<html lang="en" class="{{if .server.ThemeClass}}{{.server.ThemeClass}}{{else}}theme-dark{{end}}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{.title}}</title>
    <link rel="stylesheet" href="/static/css/common.css">
    <link rel="stylesheet" href="/static/css/components.css">
    <link rel="stylesheet" href="/static/css/public.css">
</head>
<body>
    <div class="auth-container">
        <div class="auth-card">
            <h1>{{t .server.Lang "forgot_password_heading"}}</h1>
            <p>{{t .server.Lang "forgot_password_intro"}}</p>

            {{if .error}}
            <div class="alert alert-error">{{.error}}</div>
            {{end}}

            <form method="POST" class="auth-form">
                <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
                <div class="form-group">
                    <label for="email">{{t .server.Lang "forgot_password_email_label"}}</label>
                    <input type="email" id="email" name="email" required autocomplete="email" placeholder="you@example.com">
                </div>
                <button type="submit" class="btn btn-primary">{{t .server.Lang "forgot_password_submit"}}</button>
            </form>

            <div class="auth-links">
                <a href="/server/auth/login">{{t .server.Lang "forgot_password_back_to_login"}}</a>
            </div>
        </div>
    </div>
</body>
</html>
{{end}}
