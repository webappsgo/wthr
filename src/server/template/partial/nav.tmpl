{{define "navbar"}}
<input class="nav-toggle" type="checkbox" id="nav-toggle" aria-label="{{t .lang "nav.menu_toggle"}}">
<header class="site-header">
    <a class="navbar-brand" href="/">
        {{if and .server.Logo .server.Logo200}}
        <img src="{{.server.Logo200}}" srcset="{{.server.Logo50}} 50w, {{.server.Logo200}} 200w" sizes="(max-width: 767px) 50px, 200px" width="200" alt="{{.server.Title}}">
        {{else}}
        <span>{{.server.Title}}</span>
        {{end}}
    </a>
    <nav class="nav-links" id="navigation" aria-label="{{t .lang "nav.main_aria"}}">
        <a href="/" class="navbar-link {{if eq .page "weather"}}active{{end}}"{{if eq .page "weather"}} aria-current="page"{{end}}>{{t .lang "nav.home"}}</a>
        <a href="/moon" class="navbar-link {{if eq .page "moon"}}active{{end}}"{{if eq .page "moon"}} aria-current="page"{{end}}>{{t .lang "nav.moon"}}</a>
        <a href="/severe-weather" class="navbar-link {{if eq .page "severe-weather"}}active{{end}}"{{if eq .page "severe-weather"}} aria-current="page"{{end}}>{{t .lang "nav.alerts"}}</a>
        <a href="/earthquakes" class="navbar-link {{if eq .page "earthquake"}}active{{end}}"{{if eq .page "earthquake"}} aria-current="page"{{end}}>{{t .lang "nav.earthquakes"}}</a>
    </nav>
    <label class="nav-toggle-label" for="nav-toggle" aria-label="{{t .lang "nav.menu_toggle"}}">☰</label>
    <div class="header-actions">
        {{if .user.Email}}
        <div class="notification-bell">
            <button class="bell-button" data-action="nav-dropdown-toggle" data-dropdown-id="notification-dropdown" data-trigger-id="notification-bell" id="notification-bell" aria-label="{{t .lang "nav.notifications"}}" aria-haspopup="true" aria-expanded="false">
                <svg class="bell-icon" width="20" height="20" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 2a6 6 0 00-6 6v3.586l-.707.707A1 1 0 004 14h12a1 1 0 00.707-1.707L16 11.586V8a6 6 0 00-6-6zM10 18a3 3 0 01-3-3h6a3 3 0 01-3 3z"/></svg>
                <span id="notification-badge" class="badge" aria-live="polite" role="status"></span>
            </button>
            <div class="notification-dropdown" id="notification-dropdown" role="menu" hidden>
                <div class="dropdown-header">
                    <span>{{t .lang "nav.notifications"}}</span>
                    <button class="mark-all-read" data-action="nav-notifications-mark-all-read">{{t .lang "notifications.mark_all_read"}}</button>
                </div>
                <div class="notification-list" id="notification-list"><div class="notification-empty">{{t .lang "nav.no_notifications"}}</div></div>
                <a href="/users/notifications" class="dropdown-footer">{{t .lang "nav.view_all"}}</a>
            </div>
        </div>
        <div class="profile-avatar">
            <button class="avatar" data-action="nav-dropdown-toggle" data-dropdown-id="profile-dropdown" data-trigger-id="profile-avatar" id="profile-avatar" aria-label="{{t .lang "nav.user_menu"}}" aria-haspopup="true" aria-expanded="false">
                {{index .user.Email 0 | printf "%c" | upper}}
            </button>
            <div class="profile-dropdown" id="profile-dropdown" role="menu" aria-labelledby="profile-avatar" hidden>
                <div class="profile-dropdown-header">
                    <div>{{if .user.DisplayName}}{{.user.DisplayName}}{{else if .user.Username}}{{.user.Username}}{{else}}{{.user.Email}}{{end}}</div>
                    <div class="profile-dropdown-role">{{if .user.Role}}{{.user.Role}}{{else}}{{t .lang "nav.profile"}}{{end}}</div>
                </div>
                <nav class="profile-dropdown-menu">
                    <a href="/users/profile" class="profile-dropdown-item" role="menuitem">{{t .lang "nav.profile"}}</a>
                    <a href="/users/settings" class="profile-dropdown-item" role="menuitem">{{t .lang "nav.settings"}}</a>
                    <a href="/users/security" class="profile-dropdown-item" role="menuitem">{{t .lang "nav.security"}}</a>
                    <a href="/users/tokens" class="profile-dropdown-item" role="menuitem">{{t .lang "nav.api_tokens"}}</a>
                    <form action="/server/preferences" method="post" class="profile-dropdown-item theme-toggle-row">
                        <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
                        <input type="hidden" name="theme" value="{{nextTheme (or .server.Theme "dark")}}">
                        <span class="theme-toggle-label">{{t .lang "theme.label"}}</span>
                        <button type="submit" class="theme-btn">{{t .lang (printf "theme.%s" (or .server.Theme "dark"))}}</button>
                    </form>
                    <a href="/server/auth/logout" class="profile-dropdown-item" role="menuitem">{{t .lang "nav.logout"}}</a>
                </nav>
            </div>
        </div>
        {{else}}
        <a href="/server/preferences" class="header-preferences">{{t .lang "nav.preferences"}}</a>
        <form action="/server/preferences" method="post" class="theme-toggle-form">
            <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
            <input type="hidden" name="theme" value="{{nextTheme (or .server.Theme "dark")}}">
            <button type="submit" class="theme-button" aria-label="{{t .lang "theme.switch"}} ({{t .lang (printf "theme.%s" (or .server.Theme "dark"))}})" title="{{t .lang "theme.switch"}}">{{t .lang (printf "theme.%s" (or .server.Theme "dark"))}}</button>
        </form>
        {{end}}
    </div>
    {{if .operator_header}}{{.operator_header}}{{end}}
</header>
<nav class="nav-drawer" id="mobile-navigation" aria-label="{{t .lang "nav.mobile_aria"}}">
    <a href="/" class="mobile-menu-item {{if eq .page "weather"}}active{{end}}"{{if eq .page "weather"}} aria-current="page"{{end}}>{{t .lang "nav.home"}}</a>
    <a href="/moon" class="mobile-menu-item {{if eq .page "moon"}}active{{end}}"{{if eq .page "moon"}} aria-current="page"{{end}}>{{t .lang "nav.moon"}}</a>
    <a href="/severe-weather" class="mobile-menu-item {{if eq .page "severe-weather"}}active{{end}}"{{if eq .page "severe-weather"}} aria-current="page"{{end}}>{{t .lang "nav.alerts"}}</a>
    <a href="/earthquakes" class="mobile-menu-item {{if eq .page "earthquake"}}active{{end}}"{{if eq .page "earthquake"}} aria-current="page"{{end}}>{{t .lang "nav.earthquakes"}}</a>
</nav>
<label class="nav-scrim" for="nav-toggle" aria-hidden="true"></label>
{{if .admin_impersonation}}
<aside class="impersonation-banner" role="status">
    <p>{{t .lang "admin.impersonation.active_notice"}}</p>
    <form method="post" action="/server/auth/impersonation/stop">
        <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
        <button class="btn btn-secondary" type="submit">{{t .lang "admin.impersonation.return_action"}}</button>
    </form>
</aside>
{{end}}
{{end}}
