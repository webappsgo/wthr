{{define "header"}}
{{/* Site header (logo, branding) - Mandatory partial */}}
<header class="site-header">
    <div class="container">
        <div class="header-content">
            <p class="site-logo">{{if .server.Logo}}<img src="{{.server.Logo200}}" srcset="{{.server.Logo50}} 50w, {{.server.Logo200}} 200w" sizes="(max-width: 767px) 50px, 200px" width="200" alt="{{.server.Title}}">{{else}}{{if .server.Title}}{{.server.Title}}{{else}}wthr{{end}}{{end}}</p>
            {{if .operator_header}}{{.operator_header}}{{end}}
        </div>
    </div>
</header>
{{end}}
