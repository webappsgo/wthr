{{define "location_details"}}
<!-- Location details: one definition list, same on every page -->
<section class="location-details-section" aria-label="{{t .Lang "location.heading"}}">
    <dl class="location-info">
        <div class="location-detail">
            <dt class="location-detail__label"><span aria-hidden="true">📍</span> {{t .Lang "location.label"}}</dt>
            <dd class="location-detail__value location-detail__value--name">{{if .Data.Location.ShortName}}{{.Data.Location.ShortName}}{{else}}{{.Data.Location.Name}}, {{.Data.Location.Country}}{{end}}</dd>
        </div>
        <div class="location-detail">
            <dt class="location-detail__label"><span aria-hidden="true">🌍</span> {{t .Lang "location.country"}}</dt>
            <dd class="location-detail__value location-detail__value--country">{{.Data.Location.Country}}</dd>
        </div>
        <div class="location-detail">
            <dt class="location-detail__label"><span aria-hidden="true">🌐</span> {{t .Lang "location.coordinates"}}</dt>
            <dd class="location-detail__value location-detail__value--coords">{{if and .Data.Location.Latitude .Data.Location.Longitude}}{{.Data.Location.Latitude}}, {{.Data.Location.Longitude}}{{else}}{{t .Lang "location.unknown"}}{{end}}</dd>
        </div>
        {{if .Data.Location.Timezone}}
        <div class="location-detail">
            <dt class="location-detail__label"><span aria-hidden="true">🕐</span> {{t .Lang "location.timezone"}}</dt>
            <dd class="location-detail__value location-detail__value--timezone">{{.Data.Location.Timezone}}</dd>
        </div>
        {{end}}
        {{if .Data.Location.Population}}
        <div class="location-detail">
            <dt class="location-detail__label"><span aria-hidden="true">👥</span> {{t .Lang "location.population"}}</dt>
            <dd class="location-detail__value location-detail__value--population">{{.Data.Location.PopulationFormatted}}</dd>
        </div>
        {{end}}
    </dl>
</section>
{{end}}
