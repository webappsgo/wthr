<!DOCTYPE html>
<html lang="{{if .server.Lang}}{{.server.Lang}}{{else}}en{{end}}" dir="{{if eq (printf "%v" .server.Lang) "ar"}}rtl{{else}}ltr{{end}}" class="{{if .server.ThemeClass}}{{.server.ThemeClass}}{{else}}theme-dark{{end}}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{t .server.Lang "loading.title"}}</title>
    <link rel="stylesheet" href="{{asset "/static/css/common.css"}}">
    <link rel="stylesheet" href="{{asset "/static/css/components.css"}}">
    <link rel="stylesheet" href="{{asset "/static/css/public.css"}}">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>☕</text></svg>">
</head>
<body>
    <div class="weather-container">
        <div class="weather-header">
            ☕ {{t .server.Lang "loading.brand"}}
        </div>

        <div class="loading-page-container">
            <div class="coffee-spinner">☕</div>

            <h2 class="loading-page-title">
                {{t .server.Lang "loading.heading"}}<span class="loading-dots"></span>
            </h2>

            <div class="status-info">
                <div class="loading-page-status-item--yellow">
                    🌍 {{t .server.Lang "loading.step_locations"}}
                </div>
                <div class="loading-page-status-item--green">
                    🌤️ {{t .server.Lang "loading.step_services"}}
                </div>
                <div class="loading-page-status-item--purple">
                    🎨 {{t .server.Lang "loading.step_ui"}}
                </div>
            </div>

            <div class="margin-y-2">
                <p class="text-comment">
                    {{t .server.Lang "loading.intro"}}
                </p>

                <div class="margin-y-15">
                    <span class="loading-page-countdown-label">{{t .server.Lang "loading.next_check"}}</span>
                    <span id="countdown" class="retry-countdown">30</span>
                    <span class="loading-page-countdown-label">{{t .server.Lang "loading.seconds"}}</span>
                    <div class="loading-page-countdown-note">
                        {{t .server.Lang "loading.auto_check"}}
                    </div>
                </div>

                <button id="retry-btn" class="search-button loading-page-retry-button" data-action="loading-retry">
                    🔄 {{t .server.Lang "loading.retry"}}
                </button>
            </div>

            <div class="loading-page-while-wait-box">
                <h4 class="loading-page-while-wait-title">{{t .server.Lang "loading.wait_heading"}}</h4>
                <p class="loading-page-while-wait-text">
                    {{t .server.Lang "loading.wait_text"}}
                </p>
                <div class="loading-page-code-box">
                    <div class="loading-page-code-line loading-page-code-line--cyan">curl -q -LSs {{.HostInfo.FullHost}}/London,GB?format=3</div>
                    <div class="loading-page-code-line loading-page-code-line--pink">curl -q -LSs {{.HostInfo.FullHost}}/moon/Tokyo,JP</div>
                </div>
            </div>
        </div>

        <div class="footer">
            <p>{{t .server.Lang "loading.footer"}}</p>
        </div>
    </div>

    <script src="{{asset "/static/js/app.js"}}" defer></script>
</body>
</html>
