{{template "head" .}}
{{template "admin_header" .}}
{{- $lang := "en" -}}
{{- if .lang}}{{$lang = .lang}}{{end -}}
{{- $ap := "/server/admin" -}}
{{- if .admin_path}}{{$ap = .admin_path}}{{end -}}
{{- $apiPath := "/api/v1/server/admin" -}}
{{- if .admin_api_path}}{{$apiPath = .admin_api_path}}{{end -}}
  <div class="admin-header">
    <h1>{{t $lang "admin.channels.title"}}</h1>
    <p class="admin-page-intro">{{t $lang "admin.channels.intro"}}</p>
  </div>

  {{template "flash" .}}

  {{if not .channels}}
  <section class="admin-section" aria-labelledby="channels-list-heading">
    <div class="section-header">
      <h2 id="channels-list-heading">{{t $lang "admin.channels.list_heading"}}</h2>
    </div>
    <div class="empty-state">
      <p class="empty-state__icon" aria-hidden="true">&#128225;</p>
      <h3 class="empty-state__title">{{t $lang "admin.channels.empty_title"}}</h3>
      <p class="empty-state__message">{{t $lang "admin.channels.empty_message"}}</p>
      <a class="btn btn-primary" href="{{$ap}}/config/notifications">{{t $lang "admin.channels.empty_action"}}</a>
    </div>
  </section>
  {{else}}
  <section class="admin-section" aria-labelledby="channels-list-heading">
    <div class="section-header">
      <h2 id="channels-list-heading">{{t $lang "admin.channels.list_heading"}}</h2>
    </div>
    {{range .channels}}
    <article class="admin-card" aria-labelledby="channel-{{.ChannelType}}">
      <h3 class="admin-card__title" id="channel-{{.ChannelType}}">{{.ChannelName}}</h3>
      <dl class="admin-detail-list">
        <dt class="admin-detail-list__term">{{t $lang "admin.channels.col_type"}}</dt>
        <dd class="admin-detail-list__value admin-break-all"><code>{{.ChannelType}}</code></dd>
        <dt class="admin-detail-list__term">{{t $lang "admin.channels.col_state"}}</dt>
        <dd class="admin-detail-list__value">{{.State}}</dd>
        <dt class="admin-detail-list__term">{{t $lang "admin.channels.col_enabled"}}</dt>
        <dd class="admin-detail-list__value">{{if .Enabled}}{{t $lang "admin.channels.yes"}}{{else}}{{t $lang "admin.channels.no"}}{{end}}</dd>
      </dl>
      <form class="admin-form" method="post" action="{{$ap}}/config/channels/{{.ChannelType}}">
        <input type="hidden" name="csrf_token" value="{{$.csrf_token}}">
        <div class="form-group">
          <label class="form-check" for="channel-{{.ChannelType}}-enabled">
            <input type="checkbox" id="channel-{{.ChannelType}}-enabled" name="enabled" value="true" {{if .Enabled}}checked{{end}}>
            <span>{{t $lang "admin.channels.field_enabled"}}</span>
          </label>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn-primary">{{t $lang "admin.channels.action_update"}}</button>
        </div>
      </form>
      <form class="admin-form" method="post" action="{{$ap}}/config/channels/{{.ChannelType}}/enable">
        <input type="hidden" name="csrf_token" value="{{$.csrf_token}}">
        <div class="form-actions">
          <button type="submit" class="btn btn-secondary">{{t $lang "admin.channels.op_enable"}}</button>
        </div>
      </form>
      <form class="admin-form" method="post" action="{{$ap}}/config/channels/{{.ChannelType}}/disable">
        <input type="hidden" name="csrf_token" value="{{$.csrf_token}}">
        <div class="form-actions">
          <button type="submit" class="btn btn-secondary">{{t $lang "admin.channels.op_disable"}}</button>
        </div>
      </form>
      <form class="admin-form" method="post" action="{{$ap}}/config/channels/{{.ChannelType}}/test">
        <input type="hidden" name="csrf_token" value="{{$.csrf_token}}">
        <div class="form-group">
          <label for="channel-{{.ChannelType}}-recipient">{{t $lang "admin.channels.field_recipient"}}</label>
          <input type="email" id="channel-{{.ChannelType}}-recipient" name="recipient" required autocomplete="email">
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn-secondary">{{t $lang "admin.channels.op_test"}}</button>
        </div>
      </form>
    </article>
    {{end}}
  </section>
  {{end}}

  <section class="admin-section" aria-labelledby="channels-read-heading">
    <div class="section-header">
      <h2 id="channels-read-heading">{{t $lang "admin.channels.read_heading"}}</h2>
    </div>
    <dl class="admin-detail-list">
      <dt class="admin-detail-list__term">{{t $lang "admin.channels.read_list"}}</dt>
      <dd class="admin-detail-list__value admin-break-all"><code>GET {{$apiPath}}/config/channels</code></dd>
      <dt class="admin-detail-list__term">{{t $lang "admin.channels.read_definitions"}}</dt>
      <dd class="admin-detail-list__value admin-break-all"><code>GET {{$apiPath}}/config/channels/definitions</code></dd>
      <dt class="admin-detail-list__term">{{t $lang "admin.channels.read_detail"}}</dt>
      <dd class="admin-detail-list__value admin-break-all"><code>GET {{$apiPath}}/config/channels/:type</code></dd>
      <dt class="admin-detail-list__term">{{t $lang "admin.channels.read_stats"}}</dt>
      <dd class="admin-detail-list__value admin-break-all"><code>GET {{$apiPath}}/config/channels/:type/stats</code></dd>
      <dt class="admin-detail-list__term">{{t $lang "admin.channels.read_queue"}}</dt>
      <dd class="admin-detail-list__value admin-break-all"><code>GET {{$apiPath}}/config/channels/queue/stats</code></dd>
      <dt class="admin-detail-list__term">{{t $lang "admin.channels.read_history"}}</dt>
      <dd class="admin-detail-list__value admin-break-all"><code>GET {{$apiPath}}/config/channels/history</code></dd>
    </dl>
  </section>

  <section class="admin-section" aria-labelledby="channels-write-heading">
    <div class="section-header">
      <h2 id="channels-write-heading">{{t $lang "admin.channels.write_heading"}}</h2>
    </div>
    <div class="admin-table-scroll">
      <table class="admin-table">
        <caption class="admin-table-caption">{{t $lang "admin.channels.write_caption"}}</caption>
        <thead class="admin-table-header">
          <tr class="admin-table-head-row">
            <th class="admin-table-head-cell" scope="col">{{t $lang "admin.channels.col_operation"}}</th>
            <th class="admin-table-head-cell" scope="col">{{t $lang "admin.channels.col_endpoint"}}</th>
            <th class="admin-table-head-cell" scope="col">{{t $lang "admin.channels.col_body"}}</th>
          </tr>
        </thead>
        <tbody>
          <tr class="admin-table-body-row">
            <th class="admin-table-body-cell" scope="row">{{t $lang "admin.channels.op_update"}}</th>
            <td class="admin-table-body-cell admin-break-all"><code>PUT {{$apiPath}}/config/channels/:type</code></td>
            <td class="admin-table-body-cell admin-break-all"><code>{"enabled": true, "config": {}}</code></td>
          </tr>
          <tr class="admin-table-body-row">
            <th class="admin-table-body-cell" scope="row">{{t $lang "admin.channels.op_enable"}}</th>
            <td class="admin-table-body-cell admin-break-all"><code>POST {{$apiPath}}/config/channels/:type/enable</code></td>
            <td class="admin-table-body-cell">{{t $lang "admin.channels.body_none"}}</td>
          </tr>
          <tr class="admin-table-body-row">
            <th class="admin-table-body-cell" scope="row">{{t $lang "admin.channels.op_disable"}}</th>
            <td class="admin-table-body-cell admin-break-all"><code>POST {{$apiPath}}/config/channels/:type/disable</code></td>
            <td class="admin-table-body-cell">{{t $lang "admin.channels.body_none"}}</td>
          </tr>
          <tr class="admin-table-body-row">
            <th class="admin-table-body-cell" scope="row">{{t $lang "admin.channels.op_test"}}</th>
            <td class="admin-table-body-cell admin-break-all"><code>POST {{$apiPath}}/config/channels/:type/test</code></td>
            <td class="admin-table-body-cell admin-break-all"><code>{"recipient": "..."}</code></td>
          </tr>
          <tr class="admin-table-body-row">
            <th class="admin-table-body-cell" scope="row">{{t $lang "admin.channels.op_initialize"}}</th>
            <td class="admin-table-body-cell admin-break-all"><code>POST {{$apiPath}}/config/channels/initialize</code></td>
            <td class="admin-table-body-cell">{{t $lang "admin.channels.body_none"}}</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>
{{template "admin_footer" .}}
