{{template "head" .}}
{{template "admin_header" .}}
{{- $lang := "en" -}}
{{- if .lang}}{{$lang = .lang}}{{end -}}
{{- $ap := "/server/administration" -}}
{{- if .admin_path}}{{$ap = .admin_path}}{{end -}}
  <div class="admin-header">
    <h1>{{t $lang "admin.tokens.title"}}</h1>
    <p class="admin-page-intro">{{t $lang "admin.tokens.intro"}}</p>
  </div>
  {{if .flash}}<div class="alert alert-{{.flash.Kind}}" role="status">{{t $lang .flash.Key}}</div>{{end}}
  {{if .new_token}}<section class="admin-section" role="alert" aria-labelledby="new-token-heading">
    <h2 id="new-token-heading">{{t $lang "admin.tokens.new_token_heading"}}</h2>
    <p>{{t $lang "admin.tokens.new_token_notice"}}</p>
    <code class="admin-break-all">{{.new_token}}</code>
  </section>{{end}}
  <section class="admin-section" aria-labelledby="tokens-create-heading">
    <div class="section-header"><h2 id="tokens-create-heading">{{t $lang "admin.tokens.create_heading"}}</h2></div>
    {{if .users}}<form method="post" action="{{$ap}}/security/tokens">
      <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
      <label for="token-user">{{t $lang "admin.tokens.user_label"}}</label>
      <select id="token-user" name="user_id" required>{{range .users}}{{if and .IsActive (not .IsBanned)}}<option value="{{.ID}}">{{.Username}} ({{.Email}})</option>{{end}}{{end}}</select>
      <label for="token-name">{{t $lang "admin.tokens.name"}}</label>
      <input id="token-name" name="name" maxlength="100" required>
      <button class="btn btn-primary" type="submit">{{t $lang "admin.tokens.create_action"}}</button>
    </form>{{else}}<p>{{t $lang "admin.tokens.no_users"}}</p>{{end}}
  </section>
  <section class="admin-section" aria-labelledby="tokens-list-heading">
    <div class="section-header"><h2 id="tokens-list-heading">{{t $lang "admin.tokens.list_heading"}}</h2></div>
    {{if .tokens}}
    <div class="table-responsive"><table class="admin-table">
      <thead><tr><th>{{t $lang "admin.tokens.owner"}}</th><th>{{t $lang "admin.tokens.name"}}</th><th>{{t $lang "admin.tokens.prefix"}}</th><th>{{t $lang "admin.tokens.created"}}</th><th>{{t $lang "admin.tokens.last_used"}}</th><th>{{t $lang "admin.tokens.expires"}}</th><th>{{t $lang "admin.tokens.actions"}}</th></tr></thead>
      <tbody>{{range .tokens}}<tr>
        <td>{{.Email}} <span class="text-muted">(#{{.UserID}})</span></td><td>{{.Name}}</td><td><code>{{.Prefix}}</code></td>
        <td>{{.CreatedAt}}</td><td>{{if .LastUsedAt}}{{.LastUsedAt}}{{else}}{{t $lang "admin.tokens.never_used"}}{{end}}</td>
        <td>{{if .ExpiresAt}}{{.ExpiresAt}}{{else}}{{t $lang "admin.tokens.never_expires"}}{{end}}</td>
        <td><form method="post" action="{{$ap}}/security/tokens/{{.ID}}/revoke">
          <input type="hidden" name="csrf_token" value="{{$.csrf_token}}">
          <button class="btn btn-danger" type="submit">{{t $lang "admin.tokens.revoke_action"}}</button>
        </form></td>
      </tr>{{end}}</tbody>
    </table></div>
    {{else}}
      <div class="empty-state"><p class="empty-state__icon" aria-hidden="true">&#128273;</p><h3 class="empty-state__title">{{t $lang "admin.tokens.empty_title"}}</h3><p class="empty-state__message">{{t $lang "admin.tokens.empty_message"}}</p></div>
    {{end}}
  </section>
{{template "admin_footer" .}}
