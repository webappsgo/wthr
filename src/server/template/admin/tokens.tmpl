{{template "head" .}}
{{template "admin_header" .}}
{{- $lang := "en" -}}
{{- if .lang}}{{$lang = .lang}}{{end -}}
{{- $ap := "/server/admin" -}}
{{- if .admin_path}}{{$ap = .admin_path}}{{end -}}
  <div class="admin-header">
    <h1>{{t $lang "admin.tokens.title"}}</h1>
    <p class="admin-page-intro">{{t $lang "admin.tokens.intro"}}</p>
  </div>

  <section class="admin-section" aria-labelledby="tokens-list-heading">
    <div class="section-header">
      <h2 id="tokens-list-heading">{{t $lang "admin.tokens.list_heading"}}</h2>
    </div>
    <div class="empty-state">
      <p class="empty-state__icon" aria-hidden="true">&#128273;</p>
      <h3 class="empty-state__title">{{t $lang "admin.tokens.empty_title"}}</h3>
      <p class="empty-state__message">{{t $lang "admin.tokens.empty_message"}}</p>
      <a class="btn btn-primary" href="{{$ap}}/config/security">{{t $lang "admin.tokens.empty_action"}}</a>
    </div>
  </section>
{{template "admin_footer" .}}
