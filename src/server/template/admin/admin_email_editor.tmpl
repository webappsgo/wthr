{{define "admin/admin_email_editor.tmpl"}}
{{template "head" .}}
{{template "admin_header" .}}
{{- $lang := "en" -}}
{{- if .lang}}{{$lang = .lang}}{{end -}}
{{- $ap := "/server/admin" -}}
{{- if .admin_path}}{{$ap = .admin_path}}{{end -}}
    <div class="content-header">
        <h1>{{t $lang "admin.email_editor.title"}}</h1>
    </div>

    {{template "flash" .}}

    <div class="admin-page-container wide">
        <div class="info-box">
            <h4>{{t $lang "admin.email_editor.info_heading"}}</h4>
            <p>{{t $lang "admin.email_editor.info_body"}}</p>
        </div>

        <div class="editor-layout">
            <div class="template-list" role="navigation" aria-label="{{t $lang "admin.email_editor.nav_aria"}}">
                <h2>{{t $lang "admin.email_editor.templates_heading"}}</h2>
                {{if not .templates}}
                <p class="empty-state__message">{{t $lang "admin.email_editor.templates_empty"}}</p>
                {{else}}
                {{range .templates}}
                <a class="template-item{{if eq .Name $.selected}} active{{end}}" data-template="{{.Name}}" href="{{$ap}}/config/email/templates?template={{.Name}}"{{if eq .Name $.selected}} aria-current="true"{{end}}>
                    <span class="template-name">{{t $lang (printf "admin.email_editor.tpl_%s_name" .Name)}}</span>
                    <span class="template-desc">{{t $lang (printf "admin.email_editor.tpl_%s_desc" .Name)}}</span>
                </a>
                {{end}}
                {{end}}
            </div>

            {{if .current}}
            <div class="editor-panel">
                <h2><span id="editorTitle">{{t $lang "admin.email_editor.edit_heading"}}</span></h2>

                <form id="templateForm" class="admin-form" method="post" action="{{$ap}}/config/email/templates" enctype="application/x-www-form-urlencoded">
                    <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
                    <input type="hidden" name="template" id="templateName" value="{{.selected}}">
                    <div class="form-group">
                        <label for="templateSubject">{{t $lang "admin.email_editor.subject_label"}}</label>
                        <input type="text" id="templateSubject" name="subject" required value="{{.current.Subject}}" placeholder="{{t $lang "admin.email_editor.subject_placeholder"}}">
                    </div>

                    <div class="form-group">
                        <label for="templateBody">{{t $lang "admin.email_editor.body_label"}}</label>
                        <textarea id="templateBody" name="body" required placeholder="{{t $lang "admin.email_editor.body_placeholder"}}">{{.current.Body}}</textarea>

                        <div class="variables-help">
                            <h4>{{t $lang "admin.email_editor.variables_heading"}}</h4>
                            <span class="variable-tag" data-var="{app_name}">{app_name}</span>
                            <span class="variable-tag" data-var="{app_url}">{app_url}</span>
                            <span class="variable-tag" data-var="{admin_email}">{admin_email}</span>
                            <span class="variable-tag" data-var="{current_year}">{current_year}</span>
                            <span class="variable-tag" data-var="{reset_link}">{reset_link}</span>
                            <span class="variable-tag" data-var="{backup_file}">{backup_file}</span>
                            <span class="variable-tag" data-var="{error_message}">{error_message}</span>
                            <span class="variable-tag" data-var="{days_until_expiry}">{days_until_expiry}</span>
                            <span class="variable-tag" data-var="{ip_address}">{ip_address}</span>
                            <span class="variable-tag" data-var="{timestamp}">{timestamp}</span>
                        </div>
                    </div>

                    <div class="action-buttons">
                        <button type="submit" class="btn btn-primary" id="saveBtn" aria-label="{{t $lang "admin.email_editor.save_aria"}}">
                            {{t $lang "admin.email_editor.save_action"}}
                        </button>
                    </div>
                </form>

                <form class="admin-form" method="post" action="{{$ap}}/config/email/templates/preview" enctype="application/x-www-form-urlencoded">
                    <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
                    <input type="hidden" name="template" value="{{.selected}}">
                    <div class="form-actions">
                        <button type="submit" class="btn btn-secondary" id="testBtn" aria-label="{{t $lang "admin.email_editor.test_aria"}}">
                            {{t $lang "admin.email_editor.test_action"}}
                        </button>
                    </div>
                </form>
            </div>

            <div class="preview-panel">
                <h2>{{t $lang "admin.email_editor.preview_heading"}}</h2>
                <div class="preview-content" role="region" aria-label="{{t $lang "admin.email_editor.preview_aria"}}">
                    <div class="preview-subject" id="previewSubject" aria-live="polite">{{t $lang "admin.email_editor.preview_subject_placeholder"}}</div>
                    <div class="preview-body" id="previewBody" aria-live="polite">{{t $lang "admin.email_editor.preview_body_placeholder"}}</div>
                </div>
                <button type="button" class="btn btn-secondary" id="reloadBtn" aria-label="{{t $lang "admin.email_editor.reload_aria"}}">
                    {{t $lang "admin.email_editor.reload_action"}}
                </button>
            </div>
            {{end}}
        </div>
    </div>

    <script type="application/json" id="admin-email-editor-data">{"subjectPlaceholder": {{t $lang "admin.email_editor.preview_subject_placeholder"}}, "bodyPlaceholder": {{t $lang "admin.email_editor.preview_body_placeholder"}}, "reloadConfirm": {{t $lang "admin.email_editor.reload_confirm"}}, "reloadTitle": {{t $lang "admin.email_editor.reload_title"}}}</script>
    <script src="/static/js/app.js"></script>
{{template "admin_footer" .}}
{{end}}
