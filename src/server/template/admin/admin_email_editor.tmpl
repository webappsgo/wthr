{{define "admin/admin_email_editor.tmpl"}}
{{template "head" .}}
{{template "admin_header" .}}
{{- $lang := "en" -}}
{{- if .lang}}{{$lang = .lang}}{{end -}}
    <div class="content-header">
        <h1>{{t $lang "admin.email_editor.title"}}</h1>
    </div>

    <div class="admin-page-container wide">
        <div class="admin-alert admin-alert-success" id="successAlert" role="alert"></div>
        <div class="admin-alert admin-alert-error" id="errorAlert" role="alert"></div>

        <div class="info-box">
            <h4>{{t $lang "admin.email_editor.info_heading"}}</h4>
            <p>{{t $lang "admin.email_editor.info_body"}}</p>
        </div>

        <div class="editor-layout">
            <!-- Template List -->
            <div class="template-list" role="navigation" aria-label="{{t $lang "admin.email_editor.nav_aria"}}">
                <h2>{{t $lang "admin.email_editor.templates_heading"}}</h2>
                <div class="template-item active" data-template="welcome" tabindex="0" role="button" aria-pressed="true">
                    <span class="template-name">{{t $lang "admin.email_editor.tpl_welcome_name"}}</span>
                    <span class="template-desc">{{t $lang "admin.email_editor.tpl_welcome_desc"}}</span>
                </div>
                <div class="template-item" data-template="password_reset" tabindex="0" role="button" aria-pressed="false">
                    <span class="template-name">{{t $lang "admin.email_editor.tpl_password_reset_name"}}</span>
                    <span class="template-desc">{{t $lang "admin.email_editor.tpl_password_reset_desc"}}</span>
                </div>
                <div class="template-item" data-template="backup_complete" tabindex="0" role="button" aria-pressed="false">
                    <span class="template-name">{{t $lang "admin.email_editor.tpl_backup_complete_name"}}</span>
                    <span class="template-desc">{{t $lang "admin.email_editor.tpl_backup_complete_desc"}}</span>
                </div>
                <div class="template-item" data-template="backup_failed" tabindex="0" role="button" aria-pressed="false">
                    <span class="template-name">{{t $lang "admin.email_editor.tpl_backup_failed_name"}}</span>
                    <span class="template-desc">{{t $lang "admin.email_editor.tpl_backup_failed_desc"}}</span>
                </div>
                <div class="template-item" data-template="ssl_expiring" tabindex="0" role="button" aria-pressed="false">
                    <span class="template-name">{{t $lang "admin.email_editor.tpl_ssl_expiring_name"}}</span>
                    <span class="template-desc">{{t $lang "admin.email_editor.tpl_ssl_expiring_desc"}}</span>
                </div>
                <div class="template-item" data-template="ssl_renewed" tabindex="0" role="button" aria-pressed="false">
                    <span class="template-name">{{t $lang "admin.email_editor.tpl_ssl_renewed_name"}}</span>
                    <span class="template-desc">{{t $lang "admin.email_editor.tpl_ssl_renewed_desc"}}</span>
                </div>
                <div class="template-item" data-template="login_alert" tabindex="0" role="button" aria-pressed="false">
                    <span class="template-name">{{t $lang "admin.email_editor.tpl_login_alert_name"}}</span>
                    <span class="template-desc">{{t $lang "admin.email_editor.tpl_login_alert_desc"}}</span>
                </div>
                <div class="template-item" data-template="security_alert" tabindex="0" role="button" aria-pressed="false">
                    <span class="template-name">{{t $lang "admin.email_editor.tpl_security_alert_name"}}</span>
                    <span class="template-desc">{{t $lang "admin.email_editor.tpl_security_alert_desc"}}</span>
                </div>
                <div class="template-item" data-template="scheduler_error" tabindex="0" role="button" aria-pressed="false">
                    <span class="template-name">{{t $lang "admin.email_editor.tpl_scheduler_error_name"}}</span>
                    <span class="template-desc">{{t $lang "admin.email_editor.tpl_scheduler_error_desc"}}</span>
                </div>
                <div class="template-item" data-template="test" tabindex="0" role="button" aria-pressed="false">
                    <span class="template-name">{{t $lang "admin.email_editor.tpl_test_name"}}</span>
                    <span class="template-desc">{{t $lang "admin.email_editor.tpl_test_desc"}}</span>
                </div>
            </div>

            <!-- Editor Panel -->
            <div class="editor-panel">
                <h2>
                    <span id="editorTitle">{{t $lang "admin.email_editor.edit_heading"}}</span>
                </h2>

                <form id="templateForm">
    <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
                    <div class="form-group">
                        <label for="templateSubject">{{t $lang "admin.email_editor.subject_label"}}</label>
                        <input type="text" id="templateSubject" placeholder="{{t $lang "admin.email_editor.subject_placeholder"}}" aria-required="true">
                    </div>

                    <div class="form-group">
                        <label for="templateBody">{{t $lang "admin.email_editor.body_label"}}</label>
                        <textarea id="templateBody" placeholder="{{t $lang "admin.email_editor.body_placeholder"}}" aria-required="true"></textarea>

                        <div class="variables-help">
                            <h4>{{t $lang "admin.email_editor.variables_heading"}}</h4>
                            <span class="variable-tag" data-var="{app_name}">{app_name}</span>
                            <span class="variable-tag" data-var="{app_url}">{app_url}</span>
                            <span class="variable-tag" data-var="{admin_email}">{admin_email}</span>
                            <span class="variable-tag" data-var="{current_year}">{current_year}</span>
                            <span class="variable-tag" data-var="{reset_link}">{reset_link}</span>
                            <span class="variable-tag" data-var="{backup_file}">{backup_file}</span>
                            <span class="variable-tag" data-var="{error_message}">{error_message}</span>
                            <span class="variable-tag" data-var="{days_until_expiry}">{days_until_expiry}</span>
                            <span class="variable-tag" data-var="{ip_address}">{ip_address}</span>
                            <span class="variable-tag" data-var="{timestamp}">{timestamp}</span>
                        </div>
                    </div>

                    <div class="action-buttons">
                        <button type="button" class="btn btn-primary" id="saveBtn" aria-label="{{t $lang "admin.email_editor.save_aria"}}">
                            {{t $lang "admin.email_editor.save_action"}}
                        </button>
                        <button type="button" class="btn btn-secondary" id="reloadBtn" aria-label="{{t $lang "admin.email_editor.reload_aria"}}">
                            {{t $lang "admin.email_editor.reload_action"}}
                        </button>
                        <button type="button" class="btn btn-success" id="testBtn" aria-label="{{t $lang "admin.email_editor.test_aria"}}">
                            {{t $lang "admin.email_editor.test_action"}}
                        </button>
                    </div>
                </form>
            </div>

            <!-- Preview Panel -->
            <div class="preview-panel">
                <h2>{{t $lang "admin.email_editor.preview_heading"}}</h2>
                <div class="preview-content" role="region" aria-label="{{t $lang "admin.email_editor.preview_aria"}}">
                    <div class="preview-subject" id="previewSubject">{{t $lang "admin.email_editor.preview_subject_placeholder"}}</div>
                    <div class="preview-body" id="previewBody">{{t $lang "admin.email_editor.preview_body_placeholder"}}</div>
                </div>
            </div>
        </div>
    </div>

    <script type="application/json" id="admin-email-editor-data">{"adminApiPath": {{.admin_api_path}}}</script>
    <script src="/static/js/app.js"></script>
{{template "admin_footer" .}}
{{end}}
