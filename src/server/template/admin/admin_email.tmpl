{{define "admin/admin_email.tmpl"}}
{{template "head" .}}
{{template "admin_header" .}}
{{- $lang := "en" -}}
{{- if .lang}}{{$lang = .lang}}{{end -}}

            <div class="content-header">
                <h1>📧 {{t $lang "admin.email.title"}}</h1>
                <p class="subtitle">{{t $lang "admin.email.intro"}}</p>
            </div>

            <!-- SMTP Configuration Section -->
            <section class="admin-card" aria-labelledby="smtp-heading">
                <div class="card-header">
                    <h2 id="smtp-heading">{{t $lang "admin.email.smtp_heading"}}</h2>
                    <p class="card-description">{{t $lang "admin.email.smtp_description"}}</p>
                </div>
                <div class="card-body">
                    <form id="smtp-form" class="settings-form">
    <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
                        <div class="form-group">
                            <label class="toggle-label">
                                <input
                                    type="checkbox"
                                    id="smtp_enabled"
                                    name="smtp.enabled"
                                    class="toggle-input"
                                    aria-describedby="smtp_enabled_help"
                                >
                                <span class="toggle-slider"></span>
                                {{t $lang "admin.email.enable_label"}}
                            </label>
                            <small id="smtp_enabled_help" class="form-text">
                                {{t $lang "admin.email.enable_help"}}
                            </small>
                        </div>

                        <div id="smtp-fields" class="smtp-fields">
                            <div class="form-row">
                                <div class="form-group col-md-8">
                                    <label for="smtp_host">
                                        {{t $lang "admin.email.host_label"}}
                                        <span class="required" aria-label="required">*</span>
                                    </label>
                                    <input
                                        type="text"
                                        id="smtp_host"
                                        name="smtp.host"
                                        class="form-control"
                                        placeholder="smtp.gmail.com"
                                        required
                                        aria-required="true"
                                        aria-describedby="smtp_host_help"
                                    >
                                    <small id="smtp_host_help" class="form-text">
                                        {{t $lang "admin.email.host_help"}}
                                    </small>
                                </div>

                                <div class="form-group col-md-4">
                                    <label for="smtp_port">
                                        {{t $lang "admin.email.port_label"}}
                                        <span class="required" aria-label="required">*</span>
                                    </label>
                                    <input
                                        type="number"
                                        id="smtp_port"
                                        name="smtp.port"
                                        class="form-control"
                                        placeholder="587"
                                        min="1"
                                        max="65535"
                                        required
                                        aria-required="true"
                                        aria-describedby="smtp_port_help"
                                    >
                                    <small id="smtp_port_help" class="form-text">
                                        {{t $lang "admin.email.port_help"}}
                                    </small>
                                </div>
                            </div>

                            <div class="form-group">
                                <label for="smtp_username">{{t $lang "admin.email.username_label"}}</label>
                                <input
                                    type="text"
                                    id="smtp_username"
                                    name="smtp.username"
                                    class="form-control"
                                    placeholder="your-email@example.com"
                                    autocomplete="username"
                                    aria-describedby="smtp_username_help"
                                >
                                <small id="smtp_username_help" class="form-text">
                                    {{t $lang "admin.email.username_help"}}
                                </small>
                            </div>

                            <div class="form-group">
                                <label for="smtp_password">{{t $lang "admin.email.password_label"}}</label>
                                <input
                                    type="password"
                                    id="smtp_password"
                                    name="smtp.password"
                                    class="form-control"
                                    placeholder="••••••••"
                                    autocomplete="current-password"
                                    aria-describedby="smtp_password_help"
                                >
                                <small id="smtp_password_help" class="form-text">
                                    {{t $lang "admin.email.password_help"}}
                                </small>
                            </div>

                            <div class="form-group">
                                <label for="smtp_from">{{t $lang "admin.email.from_address_label"}}</label>
                                <input
                                    type="email"
                                    id="smtp_from"
                                    name="smtp.from_address"
                                    class="form-control"
                                    placeholder="no-reply@example.com"
                                    aria-describedby="smtp_from_help"
                                >
                                <small id="smtp_from_help" class="form-text">
                                    {{t $lang "admin.email.from_address_help"}}
                                </small>
                            </div>

                            <div class="form-group">
                                <label for="smtp_from_name">{{t $lang "admin.email.from_name_label"}}</label>
                                <input
                                    type="text"
                                    id="smtp_from_name"
                                    name="smtp.from_name"
                                    class="form-control"
                                    placeholder="Weather App"
                                    aria-describedby="smtp_from_name_help"
                                >
                                <small id="smtp_from_name_help" class="form-text">
                                    {{t $lang "admin.email.from_name_help"}}
                                </small>
                            </div>

                            <div class="form-group">
                                <label for="smtp_encryption">{{t $lang "admin.email.encryption_label"}}</label>
                                <select id="smtp_encryption" name="smtp.encryption" class="form-control" aria-describedby="smtp_encryption_help">
                                    <option value="tls">{{t $lang "admin.email.encryption_tls"}}</option>
                                    <option value="ssl">{{t $lang "admin.email.encryption_ssl"}}</option>
                                    <option value="none">{{t $lang "admin.email.encryption_none"}}</option>
                                </select>
                                <small id="smtp_encryption_help" class="form-text">
                                    {{t $lang "admin.email.encryption_help"}}
                                </small>
                            </div>

                            <div class="alert alert-info" role="status">
                                <strong>{{t $lang "admin.email.providers_heading"}}</strong><br>
                                • <strong>Gmail:</strong> {{t $lang "admin.email.provider_gmail"}}<br>
                                • <strong>Outlook:</strong> {{t $lang "admin.email.provider_outlook"}}<br>
                                • <strong>SendGrid:</strong> {{t $lang "admin.email.provider_sendgrid"}}<br>
                                • <strong>Mailgun:</strong> {{t $lang "admin.email.provider_mailgun"}}
                            </div>
                        </div>

                        <div class="button-group">
                            <button type="submit" class="btn btn-primary" aria-label="{{t $lang "admin.email.save_aria"}}">
                                💾 {{t $lang "admin.email.save_action"}}
                            </button>
                            <button type="button" class="btn btn-success" id="test-email-btn" aria-label="{{t $lang "admin.email.send_test_aria"}}">
                                📨 {{t $lang "admin.email.send_test_action"}}
                            </button>
                            <button type="button" class="btn btn-secondary" id="autodetect-btn" aria-label="{{t $lang "admin.email.autodetect_aria"}}">
                                🔍 {{t $lang "admin.email.autodetect_action"}}
                            </button>
                        </div>
                    </form>
                </div>
            </section>

            <!-- Email Templates Section -->
            <section class="admin-card" aria-labelledby="templates-heading">
                <div class="card-header">
                    <h2 id="templates-heading">{{t $lang "admin.email.templates_heading"}}</h2>
                    <p class="card-description">{{t $lang "admin.email.templates_description"}}</p>
                </div>
                <div class="card-body">
                    <div class="template-list">
                        <div class="template-item">
                            <div class="template-info">
                                <strong>{{t $lang "admin.email.template_welcome_title"}}</strong>
                                <p>{{t $lang "admin.email.template_welcome_desc"}}</p>
                            </div>
                            <a href="{{.admin_path}}/config/email/templates/welcome" class="btn btn-sm btn-secondary">{{t $lang "admin.email.edit_template_action"}}</a>
                        </div>

                        <div class="template-item">
                            <div class="template-info">
                                <strong>{{t $lang "admin.email.template_password_reset_title"}}</strong>
                                <p>{{t $lang "admin.email.template_password_reset_desc"}}</p>
                            </div>
                            <a href="{{.admin_path}}/config/email/templates/password_reset" class="btn btn-sm btn-secondary">{{t $lang "admin.email.edit_template_action"}}</a>
                        </div>

                        <div class="template-item">
                            <div class="template-info">
                                <strong>{{t $lang "admin.email.template_backup_complete_title"}}</strong>
                                <p>{{t $lang "admin.email.template_backup_complete_desc"}}</p>
                            </div>
                            <a href="{{.admin_path}}/config/email/templates/backup_complete" class="btn btn-sm btn-secondary">{{t $lang "admin.email.edit_template_action"}}</a>
                        </div>

                        <div class="template-item">
                            <div class="template-info">
                                <strong>{{t $lang "admin.email.template_backup_failed_title"}}</strong>
                                <p>{{t $lang "admin.email.template_backup_failed_desc"}}</p>
                            </div>
                            <a href="{{.admin_path}}/config/email/templates/backup_failed" class="btn btn-sm btn-secondary">{{t $lang "admin.email.edit_template_action"}}</a>
                        </div>

                        <div class="template-item">
                            <div class="template-info">
                                <strong>{{t $lang "admin.email.template_ssl_expiring_title"}}</strong>
                                <p>{{t $lang "admin.email.template_ssl_expiring_desc"}}</p>
                            </div>
                            <a href="{{.admin_path}}/config/email/templates/ssl_expiring" class="btn btn-sm btn-secondary">{{t $lang "admin.email.edit_template_action"}}</a>
                        </div>

                        <div class="template-item">
                            <div class="template-info">
                                <strong>{{t $lang "admin.email.template_ssl_renewed_title"}}</strong>
                                <p>{{t $lang "admin.email.template_ssl_renewed_desc"}}</p>
                            </div>
                            <a href="{{.admin_path}}/config/email/templates/ssl_renewed" class="btn btn-sm btn-secondary">{{t $lang "admin.email.edit_template_action"}}</a>
                        </div>

                        <div class="template-item">
                            <div class="template-info">
                                <strong>{{t $lang "admin.email.template_login_alert_title"}}</strong>
                                <p>{{t $lang "admin.email.template_login_alert_desc"}}</p>
                            </div>
                            <a href="{{.admin_path}}/config/email/templates/login_alert" class="btn btn-sm btn-secondary">{{t $lang "admin.email.edit_template_action"}}</a>
                        </div>

                        <div class="template-item">
                            <div class="template-info">
                                <strong>{{t $lang "admin.email.template_security_alert_title"}}</strong>
                                <p>{{t $lang "admin.email.template_security_alert_desc"}}</p>
                            </div>
                            <a href="{{.admin_path}}/config/email/templates/security_alert" class="btn btn-sm btn-secondary">{{t $lang "admin.email.edit_template_action"}}</a>
                        </div>

                        <div class="template-item">
                            <div class="template-info">
                                <strong>{{t $lang "admin.email.template_scheduler_error_title"}}</strong>
                                <p>{{t $lang "admin.email.template_scheduler_error_desc"}}</p>
                            </div>
                            <a href="{{.admin_path}}/config/email/templates/scheduler_error" class="btn btn-sm btn-secondary">{{t $lang "admin.email.edit_template_action"}}</a>
                        </div>

                        <div class="template-item">
                            <div class="template-info">
                                <strong>{{t $lang "admin.email.template_test_title"}}</strong>
                                <p>{{t $lang "admin.email.template_test_desc"}}</p>
                            </div>
                            <a href="{{.admin_path}}/config/email/templates/test" class="btn btn-sm btn-secondary">{{t $lang "admin.email.edit_template_action"}}</a>
                        </div>
                    </div>

                    <div class="alert alert-info mt-4" role="status">
                        <strong>{{t $lang "admin.email.template_vars_label"}}</strong> {{t $lang "admin.email.template_vars_text1"}} <code>{app_name}</code>, <code>{app_url}</code>, {{t $lang "admin.email.template_vars_text2"}}
                    </div>
                </div>
            </section>

            <!-- Test Email Result -->
            <div id="test-result" class="alert d-none" role="status" aria-live="polite"></div>

    <script type="application/json" id="admin-email-data">{"apiPath": {{.api_path}}, "adminApiPath": {{.admin_api_path}}}</script>
    <script src="/static/js/app.js"></script>

{{template "admin_footer" .}}
{{end}}
