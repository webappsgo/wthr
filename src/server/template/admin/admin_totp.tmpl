{{template "head" .}}
{{template "admin_header" .}}
<main id="main-content" class="admin-content">
    <h1>{{t .server.Lang "admin.totp.title"}}</h1>
    {{if .success}}<div class="alert alert-success" role="status" aria-live="polite">{{.success}}</div>{{end}}
    {{if .recovery_keys}}
    <section class="card" aria-labelledby="recovery-codes-heading">
        <h2 id="recovery-codes-heading">{{t .server.Lang "admin.totp.recovery_codes_title"}}</h2>
        <p>{{t .server.Lang "admin.totp.recovery_codes_once"}}</p>
        <ul>{{range .recovery_keys}}<li><code>{{.}}</code></li>{{end}}</ul>
    </section>
    {{end}}
    {{if .totp.Enabled}}
    <section class="card" aria-labelledby="totp-enabled-heading">
        <h2 id="totp-enabled-heading">{{t .server.Lang "admin.totp.enabled_heading"}}</h2>
        <p>{{t .server.Lang "admin.totp.recovery_remaining"}}: {{.totp.RecoveryKeysCount}}</p>
        <form method="post" action="{{.admin_self_path}}/profile/security/totp/recovery/regenerate">
            <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
            <label for="regenerate-code">{{t .server.Lang "admin.totp.current_code"}}</label>
            <input id="regenerate-code" name="code" inputmode="numeric" autocomplete="one-time-code" required>
            <button type="submit">{{t .server.Lang "admin.totp.regenerate_button"}}</button>
        </form>
        <form method="post" action="{{.admin_self_path}}/profile/security/totp/disable">
            <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
            <label for="disable-code">{{t .server.Lang "admin.totp.disable_code"}}</label>
            <input id="disable-code" name="code" autocomplete="one-time-code" required>
            <label><input type="checkbox" name="use_recovery_key" value="true"> {{t .server.Lang "admin.totp.use_recovery_key"}}</label>
            <button type="submit">{{t .server.Lang "admin.totp.disable_button"}}</button>
        </form>
    </section>
    {{else if .show_setup}}
    <section class="card" aria-labelledby="totp-setup-heading">
        <h2 id="totp-setup-heading">{{t .server.Lang "admin.totp.setup_heading"}}</h2>
        <p>{{t .server.Lang "admin.totp.scan_qr"}}</p>
        <img src="{{.setup.qr_code}}" alt="{{t .server.Lang "admin.totp.qr_alt"}}" width="200" height="200">
        <p>{{t .server.Lang "admin.totp.manual_key"}} <code>{{.setup.secret}}</code></p>
        <form method="post" action="{{.admin_self_path}}/profile/security/totp/enable">
            <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
            <label for="enable-code">{{t .server.Lang "admin.totp.confirm_code"}}</label>
            <input id="enable-code" name="code" inputmode="numeric" autocomplete="one-time-code" required>
            <label><input type="checkbox" name="recovery_saved" value="true" required> {{t .server.Lang "admin.totp.recovery_ack"}}</label>
            <button type="submit">{{t .server.Lang "admin.totp.enable_button"}}</button>
        </form>
    </section>
    {{else}}
    <section class="card" aria-labelledby="totp-disabled-heading">
        <h2 id="totp-disabled-heading">{{t .server.Lang "admin.totp.disabled_heading"}}</h2>
        <p>{{t .server.Lang "admin.totp.encouragement"}}</p>
        <form method="post" action="{{.admin_self_path}}/profile/security/totp/setup">
            <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
            <label for="setup-password">{{t .server.Lang "admin.totp.current_password"}}</label>
            <input id="setup-password" type="password" name="password" autocomplete="current-password" required>
            <button type="submit">{{t .server.Lang "admin.totp.setup_button"}}</button>
        </form>
    </section>
    {{end}}
</main>
{{template "admin_footer" .}}
