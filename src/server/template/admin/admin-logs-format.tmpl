{{template "head" .}}
{{template "admin_header" .}}
{{- $lang := "en" -}}
{{- if .lang}}{{$lang = .lang}}{{end -}}
{{- $ap := "/server/admin" -}}
{{- if .admin_path}}{{$ap = .admin_path}}{{end -}}
{{- $current := .current_format -}}
  <div class="admin-header">
    <h1>{{t $lang "admin.logs_format.title"}}</h1>
    <p class="admin-page-intro">{{t $lang "admin.logs_format.intro"}}</p>
  </div>

  <section class="admin-section" aria-labelledby="logs-format-current-heading">
    <div class="section-header">
      <h2 id="logs-format-current-heading">{{t $lang "admin.logs_format.current_heading"}}</h2>
    </div>
    <dl class="admin-detail-list">
      <dt class="admin-detail-list__term">{{t $lang "admin.logs_format.current_label"}}</dt>
      <dd class="admin-detail-list__value admin-break-all">{{if $current}}{{$current}}{{else}}{{t $lang "admin.common.not_set"}}{{end}}</dd>
    </dl>
  </section>

  <section class="admin-section" aria-labelledby="logs-format-list-heading">
    <div class="section-header">
      <h2 id="logs-format-list-heading">{{t $lang "admin.logs_format.available_heading"}}</h2>
    </div>
    {{if .formats}}
    <div class="admin-table-scroll">
      <table class="admin-table">
        <caption class="admin-table-caption">{{t $lang "admin.logs_format.available_caption"}}</caption>
        <thead class="admin-table-header">
          <tr class="admin-table-head-row">
            <th class="admin-table-head-cell" scope="col">{{t $lang "admin.logs_format.col_name"}}</th>
            <th class="admin-table-head-cell" scope="col">{{t $lang "admin.logs_format.col_id"}}</th>
            <th class="admin-table-head-cell" scope="col">{{t $lang "admin.logs_format.col_description"}}</th>
            <th class="admin-table-head-cell" scope="col">{{t $lang "admin.logs_format.col_active"}}</th>
          </tr>
        </thead>
        <tbody>
          {{range .formats}}
          <tr class="admin-table-body-row">
            <th class="admin-table-body-cell" scope="row">{{.name}}</th>
            <td class="admin-table-body-cell admin-break-all"><code>{{.id}}</code></td>
            <td class="admin-table-body-cell">{{.description}}</td>
            <td class="admin-table-body-cell">
              {{if eq .id $current}}
              <span class="admin-flag admin-flag--on">
                <span class="admin-flag__icon" aria-hidden="true">&#10003;</span>
                <span class="admin-flag__text">{{t $lang "admin.logs_format.active_yes"}}</span>
              </span>
              {{else}}
              <span class="admin-flag admin-flag--off">
                <span class="admin-flag__icon" aria-hidden="true">&#8212;</span>
                <span class="admin-flag__text">{{t $lang "admin.logs_format.active_no"}}</span>
              </span>
              {{end}}
            </td>
          </tr>
          {{end}}
        </tbody>
      </table>
    </div>
    {{else}}
    <div class="empty-state">
      <p class="empty-state__icon" aria-hidden="true">&#128220;</p>
      <h3 class="empty-state__title">{{t $lang "admin.logs_format.empty_title"}}</h3>
      <p class="empty-state__message">{{t $lang "admin.logs_format.empty_message"}}</p>
      <a class="btn btn-secondary" href="{{$ap}}/config/logs">{{t $lang "admin.logs_format.empty_action"}}</a>
    </div>
    {{end}}
  </section>
{{template "admin_footer" .}}
