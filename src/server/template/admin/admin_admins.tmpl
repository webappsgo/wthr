{{template "head" .}}
{{template "admin_header" .}}
{{- $lang := "en" -}}
{{- if .lang}}{{$lang = .lang}}{{end -}}
{{- $ap := "/server/administration" -}}
{{- if .admin_path}}{{$ap = .admin_path}}{{end -}}
  <div class="admin-header">
    <header class="page-header"><h1 class="page-title">{{t $lang "admin.admins.title"}}</h1></header>
    <p class="admin-page-intro">{{t $lang "admin.admins.intro"}}</p>
  </div>

  <section class="admin-section" aria-labelledby="admins-accounts-heading">
    <div class="section-header">
      <h2 id="admins-accounts-heading">{{t $lang "admin.admins.accounts_heading"}}</h2>
    </div>
    <dl class="admin-detail-list">
      <dt class="admin-detail-list__term">{{t $lang "admin.admins.col_username"}}</dt>
      <dd class="admin-detail-list__value">{{.current_admin.Username}}</dd>
      <dt class="admin-detail-list__term">{{t $lang "admin.admins.col_email"}}</dt>
      <dd class="admin-detail-list__value admin-break-all">{{.current_admin.Email}}</dd>
      <dt class="admin-detail-list__term">{{t $lang "admin.admins.count_label"}}</dt>
      <dd class="admin-detail-list__value">{{.admin_count}}</dd>
    </dl>
    <p class="admin-page-intro">{{t $lang "admin.admins.empty_message"}}</p>
    <a class="btn btn-primary" href="{{$ap}}/admins/invite">{{t $lang "admin.admins.empty_action"}}</a>
  </section>
{{template "admin_footer" .}}
