{{template "head" .}}
{{template "admin_header" .}}
{{- $lang := "en" -}}
{{- if .lang}}{{$lang = .lang}}{{end -}}
{{- $ap := "/server/admin" -}}
{{- if .admin_path}}{{$ap = .admin_path}}{{end -}}
  <div class="admin-header">
    <h1>{{t $lang "admin.blocklists.title"}}</h1>
    <p class="admin-page-intro">{{t $lang "admin.blocklists.intro"}}</p>
  </div>

  <section class="admin-section" aria-labelledby="blocklists-sources-heading">
    <div class="section-header">
      <h2 id="blocklists-sources-heading">{{t $lang "admin.blocklists.sources_heading"}}</h2>
    </div>
    <div class="empty-state">
      <p class="empty-state__icon" aria-hidden="true">&#128683;</p>
      <h3 class="empty-state__title">{{t $lang "admin.blocklists.empty_title"}}</h3>
      <p class="empty-state__message">{{t $lang "admin.blocklists.empty_message"}}</p>
      <a class="btn btn-primary" href="{{$ap}}/config/network/geoip">{{t $lang "admin.blocklists.empty_action"}}</a>
    </div>
  </section>
{{template "admin_footer" .}}
