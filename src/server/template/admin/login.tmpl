{{- $lang := "en" -}}
{{- if .lang}}{{$lang = .lang}}{{end -}}
<!DOCTYPE html>
<html lang="{{$lang}}" dir="{{if eq $lang "ar"}}rtl{{else}}ltr{{end}}" class="{{if .server.ThemeClass}}{{.server.ThemeClass}}{{else}}theme-dark{{end}}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title>{{t $lang "admin.login.page_title"}} - {{ .branding.Title }}</title>
    <link rel="stylesheet" href="{{asset "/static/css/common.css"}}">
    <link rel="stylesheet" href="{{asset "/static/css/components.css"}}">
    <link rel="stylesheet" href="{{asset "/static/css/admin.css"}}">
</head>
<body>
    <a href="#main-content" class="skip-link">{{t $lang "aria.skip_to_main"}}</a>
    <a href="#admin-login-form" class="skip-link">{{t $lang "admin.skip.nav"}}</a>
    <main id="main-content">
      <div class="container container-sm">
        <header class="page-header"><h1 class="page-title">{{ .branding.Title }}</h1></header>
        <section class="section-card" aria-labelledby="admin-login-heading">
            <h2 class="sr-only" id="admin-login-heading">{{t $lang "admin.login.page_title"}}</h2>

            {{/* Error message if login failed */}}
            {{ if .error }}
            <div class="error-message" role="alert">{{ .error }}</div>
            {{ end }}

            <form id="admin-login-form" method="POST" action="{{.admin_path}}/login" autocomplete="off">
    <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
                <div class="form-group">
                    <label for="username" class="form-label">{{t $lang "admin.admins.col_username"}}</label>
                    <input type="text"
                           id="username"
                           name="username"
                           class="form-input"
                           required
                           autofocus
                           autocomplete="username"
                           aria-label="{{t $lang "admin.login.username_aria_label"}}"
                           aria-required="true">
                </div>

                <div class="form-group">
                    <label for="password" class="form-label">{{t $lang "admin.invite_accept.password_label"}}</label>
                    <input type="password"
                           id="password"
                           name="password"
                           class="form-input"
                           required
                           autocomplete="current-password"
                           aria-label="{{t $lang "admin.login.password_aria_label"}}"
                           aria-required="true">
                </div>

                {{/* Remember me checkbox per AI.md PART 18 */}}
                <div class="form-checkbox">
                    <input type="checkbox"
                           id="remember"
                           name="remember"
                           value="1">
                    <label for="remember">{{t $lang "admin.login.remember_me_label"}}</label>
                </div>

                <button type="submit" class="btn-login">{{t $lang "nav.login"}}</button>
            </form>
        </section>

        {{/* Version number at bottom per AI.md PART 18 */}}
        <div class="login-footer">
            v{{ .version }}
        </div>
      </div>
    </main>
</body>
</html>
