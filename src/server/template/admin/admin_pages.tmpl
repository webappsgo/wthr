{{template "head" .}}
{{template "admin_header" .}}
{{- $lang := "en" -}}
{{- if .lang}}{{$lang = .lang}}{{end -}}
{{- $ap := "/server/admin" -}}
{{- if .admin_path}}{{$ap = .admin_path}}{{end -}}
  <div class="admin-header">
    <h1>{{t $lang "admin.pages.title"}}</h1>
    <p class="admin-page-intro">{{t $lang "admin.pages.intro"}}</p>
  </div>

  <section class="admin-section" aria-labelledby="pages-public-heading">
    <div class="section-header">
      <h2 id="pages-public-heading">{{t $lang "admin.pages.public_heading"}}</h2>
    </div>
    <ul class="admin-link-grid">
      <li class="admin-link-card">
        <a class="admin-link-card__link" href="/server/about">{{t $lang "admin.pages.link_about"}}</a>
      </li>
      <li class="admin-link-card">
        <a class="admin-link-card__link" href="/server/privacy">{{t $lang "admin.pages.link_privacy"}}</a>
      </li>
      <li class="admin-link-card">
        <a class="admin-link-card__link" href="/server/terms">{{t $lang "admin.pages.link_terms"}}</a>
      </li>
      <li class="admin-link-card">
        <a class="admin-link-card__link" href="/server/contact">{{t $lang "admin.pages.link_contact"}}</a>
      </li>
      <li class="admin-link-card">
        <a class="admin-link-card__link" href="/server/help">{{t $lang "admin.pages.link_help"}}</a>
      </li>
      <li class="admin-link-card">
        <a class="admin-link-card__link" href="/server/healthz">{{t $lang "admin.pages.link_healthz"}}</a>
      </li>
    </ul>
  </section>

  <section class="admin-section" aria-labelledby="pages-content-heading">
    <div class="section-header">
      <h2 id="pages-content-heading">{{t $lang "admin.pages.content_heading"}}</h2>
    </div>
    <div class="empty-state">
      <p class="empty-state__icon" aria-hidden="true">&#128196;</p>
      <h3 class="empty-state__title">{{t $lang "admin.pages.empty_title"}}</h3>
      <p class="empty-state__message">{{t $lang "admin.pages.empty_message"}}</p>
      <a class="btn btn-primary" href="{{$ap}}/config/templates">{{t $lang "admin.pages.empty_action"}}</a>
    </div>
  </section>
{{template "admin_footer" .}}
