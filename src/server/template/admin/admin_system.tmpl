{{define "admin/admin_system.tmpl"}}
{{template "head" .}}
{{template "admin_header" .}}
{{- $lang := "en" -}}
{{- if .lang}}{{$lang = .lang}}{{end -}}

            <div class="content-header">
                <h1>⚙️ {{t $lang "admin.system.title"}}</h1>
                <p class="subtitle">{{t $lang "admin.system.subtitle"}}</p>
            </div>

            <!-- System Status Section -->
            <section class="admin-card" aria-labelledby="status-heading">
                <div class="card-header">
                    <h2 id="status-heading">{{t $lang "admin.system.status_heading"}}</h2>
                    <p class="card-description">{{t $lang "admin.system.status_desc"}}</p>
                </div>
                <div class="card-body">
                    <div class="stats-grid">
                        <div class="stat-item">
                            <div class="stat-label">{{t $lang "admin.system.server_status_label"}}</div>
                            <div class="stat-value">
                                <span class="badge badge-success">✅ {{t $lang "admin.system.online"}}</span>
                            </div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-label">{{t $lang "admin.system.uptime_label"}}</div>
                            <div class="stat-value" id="uptime">
                                <span class="loading">{{t $lang "admin.system.loading"}}</span>
                            </div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-label">{{t $lang "admin.system.version_label"}}</div>
                            <div class="stat-value" id="version">-</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-label">{{t $lang "admin.system.build_date_label"}}</div>
                            <div class="stat-value" id="build-date">-</div>
                        </div>
                    </div>

                    <button class="btn btn-secondary" data-action="refresh-system-info" aria-label="{{t $lang "admin.system.refresh_system_aria"}}">
                        🔄 {{t $lang "action.refresh"}}
                    </button>
                </div>
            </section>

            <!-- Server Information Section -->
            <section class="admin-card" aria-labelledby="server-info-heading">
                <div class="card-header">
                    <h2 id="server-info-heading">{{t $lang "admin.system.server_info_heading"}}</h2>
                    <p class="card-description">{{t $lang "admin.system.server_info_desc"}}</p>
                </div>
                <div class="card-body">
                    <div class="info-grid">
                        <div class="info-item">
                            <div class="info-label">{{t $lang "admin.system.os_label"}}</div>
                            <div class="info-value" id="os">-</div>
                        </div>
                        <div class="info-item">
                            <div class="info-label">{{t $lang "admin.system.arch_label"}}</div>
                            <div class="info-value" id="arch">-</div>
                        </div>
                        <div class="info-item">
                            <div class="info-label">{{t $lang "admin.system.go_version_label"}}</div>
                            <div class="info-value" id="go-version">-</div>
                        </div>
                        <div class="info-item">
                            <div class="info-label">{{t $lang "admin.system.hostname_label"}}</div>
                            <div class="info-value" id="hostname">-</div>
                        </div>
                        <div class="info-item">
                            <div class="info-label">{{t $lang "admin.system.working_dir_label"}}</div>
                            <div class="info-value" id="working-dir">-</div>
                        </div>
                        <div class="info-item">
                            <div class="info-label">{{t $lang "admin.system.pid_label"}}</div>
                            <div class="info-value" id="pid">-</div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Resource Usage Section -->
            <section class="admin-card" aria-labelledby="resources-heading">
                <div class="card-header">
                    <h2 id="resources-heading">{{t $lang "admin.system.resources_heading"}}</h2>
                    <p class="card-description">{{t $lang "admin.system.resources_desc"}}</p>
                </div>
                <div class="card-body">
                    <div class="stats-grid">
                        <div class="stat-item">
                            <div class="stat-label">{{t $lang "admin.system.memory_alloc_label"}}</div>
                            <div class="stat-value" id="memory-alloc">
                                <span class="loading">{{t $lang "admin.system.loading"}}</span>
                            </div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-label">{{t $lang "admin.system.memory_sys_label"}}</div>
                            <div class="stat-value" id="memory-sys">-</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-label">{{t $lang "admin.system.goroutines_label"}}</div>
                            <div class="stat-value" id="goroutines">-</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-label">{{t $lang "admin.system.gc_runs_label"}}</div>
                            <div class="stat-value" id="gc-runs">-</div>
                        </div>
                    </div>

                    <div class="alert alert-info mt-4" role="status">
                        <strong>{{t $lang "admin.system.note_label"}}</strong> {{t $lang "admin.system.memory_note_text"}}
                    </div>

                    <div class="button-group">
                        <button class="btn btn-secondary" data-action="trigger-gc" aria-label="{{t $lang "admin.system.trigger_gc_aria"}}">
                            🧹 {{t $lang "admin.system.run_gc_action"}}
                        </button>
                        <button class="btn btn-secondary" data-action="refresh-resource-usage" aria-label="{{t $lang "admin.system.refresh_resources_aria"}}">
                            🔄 {{t $lang "action.refresh"}}
                        </button>
                    </div>
                </div>
            </section>

            <!-- Network Information Section -->
            <section class="admin-card" aria-labelledby="network-heading">
                <div class="card-header">
                    <h2 id="network-heading">{{t $lang "admin.system.network_heading"}}</h2>
                    <p class="card-description">{{t $lang "admin.system.network_desc"}}</p>
                </div>
                <div class="card-body">
                    <div class="info-grid">
                        <div class="info-item">
                            <div class="info-label">{{t $lang "admin.system.http_port_label"}}</div>
                            <div class="info-value" id="http-port">-</div>
                        </div>
                        <div class="info-item">
                            <div class="info-label">{{t $lang "admin.system.https_port_label"}}</div>
                            <div class="info-value" id="https-port">-</div>
                        </div>
                        <div class="info-item">
                            <div class="info-label">{{t $lang "admin.system.https_enabled_label"}}</div>
                            <div class="info-value" id="https-enabled">-</div>
                        </div>
                        <div class="info-item">
                            <div class="info-label">{{t $lang "admin.system.tor_hidden_service_label"}}</div>
                            <div class="info-value" id="tor-status">-</div>
                        </div>
                        <div class="info-item">
                            <div class="info-label">{{t $lang "admin.system.onion_address_label"}}</div>
                            <div class="info-value onion-address" id="onion-address">-</div>
                        </div>
                        <div class="info-item">
                            <div class="info-label">{{t $lang "admin.system.server_url_label"}}</div>
                            <div class="info-value" id="server-url">-</div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Environment Section -->
            <section class="admin-card" aria-labelledby="env-heading">
                <div class="card-header">
                    <h2 id="env-heading">{{t $lang "admin.system.env_heading"}}</h2>
                    <p class="card-description">{{t $lang "admin.system.env_desc"}}</p>
                </div>
                <div class="card-body">
                    <div class="info-grid">
                        <div class="info-item">
                            <div class="info-label">{{t $lang "admin.system.mode_label"}}</div>
                            <div class="info-value" id="mode">-</div>
                        </div>
                        <div class="info-item">
                            <div class="info-label">{{t $lang "admin.system.debug_enabled_label"}}</div>
                            <div class="info-value" id="debug">-</div>
                        </div>
                        <div class="info-item">
                            <div class="info-label">{{t $lang "admin.system.data_dir_label"}}</div>
                            <div class="info-value" id="data-dir">-</div>
                        </div>
                        <div class="info-item">
                            <div class="info-label">{{t $lang "admin.system.config_dir_label"}}</div>
                            <div class="info-value" id="config-dir">-</div>
                        </div>
                        <div class="info-item">
                            <div class="info-label">{{t $lang "admin.system.log_dir_label"}}</div>
                            <div class="info-value" id="log-dir">-</div>
                        </div>
                        <div class="info-item">
                            <div class="info-label">{{t $lang "admin.system.timezone_label"}}</div>
                            <div class="info-value" id="timezone">-</div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Actions Section -->
            <section class="admin-card" aria-labelledby="actions-heading">
                <div class="card-header">
                    <h2 id="actions-heading">{{t $lang "admin.system.actions_heading"}}</h2>
                    <p class="card-description">{{t $lang "admin.system.actions_desc"}}</p>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning" role="alert">
                        <strong>{{t $lang "admin.system.warning_label"}}</strong> {{t $lang "admin.system.actions_warning_text"}}
                    </div>

                    <div class="action-buttons">
                        <button class="btn btn-secondary" data-action="reload-config" aria-label="{{t $lang "admin.system.reload_config_aria"}}">
                            🔄 {{t $lang "admin.system.reload_config_action"}}
                        </button>
                        <button class="btn btn-info" data-action="view-all-routes" aria-label="{{t $lang "admin.system.view_routes_aria"}}">
                            🗺️ {{t $lang "admin.system.view_routes_action"}}
                        </button>
                        <button class="btn btn-info" data-action="export-system-info" aria-label="{{t $lang "admin.system.export_info_aria"}}">
                            📥 {{t $lang "admin.system.export_info_action"}}
                        </button>
                    </div>

                    <div id="action-result" class="alert d-none mt-4" role="status" aria-live="polite"></div>
                </div>
            </section>

    <script type="application/json" id="admin-system-data">{"adminApiPath": {{.admin_api_path}}}</script>
    <script src="/static/js/app.js"></script>

{{template "admin_footer" .}}
{{end}}
