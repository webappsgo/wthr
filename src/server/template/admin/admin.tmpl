{{template "head" .}}

{{template "admin_header" .}}
{{- $lang := "en" -}}
{{- if .lang}}{{$lang = .lang}}{{end -}}

<div class="admin-container">
        <div class="admin_header">
            <h1>{{t $lang "admin.dashboard.title"}}</h1>
            <p class="text-comment">{{t $lang "admin.dashboard.intro"}}</p>
        </div>

        <div class="stats-grid">
            <div class="stat-card">
                <h3>{{t $lang "admin.dashboard.total_users"}}</h3>
                <div class="stat-value">{{ .totalUsers }}</div>
            </div>
            <div class="stat-card">
                <h3>{{t $lang "admin.dashboard.admin_users"}}</h3>
                <div class="stat-value">{{ .adminCount }}</div>
            </div>
            <div class="stat-card">
                <h3>{{t $lang "admin.dashboard.total_locations"}}</h3>
                <div class="stat-value">{{ .totalLocations }}</div>
            </div>
            <div class="stat-card">
                <h3>{{t $lang "admin.dashboard.system_status"}}</h3>
                <div class="stat-value admin-stat-value-online">✓ {{t $lang "admin.dashboard.online"}}</div>
            </div>
        </div>

        <div class="admin-tabs">
            <button class="tab active" data-tab="users">{{t $lang "admin.dashboard.tab_users"}}</button>
            <button class="tab" data-tab="settings">{{t $lang "admin.dashboard.tab_settings"}}</button>
            <button class="tab" data-tab="web">{{t $lang "admin.dashboard.tab_web"}}</button>
            <button class="tab" data-tab="security">{{t $lang "admin.dashboard.tab_security"}}</button>
            <button class="tab" data-tab="database">{{t $lang "admin.dashboard.tab_database"}}</button>
            <button class="tab" data-tab="ssl">{{t $lang "admin.dashboard.tab_ssl"}}</button>
            <button class="tab" data-tab="backup">{{t $lang "admin.dashboard.tab_backup"}}</button>
            <button class="tab" data-tab="tokens">{{t $lang "admin.dashboard.tab_tokens"}}</button>
            <button class="tab" data-tab="logs">{{t $lang "admin.dashboard.tab_logs"}}</button>
            <button class="tab" data-tab="tasks">{{t $lang "admin.dashboard.tab_tasks"}}</button>
        </div>

        <div id="users" class="tab-content active">
            <div class="admin-section">
                <div class="section-header">
                    <h2>{{t $lang "admin.dashboard.user_management"}}</h2>
                    <button class="btn btn-primary" onclick="showAddUserModal()">+ {{t $lang "admin.dashboard.add_user"}}</button>
                </div>
                <div id="users-list" class="overflow-auto">
                    <p class="admin-loading-text">{{t $lang "admin.dashboard.loading_users"}}</p>
                </div>
            </div>
        </div>

        <div id="settings" class="tab-content">
            <div class="admin-section">
                <div class="section-header">
                    <h2>{{t $lang "admin.dashboard.server_settings"}}</h2>
                    <button class="btn btn-success" onclick="applyAllSettings()" id="apply-settings-btn">✓ {{t $lang "admin.dashboard.apply_all_reload"}}</button>
                </div>
                <div id="settings-list" class="overflow-auto">
                    <p class="loading-text">{{t $lang "admin.dashboard.loading_settings"}}</p>
                </div>
            </div>
        </div>

        <div id="web" class="tab-content">
            <div class="admin-section">
                <div class="section-header">
                    <h2>{{t $lang "admin.dashboard.web_settings"}}</h2>
                    <button class="btn btn-success" onclick="saveWebSettings()">💾 {{t $lang "admin.dashboard.save_changes"}}</button>
                </div>

                <div class="settings-form">
                    <div class="form-group">
                        <label class="form-label">{{t $lang "admin.dashboard.site_title"}}</label>
                        <input type="text" id="web-title" class="form-input" value="Weather">
                        <small class="text-comment">{{t $lang "admin.dashboard.site_title_hint"}}</small>
                    </div>

                    <div class="form-group">
                        <label class="form-label">{{t $lang "admin.dashboard.site_tagline"}}</label>
                        <input type="text" id="web-tagline" class="form-input" value="Production-grade weather API">
                        <small class="text-comment">{{t $lang "admin.dashboard.site_tagline_hint"}}</small>
                    </div>

                    <div class="form-group">
                        <label class="form-label">{{t $lang "admin.dashboard.footer_text"}}</label>
                        <textarea id="web-footer" class="form-input" rows="2">Production-grade forecasts, alerts, and you data</textarea>
                        <small class="text-comment">{{t $lang "admin.dashboard.footer_text_hint"}}</small>
                    </div>

                    <div class="form-group">
                        <label class="form-label">{{t $lang "admin.dashboard.theme"}}</label>
                        <select id="web-theme" class="form-input">
                            <option value="dark" selected>{{t $lang "admin.dashboard.theme_dark"}}</option>
                            <option value="light">{{t $lang "admin.dashboard.theme_light"}}</option>
                            <option value="auto">{{t $lang "admin.dashboard.theme_auto"}}</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="form-label">{{t $lang "admin.dashboard.items_per_page"}}</label>
                        <input type="number" id="web-page-size" class="form-input" value="50" min="10" max="500">
                        <small class="text-comment">{{t $lang "admin.dashboard.items_per_page_hint"}}</small>
                    </div>

                    <div class="form-group">
                        <label class="checkbox-label">
                            <input type="checkbox" id="web-analytics" checked>
                            {{t $lang "admin.dashboard.enable_analytics"}}
                        </label>
                        <small class="text-comment">{{t $lang "admin.dashboard.enable_analytics_hint"}}</small>
                    </div>
                </div>
            </div>
        </div>

        <div id="security" class="tab-content">
            <div class="admin-section">
                <div class="section-header">
                    <h2>{{t $lang "admin.dashboard.security_settings"}}</h2>
                    <button class="btn btn-success" onclick="saveSecuritySettings()">💾 {{t $lang "admin.dashboard.save_changes"}}</button>
                </div>

                <div class="settings-form">
                    <h3 class="admin-section-title">{{t $lang "admin.dashboard.rate_limiting"}}</h3>

                    <div class="form-group">
                        <label class="checkbox-label">
                            <input type="checkbox" id="sec-ratelimit-enabled" checked>
                            {{t $lang "admin.dashboard.enable_rate_limiting"}}
                        </label>
                    </div>

                    <div class="form-grid">
                        <div class="form-group">
                            <label class="form-label">{{t $lang "admin.dashboard.global_rate_limit"}}</label>
                            <input type="number" id="sec-global-limit" class="form-input" value="100">
                            <small class="text-comment">{{t $lang "admin.dashboard.global_rate_limit_hint"}}</small>
                        </div>

                        <div class="form-group">
                            <label class="form-label">{{t $lang "admin.dashboard.api_rate_limit"}}</label>
                            <input type="number" id="sec-api-limit" class="form-input" value="100">
                            <small class="text-comment">{{t $lang "admin.dashboard.rate_limit_15min_hint"}}</small>
                        </div>

                        <div class="form-group">
                            <label class="form-label">{{t $lang "admin.dashboard.admin_rate_limit"}}</label>
                            <input type="number" id="sec-admin-limit" class="form-input" value="30">
                            <small class="text-comment">{{t $lang "admin.dashboard.rate_limit_15min_hint"}}</small>
                        </div>
                    </div>

                    <hr class="admin-hr">

                    <h3 class="admin-section-title">{{t $lang "admin.dashboard.security_headers"}}</h3>

                    <div class="form-group">
                        <label class="checkbox-label">
                            <input type="checkbox" id="sec-hsts" checked>
                            {{t $lang "admin.dashboard.enable_hsts"}}
                        </label>
                        <small class="text-comment">{{t $lang "admin.dashboard.enable_hsts_hint"}}</small>
                    </div>

                    <div class="form-group">
                        <label class="form-label">{{t $lang "admin.dashboard.csp"}}</label>
                        <textarea id="sec-csp" class="form-input" rows="3">default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'</textarea>
                    </div>

                    <div class="form-group">
                        <label class="form-label">{{t $lang "admin.dashboard.blocked_ips"}}</label>
                        <textarea id="sec-blocked-ips" class="form-input" rows="4" placeholder="{{t $lang "admin.dashboard.blocked_ips_placeholder"}}"></textarea>
                        <small class="text-comment">{{t $lang "admin.dashboard.blocked_ips_hint"}}</small>
                    </div>

                    <div class="form-group">
                        <label class="checkbox-label">
                            <input type="checkbox" id="sec-require-https" checked>
                            {{t $lang "admin.dashboard.require_https"}}
                        </label>
                    </div>
                </div>
            </div>
        </div>

        <div id="database" class="tab-content">
            <div class="admin-section">
                <div class="section-header">
                    <h2>{{t $lang "admin.dashboard.database_cache"}}</h2>
                    <button class="btn btn-primary" onclick="testDatabaseConnection()">🔌 {{t $lang "admin.dashboard.test_connection"}}</button>
                </div>

                <div class="stats-grid margin-bottom-2">
                    <div class="stat-card">
                        <h3>{{t $lang "admin.dashboard.database_type"}}</h3>
                        <div class="stat-value admin-stat-value-medium">SQLite</div>
                    </div>
                    <div class="stat-card">
                        <h3>{{t $lang "admin.dashboard.database_size"}}</h3>
                        <div class="stat-value admin-stat-value-medium">2.4 MB</div>
                    </div>
                    <div class="stat-card">
                        <h3>{{t $lang "admin.dashboard.total_records"}}</h3>
                        <div class="stat-value admin-stat-value-medium">1,247</div>
                    </div>
                    <div class="stat-card">
                        <h3>{{t $lang "admin.dashboard.cache_hit_rate"}}</h3>
                        <div class="stat-value admin-stat-value-medium-success">94%</div>
                    </div>
                </div>

                <div class="settings-form">
                    <h3 class="admin-section-title">{{t $lang "admin.dashboard.cache_settings"}}</h3>

                    <div class="form-group">
                        <label class="checkbox-label">
                            <input type="checkbox" id="db-cache-enabled" checked>
                            {{t $lang "admin.dashboard.enable_memory_cache"}}
                        </label>
                    </div>

                    <div class="form-grid">
                        <div class="form-group">
                            <label class="form-label">{{t $lang "admin.dashboard.weather_cache_ttl"}}</label>
                            <input type="number" id="db-weather-ttl" class="form-input" value="1800">
                            <small class="text-comment">{{t $lang "admin.dashboard.weather_cache_ttl_hint"}}</small>
                        </div>

                        <div class="form-group">
                            <label class="form-label">{{t $lang "admin.dashboard.geoip_cache_ttl"}}</label>
                            <input type="number" id="db-geoip-ttl" class="form-input" value="86400">
                            <small class="text-comment">{{t $lang "admin.dashboard.geoip_cache_ttl_hint"}}</small>
                        </div>
                    </div>

                    <hr class="admin-hr">

                    <h3 class="admin-section-title">{{t $lang "admin.dashboard.database_maintenance"}}</h3>

                    <div class="form-group">
                        <button class="btn btn-warning" onclick="optimizeDatabase()">⚡ {{t $lang "admin.dashboard.optimize_database"}}</button>
                        <button class="btn btn-warning" onclick="clearCache()">🗑️ {{t $lang "admin.dashboard.clear_all_cache"}}</button>
                        <button class="btn btn-danger" onclick="vacuumDatabase()">🧹 {{t $lang "admin.dashboard.vacuum_database"}}</button>
                    </div>

                    <div class="form-group">
                        <label class="form-label">{{t $lang "admin.dashboard.auto_cleanup"}}</label>
                        <div class="checkbox-label">
                            <input type="checkbox" id="db-auto-cleanup" checked>
                            {{t $lang "admin.dashboard.auto_cleanup_label"}}
                        </div>
                        <small class="text-comment">{{t $lang "admin.dashboard.auto_cleanup_hint"}}</small>
                    </div>
                </div>
            </div>
        </div>

        <div id="ssl" class="tab-content">
            <div class="admin-section">
                <div class="section-header">
                    <h2>{{t $lang "admin.dashboard.ssl_management"}}</h2>
                    <button class="btn btn-primary" onclick="testSSLCertificate()">🔍 {{t $lang "admin.dashboard.verify_certificate"}}</button>
                </div>

                <div class="settings-form">
                    <div class="form-group">
                        <label class="checkbox-label">
                            <input type="checkbox" id="ssl-enabled">
                            {{t $lang "admin.dashboard.enable_ssl"}}
                        </label>
                    </div>

                    <div class="form-group">
                        <label class="form-label">{{t $lang "admin.dashboard.cert_file_path"}}</label>
                        <input type="text" id="ssl-cert" class="form-input" placeholder="/etc/webappsgo/wthr/ssl/certs/cert.pem">
                        <small class="text-comment">{{t $lang "admin.dashboard.cert_file_path_hint"}}</small>
                    </div>

                    <div class="form-group">
                        <label class="form-label">{{t $lang "admin.dashboard.key_file_path"}}</label>
                        <input type="text" id="ssl-key" class="form-input" placeholder="/etc/webappsgo/wthr/ssl/certs/key.pem">
                        <small class="text-comment">{{t $lang "admin.dashboard.key_file_path_hint"}}</small>
                    </div>

                    <hr class="admin-hr">

                    <h3 class="admin-section-title">{{t $lang "admin.dashboard.lets_encrypt"}}</h3>

                    <div class="form-group">
                        <label class="checkbox-label">
                            <input type="checkbox" id="ssl-acme-enabled">
                            {{t $lang "admin.dashboard.enable_auto_ssl"}}
                        </label>
                        <small class="text-comment">{{t $lang "admin.dashboard.enable_auto_ssl_hint"}}</small>
                    </div>

                    <div class="form-group">
                        <label class="form-label">{{t $lang "admin.dashboard.domain_name"}}</label>
                        <input type="text" id="ssl-domain" class="form-input" placeholder="weather.example.com">
                        <small class="text-comment">{{t $lang "admin.dashboard.domain_name_hint"}}</small>
                    </div>

                    <div class="form-group">
                        <label class="form-label">{{t $lang "admin.dashboard.contact_email"}}</label>
                        <input type="email" id="ssl-email" class="form-input" placeholder="admin@example.com">
                        <small class="text-comment">{{t $lang "admin.dashboard.contact_email_hint"}}</small>
                    </div>

                    <div class="form-group">
                        <label class="form-label">{{t $lang "admin.dashboard.acme_provider"}}</label>
                        <select id="ssl-provider" class="form-input">
                            <option value="letsencrypt">Let's Encrypt</option>
                            <option value="zerossl">ZeroSSL</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <button class="btn btn-success" onclick="obtainCertificate()">🔐 {{t $lang "admin.dashboard.obtain_certificate"}}</button>
                        <button class="btn btn-primary" onclick="renewCertificate()">🔄 {{t $lang "admin.dashboard.renew_certificate"}}</button>
                    </div>

                    <div class="info-box">
                        <strong>{{t $lang "admin.dashboard.note_label"}}</strong> {{t $lang "admin.dashboard.ssl_note"}}
                    </div>
                </div>
            </div>
        </div>

        <div id="backup" class="tab-content">
            <div class="admin-section">
                <div class="section-header">
                    <h2>{{t $lang "admin.dashboard.backup_restore"}}</h2>
                    <button class="btn btn-primary" onclick="createBackup()">💾 {{t $lang "admin.dashboard.create_backup_now"}}</button>
                </div>

                <div class="stats-grid margin-bottom-2">
                    <div class="stat-card">
                        <h3>{{t $lang "admin.dashboard.last_backup"}}</h3>
                        <div class="stat-value admin-stat-value-medium">2 hours ago</div>
                    </div>
                    <div class="stat-card">
                        <h3>{{t $lang "admin.dashboard.backup_size"}}</h3>
                        <div class="stat-value admin-stat-value-medium">3.2 MB</div>
                    </div>
                    <div class="stat-card">
                        <h3>{{t $lang "admin.dashboard.total_backups"}}</h3>
                        <div class="stat-value admin-stat-value-medium">12</div>
                    </div>
                    <div class="stat-card">
                        <h3>{{t $lang "admin.dashboard.auto_backup"}}</h3>
                        <div class="stat-value admin-stat-value-medium-success">✓ {{t $lang "admin.dashboard.enabled_word"}}</div>
                    </div>
                </div>

                <div class="settings-form">
                    <h3 class="admin-section-title">{{t $lang "admin.dashboard.auto_backup_settings"}}</h3>

                    <div class="form-group">
                        <label class="checkbox-label">
                            <input type="checkbox" id="backup-enabled" checked>
                            {{t $lang "admin.dashboard.enable_auto_backups"}}
                        </label>
                    </div>

                    <div class="form-grid">
                        <div class="form-group">
                            <label class="form-label">{{t $lang "admin.dashboard.backup_interval"}}</label>
                            <select id="backup-interval" class="form-input">
                                <option value="3600">{{t $lang "admin.dashboard.interval_hourly"}}</option>
                                <option value="21600" selected>{{t $lang "admin.dashboard.interval_6h"}}</option>
                                <option value="43200">{{t $lang "admin.dashboard.interval_12h"}}</option>
                                <option value="86400">{{t $lang "admin.dashboard.interval_daily"}}</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label class="form-label">{{t $lang "admin.dashboard.retention_count"}}</label>
                            <input type="number" id="backup-retention" class="form-input" value="7" min="1" max="30">
                            <small class="text-comment">{{t $lang "admin.dashboard.retention_count_hint"}}</small>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">{{t $lang "admin.dashboard.backup_directory"}}</label>
                        <input type="text" id="backup-path" class="form-input" value="/mnt/Backups/webappsgo/wthr">
                        <small class="text-comment">{{t $lang "admin.dashboard.backup_directory_hint"}}</small>
                    </div>

                    <hr class="admin-hr">

                    <h3 class="admin-section-title">{{t $lang "admin.dashboard.available_backups"}}</h3>

                    <div id="backup-list">
                        <p class="text-comment">{{t $lang "admin.dashboard.loading_backups"}}</p>
                    </div>

                    <hr class="admin-hr">

                    <h3 class="admin-section-title">{{t $lang "admin.dashboard.restore_from_backup"}}</h3>

                    <div class="form-group">
                        <label class="form-label">{{t $lang "admin.dashboard.upload_backup_file"}}</label>
                        <input type="file" id="backup-upload" class="form-input" accept=".tar.gz,.tgz">
                        <button class="btn btn-warning margin-top-05" onclick="restoreBackup()">📦 {{t $lang "admin.dashboard.restore_backup"}}</button>
                    </div>

                    <div class="warning-box">
                        <strong>⚠️ {{t $lang "admin.dashboard.warning_label"}}</strong> {{t $lang "admin.dashboard.restore_warning"}}
                    </div>
                </div>
            </div>
        </div>

        <div id="tokens" class="tab-content">
            <div class="admin-section">
                <div class="section-header">
                    <h2>{{t $lang "admin.dashboard.token_management"}}</h2>
                    <button class="btn btn-primary" onclick="showGenerateTokenModal()">+ {{t $lang "admin.dashboard.generate_token"}}</button>
                </div>
                <div id="tokens-list" class="overflow-auto">
                    <p class="admin-loading-text">{{t $lang "admin.dashboard.loading_tokens"}}</p>
                </div>
            </div>
        </div>

        <div id="logs" class="tab-content">
            <div class="admin-section">
                <div class="section-header">
                    <h2>{{t $lang "admin.dashboard.audit_logs"}}</h2>
                    <button class="btn btn-danger" onclick="clearAuditLogs()">{{t $lang "admin.dashboard.clear_old_logs"}}</button>
                </div>
                <div id="logs-list" class="overflow-auto">
                    <p class="admin-loading-text">{{t $lang "admin.dashboard.loading_logs"}}</p>
                </div>
            </div>
        </div>

        <div id="tasks" class="tab-content">
            <div class="admin-section">
                <div class="section-header">
                    <h2>{{t $lang "admin.dashboard.scheduled_tasks"}}</h2>
                </div>
                <div id="tasks-list" class="overflow-auto">
                    <p class="admin-loading-text">{{t $lang "admin.dashboard.loading_scheduled_tasks"}}</p>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Configurable paths per AI.md PART 17
        const API_PATH = '{{.api_path}}';
        const ADMIN_API_PATH = '{{.admin_api_path}}';

        // Tab switching
        const tabs = document.querySelectorAll('.tab');
        const tabContents = document.querySelectorAll('.tab-content');

        tabs.forEach(tab => {
            tab.addEventListener('click', () => {
                tabs.forEach(t => t.classList.remove('active'));
                tabContents.forEach(tc => tc.classList.remove('active'));

                tab.classList.add('active');
                const tabId = tab.getAttribute('data-tab');
                document.getElementById(tabId).classList.add('active');

                // Load data when tab is clicked
                if (tabId === 'users') loadUsers();
                if (tabId === 'settings') loadSettings();
                if (tabId === 'tokens') loadTokens();
                if (tabId === 'logs') loadLogs();
                if (tabId === 'tasks') loadScheduledTasks();
            });
        });

        // Load users on page load
        document.addEventListener('DOMContentLoaded', () => {
            loadUsers();
        });

        // User Management
        async function loadUsers() {
            try {
                const response = await fetch(`${ADMIN_API_PATH}/users');
                const users = await response.json();

                const html = `
                    <table class="admin-table-full">
                        <thead>
                            <tr class="admin-table-head-row">
                                <th class="admin-table-head-cell">ID</th>
                                <th class="admin-table-head-cell">Email</th>
                                <th class="admin-table-head-cell">Role</th>
                                <th class="admin-table-head-cell">Created</th>
                                <th class="admin-table-head-cell-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${users.map(user => {
                                // Protect first admin (ID 1) from deletion
                                const isFirstAdmin = user.id === 1;
                                const actionButtons = isFirstAdmin
                                    ? `<button onclick="editAdminUser(${user.id}, '${user.email}')" class="btn-edit">Edit</button>`
                                    : `<button onclick="deleteUser(${user.id})" class="btn-delete">Delete</button>`;

                                return `
                                <tr class="admin-table-body-row">
                                    <td class="admin-table-body-cell">${user.id}${isFirstAdmin ? ' <span class="admin-user-primary">(Primary)</span>' : ''}</td>
                                    <td class="admin-table-body-cell">${user.email}</td>
                                    <td class="admin-table-body-cell"><span class="${user.role === 'admin' ? 'admin-role-badge-admin' : 'admin-role-badge'}">${user.role}</span></td>
                                    <td class="admin-table-body-cell">${new Date(user.created_at).toLocaleDateString()}</td>
                                    <td class="admin-table-body-cell-right">
                                        ${actionButtons}
                                    </td>
                                </tr>
                                `;
                            }).join('')}
                        </tbody>
                    </table>
                `;
                document.getElementById('users-list').innerHTML = html;
            } catch (error) {
                document.getElementById('users-list').innerHTML = '<p class="admin-error-text">Error loading users</p>';
            }
        }

        async function deleteUser(id) {
            const confirmed = await showConfirm('Are you sure you want to delete this user? This action cannot be undone.', 'Delete User');
            if (!confirmed) return;

            try {
                await fetch(`${ADMIN_API_PATH}/server/users/${id}`, { method: 'DELETE' });
                Toast.success('User deleted successfully');
                loadUsers();
            } catch (error) {
                Toast.error('Failed to delete user');
            }
        }

        async function editAdminUser(userId, currentEmail) {
            const modalId = 'edit-admin-modal-' + Date.now();

            Modal.create({
                id: modalId,
                title: 'Edit Primary Admin Account',
                body: `
                    <form id="editAdminForm">
    <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
                        <div class="form-group">
                            <label for="editAdminEmail">Email Address</label>
                            <input type="email" id="editAdminEmail" class="form-input" required value="${currentEmail}" placeholder="admin@example.com">
                            <small class="text-comment">Update the email address for this account</small>
                        </div>
                        <div class="form-group">
                            <label for="editAdminPassword">New Password (optional)</label>
