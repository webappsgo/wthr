{{template "head" .}}
{{template "admin_header" .}}
{{- $lang := "en" -}}
{{- if .lang}}{{$lang = .lang}}{{end -}}
{{- $ap := "/server/administration" -}}
{{- if .admin_path}}{{$ap = .admin_path}}{{end -}}
<main class="admin-container" id="main-content">
  <header class="admin-header">
    <h1>{{t $lang "admin.dashboard.title"}}</h1>
    <p class="admin-page-intro">{{t $lang "admin.dashboard.intro"}}</p>
  </header>
  <section class="stats-grid" aria-label="{{t $lang "admin.dashboard.overview"}}">
    <article class="stat-card"><h2>{{t $lang "admin.dashboard.total_users"}}</h2><p class="stat-value">{{.totalUsers}}</p><a href="{{$ap}}/moderation/users">{{t $lang "admin.dashboard.user_management"}}</a></article>
    <article class="stat-card"><h2>{{t $lang "admin.dashboard.admin_users"}}</h2><p class="stat-value">{{.adminCount}}</p><a href="{{$ap}}/admins">{{t $lang "admin.admins.title"}}</a></article>
    <article class="stat-card"><h2>{{t $lang "admin.dashboard.total_locations"}}</h2><p class="stat-value">{{.totalLocations}}</p></article>
    <article class="stat-card"><h2>{{t $lang "admin.dashboard.system_status"}}</h2><p class="stat-value">✓ {{t $lang "admin.dashboard.online"}}</p></article>
  </section>
  <section class="admin-section" aria-labelledby="admin-quick-links-heading">
    <div class="section-header"><h2 id="admin-quick-links-heading">{{t $lang "admin.dashboard.quick_links"}}</h2></div>
    <nav class="admin-card-grid" aria-label="{{t $lang "admin.dashboard.quick_links"}}">
      <a class="admin-card" href="{{$ap}}/moderation/users"><h3>{{t $lang "admin.dashboard.user_management"}}</h3></a>
      <a class="admin-card" href="{{$ap}}/users/invites"><h3>{{t $lang "admin.user_invites.title"}}</h3></a>
      <a class="admin-card" href="{{$ap}}/settings"><h3>{{t $lang "admin.dashboard.server_settings"}}</h3></a>
      <a class="admin-card" href="{{$ap}}/web"><h3>{{t $lang "admin.dashboard.web_settings"}}</h3></a>
      <a class="admin-card" href="{{$ap}}/security"><h3>{{t $lang "admin.dashboard.security_settings"}}</h3></a>
      <a class="admin-card" href="{{$ap}}/database"><h3>{{t $lang "admin.dashboard.database_cache"}}</h3></a>
      <a class="admin-card" href="{{$ap}}/ssl"><h3>{{t $lang "admin.nav.ssl"}}</h3></a>
      <a class="admin-card" href="{{$ap}}/backup"><h3>{{t $lang "admin.dashboard.backup_restore"}}</h3></a>
      <a class="admin-card" href="{{$ap}}/security/tokens"><h3>{{t $lang "admin.dashboard.tab_tokens"}}</h3></a>
      <a class="admin-card" href="{{$ap}}/logs"><h3>{{t $lang "admin.dashboard.tab_logs"}}</h3></a>
      <a class="admin-card" href="{{$ap}}/scheduler"><h3>{{t $lang "admin.nav.scheduler"}}</h3></a>
      <a class="admin-card" href="{{$ap}}/admins"><h3>{{t $lang "admin.admins.title"}}</h3></a>
    </nav>
  </section>
</main>
{{template "admin_footer" .}}
