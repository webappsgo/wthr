{{- $lang := "en" -}}
{{- if .lang}}{{$lang = .lang}}{{end -}}
<!DOCTYPE html>
<html lang="{{$lang}}" class="{{if .server.ThemeClass}}{{.server.ThemeClass}}{{else}}theme-dark{{end}}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title>{{ .title }}</title>
    <link rel="stylesheet" href="/static/css/common.css">
    <link rel="stylesheet" href="/static/css/components.css">
    <link rel="stylesheet" href="/static/css/admin.css">
</head>
<body>
    <div class="login-container">
        <div class="login-card">
            <div class="login-header">
                <h1 class="login-title">{{ .branding.Title }}</h1>
                <p class="login-subtitle">{{t $lang "admin.setup_token.subtitle"}}</p>
            </div>

            <div class="login-info">
                <p>{{t $lang "admin.setup_token.welcome_message"}}</p>
                <p>{{t $lang "admin.setup_token.instructions"}}</p>
            </div>

            {{ if .error }}
            <div class="error-message" role="alert">{{ .error }}</div>
            {{ end }}

            <form method="POST" action="{{.admin_path}}/verify-token" autocomplete="off">
                <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
                <div class="form-group">
                    <label for="setup_token" class="form-label">{{t $lang "admin.setup_token.label"}}</label>
                    <input type="text"
                           id="setup_token"
                           name="setup_token"
                           class="form-input long-string"
                           required
                           autofocus
                           autocomplete="off"
                           placeholder="{{t $lang "admin.setup_token.placeholder"}}"
                           aria-label="{{t $lang "admin.setup_token.aria_label"}}"
                           aria-required="true"
                           pattern="[a-fA-F0-9]{32}"
                           title="{{t $lang "admin.setup_token.field_title"}}">
                </div>

                <button type="submit" class="btn-login">{{t $lang "admin.setup_token.verify_action"}}</button>
            </form>

            <div class="login-help">
                <p>{{t $lang "admin.setup_token.help_shown_once"}}</p>
                <p>{{t $lang "admin.setup_token.help_check_console"}}</p>
            </div>
        </div>

        {{ if .version }}
        <div class="login-footer">
            v{{ .version }}
        </div>
        {{ end }}
    </div>
</body>
</html>
