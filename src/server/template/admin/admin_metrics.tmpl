{{define "admin/admin_metrics.tmpl"}}
{{template "head" .}}
{{template "admin_header" .}}
{{- $lang := "en" -}}
{{- if .lang}}{{$lang = .lang}}{{end -}}
    <div class="content-header">
        <h1>📊 {{t $lang "admin.metrics.title"}}</h1>
    </div>

    <div class="admin-page-container wide">
        <div class="admin-alert admin-alert-success" id="successAlert" role="status" aria-live="polite"></div>
        <div class="admin-alert admin-alert-error" id="errorAlert" role="alert" aria-live="assertive"></div>

        <!-- Live registry statistics -->
        <div class="admin-page-card">
            <h2>📈 {{t $lang "admin.metrics.current_heading"}}</h2>
            <div class="stats-grid">
                <div class="stat-box">
                    <div class="stat-value" id="totalMetrics">0</div>
                    <div class="stat-label">{{t $lang "admin.metrics.total_label"}}</div>
                </div>
                <div class="stat-box">
                    <div class="stat-value" id="seriesMetrics">0</div>
                    <div class="stat-label">{{t $lang "admin.metrics.series_label"}}</div>
                </div>
                <div class="stat-box">
                    <div class="stat-value" id="exportFormats">3</div>
                    <div class="stat-label">{{t $lang "admin.metrics.export_formats_label"}}</div>
                </div>
            </div>
        </div>

        <!-- Tabs -->
        <div class="admin-tabs">
            <button class="admin-tab active" data-tab="settings">{{t $lang "admin.metrics.tab_settings"}}</button>
            <button class="admin-tab" data-tab="registered">{{t $lang "admin.metrics.tab_registered"}}</button>
            <button class="admin-tab" data-tab="export">{{t $lang "admin.metrics.tab_export"}}</button>
        </div>

        <!-- Settings Tab -->
        <div class="admin-tab-content active" id="settings">
            <div class="metrics-grid">
                <div class="admin-page-card">
                    <h2>⚙️ {{t $lang "admin.metrics.prometheus_config_heading"}}</h2>
                    <form id="prometheusForm"
                          data-msg-saved="{{t $lang "admin.common.settings_saved"}}"
                          data-msg-error="{{t $lang "admin.common.settings_save_error"}}">
                        <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
                        <div class="form-group">
                            <label>
                                <input type="checkbox" id="metricsEnabled">
                                {{t $lang "admin.metrics.enable_prometheus_label"}}
                            </label>
                            <small>{{t $lang "admin.metrics.enable_prometheus_hint"}}</small>
                        </div>

                        <div class="form-group">
                            <label>
                                <input type="checkbox" id="rootAliasEnabled">
                                {{t $lang "admin.metrics.root_alias_label"}}
                            </label>
                            <small>{{t $lang "admin.metrics.root_alias_hint"}}</small>
                        </div>

                        <div class="form-group">
                            <label>
                                <input type="checkbox" id="includeSystem">
                                {{t $lang "admin.metrics.include_system_label"}}
                            </label>
                        </div>

                        <div class="form-group">
                            <label>
                                <input type="checkbox" id="includeRuntime">
                                {{t $lang "admin.metrics.include_runtime_label"}}
                            </label>
                        </div>

                        <div class="form-group">
                            <label for="lokiMaxEntries">{{t $lang "admin.metrics.loki_max_entries_label"}}</label>
                            <input type="number" id="lokiMaxEntries" min="1" step="1" value="1000">
                        </div>

                        <div class="form-group">
                            <label for="lokiMaxAge">{{t $lang "admin.metrics.loki_max_age_label"}}</label>
                            <input type="text" id="lokiMaxAge" placeholder="1h" value="1h">
                        </div>

                        <h3 class="mt-3 mb-2">{{t $lang "admin.metrics.tokens_heading"}}</h3>
                        <p><small>{{t $lang "admin.metrics.token_hint"}}</small></p>

                        <div class="form-group">
                            <label for="tokenPrometheus">{{t $lang "admin.metrics.token_prometheus_label"}}</label>
                            <input type="text" id="tokenPrometheus" autocomplete="off">
                        </div>

                        <div class="form-group">
                            <label for="tokenGrafana">{{t $lang "admin.metrics.token_grafana_label"}}</label>
                            <input type="text" id="tokenGrafana" autocomplete="off">
                        </div>

                        <div class="form-group">
                            <label for="tokenLoki">{{t $lang "admin.metrics.token_loki_label"}}</label>
                            <input type="text" id="tokenLoki" autocomplete="off">
                        </div>

                        <div class="form-group">
                            <label>
                                <input type="checkbox" id="allowUnauthenticated">
                                {{t $lang "admin.metrics.allow_unauthenticated_label"}}
                            </label>
                            <small>{{t $lang "admin.metrics.allow_unauthenticated_hint"}}</small>
                        </div>

                        <button type="submit" class="btn btn-primary"
                                data-label-save="💾 {{t $lang "admin.metrics.save_config_action"}}"
                                data-label-saving="{{t $lang "admin.common.saving"}}">💾 {{t $lang "admin.metrics.save_config_action"}}</button>
                    </form>
                </div>

                <div class="admin-page-card">
                    <h2>🔗 {{t $lang "admin.metrics.integration_heading"}}</h2>
                    <div class="form-group">
                        <label>{{t $lang "admin.metrics.metrics_endpoint_label"}}</label>
                        <div class="code-block mt-1" id="metricsEndpointDisplay"></div>
                    </div>

                    <div class="form-group">
                        <label>{{t $lang "admin.metrics.prometheus_config_label"}}</label>
                        <div class="code-block" id="scrapeConfigDisplay"></div>
                    </div>

                    <div class="btn-group">
                        <button class="btn btn-success" id="testPrometheusBtn"
                                data-msg-success="{{t $lang "admin.metrics.test_success"}}"
                                data-msg-error="{{t $lang "admin.metrics.test_error"}}">🧪 {{t $lang "admin.metrics.test_endpoint_action"}}</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Registered Metrics Tab -->
        <div class="admin-tab-content" id="registered">
            <div class="admin-page-card">
                <h2>📊 {{t $lang "admin.metrics.registered_heading"}}</h2>
                <div class="table-responsive">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th scope="col">{{t $lang "admin.metrics.col_name"}}</th>
                                <th scope="col">{{t $lang "admin.metrics.col_type"}}</th>
                                <th scope="col">{{t $lang "admin.metrics.col_series"}}</th>
                                <th scope="col">{{t $lang "admin.metrics.col_help"}}</th>
                            </tr>
                        </thead>
                        <tbody id="registeredMetricsBody">
                            <tr>
                                <td colspan="4" class="text-center text-muted p-3">{{t $lang "admin.metrics.registered_empty"}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Export Tab -->
        <div class="admin-tab-content" id="export">
            <div class="metrics-grid">
                <div class="admin-page-card">
                    <h2>📤 {{t $lang "admin.metrics.export_formats_heading"}}</h2>
                    <div class="btn-group-vertical">
                        <button class="btn btn-primary" id="exportPrometheusBtn">
                            📊 {{t $lang "admin.metrics.export_prometheus_action"}}
                        </button>
                        <button class="btn btn-primary" id="exportJsonBtn">
                            📋 {{t $lang "admin.metrics.export_json_action"}}
                        </button>
                        <button class="btn btn-primary" id="exportOpenMetricsBtn">
                            📈 {{t $lang "admin.metrics.export_openmetrics_action"}}
                        </button>
                    </div>
                </div>

                <div class="admin-page-card">
                    <h2>👁️ {{t $lang "admin.metrics.preview_heading"}}</h2>
                    <div class="metric-preview" id="exportPreview">
                        <p class="text-center text-muted">{{t $lang "admin.metrics.preview_empty"}}</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script type="application/json" id="admin-metrics-data">{"apiPath": {{.api_path}}, "adminApiPath": {{.admin_api_path}}, "csrfToken": {{.csrf_token}}, "msgLoadError": {{t $lang "admin.metrics.load_error"}}, "msgExportError": {{t $lang "admin.metrics.export_error"}}, "registeredEmpty": {{t $lang "admin.metrics.registered_empty"}}}</script>
    <script src="/static/js/app.js"></script>
{{template "admin_footer" .}}
{{end}}
