{{define "admin/admin_metrics.tmpl"}}
{{template "head" .}}
{{template "admin_header" .}}
{{- $lang := "en" -}}
{{- if .lang}}{{$lang = .lang}}{{end -}}
    <div class="content-header">
        <h1>📊 {{t $lang "admin.metrics.title"}}</h1>
    </div>

    <div class="admin-page-container wide">
        <div class="admin-alert admin-alert-success" id="successAlert" role="alert"></div>
        <div class="admin-alert admin-alert-error" id="errorAlert" role="alert"></div>

        <!-- Metrics Statistics -->
        <div class="admin-page-card">
            <h2>📈 {{t $lang "admin.metrics.current_heading"}}</h2>
            <div class="stats-grid">
                <div class="stat-box">
                    <div class="stat-value" id="totalMetrics">0</div>
                    <div class="stat-label">{{t $lang "admin.metrics.total_label"}}</div>
                </div>
                <div class="stat-box">
                    <div class="stat-value" id="enabledMetrics">0</div>
                    <div class="stat-label">{{t $lang "admin.metrics.enabled_label"}}</div>
                </div>
                <div class="stat-box">
                    <div class="stat-value" id="customMetrics">0</div>
                    <div class="stat-label">{{t $lang "admin.metrics.custom_label"}}</div>
                </div>
                <div class="stat-box">
                    <div class="stat-value" id="exportFormats">3</div>
                    <div class="stat-label">{{t $lang "admin.metrics.export_formats_label"}}</div>
                </div>
            </div>
        </div>

        <!-- Tabs -->
        <div class="admin-tabs">
            <button class="admin-tab active" data-tab="prometheus">{{t $lang "admin.metrics.tab_prometheus"}}</button>
            <button class="admin-tab" data-tab="builtin">{{t $lang "admin.metrics.tab_builtin"}}</button>
            <button class="admin-tab" data-tab="custom">{{t $lang "admin.metrics.tab_custom"}}</button>
            <button class="admin-tab" data-tab="export">{{t $lang "admin.metrics.tab_export"}}</button>
        </div>

        <!-- Prometheus Tab -->
        <div class="admin-tab-content active" id="prometheus">
            <div class="metrics-grid">
                <div class="admin-page-card">
                    <h2>⚙️ {{t $lang "admin.metrics.prometheus_config_heading"}}</h2>
                    <form id="prometheusForm">
    <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
                        <div class="form-group">
                            <label>
                                <input type="checkbox" id="prometheusEnabled" checked>
                                {{t $lang "admin.metrics.enable_prometheus_label"}}
                            </label>
                            <small>{{t $lang "admin.metrics.enable_prometheus_hint"}}</small>
                        </div>

                        <div class="form-group">
                            <label for="metricsPath">{{t $lang "admin.metrics.metrics_path_label"}}</label>
                            <input type="text" id="metricsPath" value="/metrics">
                            <small>{{t $lang "admin.metrics.metrics_path_hint"}}</small>
                        </div>

                        <div class="form-group">
                            <label for="namespace">{{t $lang "admin.metrics.namespace_label"}}</label>
                            <input type="text" id="namespace" value="wthr" placeholder="wthr">
                            <small>{{t $lang "admin.metrics.namespace_hint"}}</small>
                        </div>

                        <div class="form-group">
                            <label for="subsystem">{{t $lang "admin.metrics.subsystem_label"}}</label>
                            <input type="text" id="subsystem" placeholder="api">
                            <small>{{t $lang "admin.metrics.subsystem_hint"}}</small>
                        </div>

                        <div class="form-group">
                            <label>
                                <input type="checkbox" id="includeGoMetrics" checked>
                                {{t $lang "admin.metrics.include_go_metrics_label"}}
                            </label>
                        </div>

                        <div class="form-group">
                            <label>
                                <input type="checkbox" id="includeProcessMetrics" checked>
                                {{t $lang "admin.metrics.include_process_metrics_label"}}
                            </label>
                        </div>

                        <button type="submit" class="btn btn-primary">💾 {{t $lang "admin.metrics.save_config_action"}}</button>
                    </form>
                </div>

                <div class="admin-page-card">
                    <h2>🔗 {{t $lang "admin.metrics.integration_heading"}}</h2>
                    <div class="form-group">
                        <label>{{t $lang "admin.metrics.metrics_endpoint_label"}}</label>
                        <div class="code-block" class="mt-1">http://localhost:3000/metrics</div>
                    </div>

                    <div class="form-group">
                        <label>{{t $lang "admin.metrics.prometheus_config_label"}}</label>
                        <div class="code-block">scrape_configs:
  - job_name: 'weather'
    static_configs:
      - targets: ['localhost:3000']
    metrics_path: '/metrics'
    scrape_interval: 15s</div>
                    </div>

                    <div class="btn-group">
                        <button class="btn btn-success" id="testPrometheusBtn">🧪 {{t $lang "admin.metrics.test_endpoint_action"}}</button>
                        <button class="btn btn-secondary" id="downloadConfigBtn">📥 {{t $lang "admin.metrics.download_config_action"}}</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Built-in Metrics Tab -->
        <div class="admin-tab-content" id="builtin">
            <div class="admin-page-card">
                <h2>📊 {{t $lang "admin.metrics.builtin_heading"}}</h2>
                <div id="builtinMetrics">
                    <div class="metric-item">
                        <div class="metric-info">
                            <h3>{{t $lang "admin.metrics.http_request_count_title"}}</h3>
                            <p>{{t $lang "admin.metrics.http_request_count_desc"}}</p>
                        </div>
                        <label class="toggle-switch">
                            <input type="checkbox" checked data-metric="http_requests">
                            <span class="toggle-slider"></span>
                        </label>
                    </div>

                    <div class="metric-item">
                        <div class="metric-info">
                            <h3>{{t $lang "admin.metrics.http_request_duration_title"}}</h3>
                            <p>{{t $lang "admin.metrics.http_request_duration_desc"}}</p>
                        </div>
                        <label class="toggle-switch">
                            <input type="checkbox" checked data-metric="http_duration">
                            <span class="toggle-slider"></span>
                        </label>
                    </div>

                    <div class="metric-item">
                        <div class="metric-info">
                            <h3>{{t $lang "admin.metrics.api_response_status_title"}}</h3>
                            <p>{{t $lang "admin.metrics.api_response_status_desc"}}</p>
                        </div>
                        <label class="toggle-switch">
                            <input type="checkbox" checked data-metric="api_status">
                            <span class="toggle-slider"></span>
                        </label>
                    </div>

                    <div class="metric-item">
                        <div class="metric-info">
                            <h3>{{t $lang "admin.metrics.database_queries_title"}}</h3>
                            <p>{{t $lang "admin.metrics.database_queries_desc"}}</p>
                        </div>
                        <label class="toggle-switch">
                            <input type="checkbox" checked data-metric="db_queries">
                            <span class="toggle-slider"></span>
                        </label>
                    </div>

                    <div class="metric-item">
                        <div class="metric-info">
                            <h3>{{t $lang "admin.metrics.cache_hit_rate_title"}}</h3>
                            <p>{{t $lang "admin.metrics.cache_hit_rate_desc"}}</p>
                        </div>
                        <label class="toggle-switch">
                            <input type="checkbox" checked data-metric="cache_hits">
                            <span class="toggle-slider"></span>
                        </label>
                    </div>

                    <div class="metric-item">
                        <div class="metric-info">
                            <h3>{{t $lang "admin.metrics.active_connections_title"}}</h3>
                            <p>{{t $lang "admin.metrics.active_connections_desc"}}</p>
                        </div>
                        <label class="toggle-switch">
                            <input type="checkbox" checked data-metric="connections">
                            <span class="toggle-slider"></span>
                        </label>
                    </div>

                    <div class="metric-item">
                        <div class="metric-info">
                            <h3>{{t $lang "admin.metrics.task_execution_title"}}</h3>
                            <p>{{t $lang "admin.metrics.task_execution_desc"}}</p>
                        </div>
                        <label class="toggle-switch">
                            <input type="checkbox" checked data-metric="tasks">
                            <span class="toggle-slider"></span>
                        </label>
                    </div>

                    <div class="metric-item">
                        <div class="metric-info">
                            <h3>{{t $lang "admin.metrics.email_notifications_title"}}</h3>
                            <p>{{t $lang "admin.metrics.email_notifications_desc"}}</p>
                        </div>
                        <label class="toggle-switch">
                            <input type="checkbox" checked data-metric="emails">
                            <span class="toggle-slider"></span>
                        </label>
                    </div>
                </div>
            </div>
        </div>

        <!-- Custom Metrics Tab -->
        <div class="admin-tab-content" id="custom">
            <div class="admin-page-card">
                <h2>➕ {{t $lang "admin.metrics.add_custom_heading"}}</h2>
                <form id="customMetricForm">
    <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
                    <div class="grid">
                        <div class="form-group">
                            <label for="metricName">{{t $lang "admin.metrics.metric_name_label"}}</label>
                            <input type="text" id="metricName" placeholder="wthr_custom_metric" required>
                            <small>{{t $lang "admin.metrics.metric_name_hint"}}</small>
                        </div>

                        <div class="form-group">
                            <label for="metricType">{{t $lang "admin.metrics.metric_type_label"}}</label>
                            <select id="metricType">
                                <option value="counter">{{t $lang "admin.metrics.type_counter"}}</option>
                                <option value="gauge">{{t $lang "admin.metrics.type_gauge"}}</option>
                                <option value="histogram">{{t $lang "admin.metrics.type_histogram"}}</option>
                                <option value="summary">{{t $lang "admin.metrics.type_summary"}}</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="metricHelp">{{t $lang "admin.metrics.metric_desc_label"}}</label>
                        <input type="text" id="metricHelp" placeholder="{{t $lang "admin.metrics.metric_desc_placeholder"}}" required>
                    </div>

                    <div class="form-group">
                        <label for="metricLabels">{{t $lang "admin.metrics.metric_labels_label"}}</label>
                        <input type="text" id="metricLabels" placeholder="method,path,status">
                        <small>{{t $lang "admin.metrics.metric_labels_hint"}}</small>
                    </div>

                    <button type="submit" class="btn btn-success">➕ {{t $lang "admin.metrics.add_metric_action"}}</button>
                </form>

                <h3 class="mt-3 mb-2">{{t $lang "admin.metrics.custom_list_heading"}}</h3>
                <div id="customMetricsList">
                    <p class="text-center text-muted p-3">{{t $lang "admin.metrics.no_custom_metrics"}}</p>
                </div>
            </div>
        </div>

        <!-- Export Tab -->
        <div class="admin-tab-content" id="export">
            <div class="metrics-grid">
                <div class="admin-page-card">
                    <h2>📤 {{t $lang "admin.metrics.export_formats_heading"}}</h2>
                    <div class="btn-group-vertical">
                        <button class="btn btn-primary" id="exportPrometheusBtn">
                            📊 {{t $lang "admin.metrics.export_prometheus_action"}}
                        </button>
                        <button class="btn btn-primary" id="exportJsonBtn">
                            📋 {{t $lang "admin.metrics.export_json_action"}}
                        </button>
                        <button class="btn btn-primary" id="exportOpenMetricsBtn">
                            📈 {{t $lang "admin.metrics.export_openmetrics_action"}}
                        </button>
                    </div>
                </div>

                <div class="admin-page-card">
                    <h2>👁️ {{t $lang "admin.metrics.preview_heading"}}</h2>
                    <div class="metric-preview" id="exportPreview">
                        <p class="text-center text-muted">{{t $lang "admin.metrics.preview_empty"}}</p>
                    </div>
                </div>
            </div>

            <div class="admin-page-card">
                <h2>🔗 {{t $lang "admin.metrics.external_links_heading"}}</h2>
                <div class="form-group">
                    <label for="grafanaUrl">{{t $lang "admin.metrics.grafana_url_label"}}</label>
                    <input type="text" id="grafanaUrl" placeholder="http://grafana.example.com/dashboard/weather">
                    <small>{{t $lang "admin.metrics.grafana_url_hint"}}</small>
                </div>

                <div class="form-group">
                    <label for="prometheusUrl">{{t $lang "admin.metrics.prometheus_url_label"}}</label>
                    <input type="text" id="prometheusUrl" placeholder="http://prometheus.example.com:9090">
                    <small>{{t $lang "admin.metrics.prometheus_url_hint"}}</small>
                </div>

                <button class="btn btn-primary" id="saveLinksBtn">💾 {{t $lang "admin.metrics.save_links_action"}}</button>
            </div>
        </div>
    </div>

    <script>
        // Path variables - SPEC compliant (AI.md PART 13)
        const API_PATH = '{{.api_path}}';
        const ADMIN_API_PATH = '{{.admin_api_path}}';

        // Tab switching
        document.querySelectorAll('.admin-tab').forEach(tab => {
            tab.addEventListener('click', () => {
                document.querySelectorAll('.admin-tab').forEach(t => t.classList.remove('active'));
                document.querySelectorAll('.admin-tab-content').forEach(c => c.classList.remove('active'));

                tab.classList.add('active');
                document.getElementById(tab.dataset.tab).classList.add('active');
            });
        });

        // Load metrics stats
        async function loadStats() {
            try {
                const response = await fetch(ADMIN_API_PATH + '/server/metrics/stats');
                const data = await response.json();

                document.getElementById('totalMetrics').textContent = data.total || 0;
                document.getElementById('enabledMetrics').textContent = data.enabled || 0;
                document.getElementById('customMetrics').textContent = data.custom || 0;
            } catch (error) {
                console.error('Failed to load stats:', error);
            }
        }

        // Save Prometheus configuration
        document.getElementById('prometheusForm').addEventListener('submit', async (e) => {
            e.preventDefault();

            const config = {
                enabled: document.getElementById('prometheusEnabled').checked,
                path: document.getElementById('metricsPath').value,
                namespace: document.getElementById('namespace').value,
                subsystem: document.getElementById('subsystem').value,
                includeGoMetrics: document.getElementById('includeGoMetrics').checked,
                includeProcessMetrics: document.getElementById('includeProcessMetrics').checked
            };

            try {
                const response = await fetch(ADMIN_API_PATH + '/server/metrics/config', {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(config)
                });

                if (!response.ok) throw new Error('Failed to save configuration');

                showSuccess('Prometheus configuration saved successfully!');
            } catch (error) {
                showError('Failed to save configuration: ' + error.message);
            }
        });

        // Test Prometheus endpoint
        document.getElementById('testPrometheusBtn').addEventListener('click', async () => {
            try {
                const response = await fetch('/metrics');
                const text = await response.text();

                if (response.ok) {
                    showSuccess('Prometheus endpoint is working! Check browser console for output.');
                    console.log('Metrics output:', text);
                } else {
                    showError('Endpoint returned error: ' + response.status);
                }
            } catch (error) {
                showError('Failed to test endpoint: ' + error.message);
            }
        });

        // Export formats
        document.getElementById('exportPrometheusBtn').addEventListener('click', async () => {
            const response = await fetch('/metrics');
            const text = await response.text();
            document.getElementById('exportPreview').textContent = text;
        });

        document.getElementById('exportJsonBtn').addEventListener('click', async () => {
            const response = await fetch(ADMIN_API_PATH + '/server/metrics/export?format=json');
            const data = await response.json();
            document.getElementById('exportPreview').textContent = JSON.stringify(data, null, 2);
        });

        // Show messages
        function showSuccess(msg) {
            const alert = document.getElementById('successAlert');
            alert.textContent = msg;
            alert.classList.add('show');
            setTimeout(() => alert.classList.remove('show'), 5000);
        }

        function showError(msg) {
            const alert = document.getElementById('errorAlert');
            alert.textContent = msg;
            alert.classList.add('show');
            setTimeout(() => alert.classList.remove('show'), 5000);
        }

        // Initial load
        loadStats();
    </script>
{{template "admin_footer" .}}
{{end}}
