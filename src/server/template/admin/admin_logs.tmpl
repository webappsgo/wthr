{{define "admin/admin_logs.tmpl"}}
{{template "head" .}}
{{template "admin_header" .}}
{{- $lang := "en" -}}
{{- if .lang}}{{$lang = .lang}}{{end -}}
    <div class="content-header">
        <h1>{{t $lang "admin.logs.title"}}</h1>
    </div>

    <div class="admin-page-container wide">
        <!-- Controls Panel -->
        <div class="controls-panel">
            <div class="controls-grid">
                <div class="control-group">
                    <label for="logLevel">{{t $lang "admin.logs.level_label"}}</label>
                    <select id="logLevel" aria-label="{{t $lang "admin.logs.level_aria"}}">
                        <option value="all">{{t $lang "admin.logs.level_all"}}</option>
                        <option value="DEBUG">{{t $lang "admin.logs.level_debug"}}</option>
                        <option value="INFO">{{t $lang "admin.logs.level_info"}}</option>
                        <option value="WARN">{{t $lang "admin.logs.level_warn"}}</option>
                        <option value="ERROR">{{t $lang "admin.logs.level_error"}}</option>
                        <option value="FATAL">{{t $lang "admin.logs.level_fatal"}}</option>
                    </select>
                </div>

                <div class="control-group">
                    <label for="logSource">{{t $lang "admin.logs.source_label"}}</label>
                    <select id="logSource" aria-label="{{t $lang "admin.logs.source_aria"}}">
                        <option value="all">{{t $lang "admin.logs.source_all"}}</option>
                        <option value="server">{{t $lang "admin.logs.source_server"}}</option>
                        <option value="api">{{t $lang "admin.logs.source_api"}}</option>
                        <option value="database">{{t $lang "admin.logs.source_database"}}</option>
                        <option value="tor">{{t $lang "admin.logs.source_tor"}}</option>
                        <option value="email">{{t $lang "admin.logs.source_email"}}</option>
                        <option value="scheduler">{{t $lang "admin.logs.source_scheduler"}}</option>
                    </select>
                </div>

                <div class="control-group">
                    <label for="searchQuery">{{t $lang "admin.logs.search_label"}}</label>
                    <input type="text" id="searchQuery" placeholder="{{t $lang "admin.logs.search_placeholder"}}" aria-label="{{t $lang "admin.logs.search_aria"}}">
                </div>

                <div class="control-group">
                    <label for="tailLines">{{t $lang "admin.logs.tail_label"}}</label>
                    <select id="tailLines" aria-label="{{t $lang "admin.logs.tail_aria"}}">
                        <option value="100">{{t $lang "admin.logs.tail_100"}}</option>
                        <option value="250" selected>{{t $lang "admin.logs.tail_250"}}</option>
                        <option value="500">{{t $lang "admin.logs.tail_500"}}</option>
                        <option value="1000">{{t $lang "admin.logs.tail_1000"}}</option>
                        <option value="all">{{t $lang "admin.logs.tail_all"}}</option>
                    </select>
                </div>
            </div>

            <div class="stats-bar">
                <div class="stat">
                    <span class="stat-label">{{t $lang "admin.logs.stat_total"}}</span>
                    <span class="stat-value" id="totalEntries">0</span>
                </div>
                <div class="stat">
                    <span class="stat-label">{{t $lang "admin.logs.stat_filtered"}}</span>
                    <span class="stat-value" id="filteredEntries">0</span>
                </div>
                <div class="stat">
                    <span class="stat-label">{{t $lang "admin.logs.stat_errors"}}</span>
                    <span class="stat-value text-danger" id="errorCount">0</span>
                </div>
                <div class="stat">
                    <span class="stat-label">{{t $lang "admin.logs.stat_warnings"}}</span>
                    <span class="stat-value text-warning" id="warnCount">0</span>
                </div>
            </div>

            <div class="button-group">
                <button class="btn btn-primary" id="refreshBtn" aria-label="{{t $lang "admin.logs.refresh_aria"}}">
                    <span>🔄</span> {{t $lang "action.refresh"}}
                </button>
                <button class="btn btn-success" id="downloadBtn" aria-label="{{t $lang "admin.logs.download_aria"}}">
                    <span>⬇️</span> {{t $lang "admin.logs.download_action"}}
                </button>
                <button class="btn btn-secondary" id="clearFilterBtn" aria-label="{{t $lang "admin.logs.clear_filters_aria"}}">
                    {{t $lang "admin.logs.clear_filters_action"}}
                </button>
                <button class="btn btn-danger" id="clearLogsBtn" aria-label="{{t $lang "admin.logs.clear_logs_aria"}}">
                    <span>🗑️</span> {{t $lang "admin.logs.clear_logs_action"}}
                </button>
            </div>
        </div>

        <!-- Logs Panel -->
        <div class="logs-panel">
            <div class="logs-header">
                <h2>{{t $lang "admin.logs.entries_heading"}}</h2>
                <div class="auto-refresh">
                    <input type="checkbox" id="autoRefresh" aria-label="{{t $lang "admin.logs.auto_refresh_aria"}}">
                    <label for="autoRefresh">{{t $lang "admin.logs.auto_refresh_label"}}</label>
                </div>
            </div>
            <div class="logs-container" id="logsContainer" role="log" aria-live="polite" aria-atomic="false">
                <div class="no-logs">
                    <p>{{t $lang "admin.logs.loading"}}</p>
                </div>
            </div>
        </div>
    </div>

    <script type="application/json" id="admin-logs-data">{"adminApiPath": {{.admin_api_path}}}</script>
    <script src="/static/js/app.js"></script>
{{template "admin_footer" .}}
{{end}}
