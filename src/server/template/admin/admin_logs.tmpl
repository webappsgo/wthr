{{define "admin/admin_logs.tmpl"}}
{{template "head" .}}
{{template "admin_header" .}}
{{- $lang := "en" -}}
{{- if .lang}}{{$lang = .lang}}{{end -}}
    <div class="content-header">
        <h1>{{t $lang "admin.logs.title"}}</h1>
    </div>

    <div class="admin-page-container wide">
        <form method="get" action="{{.admin_path}}/logs" class="controls-panel">
            <div class="controls-grid">
                <div class="control-group">
                    <label for="logLevel">{{t $lang "admin.logs.level_label"}}</label>
                    <select id="logLevel" name="level">
                        <option value="all">{{t $lang "admin.logs.level_all"}}</option>
                        <option value="DEBUG"{{if eq .level "DEBUG"}} selected{{end}}>DEBUG</option>
                        <option value="INFO"{{if eq .level "INFO"}} selected{{end}}>INFO</option>
                        <option value="WARN"{{if eq .level "WARN"}} selected{{end}}>WARN</option>
                        <option value="ERROR"{{if eq .level "ERROR"}} selected{{end}}>ERROR</option>
                        <option value="FATAL"{{if eq .level "FATAL"}} selected{{end}}>FATAL</option>
                    </select>
                </div>
                <div class="control-group">
                    <label for="logSource">{{t $lang "admin.logs.source_label"}}</label>
                    <input id="logSource" name="source" value="{{.source}}" placeholder="all">
                </div>
                <div class="control-group">
                    <label for="searchQuery">{{t $lang "admin.logs.search_label"}}</label>
                    <input type="search" id="searchQuery" name="q" value="{{.query}}" placeholder="{{t $lang "admin.logs.search_placeholder"}}">
                </div>
                <div class="control-group">
                    <label for="tailLines">{{t $lang "admin.logs.tail_label"}}</label>
                    <select id="tailLines" name="tail">
                        <option value="100"{{if eq .tail "100"}} selected{{end}}>100</option><option value="250"{{if or (eq .tail "" ) (eq .tail "250")}} selected{{end}}>250</option>
                        <option value="500"{{if eq .tail "500"}} selected{{end}}>500</option><option value="1000"{{if eq .tail "1000"}} selected{{end}}>1000</option><option value="all"{{if eq .tail "all"}} selected{{end}}>{{t $lang "admin.logs.tail_all"}}</option>
                    </select>
                </div>
            </div>
            <button class="btn btn-primary" type="submit">{{t $lang "action.refresh"}}</button>
            <a class="btn btn-secondary" href="{{.admin_path}}/logs/download">{{t $lang "admin.logs.download_action"}}</a>
            <p>{{.filtered}} / {{.total}}</p>
        </form>
        {{if .cleared}}<p class="alert alert-success" role="status">{{t $lang "success.admin.logs.logs_cleared_successfully"}}</p>{{end}}
        {{if .clear_error}}<p class="alert alert-danger" role="alert">{{t $lang "errors.admin.logs.failed_to_truncate_log_file"}}</p>{{end}}
        <form method="post" action="{{.admin_path}}/logs/clear" class="admin-card">
            <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
            <label><input type="checkbox" name="confirm" value="yes" required> Clear the current application log file.</label>
            <button class="btn btn-danger" type="submit">{{t $lang "admin.logs.clear_logs_action"}}</button>
        </form>
        <section class="logs-panel" aria-labelledby="logs-static-heading">
            <h2 id="logs-static-heading">{{t $lang "admin.logs.entries_heading"}}</h2>
            {{if .logs}}
            <ol class="logs-list">
                {{range .logs}}<li><time>{{.Timestamp}}</time> <strong>{{.Level}}</strong> <span>{{.Source}}</span> {{.Message}}</li>{{end}}
            </ol>
            {{else}}
            <p class="no-logs">No log entries match these filters.</p>
            {{end}}
        </section>
    </div>
{{template "admin_footer" .}}
{{end}}
