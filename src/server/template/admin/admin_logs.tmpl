{{define "admin/admin_logs.tmpl"}}
{{template "head" .}}
{{template "admin_header" .}}
{{- $lang := "en" -}}
{{- if .lang}}{{$lang = .lang}}{{end -}}
    <div class="content-header">
        <h1>{{t $lang "admin.logs.title"}}</h1>
    </div>

    <div class="admin-page-container wide">
        <!-- Controls Panel -->
        <div class="controls-panel">
            <div class="controls-grid">
                <div class="control-group">
                    <label for="logLevel">{{t $lang "admin.logs.level_label"}}</label>
                    <select id="logLevel" aria-label="{{t $lang "admin.logs.level_aria"}}">
                        <option value="all">{{t $lang "admin.logs.level_all"}}</option>
                        <option value="DEBUG">{{t $lang "admin.logs.level_debug"}}</option>
                        <option value="INFO">{{t $lang "admin.logs.level_info"}}</option>
                        <option value="WARN">{{t $lang "admin.logs.level_warn"}}</option>
                        <option value="ERROR">{{t $lang "admin.logs.level_error"}}</option>
                        <option value="FATAL">{{t $lang "admin.logs.level_fatal"}}</option>
                    </select>
                </div>

                <div class="control-group">
                    <label for="logSource">{{t $lang "admin.logs.source_label"}}</label>
                    <select id="logSource" aria-label="{{t $lang "admin.logs.source_aria"}}">
                        <option value="all">{{t $lang "admin.logs.source_all"}}</option>
                        <option value="server">{{t $lang "admin.logs.source_server"}}</option>
                        <option value="api">{{t $lang "admin.logs.source_api"}}</option>
                        <option value="database">{{t $lang "admin.logs.source_database"}}</option>
                        <option value="tor">{{t $lang "admin.logs.source_tor"}}</option>
                        <option value="email">{{t $lang "admin.logs.source_email"}}</option>
                        <option value="scheduler">{{t $lang "admin.logs.source_scheduler"}}</option>
                    </select>
                </div>

                <div class="control-group">
                    <label for="searchQuery">{{t $lang "admin.logs.search_label"}}</label>
                    <input type="text" id="searchQuery" placeholder="{{t $lang "admin.logs.search_placeholder"}}" aria-label="{{t $lang "admin.logs.search_aria"}}">
                </div>

                <div class="control-group">
                    <label for="tailLines">{{t $lang "admin.logs.tail_label"}}</label>
                    <select id="tailLines" aria-label="{{t $lang "admin.logs.tail_aria"}}">
                        <option value="100">{{t $lang "admin.logs.tail_100"}}</option>
                        <option value="250" selected>{{t $lang "admin.logs.tail_250"}}</option>
                        <option value="500">{{t $lang "admin.logs.tail_500"}}</option>
                        <option value="1000">{{t $lang "admin.logs.tail_1000"}}</option>
                        <option value="all">{{t $lang "admin.logs.tail_all"}}</option>
                    </select>
                </div>
            </div>

            <div class="stats-bar">
                <div class="stat">
                    <span class="stat-label">{{t $lang "admin.logs.stat_total"}}</span>
                    <span class="stat-value" id="totalEntries">0</span>
                </div>
                <div class="stat">
                    <span class="stat-label">{{t $lang "admin.logs.stat_filtered"}}</span>
                    <span class="stat-value" id="filteredEntries">0</span>
                </div>
                <div class="stat">
                    <span class="stat-label">{{t $lang "admin.logs.stat_errors"}}</span>
                    <span class="stat-value text-danger" id="errorCount">0</span>
                </div>
                <div class="stat">
                    <span class="stat-label">{{t $lang "admin.logs.stat_warnings"}}</span>
                    <span class="stat-value text-warning" id="warnCount">0</span>
                </div>
            </div>

            <div class="button-group">
                <button class="btn btn-primary" id="refreshBtn" aria-label="{{t $lang "admin.logs.refresh_aria"}}">
                    <span>🔄</span> {{t $lang "action.refresh"}}
                </button>
                <button class="btn btn-success" id="downloadBtn" aria-label="{{t $lang "admin.logs.download_aria"}}">
                    <span>⬇️</span> {{t $lang "admin.logs.download_action"}}
                </button>
                <button class="btn btn-secondary" id="clearFilterBtn" aria-label="{{t $lang "admin.logs.clear_filters_aria"}}">
                    {{t $lang "admin.logs.clear_filters_action"}}
                </button>
                <button class="btn btn-danger" id="clearLogsBtn" aria-label="{{t $lang "admin.logs.clear_logs_aria"}}">
                    <span>🗑️</span> {{t $lang "admin.logs.clear_logs_action"}}
                </button>
            </div>
        </div>

        <!-- Logs Panel -->
        <div class="logs-panel">
            <div class="logs-header">
                <h2>{{t $lang "admin.logs.entries_heading"}}</h2>
                <div class="auto-refresh">
                    <input type="checkbox" id="autoRefresh" aria-label="{{t $lang "admin.logs.auto_refresh_aria"}}">
                    <label for="autoRefresh">{{t $lang "admin.logs.auto_refresh_label"}}</label>
                </div>
            </div>
            <div class="logs-container" id="logsContainer" role="log" aria-live="polite" aria-atomic="false">
                <div class="no-logs">
                    <p>{{t $lang "admin.logs.loading"}}</p>
                </div>
            </div>
        </div>
    </div>

    <script>
        const ADMIN_API_PATH = '{{.admin_api_path}}';
        let logs = [];
        let filteredLogs = [];
        let autoRefreshInterval = null;

        // Fetch logs from server
        async function fetchLogs() {
            const refreshBtn = document.getElementById('refreshBtn');
            const originalText = refreshBtn.innerHTML;
            refreshBtn.disabled = true;
            refreshBtn.innerHTML = '<span class="loading"></span> Loading...';

            try {
                const tailLines = document.getElementById('tailLines').value;
                const response = await fetch(`${ADMIN_API_PATH}/logs?tail=${tailLines}`);

                if (!response.ok) throw new Error('Failed to fetch logs');

                const data = await response.json();
                logs = data.logs || [];

                applyFilters();
                updateStats();
            } catch (error) {
                console.error('Error fetching logs:', error);
                showNoLogs('Error loading logs: ' + error.message);
            } finally {
                refreshBtn.disabled = false;
                refreshBtn.innerHTML = originalText;
            }
        }

        // Apply filters
        function applyFilters() {
            const level = document.getElementById('logLevel').value;
            const source = document.getElementById('logSource').value;
            const search = document.getElementById('searchQuery').value.toLowerCase();

            filteredLogs = logs.filter(log => {
                if (level !== 'all' && log.level !== level) return false;
                if (source !== 'all' && log.source !== source) return false;
                if (search && !log.message.toLowerCase().includes(search)) return false;
                return true;
            });

            renderLogs();
        }

        // Render logs
        function renderLogs() {
            const container = document.getElementById('logsContainer');

            if (filteredLogs.length === 0) {
                showNoLogs('No logs match the current filters');
                return;
            }

            const search = document.getElementById('searchQuery').value;
            let html = '';

            filteredLogs.forEach(log => {
                let message = escapeHtml(log.message);

                // Highlight search term
                if (search) {
                    const regex = new RegExp(`(${escapeRegex(search)})`, 'gi');
                    message = message.replace(regex, '<span class="search-highlight">$1</span>');
                }

                html += `
                    <div class="log-entry">
                        <span class="log-timestamp">${log.timestamp}</span>
                        <span class="log-level log-level-${log.level}">${log.level}</span>
                        <span class="log-message">${message}</span>
                    </div>
                `;
            });

            container.innerHTML = html;

            // Auto-scroll to bottom
            container.scrollTop = container.scrollHeight;
        }

        // Show no logs message
        function showNoLogs(message) {
            const container = document.getElementById('logsContainer');
            container.innerHTML = `
                <div class="no-logs">
                    <p>${message}</p>
                </div>
            `;
        }

        // Update statistics
        function updateStats() {
            document.getElementById('totalEntries').textContent = logs.length;
            document.getElementById('filteredEntries').textContent = filteredLogs.length;

            const errorCount = logs.filter(log => log.level === 'ERROR' || log.level === 'FATAL').length;
            const warnCount = logs.filter(log => log.level === 'WARN').length;

            document.getElementById('errorCount').textContent = errorCount;
            document.getElementById('warnCount').textContent = warnCount;
        }

        // Download logs
        async function downloadLogs() {
            try {
                const response = await fetch(`${ADMIN_API_PATH}/logs/download`);
                if (!response.ok) throw new Error('Failed to download logs');

                const blob = await response.blob();
                const url = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `logs_${new Date().toISOString().split('T')[0]}.log`;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                window.URL.revokeObjectURL(url);
            } catch (error) {
                Toast.show('Error downloading logs: ' + error.message, 'error');
            }
        }

        // Clear logs
        async function clearLogs() {
            if (!await showConfirm('Are you sure you want to clear all logs? This action cannot be undone.', 'Clear Logs')) {
                return;
            }

            try {
                const response = await fetch(`${ADMIN_API_PATH}/logs`, { method: 'DELETE' });
                if (!response.ok) throw new Error('Failed to clear logs');

                logs = [];
                filteredLogs = [];
                renderLogs();
                updateStats();
                Toast.show('Logs cleared successfully', 'success');
            } catch (error) {
                Toast.show('Error clearing logs: ' + error.message, 'error');
            }
        }

        // Clear filters
        function clearFilters() {
            document.getElementById('logLevel').value = 'all';
            document.getElementById('logSource').value = 'all';
            document.getElementById('searchQuery').value = '';
            applyFilters();
        }

        // Toggle auto-refresh
        function toggleAutoRefresh() {
            const enabled = document.getElementById('autoRefresh').checked;

            if (enabled) {
                autoRefreshInterval = setInterval(fetchLogs, 5000);
            } else {
                if (autoRefreshInterval) {
                    clearInterval(autoRefreshInterval);
                    autoRefreshInterval = null;
                }
            }
        }

        // Escape HTML
        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        // Escape regex
        function escapeRegex(text) {
            return text.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        }

        // Event listeners
        document.getElementById('logLevel').addEventListener('change', applyFilters);
        document.getElementById('logSource').addEventListener('change', applyFilters);
        document.getElementById('searchQuery').addEventListener('input', applyFilters);
        document.getElementById('tailLines').addEventListener('change', fetchLogs);
        document.getElementById('refreshBtn').addEventListener('click', fetchLogs);
        document.getElementById('downloadBtn').addEventListener('click', downloadLogs);
        document.getElementById('clearLogsBtn').addEventListener('click', clearLogs);
        document.getElementById('clearFilterBtn').addEventListener('click', clearFilters);
        document.getElementById('autoRefresh').addEventListener('change', toggleAutoRefresh);

        // Initial load
        fetchLogs();

        // Cleanup on page unload
        window.addEventListener('beforeunload', () => {
            if (autoRefreshInterval) {
                clearInterval(autoRefreshInterval);
            }
        });
    </script>
{{template "admin_footer" .}}
{{end}}
