{{template "head" .}}

{{template "admin_header" .}}
{{- $lang := "en" -}}
{{- if .lang}}{{$lang = .lang}}{{end -}}

    <!-- Main Content -->
        <div class="admin-header">
            <h1>⚙️ {{t $lang "admin.settings.title"}}</h1>
            <p class="subtitle">{{t $lang "admin.settings.subtitle"}}</p>
        </div>

        <!-- Settings Tabs -->
        <div class="tabs" role="tablist" aria-label="{{t $lang "admin.settings.tabs_aria_label"}}">
            <button class="tab active"
                    data-action="switch-settings-tab"
                    data-tab="server"
                    role="tab"
                    aria-selected="true"
                    aria-controls="tab-server"
                    aria-label="{{t $lang "admin.settings.tab_server_aria"}}"
                    title="{{t $lang "admin.settings.tab_server_title"}}">🏠 {{t $lang "admin.settings.tab_server_label"}}</button>
            <button class="tab"
                    data-action="switch-settings-tab"
                    data-tab="security"
                    role="tab"
                    aria-selected="false"
                    aria-controls="tab-security"
                    aria-label="{{t $lang "admin.settings.tab_security_aria"}}"
                    title="{{t $lang "admin.settings.tab_security_title"}}">🔒 {{t $lang "admin.settings.tab_security_label"}}</button>
            <button class="tab"
                    data-action="switch-settings-tab"
                    data-tab="features"
                    role="tab"
                    aria-selected="false"
                    aria-controls="tab-features"
                    aria-label="{{t $lang "admin.settings.tab_features_aria"}}"
                    title="{{t $lang "admin.settings.tab_features_title"}}">✨ {{t $lang "admin.settings.tab_features_label"}}</button>
            <button class="tab"
                    data-action="switch-settings-tab"
                    data-tab="backup"
                    role="tab"
                    aria-selected="false"
                    aria-controls="tab-backup"
                    aria-label="{{t $lang "admin.settings.tab_backup_aria"}}"
                    title="{{t $lang "admin.settings.tab_backup_title"}}">💾 {{t $lang "admin.settings.tab_backup_label"}}</button>
            <button class="tab"
                    data-action="switch-settings-tab"
                    data-tab="logging"
                    role="tab"
                    aria-selected="false"
                    aria-controls="tab-logging"
                    aria-label="{{t $lang "admin.settings.tab_logging_aria"}}"
                    title="{{t $lang "admin.settings.tab_logging_title"}}">📝 {{t $lang "admin.settings.tab_logging_label"}}</button>
            <button class="tab"
                    data-action="switch-settings-tab"
                    data-tab="smtp"
                    role="tab"
                    aria-selected="false"
                    aria-controls="tab-smtp"
                    aria-label="{{t $lang "admin.settings.tab_smtp_aria"}}"
                    title="{{t $lang "admin.settings.tab_smtp_title"}}">📧 {{t $lang "admin.settings.tab_smtp_label"}}</button>
            <button class="tab"
                    data-action="switch-settings-tab"
                    data-tab="ratelimit"
                    role="tab"
                    aria-selected="false"
                    aria-controls="tab-ratelimit"
                    aria-label="{{t $lang "admin.settings.tab_ratelimit_aria"}}"
                    title="{{t $lang "admin.settings.tab_ratelimit_title"}}">🚦 {{t $lang "admin.settings.tab_ratelimit_label"}}</button>
            <button class="tab"
                    data-action="switch-settings-tab"
                    data-tab="ssl"
                    role="tab"
                    aria-selected="false"
                    aria-controls="tab-ssl"
                    aria-label="{{t $lang "admin.settings.tab_ssl_aria"}}"
                    title="{{t $lang "admin.settings.tab_ssl_title"}}">🔐 {{t $lang "admin.settings.tab_ssl_label"}}</button>
            <button class="tab"
                    data-action="switch-settings-tab"
                    data-tab="weather"
                    role="tab"
                    aria-selected="false"
                    aria-controls="tab-weather"
                    aria-label="{{t $lang "admin.settings.tab_weather_aria"}}"
                    title="{{t $lang "admin.settings.tab_weather_title"}}">🌤️ {{t $lang "admin.settings.tab_weather_label"}}</button>
            <button class="tab"
                    data-action="switch-settings-tab"
                    data-tab="notifications"
                    role="tab"
                    aria-selected="false"
                    aria-controls="tab-notifications"
                    aria-label="{{t $lang "admin.settings.tab_notifications_aria"}}"
                    title="{{t $lang "admin.settings.tab_notifications_title"}}">🔔 {{t $lang "admin.settings.tab_notifications_label"}}</button>
            <button class="tab"
                    data-action="switch-settings-tab"
                    data-tab="advanced"
                    role="tab"
                    aria-selected="false"
                    aria-controls="tab-advanced"
                    aria-label="{{t $lang "admin.settings.tab_advanced_aria"}}"
                    title="{{t $lang "admin.settings.tab_advanced_title"}}">⚙️ {{t $lang "admin.settings.tab_advanced_label"}}</button>
            <button class="tab"
                    data-action="switch-settings-tab"
                    data-tab="tor"
                    role="tab"
                    aria-selected="false"
                    aria-controls="tab-tor"
                    aria-label="{{t $lang "admin.settings.tab_tor_aria"}}"
                    title="{{t $lang "admin.settings.tab_tor_title"}}">🧅 {{t $lang "admin.settings.tab_tor_label"}}</button>
            <button class="tab"
                    data-action="switch-settings-tab"
                    data-tab="history"
                    role="tab"
                    aria-selected="false"
                    aria-controls="tab-history"
                    aria-label="{{t $lang "admin.settings.tab_history_aria"}}"
                    title="{{t $lang "admin.settings.tab_history_title"}}">📊 {{t $lang "admin.settings.tab_history_label"}}</button>
        </div>

        <!-- Server Tab -->
        <div id="tab-server" class="tab-content active" role="tabpanel" aria-labelledby="tab-server">
            <div class="card">
                <h2>{{t $lang "admin.settings.general_heading"}}</h2>
                <form id="form-server-general"
                      data-settings-category="server-general"
                      role="form"
                      aria-label="{{t $lang "admin.settings.general_form_aria"}}">
                    <div class="form-group">
                        <label for="server_port">{{t $lang "admin.settings.server_port_label"}}</label>
                        <input type="number"
                               id="server_port"
                               name="server.port"
                               value="{{.settings.server_port}}"
                               min="1"
                               max="65535"
                               aria-label="{{t $lang "admin.settings.server_port_aria"}}"
                               aria-required="true"
                               aria-describedby="server_port_help"
                               title="{{t $lang "admin.settings.server_port_title"}}">
                        <small id="server_port_help">{{t $lang "admin.settings.server_port_help"}}</small>
                    </div>

                    <div class="form-group">
                        <label for="server_mode">{{t $lang "admin.settings.server_mode_label"}}</label>
                        <select id="server_mode"
                                name="server.mode"
                                aria-label="{{t $lang "admin.settings.server_mode_aria"}}"
                                aria-describedby="server_mode_help"
                                title="{{t $lang "admin.settings.server_mode_title"}}">
                            <option value="production" {{if eq .settings.server_mode "production"}}selected{{end}}>{{t $lang "admin.settings.mode_production"}}</option>
                            <option value="development" {{if eq .settings.server_mode "development"}}selected{{end}}>{{t $lang "admin.settings.mode_development"}}</option>
                        </select>
                        <small id="server_mode_help">{{t $lang "admin.settings.server_mode_help"}}</small>
                    </div>

                    <div class="form-group">
                        <label for="server_fqdn">{{t $lang "admin.settings.server_fqdn_label"}}</label>
                        <input type="text"
                               id="server_fqdn"
                               name="server.fqdn"
                               value="{{.settings.server_fqdn}}"
                               placeholder="api.example.com"
                               aria-label="{{t $lang "admin.settings.server_fqdn_aria"}}"
                               aria-describedby="server_fqdn_help"
                               title="{{t $lang "admin.settings.server_fqdn_title"}}">
                        <small id="server_fqdn_help">{{t $lang "admin.settings.server_fqdn_help"}}</small>
                    </div>

                    <div class="form-group">
                        <label for="server_address">{{t $lang "admin.settings.server_address_label"}}</label>
                        <input type="text"
                               id="server_address"
                               name="server.address"
                               value="{{.settings.server_address}}"
                               placeholder="[::]"
                               aria-label="{{t $lang "admin.settings.server_address_aria"}}"
                               aria-describedby="server_address_help"
                               title="{{t $lang "admin.settings.server_address_title"}}">
                        <small id="server_address_help">{{t $lang "admin.settings.server_address_help"}}</small>
                    </div>

                    <button type="submit"
                            class="btn btn-primary"
                            aria-label="{{t $lang "admin.settings.save_general_aria"}}"
                            title="{{t $lang "admin.settings.save_general_title"}}">{{t $lang "admin.settings.save_general_action"}}</button>
                </form>
            </div>

            <div class="card">
                <h2>{{t $lang "admin.settings.process_heading"}}</h2>
                <form id="form-server-process"
                      data-settings-category="server-process"
                      role="form"
                      aria-label="{{t $lang "admin.settings.process_form_aria"}}">
                    <div class="form-group">
                        <label class="toggle-label">
                            <input type="checkbox"
                                   name="server.daemonize"
                                   {{if .settings.server_daemonize}}checked{{end}}
                                   aria-label="{{t $lang "admin.settings.daemonize_aria"}}"
                                   aria-describedby="server_daemonize_help"
                                   title="{{t $lang "admin.settings.daemonize_title"}}"
                                   role="switch"
                                   aria-checked="{{if .settings.server_daemonize}}true{{else}}false{{end}}">
                            <span class="toggle-slider"></span>
                            <span class="toggle-text">{{t $lang "admin.settings.daemonize_toggle"}}</span>
                        </label>
                        <small id="server_daemonize_help">{{t $lang "admin.settings.daemonize_help"}}</small>
                    </div>

                    <div class="form-group">
                        <label class="toggle-label">
                            <input type="checkbox"
                                   name="server.pidfile"
                                   {{if .settings.server_pidfile}}checked{{end}}
                                   aria-label="{{t $lang "admin.settings.pidfile_aria"}}"
                                   aria-describedby="server_pidfile_help"
                                   title="{{t $lang "admin.settings.pidfile_title"}}"
                                   role="switch"
                                   aria-checked="{{if .settings.server_pidfile}}true{{else}}false{{end}}">
                            <span class="toggle-slider"></span>
                            <span class="toggle-text">{{t $lang "admin.settings.pidfile_toggle"}}</span>
                        </label>
                        <small id="server_pidfile_help">{{t $lang "admin.settings.pidfile_help"}}</small>
                    </div>

                    <button type="submit"
                            class="btn btn-primary"
                            aria-label="{{t $lang "admin.settings.save_process_aria"}}"
                            title="{{t $lang "admin.settings.save_process_title"}}">{{t $lang "admin.settings.save_process_action"}}</button>
                </form>
            </div>

            <div class="card">
                <h2>{{t $lang "admin.settings.branding_heading"}}</h2>
                <form id="form-server-branding"
                      data-settings-category="server-branding"
                      role="form"
                      aria-label="{{t $lang "admin.settings.branding_form_aria"}}">
                    <div class="form-group">
                        <label for="server_title">{{t $lang "admin.settings.server_title_label"}}</label>
                        <input type="text"
                               id="server_title"
                               name="server.title"
                               value="{{.settings.server_title}}"
                               placeholder="Weather"
                               aria-label="{{t $lang "admin.settings.server_title_aria"}}"
                               aria-describedby="server_title_help"
                               title="{{t $lang "admin.settings.server_title_title"}}">
                        <small id="server_title_help">{{t $lang "admin.settings.server_title_help"}}</small>
                    </div>

                    <div class="form-group">
                        <label for="server_tagline">{{t $lang "admin.settings.server_tagline_label"}}</label>
                        <input type="text"
                               id="server_tagline"
                               name="server.tagline"
                               value="{{.settings.server_tagline}}"
                               placeholder="Your personal weather dashboard"
                               aria-label="{{t $lang "admin.settings.server_tagline_aria"}}"
                               aria-describedby="server_tagline_help"
                               title="{{t $lang "admin.settings.server_tagline_title"}}">
                        <small id="server_tagline_help">{{t $lang "admin.settings.server_tagline_help"}}</small>
                    </div>

                    <div class="form-group">
                        <label for="server_description">{{t $lang "admin.settings.server_description_label"}}</label>
                        <textarea id="server_description"
                                  name="server.description"
                                  rows="3"
                                  placeholder="A comprehensive platform for weather forecasts..."
                                  aria-label="{{t $lang "admin.settings.server_description_aria"}}"
                                  aria-describedby="server_description_help"
                                  title="{{t $lang "admin.settings.server_description_title"}}">{{.settings.server_description}}</textarea>
                        <small id="server_description_help">{{t $lang "admin.settings.server_description_help"}}</small>
                    </div>

                    <button type="submit"
                            class="btn btn-primary"
                            aria-label="{{t $lang "admin.settings.save_branding_aria"}}"
                            title="{{t $lang "admin.settings.save_branding_title"}}">{{t $lang "admin.settings.save_branding_action"}}</button>
                </form>
            </div>

            <div class="card">
                <h2>{{t $lang "admin.settings.config_heading"}}</h2>
                <form id="form-server-config"
                      data-settings-category="server-config"
                      role="form"
                      aria-label="{{t $lang "admin.settings.config_form_aria"}}">
                    <div class="form-group">
                        <label for="server_http_port">{{t $lang "admin.settings.http_port_label"}}</label>
                        <input type="number"
                               id="server_http_port"
                               name="server.http_port"
                               value="{{.settings.server_http_port}}"
                               min="1"
                               max="65535"
                               aria-label="{{t $lang "admin.settings.http_port_aria"}}"
                               aria-required="true"
                               aria-describedby="server_http_port_help"
                               title="{{t $lang "admin.settings.http_port_title"}}">
                        <small id="server_http_port_help">{{t $lang "admin.settings.http_port_help"}}</small>
                    </div>

                    <div class="form-group">
                        <label for="server_https_port">{{t $lang "admin.settings.https_port_label"}}</label>
                        <input type="number"
                               id="server_https_port"
                               name="server.https_port"
                               value="{{.settings.server_https_port}}"
                               min="0"
                               max="65535"
                               aria-label="{{t $lang "admin.settings.https_port_aria"}}"
                               aria-describedby="server_https_port_help"
                               title="{{t $lang "admin.settings.https_port_title"}}">
                        <small id="server_https_port_help">{{t $lang "admin.settings.https_port_help"}}</small>
                    </div>

                    <div class="form-group">
                        <label for="server_timezone">{{t $lang "admin.settings.timezone_label"}}</label>
                        <select id="server_timezone"
                                name="server.timezone"
                                aria-label="{{t $lang "admin.settings.timezone_aria"}}"
                                aria-describedby="server_timezone_help"
                                title="{{t $lang "admin.settings.timezone_title"}}">
                            <option value="America/New_York" {{if eq .settings.server_timezone "America/New_York"}}selected{{end}}>America/New_York (EST/EDT)</option>
                            <option value="America/Chicago" {{if eq .settings.server_timezone "America/Chicago"}}selected{{end}}>America/Chicago (CST/CDT)</option>
                            <option value="America/Denver" {{if eq .settings.server_timezone "America/Denver"}}selected{{end}}>America/Denver (MST/MDT)</option>
                            <option value="America/Los_Angeles" {{if eq .settings.server_timezone "America/Los_Angeles"}}selected{{end}}>America/Los_Angeles (PST/PDT)</option>
                            <option value="Europe/London" {{if eq .settings.server_timezone "Europe/London"}}selected{{end}}>Europe/London (GMT/BST)</option>
                            <option value="Europe/Paris" {{if eq .settings.server_timezone "Europe/Paris"}}selected{{end}}>Europe/Paris (CET/CEST)</option>
                            <option value="Asia/Tokyo" {{if eq .settings.server_timezone "Asia/Tokyo"}}selected{{end}}>Asia/Tokyo (JST)</option>
                            <option value="UTC" {{if eq .settings.server_timezone "UTC"}}selected{{end}}>UTC</option>
                        </select>
                        <small id="server_timezone_help">{{t $lang "admin.settings.timezone_help"}}</small>
                    </div>

                    <div class="form-group">
                        <label for="server_date_format">{{t $lang "admin.settings.date_format_label"}}</label>
                        <select id="server_date_format"
                                name="server.date_format"
                                aria-label="{{t $lang "admin.settings.date_format_aria"}}"
                                aria-describedby="server_date_format_help"
                                title="{{t $lang "admin.settings.date_format_title"}}">
                            <option value="US" {{if eq .settings.server_date_format "US"}}selected{{end}}>US (Jan 1, 2024)</option>
                            <option value="EU" {{if eq .settings.server_date_format "EU"}}selected{{end}}>EU (1 Jan 2024)</option>
                            <option value="ISO" {{if eq .settings.server_date_format "ISO"}}selected{{end}}>ISO (2024-01-01)</option>
                        </select>
                        <small id="server_date_format_help">{{t $lang "admin.settings.date_format_help"}}</small>
                    </div>

                    <div class="form-group">
                        <label for="server_time_format">{{t $lang "admin.settings.time_format_label"}}</label>
                        <select id="server_time_format"
                                name="server.time_format"
                                aria-label="{{t $lang "admin.settings.time_format_aria"}}"
                                aria-describedby="server_time_format_help"
                                title="{{t $lang "admin.settings.time_format_title"}}">
                            <option value="12-hour" {{if eq .settings.server_time_format "12-hour"}}selected{{end}}>12-hour (3:30 PM)</option>
                            <option value="24-hour" {{if eq .settings.server_time_format "24-hour"}}selected{{end}}>24-hour (15:30)</option>
                        </select>
                        <small id="server_time_format_help">{{t $lang "admin.settings.time_format_help"}}</small>
                    </div>

                    <button type="submit"
                            class="btn btn-primary"
                            aria-label="{{t $lang "admin.settings.save_config_aria"}}"
                            title="{{t $lang "admin.settings.save_config_title"}}">{{t $lang "admin.settings.save_config_action"}}</button>
                </form>
            </div>
        </div>

        <!-- Security Tab -->
        <div id="tab-security" class="tab-content" role="tabpanel" aria-labelledby="tab-security">
            <div class="card">
                <h2>{{t $lang "admin.settings.auth_sessions_heading"}}</h2>
                <form id="form-security"
                      data-settings-category="security"
                      role="form"
                      aria-label="{{t $lang "admin.settings.security_form_aria"}}">
                    <div class="form-group">
                        <label for="security_session_timeout">{{t $lang "admin.settings.session_timeout_label"}}</label>
                        <input type="number"
                               id="security_session_timeout"
                               name="security.session_timeout"
                               value="{{.settings.security_session_timeout}}"
                               min="60"
                               aria-label="{{t $lang "admin.settings.session_timeout_aria"}}"
                               aria-required="true"
                               aria-describedby="security_session_timeout_help"
                               title="{{t $lang "admin.settings.session_timeout_title"}}">
                        <small id="security_session_timeout_help">{{t $lang "admin.settings.session_timeout_help"}}</small>
                    </div>

                    <div class="form-group">
                        <label for="security_max_login_attempts">{{t $lang "admin.settings.max_login_attempts_label"}}</label>
                        <input type="number"
                               id="security_max_login_attempts"
                               name="security.max_login_attempts"
                               value="{{.settings.security_max_login_attempts}}"
                               min="1"
                               aria-label="{{t $lang "admin.settings.max_login_attempts_aria"}}"
                               aria-required="true"
                               aria-describedby="security_max_login_attempts_help"
                               title="{{t $lang "admin.settings.max_login_attempts_title"}}">
                        <small id="security_max_login_attempts_help">{{t $lang "admin.settings.max_login_attempts_help"}}</small>
                    </div>

                    <div class="form-group">
                        <label for="security_lockout_duration">{{t $lang "admin.settings.lockout_duration_label"}}</label>
                        <input type="number"
                               id="security_lockout_duration"
                               name="security.lockout_duration"
                               value="{{.settings.security_lockout_duration}}"
                               min="1"
                               aria-label="{{t $lang "admin.settings.lockout_duration_aria"}}"
                               aria-required="true"
                               aria-describedby="security_lockout_duration_help"
                               title="{{t $lang "admin.settings.lockout_duration_title"}}">
                        <small id="security_lockout_duration_help">{{t $lang "admin.settings.lockout_duration_help"}}</small>
                    </div>

                    <div class="form-group">
                        <label for="security_password_min_length">{{t $lang "admin.settings.password_min_length_label"}}</label>
                        <input type="number"
                               id="security_password_min_length"
                               name="security.password_min_length"
                               value="{{.settings.security_password_min_length}}"
                               min="6"
                               aria-label="{{t $lang "admin.settings.password_min_length_aria"}}"
                               aria-required="true"
                               aria-describedby="security_password_min_length_help"
                               title="{{t $lang "admin.settings.password_min_length_title"}}">
                        <small id="security_password_min_length_help">{{t $lang "admin.settings.password_min_length_help"}}</small>
                    </div>

                    <button type="submit"
                            class="btn btn-primary"
                            aria-label="{{t $lang "admin.settings.save_security_aria"}}"
                            title="{{t $lang "admin.settings.save_security_title"}}">{{t $lang "admin.settings.save_security_action"}}</button>
                </form>
            </div>
        </div>

        <!-- Features Tab -->
        <div id="tab-features" class="tab-content" role="tabpanel" aria-labelledby="tab-features">
            <div class="card">
                <h2>{{t $lang "admin.settings.feature_toggles_heading"}}</h2>
                <form id="form-features"
                      data-settings-category="features"
                      role="form"
                      aria-label="{{t $lang "admin.settings.features_form_aria"}}">
                    <div class="form-group">
                        <label class="toggle-label">
                            <input type="checkbox"
                                   name="features.registration_enabled"
                                   {{if .settings.features_registration_enabled}}checked{{end}}
                                   aria-label="{{t $lang "admin.settings.registration_enabled_aria"}}"
                                   aria-describedby="features_registration_help"
                                   title="{{t $lang "admin.settings.registration_enabled_title"}}"
                                   role="switch"
                                   aria-checked="{{if .settings.features_registration_enabled}}true{{else}}false{{end}}">
                            <span class="toggle-slider"></span>
                            <span class="toggle-text">{{t $lang "admin.settings.registration_enabled_toggle"}}</span>
                        </label>
                        <small id="features_registration_help">{{t $lang "admin.settings.registration_enabled_help"}}</small>
                    </div>

                    <div class="form-group">
                        <label class="toggle-label">
                            <input type="checkbox"
                                   name="features.api_enabled"
                                   {{if .settings.features_api_enabled}}checked{{end}}
                                   aria-label="{{t $lang "admin.settings.api_enabled_aria"}}"
                                   aria-describedby="features_api_help"
                                   title="{{t $lang "admin.settings.api_enabled_title"}}"
                                   role="switch"
                                   aria-checked="{{if .settings.features_api_enabled}}true{{else}}false{{end}}">
                            <span class="toggle-slider"></span>
                            <span class="toggle-text">{{t $lang "admin.settings.api_enabled_toggle"}}</span>
                        </label>
                        <small id="features_api_help">{{t $lang "admin.settings.api_enabled_help"}}</small>
                    </div>

                    <div class="form-group">
                        <label class="toggle-label">
                            <input type="checkbox"
                                   name="features.weather_alerts"
                                   {{if .settings.features_weather_alerts}}checked{{end}}
                                   aria-label="{{t $lang "admin.settings.weather_alerts_enabled_aria"}}"
                                   aria-describedby="features_weather_alerts_help"
                                   title="{{t $lang "admin.settings.weather_alerts_enabled_title"}}"
                                   role="switch"
                                   aria-checked="{{if .settings.features_weather_alerts}}true{{else}}false{{end}}">
                            <span class="toggle-slider"></span>
                            <span class="toggle-text">{{t $lang "admin.settings.weather_alerts_enabled_toggle"}}</span>
                        </label>
                        <small id="features_weather_alerts_help">{{t $lang "admin.settings.weather_alerts_enabled_help"}}</small>
                    </div>

                    <button type="submit"
                            class="btn btn-primary"
                            aria-label="{{t $lang "admin.settings.save_features_aria"}}"
                            title="{{t $lang "admin.settings.save_features_title"}}">{{t $lang "admin.settings.save_features_action"}}</button>
                </form>
            </div>
        </div>

        <!-- Backup Tab -->
