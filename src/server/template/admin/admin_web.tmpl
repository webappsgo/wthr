{{define "admin/admin_web.tmpl"}}
{{template "head" .}}
{{template "admin_header" .}}
{{- $lang := "en" -}}
{{- if .lang}}{{$lang = .lang}}{{end -}}

            <div class="content-header">
                <h1>🌐 {{t $lang "admin.web.title"}}</h1>
                <p class="subtitle">{{t $lang "admin.web.subtitle"}}</p>
            </div>

            <div class="alert alert-info" role="status">
                <strong>{{t $lang "admin.web.note_label"}}</strong> {{t $lang "admin.web.note_text"}}
            </div>

            <!-- Branding Section -->
            <section class="admin-card" aria-labelledby="branding-heading">
                <div class="card-header">
                    <h2 id="branding-heading">{{t $lang "admin.web.branding_heading"}}</h2>
                    <p class="card-description">{{t $lang "admin.web.branding_desc"}}</p>
                </div>
                <div class="card-body">
                    <form id="branding-form" class="settings-form">
    <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
                        <div class="form-group">
                            <label for="app_name">
                                {{t $lang "admin.web.app_name_label"}}
                                <span class="required" aria-label="{{t $lang "admin.web.required_field_aria"}}">*</span>
                            </label>
                            <input
                                type="text"
                                id="app_name"
                                name="app.name"
                                class="form-control"
                                placeholder="{{t $lang "admin.web.app_name_placeholder"}}"
                                required
                                aria-required="true"
                                aria-describedby="app_name_help"
                            >
                            <small id="app_name_help" class="form-text">
                                {{t $lang "admin.web.app_name_help"}}
                            </small>
                        </div>

                        <div class="form-group">
                            <label for="app_tagline">{{t $lang "admin.web.app_tagline_label"}}</label>
                            <input
                                type="text"
                                id="app_tagline"
                                name="app.tagline"
                                class="form-control"
                                placeholder="{{t $lang "admin.web.app_tagline_placeholder"}}"
                                aria-describedby="app_tagline_help"
                            >
                            <small id="app_tagline_help" class="form-text">
                                {{t $lang "admin.web.app_tagline_help"}}
                            </small>
                        </div>

                        <div class="form-group">
                            <label for="app_description">{{t $lang "admin.web.app_description_label"}}</label>
                            <textarea
                                id="app_description"
                                name="app.description"
                                class="form-control"
                                rows="3"
                                placeholder="{{t $lang "admin.web.app_description_placeholder"}}"
                                aria-describedby="app_description_help"
                            ></textarea>
                            <small id="app_description_help" class="form-text">
                                {{t $lang "admin.web.app_description_help"}}
                            </small>
                        </div>

                        <button type="submit" class="btn btn-primary" aria-label="{{t $lang "admin.web.save_branding_aria"}}">
                            💾 {{t $lang "admin.web.save_branding_action"}}
                        </button>
                    </form>
                </div>
            </section>

            <!-- SEO Settings Section -->
            <section class="admin-card" aria-labelledby="seo-heading">
                <div class="card-header">
                    <h2 id="seo-heading">{{t $lang "admin.web.seo_heading"}}</h2>
                    <p class="card-description">{{t $lang "admin.web.seo_desc"}}</p>
                </div>
                <div class="card-body">
                    <form id="seo-form" class="settings-form">
    <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
                        <div class="form-group">
                            <label for="seo_keywords">{{t $lang "admin.web.seo_keywords_label"}}</label>
                            <input
                                type="text"
                                id="seo_keywords"
                                name="seo.keywords"
                                class="form-control"
                                placeholder="{{t $lang "admin.web.seo_keywords_placeholder"}}"
                                aria-describedby="seo_keywords_help"
                            >
                            <small id="seo_keywords_help" class="form-text">
                                {{t $lang "admin.web.seo_keywords_help"}}
                            </small>
                        </div>

                        <div class="form-group">
                            <label for="seo_author">{{t $lang "admin.web.seo_author_label"}}</label>
                            <input
                                type="text"
                                id="seo_author"
                                name="seo.author"
                                class="form-control"
                                placeholder="{{t $lang "admin.web.seo_author_placeholder"}}"
                                aria-describedby="seo_author_help"
                            >
                            <small id="seo_author_help" class="form-text">
                                {{t $lang "admin.web.seo_author_help"}}
                            </small>
                        </div>

                        <div class="form-group">
                            <label for="seo_og_image">{{t $lang "admin.web.seo_og_image_label"}}</label>
                            <input
                                type="url"
                                id="seo_og_image"
                                name="seo.og_image"
                                class="form-control"
                                placeholder="https://example.com/preview.png"
                                aria-describedby="seo_og_image_help"
                            >
                            <small id="seo_og_image_help" class="form-text">
                                {{t $lang "admin.web.seo_og_image_help"}}
                            </small>
                        </div>

                        <button type="submit" class="btn btn-primary" aria-label="{{t $lang "admin.web.save_seo_aria"}}">
                            💾 {{t $lang "admin.web.save_seo_action"}}
                        </button>
                    </form>
                </div>
            </section>

            <!-- robots.txt Section -->
            <section class="admin-card" aria-labelledby="robots-heading">
                <div class="card-header">
                    <h2 id="robots-heading">{{t $lang "admin.web.robots_heading"}}</h2>
                    <p class="card-description">{{t $lang "admin.web.robots_desc"}}</p>
                </div>
                <div class="card-body">
                    <div class="alert alert-info" role="status">
                        <strong>{{t $lang "admin.web.current_url_label"}}</strong> <a href="/robots.txt" target="_blank" rel="noopener">/robots.txt</a><br>
                        {{t $lang "admin.web.robots_placeholder_note_prefix"}} <code>{app_url}</code> {{t $lang "admin.web.robots_placeholder_note_suffix"}}
                    </div>

                    <form id="robots-form" class="settings-form">
    <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
                        <div class="form-group">
                            <label for="robots_txt">{{t $lang "admin.web.robots_content_label"}}</label>
                            <textarea
                                id="robots_txt"
                                name="web.robots_txt"
                                class="form-control code-editor"
                                rows="12"
                                aria-describedby="robots_txt_help"
                                spellcheck="false"
                            >User-agent: *
Allow: /
Disallow: /admin/
Disallow: /api/
Sitemap: {app_url}/sitemap.xml</textarea>
                            <small id="robots_txt_help" class="form-text">
                                <strong>{{t $lang "admin.web.common_directives_label"}}</strong><br>
                                • <code>User-agent: *</code> - {{t $lang "admin.web.directive_all_crawlers"}}<br>
                                • <code>Allow: /</code> - {{t $lang "admin.web.directive_allow_all"}}<br>
                                • <code>Disallow: /admin/</code> - {{t $lang "admin.web.directive_block_admin"}}<br>
                                • <code>Sitemap:</code> - {{t $lang "admin.web.directive_sitemap_link"}}
                            </small>
                        </div>

                        <div class="button-group">
                            <button type="submit" class="btn btn-primary" aria-label="{{t $lang "admin.web.save_robots_aria"}}">
                                💾 {{t $lang "admin.web.save_robots_action"}}
                            </button>
                            <button type="button" class="btn btn-secondary" data-action="admin-web-preview-robots" aria-label="{{t $lang "admin.web.preview_robots_aria"}}">
                                👁️ {{t $lang "admin.web.preview_action"}}
                            </button>
                            <button type="button" class="btn btn-secondary" data-action="admin-web-reset-robots" aria-label="{{t $lang "admin.web.reset_defaults_aria"}}">
                                🔄 {{t $lang "admin.web.reset_default_action"}}
                            </button>
                        </div>
                    </form>
                </div>
            </section>

            <!-- security.txt Section -->
            <section class="admin-card" aria-labelledby="security-txt-heading">
                <div class="card-header">
                    <h2 id="security-txt-heading">{{t $lang "admin.web.security_heading"}}</h2>
                    <p class="card-description">{{t $lang "admin.web.security_desc"}}</p>
                </div>
                <div class="card-body">
                    <div class="alert alert-info" role="status">
                        <strong>{{t $lang "admin.web.current_url_label"}}</strong> <a href="/.well-known/security.txt" target="_blank" rel="noopener">/.well-known/security.txt</a><br>
                        {{t $lang "admin.web.security_url_note"}}
                    </div>

                    <form id="security-txt-form" class="settings-form">
    <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
                        <div class="form-group">
                            <label for="security_contact">
                                {{t $lang "admin.web.contact_label"}} <span class="required" aria-label="{{t $lang "admin.web.required_field_aria"}}">*</span>
                            </label>
                            <input
                                type="text"
                                id="security_contact"
                                name="security.contact"
                                class="form-control"
                                placeholder="security@wthr.top, https://wthr.top/security"
                                required
                                aria-required="true"
                                aria-describedby="security_contact_help"
                            >
                            <small id="security_contact_help" class="form-text">
                                {{t $lang "admin.web.contact_help"}}
                            </small>
                        </div>

                        <div class="form-group">
                            <label for="security_languages">{{t $lang "admin.web.languages_label"}}</label>
                            <input
                                type="text"
                                id="security_languages"
                                name="security.languages"
                                class="form-control"
                                placeholder="en, es, fr"
                                aria-describedby="security_languages_help"
                            >
                            <small id="security_languages_help" class="form-text">
                                {{t $lang "admin.web.languages_help"}}
                            </small>
                        </div>

                        <div class="form-group">
                            <label for="security_encryption">{{t $lang "admin.web.encryption_label"}}</label>
                            <input
                                type="url"
                                id="security_encryption"
                                name="security.encryption"
                                class="form-control"
                                placeholder="https://example.com/pgp-key.txt"
                                aria-describedby="security_encryption_help"
                            >
                            <small id="security_encryption_help" class="form-text">
                                {{t $lang "admin.web.encryption_help"}}
                            </small>
                        </div>

                        <div class="form-group">
                            <label for="security_policy">{{t $lang "admin.web.policy_label"}}</label>
                            <input
                                type="url"
                                id="security_policy"
                                name="security.policy"
                                class="form-control"
                                placeholder="https://example.com/security-policy"
                                aria-describedby="security_policy_help"
                            >
                            <small id="security_policy_help" class="form-text">
                                {{t $lang "admin.web.policy_help"}}
                            </small>
                        </div>

                        <div class="form-group">
                            <label for="security_acknowledgments">{{t $lang "admin.web.acknowledgments_label"}}</label>
                            <input
                                type="url"
                                id="security_acknowledgments"
                                name="security.acknowledgments"
                                class="form-control"
                                placeholder="https://example.com/hall-of-fame"
                                aria-describedby="security_acknowledgments_help"
                            >
                            <small id="security_acknowledgments_help" class="form-text">
                                {{t $lang "admin.web.acknowledgments_help"}}
                            </small>
                        </div>

                        <div class="alert alert-warning" role="status">
                            <strong>{{t $lang "admin.web.auto_renewal_label"}}</strong> {{t $lang "admin.web.auto_renewal_text"}}
                        </div>

                        <div class="button-group">
                            <button type="submit" class="btn btn-primary" aria-label="{{t $lang "admin.web.save_security_aria"}}">
                                💾 {{t $lang "admin.web.save_security_action"}}
                            </button>
                            <button type="button" class="btn btn-secondary" data-action="admin-web-preview-security" aria-label="{{t $lang "admin.web.preview_security_aria"}}">
                                👁️ {{t $lang "admin.web.preview_action"}}
                            </button>
                        </div>
                    </form>
                </div>
            </section>

    <script type="application/json" id="admin-web-data">
    {"apiPath": "{{.api_path}}", "adminApiPath": "{{.admin_api_path}}"}
    </script>

{{template "admin_footer" .}}
{{end}}
