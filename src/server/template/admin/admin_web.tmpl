{{define "admin/admin_web.tmpl"}}
{{template "head" .}}
{{template "admin_header" .}}
{{- $lang := "en" -}}
{{- if .lang}}{{$lang = .lang}}{{end -}}

            <div class="content-header">
                <header class="page-header"><h1 class="page-title">🌐 {{t $lang "admin.web.title"}}</h1></header>
                <p class="subtitle">{{t $lang "admin.web.subtitle"}}</p>
            </div>

            {{template "flash" .}}

            <div class="alert alert-info" role="status">
                <strong>{{t $lang "admin.web.note_label"}}</strong> {{t $lang "admin.web.note_text"}}
            </div>

            <section class="admin-section-card" aria-labelledby="mcp-heading">
                <div class="card-header">
                    <h2 id="mcp-heading">{{t $lang "admin.web.mcp_heading"}}</h2>
                    <p class="card-description">{{t $lang "admin.web.mcp_desc"}}</p>
                </div>
                <div class="card-body">
                    <p>{{t $lang "admin.web.mcp_auth_note"}}</p>
                    <p>{{t $lang "admin.web.mcp_url_label"}} <a href="{{.MCPEndpointURL}}">{{.MCPEndpointURL}}</a></p>
                </div>
            </section>

            <!-- Branding Section -->
            <section class="admin-section-card" aria-labelledby="branding-heading">
                <div class="card-header">
                    <h2 id="branding-heading">{{t $lang "admin.web.branding_heading"}}</h2>
                    <p class="card-description">{{t $lang "admin.web.branding_desc"}}</p>
                </div>
                <div class="card-body">
                    <p>{{t $lang "admin.branding.intro"}}</p>
                    <a class="btn btn-primary" href="{{.admin_path}}/branding">{{t $lang "admin.web.save_branding_action"}}</a>
                </div>
            </section>

            <!-- SEO Settings Section -->
            <section class="admin-section-card" aria-labelledby="seo-heading">
                <div class="card-header">
                    <h2 id="seo-heading">{{t $lang "admin.web.seo_heading"}}</h2>
                    <p class="card-description">{{t $lang "admin.web.seo_desc"}}</p>
                </div>
                <div class="card-body">
                    <p>{{t $lang "admin.branding.intro"}}</p>
                    <a class="btn btn-primary" href="{{.admin_path}}/branding">{{t $lang "admin.web.save_seo_action"}}</a>
                </div>
            </section>

            <!-- robots.txt Section -->
            <section class="admin-section-card" aria-labelledby="robots-heading">
                <div class="card-header">
                    <h2 id="robots-heading">{{t $lang "admin.web.robots_heading"}}</h2>
                    <p class="card-description">{{t $lang "admin.web.robots_desc"}}</p>
                </div>
                <div class="card-body">
                    <div class="alert alert-info" role="status">
                        <strong>{{t $lang "admin.web.current_url_label"}}</strong> <a href="/robots.txt" target="_blank" rel="noopener">/robots.txt</a>
                    </div>

                    <form id="robots-form" class="settings-form" method="post" action="{{if .admin_path}}{{.admin_path}}{{else}}/server/administration{{end}}/web/robots">
                        <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
                        <div class="form-group">
                            <label for="robots_allow">{{t $lang "admin.web.robots_allow_label"}}</label>
                            <textarea id="robots_allow" name="allow" class="form-control code-editor" rows="4" aria-describedby="robots_allow_help" spellcheck="false">{{.RobotsAllow}}</textarea>
                            <small id="robots_allow_help" class="form-text">{{t $lang "admin.web.robots_allow_help"}}</small>
                        </div>
                        <div class="form-group">
                            <label for="robots_deny">{{t $lang "admin.web.robots_deny_label"}}</label>
                            <textarea id="robots_deny" name="deny" class="form-control code-editor" rows="4" aria-describedby="robots_deny_help" spellcheck="false">{{.RobotsDeny}}</textarea>
                            <small id="robots_deny_help" class="form-text">{{t $lang "admin.web.robots_deny_help"}}</small>
                        </div>
                        <div class="form-group">
                            <label for="robots_preview">{{t $lang "admin.web.robots_preview_label"}}</label>
                            <textarea id="robots_preview" class="form-control code-editor" rows="7" readonly spellcheck="false">{{.RobotsPreview}}</textarea>
                        </div>

                        <div class="button-group">
                            <button type="submit" class="btn btn-primary" aria-label="{{t $lang "admin.web.save_robots_aria"}}">
                                💾 {{t $lang "admin.web.save_robots_action"}}
                            </button>
                            <button type="submit" name="reset" value="1" class="btn btn-secondary" aria-label="{{t $lang "admin.web.reset_defaults_aria"}}">
                                🔄 {{t $lang "admin.web.reset_default_action"}}
                            </button>
                        </div>
                    </form>
                </div>
            </section>

            <section class="admin-section-card" aria-labelledby="feeds-heading">
                <div class="card-header">
                    <h2 id="feeds-heading">{{t $lang "admin.web.feeds_heading"}}</h2>
                    <p class="card-description">{{t $lang "admin.web.feeds_desc"}}</p>
                </div>
                <div class="card-body">
                    <form id="feeds-form" class="settings-form" method="post" action="{{if .admin_path}}{{.admin_path}}{{else}}/server/administration{{end}}/web/feeds">
                        <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
                        <div class="form-group">
                            <label for="feed_max_items">{{t $lang "admin.web.feed_max_items_label"}}</label>
                            <input type="number" id="feed_max_items" name="max_items" class="form-control" min="1" max="{{.FeedMaxLimit}}" value="{{.FeedMaxItems}}" required aria-describedby="feed_max_items_help">
                            <small id="feed_max_items_help" class="form-text">{{t $lang "admin.web.feed_max_items_help"}}</small>
                        </div>
                        <div class="form-group">
                            <label for="feed_title">{{t $lang "admin.web.feed_title_label"}}</label>
                            <input type="text" id="feed_title" name="title" class="form-control" maxlength="140" value="{{.FeedTitle}}" aria-describedby="feed_title_help">
                            <small id="feed_title_help" class="form-text">{{t $lang "admin.web.feed_title_help"}}</small>
                        </div>
                        <div class="button-group">
                            <button type="submit" class="btn btn-primary">💾 {{t $lang "admin.web.feeds_save_action"}}</button>
                        </div>
                    </form>
                </div>
            </section>

            <section class="admin-section-card" aria-labelledby="cors-heading">
                <div class="card-header">
                    <h2 id="cors-heading">{{t $lang "admin.web.cors_heading"}}</h2>
                    <p class="card-description">{{t $lang "admin.web.cors_desc"}}</p>
                </div>
                <div class="card-body">
                    <form id="cors-form" class="settings-form" method="post" action="{{if .admin_path}}{{.admin_path}}{{else}}/server/administration{{end}}/web/cors">
                        <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
                        <div class="form-group">
                            <label for="cors_allow_all">
                                <input type="checkbox" id="cors_allow_all" name="allow_all" value="on"{{if .CORS.AllowAll}} checked{{end}} aria-describedby="cors_allow_all_help">
                                {{t $lang "admin.web.cors_allow_all_label"}}
                            </label>
                            <small id="cors_allow_all_help" class="form-text">{{t $lang "admin.web.cors_allow_all_help"}}</small>
                        </div>
                        <div class="form-group">
                            <label for="cors_origins">{{t $lang "admin.web.cors_origins_label"}}</label>
                            <textarea id="cors_origins" name="origins" class="form-control" rows="3" aria-describedby="cors_origins_help">{{.CORS.Origins}}</textarea>
                            <small id="cors_origins_help" class="form-text">{{t $lang "admin.web.cors_origins_help"}}</small>
                        </div>
                        <div class="form-group">
                            <p id="cors_preview_label">{{t $lang "admin.web.cors_preview_label"}}</p>
                            <pre class="code-preview" aria-labelledby="cors_preview_label">{{range $name, $value := .CORS.Preview}}{{$name}}: {{$value}}
{{else}}{{t $lang "admin.web.cors_preview_empty"}}
{{end}}</pre>
                        </div>
                        <div class="button-group">
                            <button type="submit" class="btn btn-primary">💾 {{t $lang "admin.web.cors_save_action"}}</button>
                        </div>
                    </form>
                </div>
            </section>

            <!-- security.txt Section -->
            <section class="admin-section-card" aria-labelledby="security-txt-heading">
                <div class="card-header">
                    <h2 id="security-txt-heading">{{t $lang "admin.web.security_heading"}}</h2>
                    <p class="card-description">{{t $lang "admin.web.security_desc"}}</p>
                </div>
                <div class="card-body">
                    <div class="alert alert-info" role="status">
                        <strong>{{t $lang "admin.web.current_url_label"}}</strong> <a href="/.well-known/security.txt" target="_blank" rel="noopener">/.well-known/security.txt</a><br>
                        {{t $lang "admin.web.security_url_note"}}
                    </div>

                    <form id="security-txt-form" class="settings-form" method="post" action="{{if .admin_path}}{{.admin_path}}{{else}}/server/administration{{end}}/web/security">
                        <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
                        <div class="form-group">
                            <label for="security_contact">
                                {{t $lang "admin.web.contact_label"}} <span class="required" aria-label="{{t $lang "admin.web.required_field_aria"}}">*</span>
                            </label>
                            <input
                                type="text"
                                id="security_contact"
                                name="security.contact"
                                class="form-control"
                                value="{{.SecurityContact}}"
                                placeholder="security@wthr.top, https://wthr.top/security"
                                required
                                aria-required="true"
                                aria-describedby="security_contact_help"
                            >
                            <small id="security_contact_help" class="form-text">
                                {{t $lang "admin.web.contact_help"}}
                            </small>
                        </div>

                        <div class="form-group">
                            <label for="security_languages">{{t $lang "admin.web.languages_label"}}</label>
                            <input
                                type="text"
                                id="security_languages"
                                name="security.languages"
                                class="form-control"
                                value="{{.SecurityLanguages}}"
                                placeholder="en, es, fr"
                                aria-describedby="security_languages_help"
                            >
                            <small id="security_languages_help" class="form-text">
                                {{t $lang "admin.web.languages_help"}}
                            </small>
                        </div>

                        <div class="form-group">
                            <label for="security_report_url">{{t $lang "admin.web.report_url_label"}}</label>
                            <input
                                type="url"
                                id="security_report_url"
                                name="web.security.report_url"
                                class="form-control"
                                value="{{.SecurityPolicy}}"
                                placeholder="https://github.com/{{.server.GitOrg}}/{{.server.GitRepo}}/security/advisories/new"
                                aria-describedby="security_report_url_help"
                            >
                            <small id="security_report_url_help" class="form-text">
                                {{t $lang "admin.web.report_url_help"}}
                            </small>
                        </div>

                        <div class="form-group">
                            <label for="security_keyservers">{{t $lang "admin.web.keyservers_label"}}</label>
                            <input
                                type="text"
                                id="security_keyservers"
                                name="web.security.keyservers"
                                class="form-control"
                                value="{{.SecurityEncryption}}"
                                placeholder="https://keys.openpgp.org"
                                aria-describedby="security_keyservers_help"
                            >
                            <small id="security_keyservers_help" class="form-text">
                                {{t $lang "admin.web.keyservers_help"}}
                            </small>
                        </div>

                        <div class="alert alert-warning" role="status">
                            <strong>{{t $lang "admin.web.auto_renewal_label"}}</strong> {{t $lang "admin.web.auto_renewal_text"}}
                        </div>

                        <div class="button-group">
                            <button type="submit" class="btn btn-primary" aria-label="{{t $lang "admin.web.save_security_aria"}}">
                                💾 {{t $lang "admin.web.save_security_action"}}
                            </button>
                            <a class="btn btn-secondary" href="/.well-known/security.txt" target="_blank" rel="noopener" aria-label="{{t $lang "admin.web.preview_security_aria"}}">
                                👁️ {{t $lang "admin.web.preview_action"}}
                            </a>
                        </div>
                    </form>
                </div>
            </section>

    <textarea hidden id="admin-web-data">
    {"apiPath": "{{.api_path}}", "adminApiPath": "{{.admin_api_path}}"}
    </textarea>

{{template "admin_footer" .}}
{{end}}
