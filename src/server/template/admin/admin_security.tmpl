{{define "admin/admin_security.tmpl"}}
{{template "head" .}}
{{template "admin_header" .}}
{{- $lang := "en" -}}
{{- if .lang}}{{$lang = .lang}}{{end -}}

            <div class="content-header">
                <h1>🔒 {{t $lang "admin.security.title"}}</h1>
                <p class="subtitle">{{t $lang "admin.security.subtitle"}}</p>
            </div>

            <!-- Security Headers Section -->
            <section class="admin-card" aria-labelledby="headers-heading">
                <div class="card-header">
                    <h2 id="headers-heading">{{t $lang "admin.security.headers_heading"}}</h2>
                    <p class="card-description">{{t $lang "admin.security.headers_description"}}</p>
                </div>
                <div class="card-body">
                    <form id="headers-form" class="settings-form">
    <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
                        <div class="alert alert-info" role="status">
                            <strong>{{t $lang "admin.security.headers_alert_strong"}}</strong> {{t $lang "admin.security.headers_alert_text"}}
                        </div>

                        <div class="form-group">
                            <label for="csp">{{t $lang "admin.security.csp_label"}}</label>
                            <textarea
                                id="csp"
                                name="security.csp"
                                class="form-control code-editor"
                                rows="4"
                                aria-describedby="csp_help"
                                spellcheck="false"
                            >default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:;</textarea>
                            <small id="csp_help" class="form-text">
                                {{t $lang "admin.security.csp_help"}}
                            </small>
                        </div>

                        <div class="form-group">
                            <label for="hsts">{{t $lang "admin.security.hsts_label"}}</label>
                            <input
                                type="text"
                                id="hsts"
                                name="security.hsts"
                                class="form-control"
                                placeholder="max-age=31536000; includeSubDomains"
                                aria-describedby="hsts_help"
                            >
                            <small id="hsts_help" class="form-text">
                                {{t $lang "admin.security.hsts_help"}}
                            </small>
                        </div>

                        <div class="form-group">
                            <label for="x_frame_options">{{t $lang "admin.security.x_frame_options_label"}}</label>
                            <select id="x_frame_options" name="security.x_frame_options" class="form-control" aria-describedby="x_frame_help">
                                <option value="DENY">{{t $lang "admin.security.x_frame_deny_option"}}</option>
                                <option value="SAMEORIGIN">{{t $lang "admin.security.x_frame_sameorigin_option"}}</option>
                                <option value="ALLOW-FROM">{{t $lang "admin.security.x_frame_allowfrom_option"}}</option>
                            </select>
                            <small id="x_frame_help" class="form-text">
                                {{t $lang "admin.security.x_frame_help"}}
                            </small>
                        </div>

                        <div class="form-group">
                            <label for="x_content_type">{{t $lang "admin.security.x_content_type_label"}}</label>
                            <select id="x_content_type" name="security.x_content_type" class="form-control" aria-describedby="x_content_type_help">
                                <option value="nosniff">{{t $lang "admin.security.x_content_type_nosniff_option"}}</option>
                                <option value="">{{t $lang "admin.common.disabled"}}</option>
                            </select>
                            <small id="x_content_type_help" class="form-text">
                                {{t $lang "admin.security.x_content_type_help"}}
                            </small>
                        </div>

                        <div class="form-group">
                            <label for="referrer_policy">{{t $lang "admin.security.referrer_policy_label"}}</label>
                            <select id="referrer_policy" name="security.referrer_policy" class="form-control" aria-describedby="referrer_policy_help">
                                <option value="strict-origin-when-cross-origin">{{t $lang "admin.security.referrer_strict_option"}}</option>
                                <option value="no-referrer">{{t $lang "admin.security.referrer_no_referrer_option"}}</option>
                                <option value="no-referrer-when-downgrade">no-referrer-when-downgrade</option>
                                <option value="same-origin">same-origin</option>
                                <option value="origin">origin</option>
                            </select>
                            <small id="referrer_policy_help" class="form-text">
                                {{t $lang "admin.security.referrer_policy_help"}}
                            </small>
                        </div>

                        <div class="form-group">
                            <label for="permissions_policy">{{t $lang "admin.security.permissions_policy_label"}}</label>
                            <textarea
                                id="permissions_policy"
                                name="security.permissions_policy"
                                class="form-control code-editor"
                                rows="3"
                                aria-describedby="permissions_policy_help"
                                spellcheck="false"
                            >geolocation=(), microphone=(), camera=()</textarea>
                            <small id="permissions_policy_help" class="form-text">
                                {{t $lang "admin.security.permissions_policy_help"}}
                            </small>
                        </div>

                        <button type="submit" class="btn btn-primary" aria-label="{{t $lang "admin.security.save_headers_label"}}">
                            💾 {{t $lang "admin.security.save_headers_button"}}
                        </button>
                    </form>
                </div>
            </section>

            <!-- CORS Settings Section -->
            <section class="admin-card" aria-labelledby="cors-heading">
                <div class="card-header">
                    <h2 id="cors-heading">{{t $lang "admin.security.cors_heading"}}</h2>
                    <p class="card-description">{{t $lang "admin.security.cors_description"}}</p>
                </div>
                <div class="card-body">
                    <form id="cors-form" class="settings-form">
    <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
                        <div class="form-group">
                            <label class="toggle-label">
                                <input
                                    type="checkbox"
                                    id="cors_enabled"
                                    name="security.cors_enabled"
                                    class="toggle-input"
                                    aria-describedby="cors_enabled_help"
                                >
                                <span class="toggle-slider"></span>
                                {{t $lang "admin.security.cors_enabled_label"}}
                            </label>
                            <small id="cors_enabled_help" class="form-text">
                                {{t $lang "admin.security.cors_enabled_help"}}
                            </small>
                        </div>

                        <div id="cors-fields" class="cors-fields">
                            <div class="form-group">
                                <label for="cors_origins">{{t $lang "admin.security.cors_origins_label"}}</label>
                                <textarea
                                    id="cors_origins"
                                    name="security.cors_origins"
                                    class="form-control"
                                    rows="3"
                                    placeholder="https://example.com&#10;https://app.example.com&#10;*"
                                    aria-describedby="cors_origins_help"
                                ></textarea>
                                <small id="cors_origins_help" class="form-text">
                                    {{t $lang "admin.security.cors_origins_help_prefix"}} <code>*</code> {{t $lang "admin.security.cors_origins_help_suffix"}}
                                </small>
                            </div>

                            <div class="form-group">
                                <label for="cors_methods">{{t $lang "admin.security.cors_methods_label"}}</label>
                                <input
                                    type="text"
                                    id="cors_methods"
                                    name="security.cors_methods"
                                    class="form-control"
                                    placeholder="GET, POST, PUT, DELETE, OPTIONS"
                                    aria-describedby="cors_methods_help"
                                >
                                <small id="cors_methods_help" class="form-text">
                                    {{t $lang "admin.security.cors_methods_help"}}
                                </small>
                            </div>

                            <div class="form-group">
                                <label for="cors_headers">{{t $lang "admin.security.cors_headers_label"}}</label>
                                <input
                                    type="text"
                                    id="cors_headers"
                                    name="security.cors_headers"
                                    class="form-control"
                                    placeholder="Content-Type, Authorization, X-Requested-With"
                                    aria-describedby="cors_headers_help"
                                >
                                <small id="cors_headers_help" class="form-text">
                                    {{t $lang "admin.security.cors_headers_help"}}
                                </small>
                            </div>

                            <div class="form-group">
                                <label class="toggle-label">
                                    <input
                                        type="checkbox"
                                        id="cors_credentials"
                                        name="security.cors_credentials"
                                        class="toggle-input"
                                        aria-describedby="cors_credentials_help"
                                    >
                                    <span class="toggle-slider"></span>
                                    {{t $lang "admin.security.cors_credentials_label"}}
                                </label>
                                <small id="cors_credentials_help" class="form-text">
                                    {{t $lang "admin.security.cors_credentials_help"}}
                                </small>
                            </div>

                            <div class="form-group">
                                <label for="cors_max_age">{{t $lang "admin.security.cors_max_age_label"}}</label>
                                <input
                                    type="number"
                                    id="cors_max_age"
                                    name="security.cors_max_age"
                                    class="form-control"
                                    placeholder="3600"
                                    min="0"
                                    max="86400"
                                    aria-describedby="cors_max_age_help"
                                >
                                <small id="cors_max_age_help" class="form-text">
                                    {{t $lang "admin.security.cors_max_age_help"}}
                                </small>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary" aria-label="{{t $lang "admin.security.save_cors_label"}}">
                            💾 {{t $lang "admin.security.save_cors_button"}}
                        </button>
                    </form>
                </div>
            </section>

            <!-- Rate Limiting Section -->
            <section class="admin-card" aria-labelledby="ratelimit-heading">
                <div class="card-header">
                    <h2 id="ratelimit-heading">{{t $lang "admin.security.ratelimit_heading"}}</h2>
                    <p class="card-description">{{t $lang "admin.security.ratelimit_description"}}</p>
                </div>
                <div class="card-body">
                    <form id="ratelimit-form" class="settings-form">
    <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
                        <div class="form-group">
                            <label class="toggle-label">
                                <input
                                    type="checkbox"
                                    id="ratelimit_enabled"
                                    name="rate_limit.enabled"
                                    class="toggle-input"
                                    aria-describedby="ratelimit_enabled_help"
                                >
                                <span class="toggle-slider"></span>
                                {{t $lang "admin.security.ratelimit_enabled_label"}}
                            </label>
                            <small id="ratelimit_enabled_help" class="form-text">
                                {{t $lang "admin.security.ratelimit_enabled_help"}}
                            </small>
                        </div>

                        <div id="ratelimit-fields" class="ratelimit-fields">
                            <div class="form-group">
                                <label for="ratelimit_global">{{t $lang "admin.security.ratelimit_global_label"}}</label>
                                <input
                                    type="number"
                                    id="ratelimit_global"
                                    name="rate_limit.global"
                                    class="form-control"
                                    placeholder="100"
                                    min="1"
                                    max="10000"
                                    aria-describedby="ratelimit_global_help"
                                >
                                <small id="ratelimit_global_help" class="form-text">
                                    {{t $lang "admin.security.ratelimit_global_help"}}
                                </small>
                            </div>

                            <div class="form-group">
                                <label for="ratelimit_per_ip">{{t $lang "admin.security.ratelimit_per_ip_label"}}</label>
                                <input
                                    type="number"
                                    id="ratelimit_per_ip"
                                    name="rate_limit.per_ip"
                                    class="form-control"
                                    placeholder="60"
                                    min="1"
                                    max="1000"
                                    aria-describedby="ratelimit_per_ip_help"
                                >
                                <small id="ratelimit_per_ip_help" class="form-text">
                                    {{t $lang "admin.security.ratelimit_per_ip_help"}}
                                </small>
                            </div>

                            <div class="form-group">
                                <label for="ratelimit_api">{{t $lang "admin.security.ratelimit_api_label"}}</label>
                                <input
                                    type="number"
                                    id="ratelimit_api"
                                    name="rate_limit.api"
                                    class="form-control"
                                    placeholder="120"
                                    min="1"
                                    max="10000"
                                    aria-describedby="ratelimit_api_help"
                                >
                                <small id="ratelimit_api_help" class="form-text">
                                    {{t $lang "admin.security.ratelimit_api_help"}}
                                </small>
                            </div>

                            <div class="form-group">
                                <label for="ratelimit_admin">{{t $lang "admin.security.ratelimit_admin_label"}}</label>
                                <input
                                    type="number"
                                    id="ratelimit_admin"
                                    name="rate_limit.admin"
                                    class="form-control"
                                    placeholder="300"
                                    min="1"
                                    max="10000"
                                    aria-describedby="ratelimit_admin_help"
                                >
                                <small id="ratelimit_admin_help" class="form-text">
                                    {{t $lang "admin.security.ratelimit_admin_help"}}
                                </small>
                            </div>

                            <div class="alert alert-warning" role="alert">
                                <strong>{{t $lang "admin.security.ratelimit_note_strong"}}</strong> {{t $lang "admin.security.ratelimit_note_text"}}
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary" aria-label="{{t $lang "admin.security.save_ratelimit_label"}}">
                            💾 {{t $lang "admin.security.save_ratelimit_button"}}
                        </button>
                    </form>
                </div>
            </section>

            <!-- Authentication Settings Section -->
            <section class="admin-card" aria-labelledby="auth-heading">
                <div class="card-header">
                    <h2 id="auth-heading">{{t $lang "admin.security.auth_heading"}}</h2>
                    <p class="card-description">{{t $lang "admin.security.auth_description"}}</p>
                </div>
                <div class="card-body">
                    <form id="auth-form" class="settings-form">
    <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
                        <div class="form-group">
                            <label for="session_timeout">{{t $lang "admin.security.session_timeout_label"}}</label>
                            <input
                                type="number"
                                id="session_timeout"
                                name="security.session_timeout"
                                class="form-control"
                                placeholder="2592000"
                                min="300"
                                max="31536000"
                                aria-describedby="session_timeout_help"
                            >
                            <small id="session_timeout_help" class="form-text">
                                {{t $lang "admin.security.session_timeout_help"}}
                            </small>
                        </div>

                        <div class="form-group">
                            <label for="max_login_attempts">{{t $lang "admin.security.max_login_attempts_label"}}</label>
                            <input
                                type="number"
                                id="max_login_attempts"
                                name="security.max_login_attempts"
                                class="form-control"
                                placeholder="5"
                                min="1"
                                max="20"
                                aria-describedby="max_login_attempts_help"
                            >
                            <small id="max_login_attempts_help" class="form-text">
                                {{t $lang "admin.security.max_login_attempts_help"}}
                            </small>
                        </div>

                        <div class="form-group">
                            <label for="lockout_duration">{{t $lang "admin.security.lockout_duration_label"}}</label>
                            <input
                                type="number"
                                id="lockout_duration"
                                name="security.lockout_duration"
                                class="form-control"
                                placeholder="30"
                                min="1"
                                max="1440"
                                aria-describedby="lockout_duration_help"
                            >
                            <small id="lockout_duration_help" class="form-text">
                                {{t $lang "admin.security.lockout_duration_help"}}
                            </small>
                        </div>

                        <div class="form-group">
                            <label for="password_min_length">{{t $lang "admin.security.password_min_length_label"}}</label>
                            <input
                                type="number"
                                id="password_min_length"
                                name="security.password_min_length"
                                class="form-control"
                                placeholder="8"
                                min="6"
                                max="64"
                                aria-describedby="password_min_length_help"
                            >
                            <small id="password_min_length_help" class="form-text">
                                {{t $lang "admin.security.password_min_length_help"}}
                            </small>
                        </div>

                        <button type="submit" class="btn btn-primary" aria-label="{{t $lang "admin.security.save_auth_label"}}">
                            💾 {{t $lang "admin.security.save_auth_button"}}
                        </button>
                    </form>
                </div>
            </section>

            <!-- Admin Passkey Management Section -->
            <section class="admin-card" aria-labelledby="passkeys-heading">
                <div class="card-header">
                    <h2 id="passkeys-heading">{{t $lang "admin.security.passkeys_heading"}}</h2>
                    <p class="card-description">{{t $lang "admin.security.passkeys_description"}}</p>
                </div>
                <div class="card-body">
                    <div id="passkeys-status" class="alert alert-info" role="status">{{t $lang "admin.security.passkeys_loading"}}</div>

                    <div id="passkeys-list" class="margin-y-md passkeys-list-hidden">
                        <h3 class="passkeys-list-heading">{{t $lang "admin.security.passkeys_registered_heading"}}</h3>
                        <div id="passkeys-items"></div>
                    </div>

                    <div class="form-group passkey-name-field-group">
                        <label for="adminPasskeyName">{{t $lang "admin.security.passkey_name_label"}}</label>
                        <input
                            type="text"
                            id="adminPasskeyName"
                            class="form-control"
                            placeholder="{{t $lang "admin.security.passkey_name_placeholder"}}"
                            aria-describedby="adminPasskeyName_help"
                            maxlength="64"
                        >
                        <small id="adminPasskeyName_help" class="form-text">{{t $lang "admin.security.passkey_name_help"}}</small>
                    </div>

                    <div class="form-group">
                        <label for="adminPasskeyPassword">{{t $lang "admin.security.passkey_password_label"}}</label>
                        <input
                            type="password"
                            id="adminPasskeyPassword"
                            class="form-control"
                            placeholder="{{t $lang "admin.security.passkey_password_placeholder"}}"
                            aria-describedby="adminPasskeyPassword_help"
                            autocomplete="current-password"
                        >
                        <small id="adminPasskeyPassword_help" class="form-text">{{t $lang "admin.security.passkey_password_help"}}</small>
                    </div>

                    <button
                        type="button"
                        class="btn btn-primary"
                        id="registerPasskeyBtn"
                        aria-label="{{t $lang "admin.security.passkey_register_label"}}"
                        data-action="register-admin-passkey"
                    >
                        🔑 {{t $lang "admin.security.passkey_add_button"}}
                    </button>

                    <div id="passkey-op-status" class="alert passkey-op-status-hidden" role="status"></div>
                </div>
            </section>

    <script type="application/json" id="admin-security-data">{"apiPath": {{.api_path}}, "adminApiPath": {{.admin_api_path}}}</script>
    <script src="/static/js/app.js"></script>

{{template "admin_footer" .}}
{{end}}
