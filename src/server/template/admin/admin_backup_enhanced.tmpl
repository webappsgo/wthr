{{define "admin/admin_backup_enhanced.tmpl"}}
{{template "head" .}}
{{template "admin_header" .}}
{{- $lang := "en" -}}
{{- if .lang}}{{$lang = .lang}}{{end -}}
    <div class="content-header">
        <h1>💾 {{t $lang "admin.backup.mgmt_title"}}</h1>
    </div>

    <div class="admin-page-container wide">
        <p class="text-muted">{{t $lang "admin.backup.intro"}}</p>

        {{if .flash}}
        <div class="admin-alert admin-alert-{{.flash.Kind}}" role="status">{{t $lang .flash.Key}}</div>
        {{end}}

        {{if not .backup_encryption_configured}}
        <div class="admin-alert admin-alert-warning" role="alert">{{t $lang "admin.backup.unencrypted_warning"}}</div>
        {{end}}

        <section class="card" aria-labelledby="backup-encryption-heading">
            <h2 id="backup-encryption-heading">{{t $lang "admin.backup.encryption_heading"}}</h2>
            <p>{{t $lang "admin.backup.encryption_help"}}</p>
            <form method="post" action="{{.admin_path}}/backup/encryption">
                <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
                <div class="form-group">
                    <label for="scheduledBackupPassword">{{t $lang "admin.backup.password_label"}}</label>
                    <input type="password" id="scheduledBackupPassword" name="password" autocomplete="new-password" required>
                </div>
                <div class="form-group">
                    <label for="scheduledBackupPasswordConfirm">{{t $lang "setup.security_confirm_backup_password_label"}}</label>
                    <input type="password" id="scheduledBackupPasswordConfirm" name="password_confirm" autocomplete="new-password" required>
                </div>
                <button type="submit" class="btn btn-primary">{{t $lang "admin.backup.encryption_save_action"}}</button>
            </form>
        </section>

        <div class="admin-alert admin-alert-success" id="successAlert" role="status" aria-live="polite"></div>
        <div class="admin-alert admin-alert-error" id="errorAlert" role="alert" aria-live="assertive"></div>

        <!-- Statistics -->
        <div class="stats-grid">
            <div class="stat-box">
                <div class="stat-value" id="totalBackups">0</div>
                <div class="stat-label">{{t $lang "admin.backup.stat_total_backups"}}</div>
            </div>
            <div class="stat-box">
                <div class="stat-value" id="totalSize">0 B</div>
                <div class="stat-label">{{t $lang "admin.backup.stat_total_size"}}</div>
            </div>
            <div class="stat-box">
                <div class="stat-value" id="lastBackup">-</div>
                <div class="stat-label">{{t $lang "admin.backup.stat_last_backup"}}</div>
            </div>
            <div class="stat-box">
                <div class="stat-value" id="nextBackup">-</div>
                <div class="stat-label">{{t $lang "admin.backup.stat_next_scheduled"}}</div>
            </div>
        </div>

        <div class="grid">
            <!-- Create Backup -->
            <div class="card">
                <h2>➕ {{t $lang "admin.backup.create_backup_heading"}}</h2>
                <form id="createForm" method="post" action="{{.admin_path}}/backup/create">
                    <input type="hidden" name="csrf_token" value="{{.csrf_token}}">

                    <div class="form-group">
                        <label for="backupPassword">{{t $lang "admin.backup.password_label"}}</label>
                        <input type="password" id="backupPassword" name="password" autocomplete="new-password">
                        <small>{{t $lang "admin.backup.password_hint"}}</small>
                    </div>

                    <div class="form-group">
                        <label>
                            <input type="checkbox" id="includeSSL" name="include_ssl" value="true">
                            {{t $lang "admin.backup.include_ssl_label"}}
                        </label>
                    </div>

                    <div class="form-group">
                        <label>
                            <input type="checkbox" id="includeData" name="include_data" value="true">
                            {{t $lang "admin.backup.include_data_label"}}
                        </label>
                    </div>

                    <button type="submit" class="btn btn-success" id="createBtn">
                        💾 {{t $lang "admin.backup.create_action"}}
                    </button>
                </form>
            </div>

            <!-- Automated Backups -->
            <div class="card">
                <h2>⏰ {{t $lang "admin.backup.automated_heading"}}</h2>
                <form id="scheduleForm" method="post" action="{{.admin_path}}/backup/schedule">
                    <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
                    <div class="form-group">
                        <label>
                            <input type="checkbox" id="autoBackup" name="enabled" value="true" checked>
                            {{t $lang "admin.backup.enable_auto_label"}}
                        </label>
                    </div>

                    <div class="form-group">
                        <label for="interval">{{t $lang "admin.backup.interval_label"}}</label>
                        <input type="number" id="interval" name="interval" value="6" min="1" max="168">
                        <small>{{t $lang "admin.backup.interval_hint"}}</small>
                    </div>

                    <div class="form-group">
                        <label for="retention">{{t $lang "admin.backup.retention_label"}}</label>
                        <input type="number" id="retention" name="retention" value="30" min="1" max="3650">
                        <small>{{t $lang "admin.backup.retention_hint"}}</small>
                    </div>

                    <fieldset>
                        <legend>{{t $lang "admin.backup.restore_limits"}}</legend>
                        <label for="restoreMaxArchiveSize">{{t $lang "admin.backup.limit_archive_size"}}</label>
                        <input id="restoreMaxArchiveSize" type="text" value="1G" autocomplete="off">
                        <label for="restoreMaxExpandedSize">{{t $lang "admin.backup.limit_expanded_size"}}</label>
                        <input id="restoreMaxExpandedSize" type="text" value="4G" autocomplete="off">
                        <label for="restoreMaxFiles">{{t $lang "admin.backup.limit_entries"}}</label>
                        <input id="restoreMaxFiles" type="number" min="1" max="1000000" value="10000">
                        <label for="restoreMaxFileSize">{{t $lang "admin.backup.limit_file_size"}}</label>
                        <input id="restoreMaxFileSize" type="text" value="512M" autocomplete="off">
                        <label for="restoreMaxRatio">{{t $lang "admin.backup.limit_ratio"}}</label>
                        <input id="restoreMaxRatio" type="number" min="1" max="10000" value="100">
                    </fieldset>

                    <button type="submit" class="btn btn-primary" id="scheduleBtn">💾 {{t $lang "admin.backup.save_schedule_action"}}</button>
                </form>
            </div>
        </div>

        <!-- Backup List -->
        <div class="card mt-3">
            <h2>📋 {{t $lang "admin.backup.history_heading"}}</h2>
            {{if .backup_files}}
            <div class="table-wrapper">
                <table>
                    <thead><tr><th scope="col">{{t $lang "admin.backup.history_heading"}}</th><th scope="col">{{t $lang "admin.backup.limit_archive_size"}}</th><th scope="col">{{t $lang "admin.backup.password_label"}}</th></tr></thead>
                    <tbody>{{range .backup_files}}<tr><td><a href="{{$.admin_path}}/backup/{{.Filename}}/download">{{.Filename}}</a></td><td>{{.Size}}</td><td>{{.Created}}</td></tr>{{end}}</tbody>
                </table>
            </div>
            {{else}}
            <p class="text-center text-muted p-3">{{t $lang "admin.backup.empty_message"}}</p>
            {{end}}
        </div>

        <div class="card mt-3">
            <h2>{{t $lang "admin.backup.restore_action"}}</h2>
            <form method="post" action="{{.admin_path}}/backup/restore" enctype="multipart/form-data">
                <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
                <div class="form-group"><label for="restoreFile">{{t $lang "admin.backup.history_heading"}}</label><input type="file" id="restoreFile" name="backup" accept=".tar.gz,.enc" required></div>
                <div class="form-group"><label for="restorePassword">{{t $lang "admin.backup.password_label"}}</label><input type="password" id="restorePassword" name="password" autocomplete="current-password"></div>
                <button class="btn btn-warning" type="submit">{{t $lang "admin.backup.restore_action"}}</button>
            </form>
        </div>
    </div>

    <script type="application/json" id="admin-backup-data">{"adminApiPath": {{.admin_api_path}}, "text": {"never": {{t $lang "admin.backup.msg_never"}}, "empty": {{t $lang "admin.backup.empty_message"}}, "created": {{t $lang "admin.backup.msg_created"}}, "creating": {{t $lang "admin.backup.msg_creating"}}, "createFailed": {{t $lang "admin.backup.msg_create_failed"}}, "deleteConfirm": {{t $lang "admin.backup.msg_delete_confirm"}}, "deleted": {{t $lang "admin.backup.msg_deleted"}}, "deleteFailed": {{t $lang "admin.backup.msg_delete_failed"}}, "restoreConfirm": {{t $lang "admin.backup.msg_restore_confirm"}}, "restored": {{t $lang "admin.backup.msg_restored"}}, "restoreFailed": {{t $lang "admin.backup.msg_restore_failed"}}, "loadFailed": {{t $lang "admin.backup.msg_load_failed"}}, "scheduleSaved": {{t $lang "admin.backup.msg_schedule_saved"}}, "scheduleFailed": {{t $lang "admin.backup.msg_schedule_failed"}}, "createAction": {{t $lang "admin.backup.create_action"}}, "downloadAction": {{t $lang "admin.backup.download_action"}}, "restoreAction": {{t $lang "admin.backup.restore_action"}}, "deleteAction": {{t $lang "admin.backup.delete_action"}}, "saveScheduleAction": {{t $lang "admin.backup.save_schedule_action"}}, "encryptedYes": {{t $lang "admin.backup.encrypted_yes"}}, "encryptedNo": {{t $lang "admin.backup.encrypted_no"}}}}</script>
    <script src="{{asset "/static/js/app.js"}}"></script>
{{template "admin_footer" .}}
{{end}}
