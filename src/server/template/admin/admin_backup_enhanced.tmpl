{{define "admin/admin_backup_enhanced.tmpl"}}
{{template "head" .}}
{{template "admin_header" .}}
{{- $lang := "en" -}}
{{- if .lang}}{{$lang = .lang}}{{end -}}
    <div class="content-header">
        <h1>💾 {{t $lang "admin.backup.mgmt_title"}}</h1>
    </div>

    <div class="admin-page-container wide">
        <p class="text-muted">{{t $lang "admin.backup.intro"}}</p>

        <div class="admin-alert admin-alert-success" id="successAlert" role="status" aria-live="polite"></div>
        <div class="admin-alert admin-alert-error" id="errorAlert" role="alert" aria-live="assertive"></div>

        <!-- Statistics -->
        <div class="stats-grid">
            <div class="stat-box">
                <div class="stat-value" id="totalBackups">0</div>
                <div class="stat-label">{{t $lang "admin.backup.stat_total_backups"}}</div>
            </div>
            <div class="stat-box">
                <div class="stat-value" id="totalSize">0 B</div>
                <div class="stat-label">{{t $lang "admin.backup.stat_total_size"}}</div>
            </div>
            <div class="stat-box">
                <div class="stat-value" id="lastBackup">-</div>
                <div class="stat-label">{{t $lang "admin.backup.stat_last_backup"}}</div>
            </div>
            <div class="stat-box">
                <div class="stat-value" id="nextBackup">-</div>
                <div class="stat-label">{{t $lang "admin.backup.stat_next_scheduled"}}</div>
            </div>
        </div>

        <div class="grid">
            <!-- Create Backup -->
            <div class="card">
                <h2>➕ {{t $lang "admin.backup.create_backup_heading"}}</h2>
                <form id="createForm" method="post" action="{{.admin_api_path}}/config/backup">
                    <input type="hidden" name="csrf_token" value="{{.csrf_token}}">

                    <div class="form-group">
                        <label for="backupPassword">{{t $lang "admin.backup.password_label"}}</label>
                        <input type="password" id="backupPassword" name="password" autocomplete="new-password">
                        <small>{{t $lang "admin.backup.password_hint"}}</small>
                    </div>

                    <div class="form-group">
                        <label>
                            <input type="checkbox" id="includeSSL" name="include_ssl" value="true">
                            {{t $lang "admin.backup.include_ssl_label"}}
                        </label>
                    </div>

                    <div class="form-group">
                        <label>
                            <input type="checkbox" id="includeData" name="include_data" value="true">
                            {{t $lang "admin.backup.include_data_label"}}
                        </label>
                    </div>

                    <button type="submit" class="btn btn-success" id="createBtn">
                        💾 {{t $lang "admin.backup.create_action"}}
                    </button>
                </form>
            </div>

            <!-- Automated Backups -->
            <div class="card">
                <h2>⏰ {{t $lang "admin.backup.automated_heading"}}</h2>
                <form id="scheduleForm" method="post" action="{{.admin_api_path}}/config/backup/schedule">
                    <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
                    <div class="form-group">
                        <label>
                            <input type="checkbox" id="autoBackup" name="enabled" value="true" checked>
                            {{t $lang "admin.backup.enable_auto_label"}}
                        </label>
                    </div>

                    <div class="form-group">
                        <label for="interval">{{t $lang "admin.backup.interval_label"}}</label>
                        <input type="number" id="interval" name="interval" value="6" min="1" max="168">
                        <small>{{t $lang "admin.backup.interval_hint"}}</small>
                    </div>

                    <div class="form-group">
                        <label for="retention">{{t $lang "admin.backup.retention_label"}}</label>
                        <input type="number" id="retention" name="retention" value="30" min="1" max="3650">
                        <small>{{t $lang "admin.backup.retention_hint"}}</small>
                    </div>

                    <button type="submit" class="btn btn-primary" id="scheduleBtn">💾 {{t $lang "admin.backup.save_schedule_action"}}</button>
                </form>
            </div>
        </div>

        <!-- Backup List -->
        <div class="card mt-3">
            <h2>📋 {{t $lang "admin.backup.history_heading"}}</h2>
            <div id="backupList">
                <p class="text-center text-muted p-3">{{t $lang "admin.backup.loading_backups"}}</p>
            </div>
        </div>
    </div>

    <script>
        // Path variables - SPEC compliant (AI.md PART 13)
        const ADMIN_API_PATH = '{{.admin_api_path}}';
        const BACKUP_API = ADMIN_API_PATH + '/config/backup';

        // Every user-facing string this page can produce at runtime is resolved
        // server-side, so the script itself carries no English (AI.md PART 31).
        const BACKUP_TEXT = {
            never: '{{t $lang "admin.backup.msg_never"}}',
            empty: '{{t $lang "admin.backup.empty_message"}}',
            created: '{{t $lang "admin.backup.msg_created"}}',
            creating: '{{t $lang "admin.backup.msg_creating"}}',
            createFailed: '{{t $lang "admin.backup.msg_create_failed"}}',
            deleteConfirm: '{{t $lang "admin.backup.msg_delete_confirm"}}',
            deleted: '{{t $lang "admin.backup.msg_deleted"}}',
            deleteFailed: '{{t $lang "admin.backup.msg_delete_failed"}}',
            restoreConfirm: '{{t $lang "admin.backup.msg_restore_confirm"}}',
            restored: '{{t $lang "admin.backup.msg_restored"}}',
            restoreFailed: '{{t $lang "admin.backup.msg_restore_failed"}}',
            loadFailed: '{{t $lang "admin.backup.msg_load_failed"}}',
            scheduleSaved: '{{t $lang "admin.backup.msg_schedule_saved"}}',
            scheduleFailed: '{{t $lang "admin.backup.msg_schedule_failed"}}',
            createAction: '{{t $lang "admin.backup.create_action"}}',
            downloadAction: '{{t $lang "admin.backup.download_action"}}',
            restoreAction: '{{t $lang "admin.backup.restore_action"}}',
            deleteAction: '{{t $lang "admin.backup.delete_action"}}',
            saveScheduleAction: '{{t $lang "admin.backup.save_schedule_action"}}',
            encryptedYes: '{{t $lang "admin.backup.encrypted_yes"}}',
            encryptedNo: '{{t $lang "admin.backup.encrypted_no"}}'
        };

        // The API returns an error envelope with a translated message; anything
        // else (network failure, unexpected status) falls back to the caller's
        // own message.
        async function backupRequest(url, options) {
            const response = await fetch(url, options);
            let payload = null;
            try {
                payload = await response.json();
            } catch (error) {
                payload = null;
            }
            if (!response.ok) {
                throw new Error(payload && payload.message ? payload.message : String(response.status));
            }
            return payload;
        }

        function formatBytes(bytes) {
            const value = Number(bytes) || 0;
            const units = ['B', 'KB', 'MB', 'GB', 'TB'];
            let index = 0;
            let size = value;
            while (size >= 1024 && index < units.length - 1) {
                size /= 1024;
                index += 1;
            }
            return (index === 0 ? size : size.toFixed(1)) + ' ' + units[index];
        }

        function formatMoment(value) {
            if (!value) {
                return BACKUP_TEXT.never;
            }
            const parsed = new Date(value);
            return isNaN(parsed.getTime()) ? value : parsed.toLocaleString();
        }

        function escapeText(value) {
            const holder = document.createElement('span');
            holder.textContent = value === null || value === undefined ? '' : String(value);
            return holder.innerHTML;
        }

        async function loadStats() {
            try {
                const stats = await backupRequest(BACKUP_API + '/stats');
                document.getElementById('totalBackups').textContent = stats.count || 0;
                document.getElementById('totalSize').textContent = formatBytes(stats.total_size);
                document.getElementById('lastBackup').textContent = formatMoment(stats.last_backup);
                document.getElementById('nextBackup').textContent = stats.next_backup ? formatMoment(stats.next_backup) : '-';
            } catch (error) {
                showError(BACKUP_TEXT.loadFailed + ' ' + error.message);
            }
        }

        async function loadBackups() {
            const container = document.getElementById('backupList');
            try {
                const backups = await backupRequest(BACKUP_API);
                if (!Array.isArray(backups) || backups.length === 0) {
                    container.innerHTML = '<p class="text-center text-muted p-3">' + escapeText(BACKUP_TEXT.empty) + '</p>';
                    return;
                }

                container.innerHTML = backups.map(function (backup) {
                    const encrypted = backup.filename.endsWith('.enc') ? BACKUP_TEXT.encryptedYes : BACKUP_TEXT.encryptedNo;
                    const name = escapeText(backup.filename);
                    return '<div class="backup-item">' +
                        '<div class="backup-info">' +
                            '<h3>' + name + '</h3>' +
                            '<div class="backup-meta">' + escapeText(formatBytes(backup.size)) + ' &bull; ' + escapeText(formatMoment(backup.created)) + ' &bull; ' + escapeText(encrypted) + '</div>' +
                        '</div>' +
                        '<div class="btn-group">' +
                            '<button type="button" class="btn btn-sm btn-primary" data-action="download-backup" data-filename="' + name + '">⬇️ ' + escapeText(BACKUP_TEXT.downloadAction) + '</button>' +
                            '<button type="button" class="btn btn-sm btn-success" data-action="restore-backup" data-filename="' + name + '">🔄 ' + escapeText(BACKUP_TEXT.restoreAction) + '</button>' +
                            '<button type="button" class="btn btn-sm btn-danger" data-action="delete-backup" data-filename="' + name + '">🗑️ ' + escapeText(BACKUP_TEXT.deleteAction) + '</button>' +
                        '</div>' +
                    '</div>';
                }).join('');
            } catch (error) {
                showError(BACKUP_TEXT.loadFailed + ' ' + error.message);
            }
        }

        // Actions are bound by delegation on a data-action attribute because CSP
        // forbids inline handlers (AI.md PART 16).
        document.getElementById('backupList').addEventListener('click', function (event) {
            const button = event.target.closest('[data-action]');
            if (!button) {
                return;
            }
            const filename = button.getAttribute('data-filename');
            if (button.getAttribute('data-action') === 'download-backup') {
                window.location.href = BACKUP_API + '/' + encodeURIComponent(filename) + '/download';
            } else if (button.getAttribute('data-action') === 'restore-backup') {
                restoreBackup(filename);
            } else if (button.getAttribute('data-action') === 'delete-backup') {
                deleteBackup(filename);
            }
        });

        document.getElementById('createForm').addEventListener('submit', async function (event) {
            event.preventDefault();
            const button = document.getElementById('createBtn');
            button.disabled = true;
            button.textContent = BACKUP_TEXT.creating;

            try {
                await backupRequest(BACKUP_API, {
                    method: 'POST',
                    body: new FormData(event.target)
                });
                showSuccess(BACKUP_TEXT.created);
                document.getElementById('backupPassword').value = '';
                await loadBackups();
                await loadStats();
            } catch (error) {
                showError(BACKUP_TEXT.createFailed + ' ' + error.message);
            } finally {
                button.disabled = false;
                button.textContent = BACKUP_TEXT.createAction;
            }
        });

        async function restoreBackup(filename) {
            if (!await showConfirm(BACKUP_TEXT.restoreConfirm + ' ' + filename, BACKUP_TEXT.restoreAction)) {
                return;
            }

            const body = new FormData();
            body.append('filename', filename);
            body.append('csrf_token', document.querySelector('#createForm [name="csrf_token"]').value);
            if (filename.endsWith('.enc')) {
                body.append('password', document.getElementById('backupPassword').value);
            }

            try {
                await backupRequest(BACKUP_API + '/restore', { method: 'POST', body: body });
                showSuccess(BACKUP_TEXT.restored);
            } catch (error) {
                showError(BACKUP_TEXT.restoreFailed + ' ' + error.message);
            }
        }

        async function deleteBackup(filename) {
            if (!await showConfirm(BACKUP_TEXT.deleteConfirm + ' ' + filename, BACKUP_TEXT.deleteAction)) {
                return;
            }

            try {
                await backupRequest(BACKUP_API + '/' + encodeURIComponent(filename), { method: 'DELETE' });
                showSuccess(BACKUP_TEXT.deleted);
                await loadBackups();
                await loadStats();
            } catch (error) {
                showError(BACKUP_TEXT.deleteFailed + ' ' + error.message);
            }
        }

        async function loadSchedule() {
            try {
                const schedule = await backupRequest(BACKUP_API + '/schedule');
                document.getElementById('autoBackup').checked = schedule.enabled !== false;
                document.getElementById('interval').value = schedule.interval;
                document.getElementById('retention').value = schedule.retention;
            } catch (error) {
                showError(BACKUP_TEXT.loadFailed + ' ' + error.message);
            }
        }

        document.getElementById('scheduleForm').addEventListener('submit', async function (event) {
            event.preventDefault();
            const button = document.getElementById('scheduleBtn');
            button.disabled = true;

            const payload = {
                enabled: document.getElementById('autoBackup').checked,
                interval: parseInt(document.getElementById('interval').value, 10),
                retention: parseInt(document.getElementById('retention').value, 10)
            };

            try {
                await backupRequest(BACKUP_API + '/schedule', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                showSuccess(BACKUP_TEXT.scheduleSaved);
                await loadStats();
            } catch (error) {
                showError(BACKUP_TEXT.scheduleFailed + ' ' + error.message);
            } finally {
                button.disabled = false;
                button.textContent = BACKUP_TEXT.saveScheduleAction;
            }
        });

        function showSuccess(msg) {
            const alert = document.getElementById('successAlert');
            alert.textContent = msg;
            alert.classList.add('show');
            setTimeout(function () { alert.classList.remove('show'); }, 5000);
        }

        function showError(msg) {
            const alert = document.getElementById('errorAlert');
            alert.textContent = msg;
            alert.classList.add('show');
            setTimeout(function () { alert.classList.remove('show'); }, 5000);
        }

        loadStats();
        loadBackups();
        loadSchedule();

        // Auto-refresh every 30 seconds
        setInterval(function () {
            loadStats();
            loadBackups();
        }, 30000);
    </script>
{{template "admin_footer" .}}
{{end}}
