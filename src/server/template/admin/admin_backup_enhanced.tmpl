{{define "admin/admin_backup_enhanced.tmpl"}}
{{template "head" .}}
{{template "admin_header" .}}
{{- $lang := "en" -}}
{{- if .lang}}{{$lang = .lang}}{{end -}}
    <div class="content-header">
        <h1>💾 {{t $lang "admin.backup.mgmt_title"}}</h1>
    </div>

    <div class="admin-page-container wide">
        <p class="text-muted">{{t $lang "admin.backup.intro"}}</p>

        <div class="admin-alert admin-alert-success" id="successAlert" role="status" aria-live="polite"></div>
        <div class="admin-alert admin-alert-error" id="errorAlert" role="alert" aria-live="assertive"></div>

        <!-- Statistics -->
        <div class="stats-grid">
            <div class="stat-box">
                <div class="stat-value" id="totalBackups">0</div>
                <div class="stat-label">{{t $lang "admin.backup.stat_total_backups"}}</div>
            </div>
            <div class="stat-box">
                <div class="stat-value" id="totalSize">0 B</div>
                <div class="stat-label">{{t $lang "admin.backup.stat_total_size"}}</div>
            </div>
            <div class="stat-box">
                <div class="stat-value" id="lastBackup">-</div>
                <div class="stat-label">{{t $lang "admin.backup.stat_last_backup"}}</div>
            </div>
            <div class="stat-box">
                <div class="stat-value" id="nextBackup">-</div>
                <div class="stat-label">{{t $lang "admin.backup.stat_next_scheduled"}}</div>
            </div>
        </div>

        <div class="grid">
            <!-- Create Backup -->
            <div class="card">
                <h2>➕ {{t $lang "admin.backup.create_backup_heading"}}</h2>
                <form id="createForm" method="post" action="{{.admin_api_path}}/config/backup">
                    <input type="hidden" name="csrf_token" value="{{.csrf_token}}">

                    <div class="form-group">
                        <label for="backupPassword">{{t $lang "admin.backup.password_label"}}</label>
                        <input type="password" id="backupPassword" name="password" autocomplete="new-password">
                        <small>{{t $lang "admin.backup.password_hint"}}</small>
                    </div>

                    <div class="form-group">
                        <label>
                            <input type="checkbox" id="includeSSL" name="include_ssl" value="true">
                            {{t $lang "admin.backup.include_ssl_label"}}
                        </label>
                    </div>

                    <div class="form-group">
                        <label>
                            <input type="checkbox" id="includeData" name="include_data" value="true">
                            {{t $lang "admin.backup.include_data_label"}}
                        </label>
                    </div>

                    <button type="submit" class="btn btn-success" id="createBtn">
                        💾 {{t $lang "admin.backup.create_action"}}
                    </button>
                </form>
            </div>

            <!-- Automated Backups -->
            <div class="card">
                <h2>⏰ {{t $lang "admin.backup.automated_heading"}}</h2>
                <form id="scheduleForm" method="post" action="{{.admin_api_path}}/config/backup/schedule">
                    <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
                    <div class="form-group">
                        <label>
                            <input type="checkbox" id="autoBackup" name="enabled" value="true" checked>
                            {{t $lang "admin.backup.enable_auto_label"}}
                        </label>
                    </div>

                    <div class="form-group">
                        <label for="interval">{{t $lang "admin.backup.interval_label"}}</label>
                        <input type="number" id="interval" name="interval" value="6" min="1" max="168">
                        <small>{{t $lang "admin.backup.interval_hint"}}</small>
                    </div>

                    <div class="form-group">
                        <label for="retention">{{t $lang "admin.backup.retention_label"}}</label>
                        <input type="number" id="retention" name="retention" value="30" min="1" max="3650">
                        <small>{{t $lang "admin.backup.retention_hint"}}</small>
                    </div>

                    <button type="submit" class="btn btn-primary" id="scheduleBtn">💾 {{t $lang "admin.backup.save_schedule_action"}}</button>
                </form>
            </div>
        </div>

        <!-- Backup List -->
        <div class="card mt-3">
            <h2>📋 {{t $lang "admin.backup.history_heading"}}</h2>
            <div id="backupList">
                <p class="text-center text-muted p-3">{{t $lang "admin.backup.loading_backups"}}</p>
            </div>
        </div>
    </div>

    <script type="application/json" id="admin-backup-data">{"adminApiPath": {{.admin_api_path}}, "text": {"never": {{t $lang "admin.backup.msg_never"}}, "empty": {{t $lang "admin.backup.empty_message"}}, "created": {{t $lang "admin.backup.msg_created"}}, "creating": {{t $lang "admin.backup.msg_creating"}}, "createFailed": {{t $lang "admin.backup.msg_create_failed"}}, "deleteConfirm": {{t $lang "admin.backup.msg_delete_confirm"}}, "deleted": {{t $lang "admin.backup.msg_deleted"}}, "deleteFailed": {{t $lang "admin.backup.msg_delete_failed"}}, "restoreConfirm": {{t $lang "admin.backup.msg_restore_confirm"}}, "restored": {{t $lang "admin.backup.msg_restored"}}, "restoreFailed": {{t $lang "admin.backup.msg_restore_failed"}}, "loadFailed": {{t $lang "admin.backup.msg_load_failed"}}, "scheduleSaved": {{t $lang "admin.backup.msg_schedule_saved"}}, "scheduleFailed": {{t $lang "admin.backup.msg_schedule_failed"}}, "createAction": {{t $lang "admin.backup.create_action"}}, "downloadAction": {{t $lang "admin.backup.download_action"}}, "restoreAction": {{t $lang "admin.backup.restore_action"}}, "deleteAction": {{t $lang "admin.backup.delete_action"}}, "saveScheduleAction": {{t $lang "admin.backup.save_schedule_action"}}, "encryptedYes": {{t $lang "admin.backup.encrypted_yes"}}, "encryptedNo": {{t $lang "admin.backup.encrypted_no"}}}}</script>
    <script src="/static/js/app.js"></script>
{{template "admin_footer" .}}
{{end}}
