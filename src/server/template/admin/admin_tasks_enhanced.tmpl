{{define "admin/admin_tasks_enhanced.tmpl"}}
{{template "head" .}}
{{template "admin_header" .}}
{{- $lang := "en" -}}
{{- if .lang}}{{$lang = .lang}}{{end -}}
    <div class="content-header">
        <h1>⚙️ {{t $lang "admin.tasks.title"}}</h1>
    </div>

    <div class="admin-page-container wide">
        <div class="admin-alert admin-alert-success" id="successAlert" role="alert"></div>
        <div class="admin-alert admin-alert-error" id="errorAlert" role="alert"></div>

        <!-- Statistics -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon">📊</div>
                <div class="stat-value" id="totalTasks">0</div>
                <div class="stat-label">{{t $lang "admin.tasks.stat_total"}}</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon">✅</div>
                <div class="stat-value" id="enabledTasks">0</div>
                <div class="stat-label">{{t $lang "admin.tasks.stat_enabled"}}</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon">▶️</div>
                <div class="stat-value" id="runningTasks">0</div>
                <div class="stat-label">{{t $lang "admin.tasks.stat_running"}}</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon">✅</div>
                <div class="stat-value" id="successRate">0%</div>
                <div class="stat-label">{{t $lang "admin.tasks.stat_success_rate"}}</div>
            </div>
        </div>

        <!-- Tabs -->
        <div class="tabs">
            <button class="tab active" data-tab="timeline">{{t $lang "admin.tasks.tab_timeline"}}</button>
            <button class="tab" data-tab="tasks">{{t $lang "admin.tasks.tab_tasks"}}</button>
            <button class="tab" data-tab="history">{{t $lang "admin.tasks.tab_history"}}</button>
            <button class="tab" data-tab="dependencies">{{t $lang "admin.tasks.tab_dependencies"}}</button>
        </div>

        <!-- Timeline Tab -->
        <div class="tab-content active" id="timeline">
            <div class="card">
                <h2>{{t $lang "admin.tasks.timeline_heading"}}</h2>
                <div class="timeline">
                    <div class="timeline-track">
                        <div class="timeline-grid" id="timelineGrid"></div>
                        <div id="timelineTasks"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Task List Tab -->
        <div class="tab-content" id="tasks">
            <div class="card">
                <h2>{{t $lang "admin.tasks.all_tasks_heading"}}</h2>
                <div class="task-list" id="taskList">
                    <div class="text-center text-muted p-3">
                        {{t $lang "admin.tasks.loading_tasks"}}
                    </div>
                </div>
            </div>
        </div>

        <!-- History Tab -->
        <div class="tab-content" id="history">
            <div class="card">
                <h2>{{t $lang "admin.tasks.history_heading"}}</h2>
                <table class="history-table" id="historyTable">
                    <thead>
                        <tr>
                            <th>{{t $lang "admin.tasks.col_task"}}</th>
                            <th>{{t $lang "admin.tasks.col_status"}}</th>
                            <th>{{t $lang "admin.tasks.col_started"}}</th>
                            <th>{{t $lang "admin.tasks.col_duration"}}</th>
                            <th>{{t $lang "admin.tasks.col_result"}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td colspan="5" class="text-center text-muted p-3">
                                {{t $lang "admin.tasks.loading_history"}}
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Dependencies Tab -->
        <div class="tab-content" id="dependencies">
            <div class="card">
                <h2>{{t $lang "admin.tasks.dependencies_heading"}}</h2>
                <div class="dependency-graph" id="dependencyGraph">
                    <svg width="100%" height="400" id="depGraphSvg">
                        <defs>
                            <marker id="arrowhead" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
                                <polygon points="0 0, 10 3, 0 6" fill="#95a5a6" />
                            </marker>
                        </defs>
                    </svg>
                </div>
            </div>
        </div>
    </div>

    <script type="application/json" id="admin-tasks-data">{"adminApiPath": {{.admin_api_path}}}</script>
    <script src="/static/js/app.js"></script>
{{template "admin_footer" .}}
{{end}}
