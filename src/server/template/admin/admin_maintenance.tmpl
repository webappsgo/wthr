{{template "head" .}}
{{template "admin_header" .}}
{{- $lang := "en" -}}
{{- if .lang}}{{$lang = .lang}}{{end -}}
{{- $ap := "/server/admin" -}}
{{- if .admin_path}}{{$ap = .admin_path}}{{end -}}
  <div class="admin-header">
    <h1>{{t $lang "admin.maintenance.title"}}</h1>
    <p class="admin-page-intro">{{t $lang "admin.maintenance.intro"}}</p>
  </div>

  <section class="admin-section" aria-labelledby="maintenance-state-heading">
    <div class="section-header">
      <h2 id="maintenance-state-heading">{{t $lang "admin.maintenance.state_heading"}}</h2>
    </div>
    <div class="empty-state">
      <p class="empty-state__icon" aria-hidden="true">&#128295;</p>
      <h3 class="empty-state__title">{{t $lang "admin.maintenance.empty_title"}}</h3>
      <p class="empty-state__message">{{t $lang "admin.maintenance.empty_message"}}</p>
      <a class="btn btn-primary" href="{{$ap}}/config/backup">{{t $lang "admin.maintenance.empty_action"}}</a>
    </div>
  </section>
{{template "admin_footer" .}}
