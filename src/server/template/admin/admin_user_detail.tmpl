{{template "head" .}}
{{template "admin_header" .}}
{{- $lang := "en" -}}
{{- if .lang}}{{$lang = .lang}}{{end -}}
{{- $ap := "/server/administration" -}}
{{- if .admin_path}}{{$ap = .admin_path}}{{end -}}
  <div class="admin-header">
    <h1>{{t $lang "admin.user_detail.title"}}</h1>
    <p class="admin-page-intro">{{t $lang "admin.user_detail.intro"}}</p>
  </div>
  {{if .flash}}<div class="alert alert-{{.flash.Kind}}" role="status">{{t $lang .flash.Key}}</div>{{end}}
  <section class="admin-section" aria-labelledby="user-detail-identity-heading">
    <div class="section-header"><h2 id="user-detail-identity-heading">{{t $lang "admin.user_detail.identity_heading"}}</h2></div>
    <dl class="admin-detail-list">
      <dt>{{t $lang "admin.user_detail.id_label"}}</dt><dd>{{.user.ID}}</dd>
      <dt>{{t $lang "admin.moderation.username"}}</dt><dd>{{.user.Username}}</dd>
      <dt>{{t $lang "admin.moderation.email"}}</dt><dd>{{.user.Email}}</dd>
      <dt>{{t $lang "admin.user_detail.display_name"}}</dt><dd>{{.user.DisplayName}}</dd>
      <dt>{{t $lang "admin.user_detail.avatar"}}</dt><dd>{{.user.AvatarURL}}</dd>
      <dt>{{t $lang "admin.user_detail.bio"}}</dt><dd>{{.user.Bio}}</dd>
      <dt>{{t $lang "admin.user_detail.role"}}</dt><dd>{{.user.Role}}</dd>
      <dt>{{t $lang "admin.user_detail.two_factor"}}</dt><dd>{{if .user.TwoFactorEnabled}}{{t $lang "admin.user_detail.enabled"}}{{else}}{{t $lang "admin.user_detail.disabled"}}{{end}}</dd>
      <dt>{{t $lang "admin.user_detail.status"}}</dt><dd>{{if and .user.IsActive (not .user.IsBanned)}}{{t $lang "admin.moderation.status_active"}}{{else}}{{t $lang "admin.moderation.status_disabled"}}{{end}}</dd>
    </dl>
    <div class="admin-actions"><a class="btn btn-secondary" href="{{$ap}}/moderation/users">{{t $lang "admin.user_detail.back_action"}}</a></div>
  </section>
  <section class="admin-section" aria-labelledby="user-detail-security-heading">
    <div class="section-header"><h2 id="user-detail-security-heading">{{t $lang "admin.user_detail.sessions_heading"}}</h2></div>
    {{if .sessions}}
      <div class="table-responsive"><table class="admin-table"><thead><tr><th>{{t $lang "admin.user_detail.ip_address"}}</th><th>{{t $lang "admin.user_detail.user_agent"}}</th><th>{{t $lang "admin.user_detail.last_used"}}</th></tr></thead><tbody>
      {{range .sessions}}<tr><td>{{.ip_address}}</td><td>{{.user_agent}}</td><td>{{.last_used_at}}</td></tr>{{end}}
      </tbody></table></div>
    {{else}}<p>{{t $lang "admin.user_detail.no_sessions"}}</p>{{end}}
    <form method="post" action="{{$ap}}/moderation/users/{{.user.ID}}">
      <input type="hidden" name="csrf_token" value="{{.csrf_token}}"><input type="hidden" name="action" value="revoke_sessions">
      <button class="btn btn-secondary" type="submit">{{t $lang "admin.user_detail.revoke_sessions_action"}}</button>
    </form>
  </section>
  <section class="admin-section" aria-labelledby="user-detail-activity-heading">
    <div class="section-header"><h2 id="user-detail-activity-heading">{{t $lang "admin.user_detail.activity_heading"}}</h2></div>
    {{if .activities}}<div class="table-responsive"><table class="admin-table"><thead><tr><th>{{t $lang "admin.user_detail.activity_type"}}</th><th>{{t $lang "admin.user_detail.activity_time"}}</th><th>{{t $lang "admin.user_detail.ip_address"}}</th></tr></thead><tbody>
      {{range .activities}}<tr><td>{{.ActivityType}}</td><td>{{.CreatedAt}}</td><td>{{.IPAddress}}</td></tr>{{end}}
    </tbody></table></div>{{else}}<p>{{t $lang "admin.user_detail.empty_message"}}</p>{{end}}
  </section>
  <section class="admin-section" aria-labelledby="user-detail-actions-heading">
    <div class="section-header"><h2 id="user-detail-actions-heading">{{t $lang "admin.user_detail.actions_heading"}}</h2></div>
    <form method="post" action="{{$ap}}/moderation/users/{{.user.ID}}/impersonate">
      <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
      <button class="btn btn-secondary" type="submit">{{t $lang "admin.user_detail.impersonate_action"}}</button>
    </form>
    <form method="post" action="{{$ap}}/moderation/users/{{.user.ID}}">
      <input type="hidden" name="csrf_token" value="{{.csrf_token}}"><input type="hidden" name="action" value="{{if .user.IsActive}}disable{{else}}enable{{end}}">
      <button class="btn btn-secondary" type="submit">{{if .user.IsActive}}{{t $lang "admin.user_detail.disable_action"}}{{else}}{{t $lang "admin.user_detail.enable_action"}}{{end}}</button>
    </form>
    <form method="post" action="{{$ap}}/moderation/users/{{.user.ID}}">
      <input type="hidden" name="csrf_token" value="{{.csrf_token}}"><input type="hidden" name="action" value="delete">
      <label><input type="checkbox" required> {{t $lang "admin.user_detail.delete_confirm"}}</label>
      <button class="btn btn-danger" type="submit">{{t $lang "admin.user_detail.delete_action"}}</button>
    </form>
  </section>
{{template "admin_footer" .}}
