{{template "head" .}}
{{template "admin_header" .}}
{{- $lang := "en" -}}
{{- if .lang}}{{$lang = .lang}}{{end -}}
<div class="admin-header"><h1>👥 {{t $lang "admin.users.title"}}</h1></div>
<form id="userSettingsForm">
    <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
<section class="card"><h2>{{t $lang "admin.users.multi_user_heading"}}</h2>
<label><input type="checkbox" name="enabled"> {{t $lang "admin.users.enable_multi_user_label"}}</label>
</section>
<section class="card"><h2>{{t $lang "admin.users.registration_heading"}}</h2>
<label for="registration_mode">{{t $lang "admin.users.registration_mode_label"}}</label>
<select id="registration_mode" name="registration_mode">
    <option value="open">{{t $lang "admin.users.registration_mode_open"}}</option>
    <option value="invite">{{t $lang "admin.users.registration_mode_invite"}}</option>
    <option value="admin_only">{{t $lang "admin.users.registration_mode_admin_only"}}</option>
    <option value="disabled">{{t $lang "admin.users.registration_mode_disabled"}}</option>
</select>
<label><input type="checkbox" name="registration_require_email_verification"> {{t $lang "admin.users.require_email_verification_label"}}</label>
</section>
<button type="submit">{{t $lang "admin.common.save_settings"}}</button>
</form>
{{template "admin_footer" .}}
