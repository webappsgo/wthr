{{define "admin/admin_database.tmpl"}}
{{template "head" .}}
{{template "admin_header" .}}
{{- $lang := "en" -}}
{{- if .lang}}{{$lang = .lang}}{{end -}}

            <div class="content-header">
                <h1>🗄️ {{t $lang "admin.database.title"}}</h1>
                <p class="subtitle">{{t $lang "admin.database.subtitle"}}</p>
            </div>

            <!-- Database Status Section -->
            <section class="admin-card" aria-labelledby="db-status-heading">
                <div class="card-header">
                    <h2 id="db-status-heading">{{t $lang "admin.database.status_heading"}}</h2>
                    <p class="card-description">{{t $lang "admin.database.status_description"}}</p>
                </div>
                <div class="card-body">
                    <div id="db-stats" class="stats-grid">
                        <div class="stat-item">
                            <div class="stat-label">{{t $lang "admin.database.connection_status"}}</div>
                            <div class="stat-value" id="db-status">
                                <span class="loading">{{t $lang "admin.database.loading"}}</span>
                            </div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-label">{{t $lang "admin.database.database_type"}}</div>
                            <div class="stat-value" id="db-type">-</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-label">{{t $lang "admin.database.database_size"}}</div>
                            <div class="stat-value" id="db-size">-</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-label">{{t $lang "admin.database.total_tables"}}</div>
                            <div class="stat-value" id="db-tables">-</div>
                        </div>
                    </div>

                    <button class="btn btn-secondary" data-action="db-refresh-stats" aria-label="{{t $lang "admin.database.refresh_stats_label"}}">
                        🔄 {{t $lang "admin.database.refresh_stats"}}
                    </button>
                </div>
            </section>

            <!-- Database Optimization Section -->
            <section class="admin-card" aria-labelledby="db-optimize-heading">
                <div class="card-header">
                    <h2 id="db-optimize-heading">{{t $lang "admin.database.optimize_heading"}}</h2>
                    <p class="card-description">{{t $lang "admin.database.optimize_description"}}</p>
                </div>
                <div class="card-body">
                    <div class="alert alert-info" role="status">
                        <strong>{{t $lang "admin.database.note_label"}}</strong> {{t $lang "admin.database.optimize_note"}}
                    </div>

                    <div class="optimization-actions">
                        <div class="action-card">
                            <div class="action-info">
                                <h3>{{t $lang "admin.database.optimize_card_title"}}</h3>
                                <p>{{t $lang "admin.database.optimize_card_description"}}</p>
                                <ul>
                                    <li>{{t $lang "admin.database.optimize_benefit_space"}}</li>
                                    <li>{{t $lang "admin.database.optimize_benefit_speed"}}</li>
                                    <li>{{t $lang "admin.database.optimize_benefit_stats"}}</li>
                                </ul>
                            </div>
                            <button class="btn btn-primary" id="optimize-btn" data-action="db-optimize" aria-label="{{t $lang "admin.database.optimize_button_label"}}">
                                ⚡ {{t $lang "admin.database.optimize_button"}}
                            </button>
                        </div>

                        <div class="action-card">
                            <div class="action-info">
                                <h3>{{t $lang "admin.database.vacuum_card_title"}}</h3>
                                <p>{{t $lang "admin.database.vacuum_card_description"}}</p>
                                <ul>
                                    <li>{{t $lang "admin.database.vacuum_benefit_size"}}</li>
                                    <li>{{t $lang "admin.database.vacuum_benefit_io"}}</li>
                                    <li>{{t $lang "admin.database.vacuum_benefit_clean"}}</li>
                                </ul>
                            </div>
                            <button class="btn btn-primary" id="vacuum-btn" data-action="db-vacuum" aria-label="{{t $lang "admin.database.vacuum_button_label"}}">
                                🧹 {{t $lang "admin.database.vacuum_button"}}
                            </button>
                        </div>

                        <div class="action-card">
                            <div class="action-info">
                                <h3>{{t $lang "admin.database.test_card_title"}}</h3>
                                <p>{{t $lang "admin.database.test_card_description"}}</p>
                                <ul>
                                    <li>{{t $lang "admin.database.test_benefit_access"}}</li>
                                    <li>{{t $lang "admin.database.test_benefit_response"}}</li>
                                    <li>{{t $lang "admin.database.test_benefit_config"}}</li>
                                </ul>
                            </div>
                            <button class="btn btn-secondary" id="test-btn" data-action="db-test-connection" aria-label="{{t $lang "admin.database.test_button_label"}}">
                                🔍 {{t $lang "admin.database.test_button"}}
                            </button>
                        </div>
                    </div>

                    <div id="operation-result" class="alert alert-result hidden" role="status" aria-live="polite"></div>
                </div>
            </section>

            <!-- Cache Management Section -->
            <section class="admin-card" aria-labelledby="cache-heading">
                <div class="card-header">
                    <h2 id="cache-heading">{{t $lang "admin.database.cache_heading"}}</h2>
                    <p class="card-description">{{t $lang "admin.database.cache_description"}}</p>
                </div>
                <div class="card-body">
                    <div class="cache-status">
                        <div class="stat-item">
                            <div class="stat-label">{{t $lang "admin.database.cache_status_label"}}</div>
                            <div class="stat-value" id="cache-status">
                                <span class="loading">{{t $lang "admin.database.loading"}}</span>
                            </div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-label">{{t $lang "admin.database.cache_type_label"}}</div>
                            <div class="stat-value" id="cache-type">-</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-label">{{t $lang "admin.database.cache_hit_rate_label"}}</div>
                            <div class="stat-value" id="cache-hitrate">-</div>
                        </div>
                    </div>

                    <div class="alert alert-info my-3" role="status">
                        <strong>{{t $lang "admin.database.cache_config_label"}}</strong> {{t $lang "admin.database.cache_config_note"}}
                        <code>REDIS_HOST</code>, <code>REDIS_PORT</code>, <code>REDIS_PASSWORD</code>
                    </div>

                    <div class="button-group">
                        <button class="btn btn-warning" id="clear-cache-btn" data-action="db-clear-cache" aria-label="{{t $lang "admin.database.clear_cache_label"}}">
                            🗑️ {{t $lang "admin.database.clear_cache_button"}}
                        </button>
                        <button class="btn btn-secondary" data-action="db-refresh-cache-stats" aria-label="{{t $lang "admin.database.refresh_cache_label"}}">
                            🔄 {{t $lang "admin.database.refresh_cache_button"}}
                        </button>
                    </div>

                    <div id="cache-result" class="alert alert-result hidden" role="status" aria-live="polite"></div>
                </div>
            </section>

            <!-- Database Configuration Section -->
            <section class="admin-card" aria-labelledby="db-config-heading">
                <div class="card-header">
                    <h2 id="db-config-heading">{{t $lang "admin.database.config_heading"}}</h2>
                    <p class="card-description">{{t $lang "admin.database.config_description"}}</p>
                </div>
                <div class="card-body">
                    <form id="db-config-form" class="settings-form">
    <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
                        <div class="form-group">
                            <label for="db_driver">{{t $lang "admin.database.driver_label"}}</label>
                            <select
                                id="db_driver"
                                name="database.driver"
                                class="form-control"
                                aria-describedby="db_driver_help"
                            >
                                <option value="file">{{t $lang "admin.database.driver_sqlite_file"}}</option>
                                <option value="sqlite">{{t $lang "admin.database.driver_sqlite"}}</option>
                                <option value="postgres">{{t $lang "admin.database.driver_postgres"}}</option>
                                <option value="mysql">{{t $lang "admin.database.driver_mysql"}}</option>
                                <option value="mariadb">{{t $lang "admin.database.driver_mariadb"}}</option>
                                <option value="mssql">{{t $lang "admin.database.driver_mssql"}}</option>
                                <option value="mongodb">{{t $lang "admin.database.driver_mongodb"}}</option>
                            </select>
                            <small id="db_driver_help" class="form-text">
                                {{t $lang "admin.database.driver_help"}}
                            </small>
                        </div>

                        <div id="remote-db-fields" class="hidden">
                            <div class="form-group">
                                <label for="db_host">{{t $lang "admin.database.host_label"}}</label>
                                <input
                                    type="text"
                                    id="db_host"
                                    name="database.host"
                                    class="form-control"
                                    placeholder="localhost"
                                    aria-describedby="db_host_help"
                                >
                                <small id="db_host_help" class="form-text">
                                    {{t $lang "admin.database.host_help"}}
                                </small>
                            </div>

                            <div class="form-group">
                                <label for="db_port">{{t $lang "admin.database.port_label"}}</label>
                                <input
                                    type="number"
                                    id="db_port"
                                    name="database.port"
                                    class="form-control"
                                    min="1"
                                    max="65535"
                                    placeholder="5432"
                                    aria-describedby="db_port_help"
                                >
                                <small id="db_port_help" class="form-text">
                                    {{t $lang "admin.database.port_help"}}
                                </small>
                            </div>

                            <div class="form-group">
                                <label for="db_name">{{t $lang "admin.database.name_label"}}</label>
                                <input
                                    type="text"
                                    id="db_name"
                                    name="database.name"
                                    class="form-control"
                                    placeholder="wthr"
                                    aria-describedby="db_name_help"
                                >
                                <small id="db_name_help" class="form-text">
                                    {{t $lang "admin.database.name_help"}}
                                </small>
                            </div>

                            <div class="form-group">
                                <label for="db_username">{{t $lang "admin.database.username_label"}}</label>
                                <input
                                    type="text"
                                    id="db_username"
                                    name="database.username"
                                    class="form-control"
                                    placeholder="admin"
                                    aria-describedby="db_username_help"
                                >
                                <small id="db_username_help" class="form-text">
                                    {{t $lang "admin.database.username_help"}}
                                </small>
                            </div>

                            <div class="form-group">
                                <label for="db_password">{{t $lang "admin.database.password_label"}}</label>
                                <div class="position-relative">
                                    <input
                                        type="password"
                                        id="db_password"
                                        name="database.password"
                                        class="form-control input-with-toggle"
                                        placeholder="{{t $lang "admin.database.password_placeholder"}}"
                                        aria-describedby="db_password_help"
                                    >
                                    <button
                                        type="button"
                                        id="toggle-password"
                                        class="btn-toggle-password"
                                        data-action="db-toggle-password"
                                        aria-label="{{t $lang "admin.database.toggle_password_label"}}"
                                    >
                                        👁️
                                    </button>
                                </div>
                                <small id="db_password_help" class="form-text">
                                    {{t $lang "admin.database.password_help"}}
                                </small>
                            </div>

                            <div id="postgres-fields" class="hidden">
                                <div class="form-group">
                                    <label for="db_sslmode">{{t $lang "admin.database.sslmode_label"}}</label>
                                    <select
                                        id="db_sslmode"
                                        name="database.sslmode"
                                        class="form-control"
                                        aria-describedby="db_sslmode_help"
                                    >
                                        <option value="disable">{{t $lang "admin.database.sslmode_disable"}}</option>
                                        <option value="require">{{t $lang "admin.database.sslmode_require"}}</option>
                                        <option value="verify-ca">{{t $lang "admin.database.sslmode_verify_ca"}}</option>
                                        <option value="verify-full">{{t $lang "admin.database.sslmode_verify_full"}}</option>
                                    </select>
                                    <small id="db_sslmode_help" class="form-text">
                                        {{t $lang "admin.database.sslmode_help"}}
                                    </small>
                                </div>
                            </div>
                        </div>

                        <div class="button-group mt-3">
                            <button type="button" class="btn btn-secondary" id="test-db-connection-btn" data-action="db-test-connection-config">
                                🔍 {{t $lang "admin.database.test_button"}}
                            </button>
                        </div>

                        <div class="alert alert-warning my-3" role="status">
                            <strong>⚠️ {{t $lang "admin.database.warning_label"}}</strong> {{t $lang "admin.database.restart_required_note"}}
                        </div>

                        <div id="db-config-result" class="alert alert-result hidden" role="status" aria-live="polite"></div>

                        <div class="button-group">
                            <button type="button" class="btn btn-secondary" data-action="db-cancel-config">
                                {{t $lang "action.cancel"}}
                            </button>
                            <button type="submit" class="btn btn-primary" aria-label="{{t $lang "admin.database.save_config_label"}}">
                                💾 {{t $lang "admin.database.save_config_button"}}
                            </button>
                        </div>
                    </form>
                </div>
            </section>

            <!-- Database Settings Section -->
            <section class="admin-card" aria-labelledby="db-settings-heading">
                <div class="card-header">
                    <h2 id="db-settings-heading">{{t $lang "admin.database.settings_heading"}}</h2>
                    <p class="card-description">{{t $lang "admin.database.settings_description"}}</p>
                </div>
                <div class="card-body">
                    <form id="db-settings-form" class="settings-form">
    <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
                        <div class="form-group">
                            <label for="db_connection_pool">{{t $lang "admin.database.pool_size_label"}}</label>
                            <input
                                type="number"
                                id="db_connection_pool"
                                name="database.pool_size"
                                class="form-control"
                                min="1"
                                max="100"
                                placeholder="25"
                                aria-describedby="db_connection_pool_help"
                            >
                            <small id="db_connection_pool_help" class="form-text">
                                {{t $lang "admin.database.pool_size_help"}}
                            </small>
                        </div>

                        <div class="form-group">
                            <label for="db_timeout">{{t $lang "admin.database.timeout_label"}}</label>
                            <input
                                type="number"
                                id="db_timeout"
                                name="database.timeout"
                                class="form-control"
                                min="1"
                                max="300"
                                placeholder="30"
                                aria-describedby="db_timeout_help"
                            >
                            <small id="db_timeout_help" class="form-text">
                                {{t $lang "admin.database.timeout_help"}}
                            </small>
                        </div>

                        <div class="form-group">
                            <label class="toggle-label">
                                <input
                                    type="checkbox"
                                    id="db_auto_optimize"
                                    name="database.auto_optimize"
                                    class="toggle-input"
                                    aria-describedby="db_auto_optimize_help"
                                >
                                <span class="toggle-slider"></span>
                                {{t $lang "admin.database.auto_optimize_label"}}
                            </label>
                            <small id="db_auto_optimize_help" class="form-text">
                                {{t $lang "admin.database.auto_optimize_help"}}
                            </small>
                        </div>

                        <button type="submit" class="btn btn-primary" aria-label="{{t $lang "admin.database.save_settings_label"}}">
                            💾 {{t $lang "admin.database.save_settings_button"}}
                        </button>
                    </form>
                </div>
            </section>

    <script type="application/json" id="admin-database-data">{"apiPath": {{.api_path}}, "adminApiPath": {{.admin_api_path}}}</script>
    <script src="/static/js/app.js"></script>

{{template "admin_footer" .}}
{{end}}
