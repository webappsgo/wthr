{{template "head" .}}
{{template "admin_header" .}}
{{- $lang := "en" -}}
{{- if .lang}}{{$lang = .lang}}{{end -}}
{{- $ap := "/server/administration" -}}
{{- if .admin_path}}{{$ap = .admin_path}}{{end -}}
{{- $self := $ap -}}
{{- if .admin_self_path}}{{$self = .admin_self_path}}{{end -}}
  <div class="admin-header">
    <header class="page-header"><h1 class="page-title">{{t $lang "admin.profile.title"}}</h1></header>
    <p class="admin-page-intro">{{t $lang "admin.profile.intro"}}</p>
  </div>

  <section class="admin-section" aria-labelledby="profile-account-heading">
    <div class="section-header">
      <h2 id="profile-account-heading">{{t $lang "admin.profile.account_heading"}}</h2>
    </div>
    <div class="empty-state">
      <p class="empty-state__icon" aria-hidden="true">&#128100;</p>
      <h3 class="empty-state__title">{{t $lang "admin.profile.empty_title"}}</h3>
      <p class="empty-state__message">{{t $lang "admin.profile.empty_message"}}</p>
      <a class="btn btn-primary" href="{{$self}}/preferences">{{t $lang "admin.profile.empty_action"}}</a>
    </div>
  </section>
  <section class="admin-section" aria-labelledby="profile-pgp-heading">
    <div class="section-header"><h2 id="profile-pgp-heading">{{t $lang "admin.profile.pgp_heading"}}</h2></div>
    <p>{{t $lang "admin.profile.pgp_description"}}</p>
    {{if .flash}}{{template "flash" .}}{{end}}
    {{if .pgp_registered}}<p>{{t $lang "admin.profile.pgp_registered"}}</p>{{end}}
    <form class="admin-form" method="post" action="{{$self}}/profile/security/pgp">
      <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
      <label for="admin-pgp-key">{{t $lang "admin.profile.pgp_key_label"}}</label>
      <textarea id="admin-pgp-key" name="public_key" rows="8" autocomplete="off" spellcheck="false" required></textarea>
      <button class="btn btn-primary" type="submit">{{t $lang "admin.profile.pgp_save"}}</button>
    </form>
    {{if .pgp_registered}}
    <form class="admin-form" method="post" action="{{$self}}/profile/security/pgp/remove">
      <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
      <button class="btn" type="submit">{{t $lang "admin.profile.pgp_remove"}}</button>
    </form>
    {{end}}
  </section>
{{template "admin_footer" .}}
