{{template "head" .}}
{{template "admin_header" .}}
{{- $lang := "en" -}}
{{- if .lang}}{{$lang = .lang}}{{end -}}
{{- $ap := "/server/administration" -}}
{{- if .admin_path}}{{$ap = .admin_path}}{{end -}}
{{- $csrf := .csrf_token -}}
  <div class="admin-header">
    <h1>{{t $lang "admin.scheduler.page_title"}}</h1>
    <p class="admin-page-intro">{{t $lang "admin.scheduler.intro"}}</p>
  </div>
  {{template "flash" .}}

  <section class="admin-section" aria-labelledby="scheduler-tasks-heading">
    <div class="section-header">
      <h2 id="scheduler-tasks-heading">{{t $lang "admin.scheduler.task_list_heading"}}</h2>
    </div>
    {{if .tasks}}
    <div class="table-scroll">
      <table class="admin-table-full scheduler-table">
        <caption class="sr-only">{{t $lang "admin.scheduler.task_list_heading"}}</caption>
        <thead>
          <tr class="admin-table-head-row">
            <th scope="col" class="admin-table-head-cell">{{t $lang "admin.scheduler.col_task"}}</th>
            <th scope="col" class="admin-table-head-cell">{{t $lang "admin.scheduler.col_status"}}</th>
            <th scope="col" class="admin-table-head-cell">{{t $lang "admin.scheduler.col_schedule"}}</th>
            <th scope="col" class="admin-table-head-cell">{{t $lang "admin.scheduler.col_last_run"}}</th>
            <th scope="col" class="admin-table-head-cell">{{t $lang "admin.scheduler.col_next_run"}}</th>
            <th scope="col" class="admin-table-head-cell">{{t $lang "admin.scheduler.col_scope"}}</th>
            <th scope="col" class="admin-table-head-cell">{{t $lang "admin.scheduler.col_actions"}}</th>
          </tr>
        </thead>
        <tbody>
          {{range .tasks}}
          <tr class="admin-table-body-row">
            <th scope="row" class="admin-table-body-cell scheduler-task-name">
              <a href="{{$ap}}/scheduler/{{.Name}}">{{t $lang (printf "admin.scheduler.task.%s" .Name)}}</a>
              <code class="scheduler-task-id">{{.Name}}</code>
            </th>
            <td class="admin-table-body-cell">
              <span class="scheduler-status scheduler-status-{{.Status}}">{{t $lang (printf "admin.scheduler.status.%s" .Status)}}</span>
            </td>
            <td class="admin-table-body-cell"><code>{{.Schedule}}</code></td>
            <td class="admin-table-body-cell">{{if .LastRun}}{{.LastRun}}<br><small>{{.LastDuration}}</small>{{else}}{{t $lang "admin.scheduler.never"}}{{end}}</td>
            <td class="admin-table-body-cell">{{if and .NextRun .Enabled}}{{.NextRun}}{{else}}{{t $lang "admin.scheduler.none"}}{{end}}</td>
            <td class="admin-table-body-cell">{{if .Global}}{{t $lang "admin.scheduler.scope_global"}}{{else}}{{t $lang "admin.scheduler.scope_local"}}{{end}}</td>
            <td class="admin-table-body-cell scheduler-actions">
              <form method="POST" action="{{$ap}}/scheduler" class="scheduler-inline-form">
                <input type="hidden" name="csrf_token" value="{{$csrf}}">
                <input type="hidden" name="task" value="{{.Name}}">
                <button type="submit" name="action" value="run" class="btn btn-primary btn-sm">{{t $lang "admin.scheduler.action_run"}}</button>
                {{if .Enabled}}
                  {{if not .Critical}}<button type="submit" name="action" value="disable" class="btn btn-secondary btn-sm">{{t $lang "admin.scheduler.action_disable"}}</button>{{end}}
                {{else}}
                  <button type="submit" name="action" value="enable" class="btn btn-secondary btn-sm">{{t $lang "admin.scheduler.action_enable"}}</button>
                {{end}}
                <a class="btn btn-secondary btn-sm" href="{{$ap}}/scheduler/{{.Name}}">{{t $lang "admin.scheduler.action_details"}}</a>
              </form>
            </td>
          </tr>
          {{end}}
        </tbody>
      </table>
    </div>
    <p class="scheduler-legend">{{t $lang "admin.scheduler.legend"}}</p>
    {{else}}
    <div class="empty-state">
      <p class="empty-state__icon" aria-hidden="true">&#9201;</p>
      <h3 class="empty-state__title">{{t $lang "admin.scheduler.empty_title"}}</h3>
      <p class="empty-state__message">{{t $lang "admin.scheduler.empty_message"}}</p>
    </div>
    {{end}}
  </section>

  <section class="admin-section" aria-labelledby="scheduler-settings-heading">
    <div class="section-header">
      <h2 id="scheduler-settings-heading">{{t $lang "admin.scheduler.global_settings_heading"}}</h2>
    </div>
    <form method="POST" action="{{$ap}}/scheduler" class="admin-form">
      <input type="hidden" name="csrf_token" value="{{$csrf}}">
      <input type="hidden" name="action" value="settings">
      <div class="form-group">
        <label for="scheduler-timezone">{{t $lang "admin.scheduler.timezone_label"}}</label>
        <input type="text" id="scheduler-timezone" name="timezone" value="{{.timezone}}" list="scheduler-timezones" required aria-describedby="scheduler-timezone-help">
        <datalist id="scheduler-timezones">
          {{range .timezones}}<option value="{{.}}"></option>{{end}}
        </datalist>
        <p class="help-text" id="scheduler-timezone-help">{{t $lang "admin.scheduler.timezone_help"}}</p>
      </div>
      <div class="form-group">
        <label for="scheduler-catch-up">{{t $lang "admin.scheduler.catch_up_window_label"}}</label>
        <input type="text" id="scheduler-catch-up" name="catch_up_window" value="{{.catch_up}}" required aria-describedby="scheduler-catch-up-help">
        <p class="help-text" id="scheduler-catch-up-help">{{t $lang "admin.scheduler.catch_up_window_help"}}</p>
      </div>
      <button type="submit" class="btn btn-primary">{{t $lang "admin.scheduler.save_action"}}</button>
    </form>
  </section>
{{template "admin_footer" .}}
