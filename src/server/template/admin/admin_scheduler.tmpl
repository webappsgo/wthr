{{define "admin/admin_scheduler.tmpl"}}
{{template "head" .}}
{{template "admin_header" .}}
{{- $lang := "en" -}}
{{- if .lang}}{{$lang = .lang}}{{end -}}
    <div class="content-header">
        <h1>{{t $lang "admin.scheduler.title"}}</h1>
    </div>

    <div class="admin-page-container">
        <div class="admin-alert admin-alert-success" id="successAlert" role="alert"></div>
        <div class="admin-alert admin-alert-error" id="errorAlert" role="alert"></div>

        <form id="schedulerForm" method="POST" action="{{.admin_path}}/config/scheduler">
    <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
            <!-- Global Settings -->
            <div class="admin-page-card">
                <h2>{{t $lang "admin.scheduler.global_settings_heading"}}</h2>

                <div class="form-row">
                    <div class="form-group">
                        <label for="timezone">
                            {{t $lang "admin.scheduler.timezone_label"}}
                            <span class="help-icon" title="{{t $lang "admin.scheduler.timezone_hint"}}">i</span>
                        </label>
                        <select name="timezone" id="timezone">
                            <option value="America/New_York" {{if eq .config.Timezone "America/New_York"}}selected{{end}}>America/New_York (EST/EDT)</option>
                            <option value="America/Chicago" {{if eq .config.Timezone "America/Chicago"}}selected{{end}}>America/Chicago (CST/CDT)</option>
                            <option value="America/Denver" {{if eq .config.Timezone "America/Denver"}}selected{{end}}>America/Denver (MST/MDT)</option>
                            <option value="America/Los_Angeles" {{if eq .config.Timezone "America/Los_Angeles"}}selected{{end}}>America/Los_Angeles (PST/PDT)</option>
                            <option value="UTC" {{if eq .config.Timezone "UTC"}}selected{{end}}>UTC</option>
                            <option value="Europe/London" {{if eq .config.Timezone "Europe/London"}}selected{{end}}>Europe/London (GMT/BST)</option>
                            <option value="Europe/Paris" {{if eq .config.Timezone "Europe/Paris"}}selected{{end}}>Europe/Paris (CET/CEST)</option>
                            <option value="Asia/Tokyo" {{if eq .config.Timezone "Asia/Tokyo"}}selected{{end}}>Asia/Tokyo (JST)</option>
                            <option value="Asia/Shanghai" {{if eq .config.Timezone "Asia/Shanghai"}}selected{{end}}>Asia/Shanghai (CST)</option>
                            <option value="Australia/Sydney" {{if eq .config.Timezone "Australia/Sydney"}}selected{{end}}>Australia/Sydney (AEDT/AEST)</option>
                        </select>
                        <div class="help-text">{{t $lang "admin.scheduler.timezone_help"}}</div>
                    </div>

                    <div class="form-group">
                        <label for="catch_up_window">
                            {{t $lang "admin.scheduler.catch_up_window_label"}}
                            <span class="help-icon" title="{{t $lang "admin.scheduler.catch_up_window_hint"}}">i</span>
                        </label>
                        <input type="text" name="catch_up_window" id="catch_up_window"
                               value="{{.config.CatchUpWindow}}"
                               placeholder="1h">
                        <div class="help-text">{{t $lang "admin.scheduler.catch_up_window_help"}}</div>
                    </div>
                </div>
            </div>

            <!-- Security Tasks -->
            <div class="admin-page-card">
                <h2>{{t $lang "admin.scheduler.tasks_heading"}}</h2>

                <div class="task-category">{{t $lang "admin.scheduler.category_security"}}</div>

                <!-- SSL Renewal -->
                <div class="task-section critical">
                    <h3>
                        <span>{{t $lang "admin.scheduler.ssl_renewal_title"}}</span>
                        <span class="warning-badge">{{t $lang "admin.scheduler.critical_badge"}}</span>
                    </h3>

                    <div class="form-row">
                        <div class="form-group">
                            <label class="toggle-label">
                                <span>{{t $lang "admin.scheduler.enabled_label"}}</span>
                                <label class="toggle-switch">
                                    <input type="checkbox" name="ssl_renewal.enabled" checked disabled>
                                    <span class="toggle-slider"></span>
                                </label>
                            </label>
                        </div>

                        <div class="form-group">
                            <label for="ssl_renewal_schedule">{{t $lang "admin.scheduler.schedule_label"}}</label>
                            <input type="text"
                                   name="ssl_renewal.schedule"
                                   id="ssl_renewal_schedule"
                                   value="{{.config.Tasks.SSLRenewal.Schedule}}"
                                   placeholder="0 3 * * *"
                                   class="cron-schedule-input" data-task-id="ssl_renewal">
                            <div class="help-text">{{t $lang "admin.scheduler.ssl_renewal_help"}}</div>
                            <div class="cron-preview" id="ssl_renewal_preview" class="hidden"></div>
                        </div>
                    </div>
                </div>

                <!-- GeoIP Update -->
                <div class="task-section">
                    <h3>{{t $lang "admin.scheduler.geoip_title"}}</h3>

                    <div class="form-row">
                        <div class="form-group">
                            <label class="toggle-label">
                                <span>{{t $lang "admin.scheduler.enabled_label"}}</span>
                                <label class="toggle-switch">
                                    <input type="checkbox" name="geoip_update.enabled"
                                           {{if .config.Tasks.GeoIPUpdate.Enabled}}checked{{end}}>
                                    <span class="toggle-slider"></span>
                                </label>
                            </label>
                        </div>

                        <div class="form-group">
                            <label for="geoip_update_schedule">{{t $lang "admin.scheduler.schedule_label"}}</label>
                            <input type="text"
                                   name="geoip_update.schedule"
                                   id="geoip_update_schedule"
                                   value="{{.config.Tasks.GeoIPUpdate.Schedule}}"
                                   placeholder="0 3 * * 0"
                                   class="cron-schedule-input" data-task-id="geoip_update">
                            <div class="help-text">{{t $lang "admin.scheduler.geoip_help"}}</div>
                            <div class="cron-preview" id="geoip_update_preview" class="hidden"></div>
                        </div>
                    </div>
                </div>

                <div class="task-category">{{t $lang "admin.scheduler.category_threat_intel"}}</div>

                <!-- Blocklist Update -->
                <div class="task-section">
                    <h3>{{t $lang "admin.scheduler.blocklist_title"}}</h3>

                    <div class="form-row">
                        <div class="form-group">
                            <label class="toggle-label">
                                <span>{{t $lang "admin.scheduler.enabled_label"}}</span>
                                <label class="toggle-switch">
                                    <input type="checkbox" name="blocklist_update.enabled"
                                           {{if .config.Tasks.BlocklistUpdate.Enabled}}checked{{end}}>
                                    <span class="toggle-slider"></span>
                                </label>
                            </label>
                        </div>

                        <div class="form-group">
                            <label for="blocklist_update_schedule">{{t $lang "admin.scheduler.schedule_label"}}</label>
                            <input type="text"
                                   name="blocklist_update.schedule"
                                   id="blocklist_update_schedule"
                                   value="{{.config.Tasks.BlocklistUpdate.Schedule}}"
                                   placeholder="0 4 * * *"
                                   class="cron-schedule-input" data-task-id="blocklist_update">
                            <div class="help-text">{{t $lang "admin.scheduler.blocklist_help"}}</div>
                            <div class="cron-preview" id="blocklist_update_preview" class="hidden"></div>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label class="toggle-label">
                                <span>{{t $lang "admin.scheduler.retry_on_fail_label"}}</span>
                                <label class="toggle-switch">
                                    <input type="checkbox" name="blocklist_update.retry_on_fail"
                                           {{if .config.Tasks.BlocklistUpdate.RetryOnFail}}checked{{end}}>
                                    <span class="toggle-slider"></span>
                                </label>
                            </label>
                        </div>

                        <div class="form-group">
                            <label for="blocklist_update_retry_delay">{{t $lang "admin.scheduler.retry_delay_label"}}</label>
                            <input type="text"
                                   name="blocklist_update.retry_delay"
                                   id="blocklist_update_retry_delay"
                                   value="{{.config.Tasks.BlocklistUpdate.RetryDelay}}"
                                   placeholder="1h">
                            <div class="help-text">{{t $lang "admin.scheduler.retry_delay_help"}}</div>
                        </div>
                    </div>
                </div>

                <!-- CVE Update -->
                <div class="task-section">
                    <h3>{{t $lang "admin.scheduler.cve_title"}}</h3>

                    <div class="form-row">
                        <div class="form-group">
                            <label class="toggle-label">
                                <span>{{t $lang "admin.scheduler.enabled_label"}}</span>
                                <label class="toggle-switch">
                                    <input type="checkbox" name="cve_update.enabled"
                                           {{if .config.Tasks.CVEUpdate.Enabled}}checked{{end}}>
                                    <span class="toggle-slider"></span>
                                </label>
                            </label>
                        </div>

                        <div class="form-group">
                            <label for="cve_update_schedule">{{t $lang "admin.scheduler.schedule_label"}}</label>
                            <input type="text"
                                   name="cve_update.schedule"
                                   id="cve_update_schedule"
                                   value="{{.config.Tasks.CVEUpdate.Schedule}}"
                                   placeholder="0 5 * * *"
                                   class="cron-schedule-input" data-task-id="cve_update">
                            <div class="help-text">{{t $lang "admin.scheduler.cve_help"}}</div>
                            <div class="cron-preview" id="cve_update_preview" class="hidden"></div>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label class="toggle-label">
                                <span>{{t $lang "admin.scheduler.retry_on_fail_label"}}</span>
                                <label class="toggle-switch">
                                    <input type="checkbox" name="cve_update.retry_on_fail"
                                           {{if .config.Tasks.CVEUpdate.RetryOnFail}}checked{{end}}>
                                    <span class="toggle-slider"></span>
                                </label>
                            </label>
                        </div>

                        <div class="form-group">
                            <label for="cve_update_retry_delay">{{t $lang "admin.scheduler.retry_delay_label"}}</label>
                            <input type="text"
                                   name="cve_update.retry_delay"
                                   id="cve_update_retry_delay"
                                   value="{{.config.Tasks.CVEUpdate.RetryDelay}}"
                                   placeholder="1h">
                            <div class="help-text">{{t $lang "admin.scheduler.retry_delay_help"}}</div>
                        </div>
                    </div>
                </div>

                <div class="task-category">{{t $lang "admin.scheduler.category_maintenance"}}</div>

                <!-- Session Cleanup -->
                <div class="task-section">
                    <h3>{{t $lang "admin.scheduler.session_cleanup_title"}}</h3>

                    <div class="form-row">
                        <div class="form-group">
                            <label class="toggle-label">
                                <span>{{t $lang "admin.scheduler.enabled_label"}}</span>
                                <label class="toggle-switch">
                                    <input type="checkbox" name="session_cleanup.enabled"
                                           {{if .config.Tasks.SessionCleanup.Enabled}}checked{{end}}>
                                    <span class="toggle-slider"></span>
                                </label>
                            </label>
                        </div>

                        <div class="form-group">
                            <label for="session_cleanup_schedule">{{t $lang "admin.scheduler.schedule_label"}}</label>
                            <input type="text"
                                   name="session_cleanup.schedule"
                                   id="session_cleanup_schedule"
                                   value="{{.config.Tasks.SessionCleanup.Schedule}}"
                                   placeholder="@hourly"
                                   class="cron-schedule-input" data-task-id="session_cleanup">
                            <div class="help-text">{{t $lang "admin.scheduler.session_cleanup_help"}}</div>
                            <div class="cron-preview" id="session_cleanup_preview" class="hidden"></div>
                        </div>
                    </div>
                </div>

                <!-- Token Cleanup -->
                <div class="task-section">
                    <h3>{{t $lang "admin.scheduler.token_cleanup_title"}}</h3>

                    <div class="form-row">
                        <div class="form-group">
                            <label class="toggle-label">
                                <span>{{t $lang "admin.scheduler.enabled_label"}}</span>
                                <label class="toggle-switch">
                                    <input type="checkbox" name="token_cleanup.enabled"
                                           {{if .config.Tasks.TokenCleanup.Enabled}}checked{{end}}>
                                    <span class="toggle-slider"></span>
                                </label>
                            </label>
                        </div>

                        <div class="form-group">
                            <label for="token_cleanup_schedule">{{t $lang "admin.scheduler.schedule_label"}}</label>
                            <input type="text"
                                   name="token_cleanup.schedule"
                                   id="token_cleanup_schedule"
                                   value="{{.config.Tasks.TokenCleanup.Schedule}}"
                                   placeholder="0 6 * * *"
                                   class="cron-schedule-input" data-task-id="token_cleanup">
                            <div class="help-text">{{t $lang "admin.scheduler.token_cleanup_help"}}</div>
                            <div class="cron-preview" id="token_cleanup_preview" class="hidden"></div>
                        </div>
                    </div>
                </div>

                <!-- Log Rotation -->
                <div class="task-section">
                    <h3>{{t $lang "admin.scheduler.log_rotation_title"}}</h3>

                    <div class="form-row">
                        <div class="form-group">
                            <label class="toggle-label">
                                <span>{{t $lang "admin.scheduler.enabled_label"}}</span>
                                <label class="toggle-switch">
                                    <input type="checkbox" name="log_rotation.enabled"
                                           {{if .config.Tasks.LogRotation.Enabled}}checked{{end}}>
                                    <span class="toggle-slider"></span>
                                </label>
                            </label>
                        </div>

                        <div class="form-group">
                            <label for="log_rotation_schedule">{{t $lang "admin.scheduler.schedule_label"}}</label>
                            <input type="text"
                                   name="log_rotation.schedule"
                                   id="log_rotation_schedule"
                                   value="{{.config.Tasks.LogRotation.Schedule}}"
                                   placeholder="0 0 * * *"
                                   class="cron-schedule-input" data-task-id="log_rotation">
                            <div class="help-text">{{t $lang "admin.scheduler.log_rotation_help"}}</div>
                            <div class="cron-preview" id="log_rotation_preview" class="hidden"></div>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="log_rotation_max_age">{{t $lang "admin.scheduler.max_age_label"}}</label>
                            <input type="text"
                                   name="log_rotation.max_age"
                                   id="log_rotation_max_age"
                                   value="{{.config.Tasks.LogRotation.MaxAge}}"
                                   placeholder="30d">
                            <div class="help-text">{{t $lang "admin.scheduler.max_age_help"}}</div>
                        </div>

                        <div class="form-group">
                            <label for="log_rotation_max_size">{{t $lang "admin.scheduler.max_size_label"}}</label>
                            <input type="text"
                                   name="log_rotation.max_size"
                                   id="log_rotation_max_size"
                                   value="{{.config.Tasks.LogRotation.MaxSize}}"
                                   placeholder="100MB">
                            <div class="help-text">{{t $lang "admin.scheduler.max_size_help"}}</div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="toggle-label">
                            <span>{{t $lang "admin.scheduler.compress_label"}}</span>
                            <label class="toggle-switch">
                                <input type="checkbox" name="log_rotation.compress"
                                       {{if .config.Tasks.LogRotation.Compress}}checked{{end}}>
                                <span class="toggle-slider"></span>
                            </label>
                        </label>
                    </div>
                </div>

                <div class="task-category">{{t $lang "admin.scheduler.category_health"}}</div>

                <!-- Self Health Check -->
                <div class="task-section">
                    <h3>{{t $lang "admin.scheduler.healthcheck_title"}}</h3>

                    <div class="form-row">
                        <div class="form-group">
                            <label class="toggle-label">
                                <span>{{t $lang "admin.scheduler.enabled_label"}}</span>
                                <label class="toggle-switch">
                                    <input type="checkbox" name="healthcheck_self.enabled"
                                           {{if .config.Tasks.HealthcheckSelf.Enabled}}checked{{end}}>
                                    <span class="toggle-slider"></span>
                                </label>
                            </label>
                        </div>

                        <div class="form-group">
                            <label for="healthcheck_self_schedule">{{t $lang "admin.scheduler.schedule_label"}}</label>
                            <input type="text"
                                   name="healthcheck_self.schedule"
                                   id="healthcheck_self_schedule"
                                   value="{{.config.Tasks.HealthcheckSelf.Schedule}}"
                                   placeholder="@every 5m"
                                   class="cron-schedule-input" data-task-id="healthcheck_self">
                            <div class="help-text">{{t $lang "admin.scheduler.healthcheck_help"}}</div>
                            <div class="cron-preview" id="healthcheck_self_preview" class="hidden"></div>
                        </div>
                    </div>
                </div>

                <!-- Tor Health Check -->
                <div class="task-section">
                    <h3>{{t $lang "admin.scheduler.tor_health_title"}}</h3>

                    <div class="form-row">
                        <div class="form-group">
                            <label class="toggle-label">
                                <span>{{t $lang "admin.scheduler.enabled_label"}}</span>
                                <label class="toggle-switch">
                                    <input type="checkbox" name="tor_health.enabled"
                                           {{if .config.Tasks.TorHealth.Enabled}}checked{{end}}>
                                    <span class="toggle-slider"></span>
                                </label>
                            </label>
                        </div>

                        <div class="form-group">
                            <label for="tor_health_schedule">{{t $lang "admin.scheduler.schedule_label"}}</label>
                            <input type="text"
                                   name="tor_health.schedule"
                                   id="tor_health_schedule"
                                   value="{{.config.Tasks.TorHealth.Schedule}}"
                                   placeholder="@every 10m"
                                   class="cron-schedule-input" data-task-id="tor_health">
                            <div class="help-text">{{t $lang "admin.scheduler.tor_health_help"}}</div>
                            <div class="cron-preview" id="tor_health_preview" class="hidden"></div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="toggle-label">
                            <span>{{t $lang "admin.scheduler.auto_restart_label"}}</span>
                            <label class="toggle-switch">
                                <input type="checkbox" name="tor_health.restart_on_fail"
                                       {{if .config.Tasks.TorHealth.RestartOnFail}}checked{{end}}>
                                <span class="toggle-slider"></span>
                            </label>
                        </label>
                    </div>
                </div>
            </div>

            <div class="btn-group">
                <button type="submit" class="btn btn-primary">{{t $lang "admin.scheduler.save_action"}}</button>
                <a href="{{.admin_path}}/config/scheduler" class="btn btn-secondary">{{t $lang "action.cancel"}}</a>
            </div>
        </form>
    </div>

    <script type="application/json" id="admin-scheduler-data">{"adminPath": {{.admin_path}}}</script>
    <script src="/static/js/app.js"></script>
{{template "admin_footer" .}}
{{end}}
