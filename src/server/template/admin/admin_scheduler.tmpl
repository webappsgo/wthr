                        <label for="catch_up_window">
                            {{t $lang "admin.scheduler.catch_up_window_label"}}
                            <span class="help-icon" title="{{t $lang "admin.scheduler.catch_up_window_hint"}}">i</span>
                        </label>
                        <input type="text" name="catch_up_window" id="catch_up_window"
