{{define "admin/admin_scheduler.tmpl"}}
{{template "head" .}}
{{template "admin_header" .}}
{{- $lang := "en" -}}
{{- if .lang}}{{$lang = .lang}}{{end -}}
    <div class="content-header">
        <h1>{{t $lang "admin.scheduler.title"}}</h1>
    </div>

    <div class="admin-page-container">
        <div class="admin-alert admin-alert-success" id="successAlert" role="alert"></div>
        <div class="admin-alert admin-alert-error" id="errorAlert" role="alert"></div>

        <form id="schedulerForm" method="POST" action="{{.admin_path}}/config/scheduler">
    <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
            <!-- Global Settings -->
