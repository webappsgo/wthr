{{define "admin/admin_ssl.tmpl"}}
{{template "head" .}}
{{template "admin_header" .}}
{{- $lang := "en" -}}
{{- if .lang}}{{$lang = .lang}}{{end -}}

    <h1>🔒 {{t $lang "admin.ssl.title"}}</h1>
    <p class="text-comment mb-4">{{t $lang "admin.ssl.subtitle"}}</p>
    {{if .flash}}<p class="flash flash-{{.flash.Kind}}" role="status" aria-live="polite">{{t $lang .flash.Key}}</p>{{end}}

    <section class="card p-4 mb-4" aria-labelledby="ssl-renewal-heading">
        <h2 id="ssl-renewal-heading" class="section-title">{{t $lang "admin.ssl.auto_renewal_heading"}}</h2>
        <form method="post" action="/server/{{.admin_path}}/ssl/auto-renew">
            <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
            <label for="auto-renew-domains">{{t $lang "admin.ssl.auto_renew_domains_label"}}</label>
            <textarea id="auto-renew-domains" name="domains" rows="3" required aria-describedby="auto-renew-domains-hint"></textarea>
            <p id="auto-renew-domains-hint" class="form-help">{{t $lang "admin.ssl.auto_renew_domains_hint"}}</p>
            <label for="auto-renew-challenge">{{t $lang "admin.ssl.challenge_label"}}</label>
            <select id="auto-renew-challenge" name="challengeType" required>
                <option value="http-01">{{t $lang "admin.ssl.challenge_http01"}}</option>
                <option value="tls-alpn-01">{{t $lang "admin.ssl.challenge_tlsalpn01"}}</option>
                <option value="dns-01">{{t $lang "admin.ssl.challenge_dns01"}}</option>
            </select>
            <button type="submit">{{t $lang "admin.ssl.auto_renew_submit"}}</button>
        </form>
    </section>

    <section class="card p-4 mb-4" aria-labelledby="ssl-revoke-heading">
        <h2 id="ssl-revoke-heading" class="section-title">{{t $lang "admin.ssl.revoke_cert_action"}}</h2>
        <form method="post" action="/server/{{.admin_path}}/ssl/revoke">
            <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
            <label for="revoke-domain">{{t $lang "admin.ssl.revoke_domain_label"}}</label>
            <input id="revoke-domain" name="domain" type="text" required>
            <button type="button" popovertarget="ssl-revoke-confirm">{{t $lang "admin.ssl.revoke_cert_action"}}</button>
            <div id="ssl-revoke-confirm" popover>
                <p>{{t $lang "admin.ssl.revoke_confirmation"}}</p>
                <button type="submit">{{t $lang "admin.ssl.revoke_cert_action"}}</button>
                <button type="button" popovertarget="ssl-revoke-confirm" popovertargetaction="hide">{{t $lang "action.cancel"}}</button>
            </div>
        </form>
    </section>

    <div class="grid-2 gap-lg">
        <section class="card p-4">
            <h2 class="section-title">📜 {{t $lang "admin.ssl.cert_status_heading"}}</h2>

            <div id="certStatus" role="status" aria-live="polite">
                <div class="text-center p-4 text-comment">
                    <div class="loading"></div>
                    <p class="mt-3">{{t $lang "admin.ssl.loading_cert_info"}}</p>
                </div>
            </div>

            <div class="flex gap-sm mt-3">
                <button type="button" class="btn btn-primary" id="refreshBtn" aria-label="{{t $lang "admin.ssl.refresh_cert_aria"}}">
                    🔄 {{t $lang "action.refresh"}}
                </button>
                <button type="button" class="btn btn-success" id="verifyBtn" aria-label="{{t $lang "admin.ssl.verify_cert_aria"}}">
                    ✓ {{t $lang "admin.ssl.verify_cert_action"}}
                </button>
            </div>
        </section>

        <section class="card p-4">
            <h2 class="section-title">🌐 {{t $lang "admin.ssl.lets_encrypt_heading"}}</h2>

            <form id="letsEncryptForm" method="post" action="{{.admin_path}}/ssl/obtain">
                <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
                <div class="form-group">
                    <label for="domain" class="form-label">{{t $lang "admin.ssl.domain_name_label"}}</label>
                    <input type="text" id="domain" name="domain" class="form-input" placeholder="example.com" required aria-required="true">
                    <small class="form-help">{{t $lang "admin.ssl.domain_name_hint"}}</small>
                </div>

                <div class="form-group">
                    <label for="email" class="form-label">{{t $lang "admin.ssl.contact_email_label"}}</label>
                    <input type="email" id="email" name="email" class="form-input" placeholder="admin@example.com" required aria-required="true">
                    <small class="form-help">{{t $lang "admin.ssl.contact_email_hint"}}</small>
                </div>

                <div class="form-group">
                    <label for="altNames" class="form-label">{{t $lang "admin.ssl.alt_names_label"}}</label>
                    <textarea id="altNames" name="altNames" class="form-textarea" rows="3" placeholder="www.example.com&#10;api.example.com"></textarea>
                    <small class="form-help">{{t $lang "admin.ssl.alt_names_hint"}}</small>
                </div>

                <div class="form-group">
                    <label for="challengeType" class="form-label">{{t $lang "admin.ssl.challenge_label"}}</label>
                    <select id="challengeType" name="challengeType" class="form-select">
                        <option value="http-01">{{t $lang "admin.ssl.challenge_http01"}}</option>
                        <option value="tls-alpn-01">{{t $lang "admin.ssl.challenge_tlsalpn01"}}</option>
                        <option value="dns-01">{{t $lang "admin.ssl.challenge_dns01"}}</option>
                    </select>
                </div>

                <div class="form-group">
                    <label class="checkbox-row">
                        <input type="checkbox" id="staging" name="staging" value="true">
                        <span>{{t $lang "admin.ssl.staging_label"}}</span>
                    </label>
                </div>

                <div class="form-group">
                    <label class="checkbox-row">
                        <input type="checkbox" id="agreeToS" required>
                        <span>{{t $lang "admin.ssl.agree_tos_label"}}</span>
                    </label>
                </div>

                <div class="flex gap-sm">
                    <button type="submit" class="btn btn-success" id="obtainBtn">
                        🔐 {{t $lang "admin.ssl.obtain_cert_action"}}
                    </button>
                    <button type="button" class="btn btn-warning" id="renewBtn">
                        🔄 {{t $lang "admin.ssl.renew_cert_action"}}
                    </button>
                </div>
            </form>
            <noscript>
                <form method="post" action="{{.admin_path}}/ssl/renew">
                    <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
                    <label for="renew-domain">{{t $lang "admin.ssl.domain_name_label"}}</label>
                    <input id="renew-domain" name="domain" type="text" required>
                    <label for="renew-challenge">{{t $lang "admin.ssl.challenge_label"}}</label>
                    <select id="renew-challenge" name="challengeType" required>
                        <option value="http-01">{{t $lang "admin.ssl.challenge_http01"}}</option>
                        <option value="tls-alpn-01">{{t $lang "admin.ssl.challenge_tlsalpn01"}}</option>
                        <option value="dns-01">{{t $lang "admin.ssl.challenge_dns01"}}</option>
                    </select>
                    <button type="submit" class="btn btn-warning">{{t $lang "admin.ssl.renew_cert_action"}}</button>
                </form>
            </noscript>
        </section>
    </div>

    <section class="card p-4 mt-4" id="dnsCard">
        <h2 class="section-title">🧩 {{t $lang "admin.ssl.dns_heading"}}</h2>
        <p class="text-comment mb-3">{{t $lang "admin.ssl.dns_intro"}}</p>

        <form id="dnsForm" method="post" action="{{.admin_path}}/ssl/dns">
            <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
            <div class="form-group">
                <label for="dnsProvider" class="form-label">{{t $lang "admin.ssl.dns_provider_label"}}</label>
                <select id="dnsProvider" name="provider" class="form-select">
                    <option value=""{{if not .dns_provider}} selected{{end}}>{{t $lang "admin.ssl.dns_provider_manual"}}</option>
                    {{range .dns_providers}}<option value="{{.}}"{{if eq . $.dns_provider}} selected{{end}}>{{.}}</option>{{end}}
                </select>
            </div>

            <div class="form-group">
                <label for="dnsCredentials">{{t $lang "admin.ssl.dns_variable_name"}}={{t $lang "admin.ssl.dns_variable_value"}}</label>
                <textarea id="dnsCredentials" name="credentials" rows="6" class="form-control" aria-describedby="dns-credentials-help">{{.dns_credentials_form}}</textarea>
                <small id="dns-credentials-help">{{t $lang "admin.ssl.dns_variable_stored_hint"}}</small>
            </div>

            <div class="flex gap-sm mt-2">
                <button type="button" class="btn btn-secondary" id="dnsVariableAdd" data-name-label="{{t $lang "admin.ssl.dns_variable_name"}}" data-value-label="{{t $lang "admin.ssl.dns_variable_value"}}">➕ {{t $lang "admin.ssl.dns_variable_add"}}</button>
                <button type="button" class="btn btn-secondary" id="dnsCheckBtn">🧪 {{t $lang "admin.ssl.dns_check_action"}}</button>
                <button type="submit" class="btn btn-primary" id="dnsSaveBtn">💾 {{t $lang "action.save"}}</button>
            </div>
            <p class="text-comment mt-2" id="dnsValidated" data-label="{{t $lang "admin.ssl.dns_validated_label"}}" role="status" aria-live="polite"></p>
        </form>
    </section>

<script type="application/json" id="admin-ssl-data">{"adminApiPath": {{.admin_api_path}}, "csrfToken": {{.csrf_token}}, "messages": {"load_failed": {{t $lang "admin.ssl.js.load_failed"}}, "obtained": {{t $lang "admin.ssl.js.obtained"}}, "renewed": {{t $lang "admin.ssl.js.renewed"}}, "valid": {{t $lang "admin.ssl.js.valid"}}, "request_failed": {{t $lang "admin.ssl.js.request_failed"}}, "check_variables": {{t $lang "admin.ssl.js.check_variables"}}, "confirm_renew": {{t $lang "admin.ssl.js.confirm_renew"}}, "no_certificate": {{t $lang "admin.ssl.js.no_certificate"}}, "subject": {{t $lang "admin.ssl.js.subject"}}, "issuer": {{t $lang "admin.ssl.js.issuer"}}, "valid_until": {{t $lang "admin.ssl.js.valid_until"}}, "days_remaining": {{t $lang "admin.ssl.js.days_remaining"}}}}</script>
<script src="{{asset "/static/js/app.js"}}"></script>

{{template "admin_footer" .}}
{{end}}
