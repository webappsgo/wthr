{{define "admin/admin_settings_form.tmpl"}}
{{template "head" .}}
{{template "admin_header" .}}
{{- $lang := "en" -}}
{{- if .lang}}{{$lang = .lang}}{{end -}}
{{- $ap := "/server/administration" -}}
{{- if .admin_path}}{{$ap = .admin_path}}{{end -}}
<div class="content-header">
  <h1>{{t $lang "admin.settings_form.title"}}</h1>
</div>

{{template "flash" .}}

<div class="admin-page-container wide">
  <nav class="admin-tabs" aria-label="{{t $lang "admin.settings_form.sections_aria"}}">
    {{range .sections}}
    <a class="admin-tab{{if eq .ID $.selected}} active{{end}}" href="{{$ap}}/settings?section={{.ID}}"{{if eq .ID $.selected}} aria-current="page"{{end}}>{{.Title}}</a>
    {{end}}
  </nav>

  {{range .sections}}
  {{if eq .ID $.selected}}
  <form class="settings-form" method="post" action="{{$ap}}/settings">
    <input type="hidden" name="csrf_token" value="{{$.csrf_token}}">
    <input type="hidden" name="section" value="{{.ID}}">

    <section class="admin-section" aria-labelledby="settings-{{.ID}}-heading">
      <div class="section-header">
        <h2 id="settings-{{.ID}}-heading">{{.Title}}</h2>
      </div>

      {{range .Fields}}
      <div class="form-group settings-field">
        {{if eq .Control "toggle"}}
        <input type="hidden" name="{{.Key}}" value="false">
        <label class="toggle-label" for="f-{{.Key}}">
          <span class="toggle-switch">
            <input type="checkbox" id="f-{{.Key}}" name="{{.Key}}" value="true"{{if .Checked}} checked{{end}}{{if .Description}} aria-describedby="d-{{.Key}}"{{end}}>
            <span class="toggle-slider" aria-hidden="true"></span>
          </span>
          <span class="toggle-text">{{.Label}}</span>
        </label>
        {{else}}
        <label class="form-label" for="f-{{.Key}}">{{.Label}}</label>
        {{if eq .Control "select"}}
        <select class="form-input" id="f-{{.Key}}" name="{{.Key}}"{{if .Description}} aria-describedby="d-{{.Key}}"{{end}}>
          {{$value := .Value}}
          {{range .Options}}<option value="{{.}}"{{if eq . $value}} selected{{end}}>{{.}}</option>{{end}}
        </select>
        {{else if eq .Control "textarea"}}
        <textarea class="form-input" id="f-{{.Key}}" name="{{.Key}}" rows="4"{{if .Description}} aria-describedby="d-{{.Key}}"{{end}}>{{.Value}}</textarea>
        {{else if eq .Control "number"}}
        <input class="form-input" type="number" step="any" id="f-{{.Key}}" name="{{.Key}}" value="{{.Value}}"{{if .Description}} aria-describedby="d-{{.Key}}"{{end}}>
        {{else if eq .Control "password"}}
        <input class="form-input" type="password" id="f-{{.Key}}" name="{{.Key}}" value="" autocomplete="new-password" placeholder="{{t $lang "admin.settings_form.secret_placeholder"}}"{{if .Description}} aria-describedby="d-{{.Key}}"{{end}}>
        {{else}}
        <input class="form-input" type="text" id="f-{{.Key}}" name="{{.Key}}" value="{{.Value}}"{{if .Description}} aria-describedby="d-{{.Key}}"{{end}}>
        {{end}}
        {{end}}
        {{if .Description}}<small class="form-help" id="d-{{.Key}}">{{.Description}}</small>{{end}}
        {{if .Restart}}<small class="form-help settings-restart"><span aria-hidden="true">&#9888;</span> {{t $lang "admin.settings_form.restart_required"}}</small>{{end}}
      </div>
      {{end}}
    </section>

    <div class="form-actions">
      <a class="btn btn-secondary" href="{{$ap}}/settings?section={{.ID}}">{{t $lang "admin.settings_form.cancel"}}</a>
      <button type="submit" class="btn btn-primary">{{t $lang "admin.settings_form.save"}}</button>
    </div>
  </form>
  {{end}}
  {{end}}
</div>
<script src="{{asset "/static/js/app.js"}}"></script>
{{template "admin_footer" .}}
{{end}}
