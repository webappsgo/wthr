{{define "admin/admin_passkey_login.tmpl"}}
{{- $lang := "en" -}}
{{- if .lang}}{{$lang = .lang}}{{end -}}
<!DOCTYPE html>
<html lang="{{$lang}}" class="{{if .server.ThemeClass}}{{.server.ThemeClass}}{{else}}theme-dark{{end}}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{t $lang "admin.passkey_login.heading"}} — {{.app_name}}</title>
    <link rel="stylesheet" href="/static/css/common.css">
    <link rel="stylesheet" href="/static/css/components.css">
    <link rel="stylesheet" href="/static/css/admin.css">
    <style>
        body {
            background: var(--color-bg, #0f1117);
            color: var(--color-text, #e2e8f0);
            font-family: system-ui, -apple-system, sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            margin: 0;
            padding: 1rem;
        }
        .passkey-card {
            background: var(--color-surface, #1a1f2e);
            border: 1px solid var(--color-border, #2d3748);
            border-radius: 12px;
            padding: 2.5rem;
            max-width: 440px;
            width: 100%;
            text-align: center;
        }
        .passkey-icon {
            font-size: 3rem;
            margin-bottom: 1rem;
        }
        h1 {
            font-size: 1.5rem;
            font-weight: 600;
            margin: 0 0 0.5rem;
            color: var(--color-heading, #f7fafc);
        }
        .subtitle {
            color: var(--color-muted, #a0aec0);
            font-size: 0.95rem;
            margin-bottom: 2rem;
        }
        .status-box {
            border-radius: 8px;
            padding: 1rem 1.25rem;
            font-size: 0.9rem;
            margin-bottom: 1.5rem;
            text-align: left;
        }
        .status-info {
            background: rgba(66, 153, 225, 0.1);
            border: 1px solid rgba(66, 153, 225, 0.3);
            color: #63b3ed;
        }
        .status-success {
            background: rgba(72, 187, 120, 0.1);
            border: 1px solid rgba(72, 187, 120, 0.3);
            color: #68d391;
        }
        .status-error {
            background: rgba(245, 101, 101, 0.1);
            border: 1px solid rgba(245, 101, 101, 0.3);
            color: #fc8181;
        }
        .spinner {
            display: inline-block;
            width: 1em;
            height: 1em;
            border: 2px solid currentColor;
            border-right-color: transparent;
            border-radius: 50%;
            animation: spin 0.75s linear infinite;
            vertical-align: middle;
            margin-right: 0.4em;
        }
        @keyframes spin { to { transform: rotate(360deg); } }
        .back-link {
            display: inline-block;
            margin-top: 0.5rem;
            color: var(--color-link, #63b3ed);
            text-decoration: none;
            font-size: 0.9rem;
        }
        .back-link:hover { text-decoration: underline; }
    </style>
</head>
<body>
    <div class="passkey-card">
        <div class="passkey-icon">🔑</div>
        <h1>{{t $lang "admin.passkey_login.heading"}}</h1>
        <p class="subtitle">{{t $lang "admin.passkey_login.subtitle"}}</p>

        {{if .error}}
        <div class="status-box status-error">{{.error}}</div>
        <a href="/server/auth/login" class="back-link">← {{t $lang "admin.passkey_login.back_link"}}</a>
        {{else}}
        <div id="passkeyStatus" class="status-box status-info">
            <span class="spinner"></span> {{t $lang "admin.passkey_login.starting_status"}}
        </div>
        <a href="/server/auth/login" class="back-link">← {{t $lang "admin.passkey_login.back_link"}}</a>

        <script>
        (function () {
            'use strict';

            var pendingToken = {{.pending_session_token | js}};
            var adminPath   = {{.admin_path | js}};

            function bufferToBase64url(buffer) {
                var bytes = new Uint8Array(buffer);
                var binary = '';
                for (var i = 0; i < bytes.byteLength; i++) binary += String.fromCharCode(bytes[i]);
                return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/g, '');
            }

            function base64urlToBuffer(b64url) {
                var padded = (b64url + '==='.slice((b64url.length + 3) % 4))
                    .replace(/-/g, '+').replace(/_/g, '/');
                var binary = atob(padded);
                var bytes = new Uint8Array(binary.length);
                for (var i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
                return bytes.buffer;
            }

            function normalizeOptions(options) {
                var pk = options.publicKey || options;
                pk.challenge = base64urlToBuffer(pk.challenge);
                if (Array.isArray(pk.allowCredentials)) {
                    pk.allowCredentials = pk.allowCredentials.map(function (cred) {
                        return Object.assign({}, cred, { id: base64urlToBuffer(cred.id) });
                    });
                }
                return pk;
            }

            function serializeAssertion(assertion, ceremonyToken) {
                return {
                    ceremony_token: ceremonyToken,
                    id:    assertion.id,
                    rawId: bufferToBase64url(assertion.rawId),
                    type:  assertion.type,
                    response: {
                        authenticatorData: bufferToBase64url(assertion.response.authenticatorData),
                        clientDataJSON:    bufferToBase64url(assertion.response.clientDataJSON),
                        signature:         bufferToBase64url(assertion.response.signature),
                        userHandle: assertion.response.userHandle
                            ? bufferToBase64url(assertion.response.userHandle)
                            : null,
                    },
                };
            }

            function setStatus(msg, cls) {
                var box = document.getElementById('passkeyStatus');
                if (!box) return;
                box.className = 'status-box ' + cls;
                box.innerHTML = msg;
            }

            async function run() {
                if (!pendingToken) {
                    setStatus('Session expired or invalid. <a href="/server/auth/login" style="color:inherit;text-decoration:underline">Please log in again.</a>', 'status-error');
                    return;
                }
                if (!window.PublicKeyCredential || !navigator.credentials || !navigator.credentials.get) {
                    setStatus('This browser does not support passkeys. Please use a modern browser.', 'status-error');
                    return;
                }

                try {
                    // Step 1 — fetch WebAuthn challenge options
                    var challengeResp = await fetch('/api/v1/server/auth/admin/passkey/challenge', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ session_token: pendingToken }),
                    });
                    var challengeData = await challengeResp.json();
                    if (!challengeResp.ok || !challengeData.ok) {
                        throw new Error(challengeData.error || 'Failed to start passkey authentication');
                    }

                    setStatus('<span class="spinner"></span> Touch your security key or use your device passkey to continue…', 'status-info');

                    // Step 2 — prompt the browser for the passkey
                    var credential = await navigator.credentials.get({
                        publicKey: normalizeOptions(challengeData.options),
                    });
                    if (!credential) {
                        throw new Error('Passkey authentication was cancelled');
                    }

                    setStatus('<span class="spinner"></span> Verifying credential…', 'status-info');

                    // Step 3 — verify with the server
                    var payload = serializeAssertion(credential, challengeData.ceremony_token);
                    var verifyResp = await fetch('/api/v1/server/auth/admin/passkey/verify', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload),
                    });
                    var verifyData = await verifyResp.json();
                    if (!verifyResp.ok || !verifyData.ok) {
                        throw new Error(verifyData.error || 'Passkey verification failed');
                    }

                    setStatus('Authentication successful. Redirecting…', 'status-success');
                    window.location.href = '/' + adminPath + '/dashboard';

                } catch (err) {
                    setStatus('Passkey authentication failed: ' + (err.message || String(err)) +
                        ' <a href="/server/auth/login" style="color:inherit;text-decoration:underline">Try again</a>', 'status-error');
                }
            }

            run();
        })();
        </script>
        {{end}}
    </div>
</body>
</html>
{{end}}
