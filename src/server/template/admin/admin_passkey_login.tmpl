{{define "admin/admin_passkey_login.tmpl"}}
{{- $lang := "en" -}}
{{- if .lang}}{{$lang = .lang}}{{end -}}
<!DOCTYPE html>
<html lang="{{$lang}}" dir="{{if eq $lang "ar"}}rtl{{else}}ltr{{end}}" class="{{if .server.ThemeClass}}{{.server.ThemeClass}}{{else}}theme-dark{{end}}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{t $lang "admin.passkey_login.heading"}} — {{.app_name}}</title>
    <link rel="stylesheet" href="{{asset "/static/css/common.css"}}">
    <link rel="stylesheet" href="{{asset "/static/css/components.css"}}">
    <link rel="stylesheet" href="{{asset "/static/css/admin.css"}}">
</head>
<body>
<a href="#main-content" class="skip-link">{{t $lang "aria.skip_to_main"}}</a>
<a href="#passkeyStatus" class="skip-link">{{t $lang "aria.skip_to_nav"}}</a>
    <main id="main-content">
      <div class="container container-sm">
        <header class="page-header"><h1 class="page-title">{{t $lang "admin.passkey_login.heading"}}</h1></header>
        <section class="section-card" aria-labelledby="admin-passkey-login-description">
            <h2 class="sr-only" id="admin-passkey-login-description">{{t $lang "admin.passkey_login.subtitle"}}</h2>
            <div class="auth-icon" aria-hidden="true">🔑</div>
            <p class="auth-subtitle">{{t $lang "admin.passkey_login.subtitle"}}</p>

            {{if .error}}
            <div class="alert alert-error" role="alert">{{.error}}</div>
            <div class="auth-links">
                <a href="/server/auth/login">← {{t $lang "admin.passkey_login.back_link"}}</a>
            </div>
            {{else}}
            <div id="passkeyStatus" class="alert alert-info" role="status" aria-live="polite">
                <span class="spinner spinner-sm" aria-hidden="true"></span> {{t $lang "admin.passkey_login.starting_status"}}
            </div>
            <div class="auth-links">
                <a href="/server/auth/login">← {{t $lang "admin.passkey_login.back_link"}}</a>
            </div>

            <textarea hidden id="admin-passkey-login-data">{"pendingToken": {{.pending_session_token}}, "adminPath": {{.admin_path}}}</textarea>
            <script src="{{asset "/static/js/app.js"}}"></script>
            {{end}}
        </section>
      </div>
    </main>
<footer class="admin-login-footer">{{t $lang "admin.footer.version"}} {{if .server}}{{.server.Version}}{{end}}</footer>
{{end}}
