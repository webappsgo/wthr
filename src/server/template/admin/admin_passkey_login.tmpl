{{define "admin/admin_passkey_login.tmpl"}}
{{- $lang := "en" -}}
{{- if .lang}}{{$lang = .lang}}{{end -}}
<!DOCTYPE html>
<html lang="{{$lang}}" dir="{{if eq $lang "ar"}}rtl{{else}}ltr{{end}}" class="{{if .server.ThemeClass}}{{.server.ThemeClass}}{{else}}theme-dark{{end}}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{t $lang "admin.passkey_login.heading"}} — {{.app_name}}</title>
    <link rel="stylesheet" href="/static/css/common.css">
    <link rel="stylesheet" href="/static/css/components.css">
    <link rel="stylesheet" href="/static/css/admin.css">
</head>
<body>
    <main id="main-content" class="auth-container">
        <div class="auth-card">
            <div class="auth-icon" aria-hidden="true">🔑</div>
            <h1>{{t $lang "admin.passkey_login.heading"}}</h1>
            <p class="auth-subtitle">{{t $lang "admin.passkey_login.subtitle"}}</p>

            {{if .error}}
            <div class="alert alert-error" role="alert">{{.error}}</div>
            <div class="auth-links">
                <a href="/server/auth/login">← {{t $lang "admin.passkey_login.back_link"}}</a>
            </div>
            {{else}}
            <div id="passkeyStatus" class="alert alert-info" role="status" aria-live="polite">
                <span class="spinner spinner-sm" aria-hidden="true"></span> {{t $lang "admin.passkey_login.starting_status"}}
            </div>
            <div class="auth-links">
                <a href="/server/auth/login">← {{t $lang "admin.passkey_login.back_link"}}</a>
            </div>

            <script type="application/json" id="admin-passkey-login-data">{"pendingToken": {{.pending_session_token}}, "adminPath": {{.admin_path}}}</script>
            <script src="/static/js/app.js"></script>
            {{end}}
        </div>
    </main>
</body>
</html>
{{end}}
