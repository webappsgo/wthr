{{template "head" .}}
{{template "admin_header" .}}
{{- $lang := "en" -}}
{{- if .lang}}{{$lang = .lang}}{{end -}}

    <h1>🧅 {{t $lang "admin.tor.title"}}</h1>
    <p>{{t $lang "admin.tor.intro"}}</p>

    <!-- Status Card -->
    <section class="card mb-4 p-4" role="region" aria-labelledby="status-heading">
        <h2 id="status-heading">{{t $lang "admin.tor.status_heading"}}</h2>

        <div class="status-row">
            <span class="status-indicator {{if .TorStatus.enabled}}status-connected{{else}}status-disconnected{{end}}"
                  role="img"
                  aria-label="{{if .TorStatus.enabled}}{{t $lang "admin.tor.status_connected"}}{{else}}{{t $lang "admin.tor.status_disconnected"}}{{end}}"></span>
            <strong id="tor-status-text">{{if .TorStatus.enabled}}{{t $lang "admin.tor.status_connected"}}{{else}}{{t $lang "admin.tor.status_disconnected"}}{{end}}</strong>
        </div>

        {{if .TorStatus.enabled}}
        <div class="onion-address-box" role="region" aria-labelledby="address-label">
            <div>
                <label id="address-label" class="d-block mb-1">{{t $lang "admin.tor.onion_address_label"}}</label>
                <code id="onion-address" class="onion-address">{{.TorStatus.onion_address}}</code>
            </div>
            <button class="btn btn-secondary"
                    data-action="admin-tor-copy-address"
                    aria-label="{{t $lang "admin.tor.copy_address_aria"}}">
                📋 {{t $lang "admin.tor.copy_action"}}
            </button>
        </div>
        {{end}}

        <div class="action-row">
            {{if .TorStatus.enabled}}
            <button class="btn btn-danger mr-md"
                    data-action="admin-tor-disable"
                    aria-label="{{t $lang "admin.tor.disable_aria"}}">
                {{t $lang "admin.tor.disable_action"}}
            </button>
            <button class="btn btn-secondary"
                    data-action="admin-tor-show-regenerate-modal"
                    aria-label="{{t $lang "admin.tor.regenerate_aria"}}">
                🔄 {{t $lang "admin.tor.regenerate_action"}}
            </button>
            {{else}}
            <button class="btn btn-primary"
                    data-action="admin-tor-enable"
                    aria-label="{{t $lang "admin.tor.enable_aria"}}">
                {{t $lang "admin.tor.enable_action"}}
            </button>
            {{end}}
        </div>
    </section>

    <!-- Vanity Address Generation -->
    <section class="card mb-4 p-4" role="region" aria-labelledby="vanity-heading">
        <h2 id="vanity-heading">{{t $lang "admin.tor.vanity_heading"}}</h2>
        <p>{{t $lang "admin.tor.vanity_intro"}}</p>

        <div class="form-group">
            <label for="vanity-prefix" class="form-label text-purple">
                {{t $lang "admin.tor.vanity_prefix_label"}}
                <span aria-hidden="true">*</span>
            </label>
            <input type="text"
                   id="vanity-prefix"
                   class="form-input"
                   maxlength="6"
                   pattern="[a-z2-7]+"
                   placeholder="{{t $lang "admin.tor.vanity_prefix_placeholder"}}"
                   aria-required="true"
                   aria-describedby="prefix-help">
            <small id="prefix-help" class="form-help">
                {{t $lang "admin.tor.vanity_prefix_help"}}
            </small>
        </div>

        <div class="mb-3">
            <strong>{{t $lang "admin.tor.vanity_estimate_heading"}}</strong>
            <ul class="mt-1">
                <li>{{t $lang "admin.tor.vanity_estimate_1_4"}}</li>
                <li>{{t $lang "admin.tor.vanity_estimate_5"}}</li>
                <li>{{t $lang "admin.tor.vanity_estimate_6"}}</li>
            </ul>
        </div>

        <button class="btn btn-primary"
                id="generate-vanity-btn"
                data-action="admin-tor-generate-vanity"
                aria-label="{{t $lang "admin.tor.vanity_generate_aria"}}">
            🎲 {{t $lang "admin.tor.vanity_generate_action"}}
        </button>

        <!-- Vanity Progress (shown when generating) -->
        <div id="vanity-progress" class="vanity-progress d-none" role="status" aria-live="polite">
            <h3>⏳ {{t $lang "admin.tor.vanity_generating_label"}}: "<span id="vanity-prefix-display"></span>"</h3>

            <div class="progress-stats">
                <div class="stat-item">
                    <div class="stat-value" id="attempts-count">0</div>
                    <div class="stat-label">{{t $lang "admin.tor.vanity_attempts_label"}}</div>
                </div>
                <div class="stat-item">
                    <div class="stat-value" id="elapsed-time">0s</div>
                    <div class="stat-label">{{t $lang "admin.tor.vanity_elapsed_label"}}</div>
                </div>
                <div class="stat-item">
                    <div class="stat-value" id="estimated-time">{{t $lang "admin.tor.vanity_calculating"}}</div>
                    <div class="stat-label">{{t $lang "admin.tor.vanity_estimated_label"}}</div>
                </div>
            </div>

            <div class="mt-3">
                <button class="btn btn-danger"
                        data-action="admin-tor-cancel-vanity"
                        aria-label="{{t $lang "admin.tor.vanity_cancel_aria"}}">
                    ⏹️ {{t $lang "action.cancel"}}
                </button>
            </div>

            <!-- Success message (shown when complete) -->
            <div id="vanity-success" class="success-box d-none">
                <strong>✅ {{t $lang "admin.tor.vanity_found_label"}}</strong>
                <div class="mt-1">
                    <code id="vanity-address-result"></code>
                </div>
                <button class="btn btn-primary mt-3"
                        data-action="admin-tor-apply-vanity"
                        aria-label="{{t $lang "admin.tor.vanity_apply_aria"}}">
                    {{t $lang "admin.tor.vanity_apply_action"}}
                </button>
            </div>
        </div>
    </section>

    <!-- Import External Keys -->
    <section class="card mb-4 p-4" role="region" aria-labelledby="import-heading">
        <h2 id="import-heading">{{t $lang "admin.tor.import_heading"}}</h2>
        <p>{{t $lang "admin.tor.import_intro"}}</p>

        <form id="import-form" enctype="multipart/form-data">
            <input type="hidden" name="csrf_token" value="{{.csrf_token}}">
            <div class="form-group">
                <label for="key-file" class="form-label text-purple">
                    {{t $lang "admin.tor.import_file_label"}}
                    <span aria-hidden="true">*</span>
                </label>
                <input type="file"
                       id="key-file"
                       name="key_file"
                       class="form-input"
                       accept=".key,.pem"
                       required
                       aria-required="true"
                       aria-describedby="import-help">
                <small id="import-help" class="form-help">
                    {{t $lang "admin.tor.import_file_help"}}
                </small>
            </div>

            <button type="submit" class="btn btn-primary" aria-label="{{t $lang "admin.tor.import_action"}}">
                📥 {{t $lang "admin.tor.import_action"}}
            </button>
        </form>

        <div class="help-section mt-3">
            <details>
                <summary class="cursor-pointer font-semibold">
                    ℹ️ {{t $lang "admin.tor.longer_vanity_help_summary"}}
                </summary>
                <div class="mt-3">
                    <p>{{t $lang "admin.tor.longer_vanity_help_intro"}}</p>

                    <h4 class="mt-3">{{t $lang "admin.tor.mkp224o_heading"}}</h4>
                    <pre class="code-block"><code># Install
git clone https://github.com/cathugger/mkp224o
cd mkp224o && ./autogen.sh && ./configure && make

# Generate (example: 7-char prefix "weather7")
./mkp224o -d ./keys weather7

# Output in: ./keys/weather7xxxxx.onion/
#   ├─ hs_ed25519_secret_key  (upload this file)
#   └─ hostname</code></pre>

                    <h4 class="mt-3">{{t $lang "admin.tor.time_estimates_heading"}}</h4>
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>{{t $lang "admin.tor.col_prefix_length"}}</th>
                                <th>{{t $lang "admin.tor.col_cpu_time"}}</th>
                                <th>{{t $lang "admin.tor.col_gpu_time"}}</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>7 chars</td>
                                <td>{{t $lang "admin.tor.time_days_weeks"}}</td>
                                <td>{{t $lang "admin.tor.time_hours_days"}}</td>
                            </tr>
                            <tr>
                                <td>8 chars</td>
                                <td>{{t $lang "admin.tor.time_weeks_months"}}</td>
                                <td>{{t $lang "admin.tor.time_days_weeks"}}</td>
                            </tr>
                            <tr>
                                <td>9+ chars</td>
                                <td>{{t $lang "admin.tor.time_months_years"}}</td>
                                <td>{{t $lang "admin.tor.time_weeks_months"}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </details>
        </div>
    </section>

    <!-- Export Keys -->
    <section class="card mb-4 p-4" role="region" aria-labelledby="export-heading">
        <h2 id="export-heading">{{t $lang "admin.tor.export_heading"}}</h2>
        <p>{{t $lang "admin.tor.export_intro"}}</p>

        <button class="btn btn-secondary"
                data-action="admin-tor-export-keys"
                aria-label="{{t $lang "admin.tor.export_action"}}">
            📤 {{t $lang "admin.tor.export_action"}}
        </button>

        <p class="warning-text">
            <strong>⚠️ {{t $lang "admin.tor.security_warning_label"}}</strong> {{t $lang "admin.tor.security_warning_text"}}
        </p>
    </section>

<!-- Regenerate Confirmation Modal -->
<div id="regenerate-modal" class="modal-overlay" role="dialog" aria-labelledby="modal-title" aria-modal="true">
    <div class="modal">
        <h2 id="modal-title">⚠️ {{t $lang "admin.tor.regenerate_modal_title"}}</h2>
        <p>{{t $lang "admin.tor.regenerate_modal_body1"}}</p>
        <p><strong>{{t $lang "admin.tor.regenerate_modal_body2"}}</strong></p>
        <p>{{t $lang "admin.tor.regenerate_modal_current_label"}} <code>{{.TorStatus.onion_address}}</code></p>

        <div class="modal-actions">
            <button class="btn btn-danger mr-md"
                    data-action="admin-tor-confirm-regenerate"
                    aria-label="{{t $lang "admin.tor.regenerate_confirm_aria"}}">
                {{t $lang "admin.tor.regenerate_confirm_action"}}
            </button>
            <button class="btn btn-secondary"
                    data-action="admin-tor-close-regenerate-modal"
                    aria-label="{{t $lang "admin.tor.regenerate_cancel_aria"}}">
                {{t $lang "action.cancel"}}
            </button>
        </div>
    </div>
</div>

<script type="application/json" id="admin-tor-data">
{"apiPath": "{{.api_path}}", "adminApiPath": "{{.admin_api_path}}"}
</script>

{{template "admin_footer" .}}
